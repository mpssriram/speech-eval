{
  "cut_end_s": 86.466,
  "cut_start_s": 7.932,
  "recording_id": "o_captain__lv_th__orig",
  "schema": "sentence_windows/v1",
  "sentences": [
    {
      "char_end": 48,
      "char_start": 0,
      "end": 3.364,
      "i": 0,
      "interpolated_boundary": false,
      "start": 0.0,
      "text": "O Captain! my Captain! our fearful trip is done,",
      "valid": true
    },
    {
      "char_end": 111,
      "char_start": 49,
      "end": 7.398,
      "i": 1,
      "interpolated_boundary": false,
      "start": 3.064,
      "text": "The ship has weather\u2019d every rack, the prize we sought is won,",
      "valid": true
    },
    {
      "char_end": 172,
      "char_start": 112,
      "end": 11.683,
      "i": 2,
      "interpolated_boundary": false,
      "start": 7.098,
      "text": "The port is near, the bells I hear, the people all exulting,",
      "valid": true
    },
    {
      "char_end": 235,
      "char_start": 173,
      "end": 16.128,
      "i": 3,
      "interpolated_boundary": false,
      "start": 11.503,
      "text": "While follow eyes the steady keel, the vessel grim and daring;",
      "valid": true
    },
    {
      "char_end": 269,
      "char_start": 243,
      "end": 18.895,
      "i": 4,
      "interpolated_boundary": false,
      "start": 16.389,
      "text": "But O heart! heart! heart!",
      "valid": true
    },
    {
      "char_end": 307,
      "char_start": 279,
      "end": 20.938,
      "i": 5,
      "interpolated_boundary": true,
      "start": 18.595,
      "text": "O the bleeding drops of red,",
      "valid": true
    },
    {
      "char_end": 353,
      "char_start": 319,
      "end": 23.151,
      "i": 6,
      "interpolated_boundary": false,
      "start": 20.638,
      "text": "Where on the deck my Captain lies,",
      "valid": true
    },
    {
      "char_end": 388,
      "char_start": 367,
      "end": 24.563,
      "i": 7,
      "interpolated_boundary": false,
      "start": 22.851,
      "text": "Fallen cold and dead.",
      "valid": true
    },
    {
      "char_end": 439,
      "char_start": 389,
      "end": 28.269,
      "i": 8,
      "interpolated_boundary": true,
      "start": 24.264,
      "text": "O Captain! my Captain! rise up and hear the bells;",
      "valid": true
    },
    {
      "char_end": 501,
      "char_start": 440,
      "end": 33.136,
      "i": 9,
      "interpolated_boundary": false,
      "start": 28.049,
      "text": "Rise up- for you the flag is flung- for you the bugle trills,",
      "valid": true
    },
    {
      "char_end": 571,
      "char_start": 502,
      "end": 37.462,
      "i": 10,
      "interpolated_boundary": false,
      "start": 33.036,
      "text": "For you bouquets and ribbon\u2019d wreaths- for you the shores a-crowding,",
      "valid": true
    },
    {
      "char_end": 635,
      "char_start": 572,
      "end": 41.788,
      "i": 11,
      "interpolated_boundary": false,
      "start": 37.403,
      "text": "For you they call, the swaying mass, their eager faces turning;",
      "valid": true
    },
    {
      "char_end": 669,
      "char_start": 643,
      "end": 44.012,
      "i": 12,
      "interpolated_boundary": false,
      "start": 41.869,
      "text": "Here Captain! dear father!",
      "valid": true
    },
    {
      "char_end": 706,
      "char_start": 679,
      "end": 45.794,
      "i": 13,
      "interpolated_boundary": false,
      "start": 43.712,
      "text": "This arm beneath your head!",
      "valid": true
    },
    {
      "char_end": 752,
      "char_start": 718,
      "end": 47.772,
      "i": 14,
      "interpolated_boundary": false,
      "start": 45.53,
      "text": "It is some dream that on the deck,",
      "valid": true
    },
    {
      "char_end": 794,
      "char_start": 766,
      "end": 49.514,
      "i": 15,
      "interpolated_boundary": false,
      "start": 47.472,
      "text": "You\u2019ve fallen cold and dead.",
      "valid": true
    },
    {
      "char_end": 851,
      "char_start": 795,
      "end": 54.44,
      "i": 16,
      "interpolated_boundary": false,
      "start": 49.975,
      "text": "My Captain does not answer, his lips are pale and still,",
      "valid": true
    },
    {
      "char_end": 909,
      "char_start": 852,
      "end": 59.086,
      "i": 17,
      "interpolated_boundary": false,
      "start": 54.761,
      "text": "My father does not feel my arm, he has no pulse nor will,",
      "valid": true
    },
    {
      "char_end": 974,
      "char_start": 910,
      "end": 63.771,
      "i": 18,
      "interpolated_boundary": false,
      "start": 59.347,
      "text": "The ship is anchor\u2019d safe and sound, its voyage closed and done,",
      "valid": true
    },
    {
      "char_end": 1034,
      "char_start": 975,
      "end": 67.946,
      "i": 19,
      "interpolated_boundary": false,
      "start": 63.952,
      "text": "From fearful trip the victor ship comes in with object won;",
      "valid": true
    },
    {
      "char_end": 1075,
      "char_start": 1042,
      "end": 71.2,
      "i": 20,
      "interpolated_boundary": false,
      "start": 67.646,
      "text": "Exult O shores, and ring O bells!",
      "valid": true
    },
    {
      "char_end": 1111,
      "char_start": 1085,
      "end": 73.343,
      "i": 21,
      "interpolated_boundary": false,
      "start": 71.041,
      "text": "But I with mournful tread,",
      "valid": true
    },
    {
      "char_end": 1153,
      "char_start": 1123,
      "end": 76.066,
      "i": 22,
      "interpolated_boundary": false,
      "start": 73.163,
      "text": "Walk the deck my Captain lies,",
      "valid": true
    },
    {
      "char_end": 1188,
      "char_start": 1167,
      "end": 78.534,
      "i": 23,
      "interpolated_boundary": false,
      "start": 75.77,
      "text": "Fallen cold and dead.",
      "valid": true
    }
  ],
