{
  "cut_end_s": 95.734,
  "cut_start_s": 9.322,
  "recording_id": "o_captain__lv_mrg__orig",
  "schema": "sentence_windows/v1",
  "sentences": [
    {
      "char_end": 48,
      "char_start": 0,
      "end": 2.993,
      "i": 0,
      "interpolated_boundary": false,
      "start": 0.0,
      "text": "O Captain! my Captain! our fearful trip is done,",
      "valid": true
    },
    {
      "char_end": 111,
      "char_start": 49,
      "end": 7.72,
      "i": 1,
      "interpolated_boundary": false,
      "start": 2.693,
      "text": "The ship has weather\u2019d every rack, the prize we sought is won,",
      "valid": true
    },
    {
      "char_end": 172,
      "char_start": 112,
      "end": 12.286,
      "i": 2,
      "interpolated_boundary": false,
      "start": 7.42,
      "text": "The port is near, the bells I hear, the people are exulting,",
      "valid": true
    },
    {
      "char_end": 235,
      "char_start": 173,
      "end": 17.312,
      "i": 3,
      "interpolated_boundary": false,
      "start": 12.607,
      "text": "While follow eyes the steady keel, the vessel grim and daring;",
      "valid": true
    },
    {
      "char_end": 269,
      "char_start": 243,
      "end": 20.256,
      "i": 4,
      "interpolated_boundary": false,
      "start": 17.133,
      "text": "But O heart! heart! heart!",
      "valid": true
    },
    {
      "char_end": 307,
      "char_start": 279,
      "end": 22.886,
      "i": 5,
      "interpolated_boundary": false,
      "start": 20.257,
      "text": "O the bleeding drops of red,",
      "valid": true
    },
    {
      "char_end": 353,
      "char_start": 319,
      "end": 25.135,
      "i": 6,
      "interpolated_boundary": false,
      "start": 22.586,
      "text": "Where on the deck my Captain lies,",
      "valid": true
    },
    {
      "char_end": 388,
      "char_start": 367,
      "end": 27.137,
      "i": 7,
      "interpolated_boundary": false,
      "start": 24.835,
      "text": "Fallen cold and dead.",
      "valid": true
    },
    {
      "char_end": 439,
      "char_start": 389,
      "end": 31.163,
      "i": 8,
      "interpolated_boundary": false,
      "start": 27.599,
      "text": "O Captain! my Captain! rise up and hear the bells;",
      "valid": true
    },
    {
      "char_end": 501,
      "char_start": 440,
      "end": 36.169,
      "i": 9,
      "interpolated_boundary": false,
      "start": 31.143,
      "text": "Rise up- for you the flag is flung- for you the bugle trills,",
      "valid": true
    },
    {
      "char_end": 571,
      "char_start": 502,
      "end": 40.856,
      "i": 10,
      "interpolated_boundary": true,
      "start": 36.03,
      "text": "For you bouquets and ribbon\u2019d wreaths- for you the shores a-crowding,",
      "valid": true
    },
    {
      "char_end": 635,
      "char_start": 572,
      "end": 45.762,
      "i": 11,
      "interpolated_boundary": false,
      "start": 41.017,
      "text": "For you they call, the swaying mass, their eager faces turning;",
      "valid": true
    },
    {
      "char_end": 669,
      "char_start": 643,
      "end": 48.206,
      "i": 12,
      "interpolated_boundary": true,
      "start": 45.462,
      "text": "Here Captain! dear father!",
      "valid": true
    },
    {
      "char_end": 706,
      "char_start": 679,
      "end": 50.068,
      "i": 13,
      "interpolated_boundary": false,
      "start": 47.906,
      "text": "This arm beneath your head!",
      "valid": true
    },
    {
      "char_end": 752,
      "char_start": 718,
      "end": 52.735,
      "i": 14,
      "interpolated_boundary": false,
      "start": 49.772,
      "text": "It is some dream that on the deck,",
      "valid": true
    },
    {
      "char_end": 794,
      "char_start": 766,
      "end": 54.217,
      "i": 15,
      "interpolated_boundary": false,
      "start": 52.435,
      "text": "You\u2019ve fallen cold and dead.",
      "valid": true
    },
    {
      "char_end": 851,
      "char_start": 795,
      "end": 59.424,
      "i": 16,
      "interpolated_boundary": false,
      "start": 54.839,
      "text": "My Captain does not answer, his lips are pale and still,",
      "valid": true
    },
    {
      "char_end": 909,
      "char_start": 852,
      "end": 63.84,
      "i": 17,
      "interpolated_boundary": false,
      "start": 59.124,
      "text": "My father does not feel my arm, he has no pulse nor will,",
      "valid": true
    },
    {
      "char_end": 974,
      "char_start": 910,
      "end": 68.696,
      "i": 18,
      "interpolated_boundary": false,
      "start": 63.54,
      "text": "The ship is anchor\u2019d safe and sound, its voyage closed and done,",
      "valid": true
    },
    {
      "char_end": 1034,
      "char_start": 975,
      "end": 72.982,
      "i": 19,
      "interpolated_boundary": false,
      "start": 68.677,
      "text": "From fearful trip the victor ship comes in with object won;",
      "valid": true
    },
    {
      "char_end": 1075,
      "char_start": 1042,
      "end": 76.847,
      "i": 20,
      "interpolated_boundary": false,
      "start": 72.682,
      "text": "Exult O shores, and ring O bells!",
      "valid": true
    },
    {
      "char_end": 1111,
      "char_start": 1085,
      "end": 80.372,
      "i": 21,
      "interpolated_boundary": false,
      "start": 76.828,
      "text": "But I with mournful tread,",
      "valid": true
    },
    {
      "char_end": 1153,
      "char_start": 1123,
      "end": 82.951,
      "i": 22,
      "interpolated_boundary": false,
      "start": 80.364,
      "text": "Walk the deck my Captain lies,",
      "valid": true
    },
    {
      "char_end": 1192,
      "char_start": 1167,
      "end": 86.412,
      "i": 23,
      "interpolated_boundary": false,
      "start": 82.651,
      "text": "Fallen cold and dead. End",
      "valid": true
    }
  ],
