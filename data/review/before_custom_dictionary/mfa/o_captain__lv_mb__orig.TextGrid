    item [2]:
        class = "IntervalTier" 
        name = "sentences" 
        xmin = 0 
        xmax = 81.869 
        intervals: size = 49 
        intervals [1]:
            xmin = 0 
            xmax = 0.14 
            text = "" 
        intervals [2]:
            xmin = 0.14 
            xmax = 3.344 
            text = "O Captain! my Captain! our fearful trip is done," 
        intervals [3]:
            xmin = 3.344 
            xmax = 3.694 
            text = "" 
        intervals [4]:
            xmin = 3.694 
            xmax = 7.604 
            text = "The ship has weather’d every rack, the prize we sought is won," 
        intervals [5]:
            xmin = 7.604 
            xmax = 8.201 
            text = "" 
        intervals [6]:
            xmin = 8.201 
            xmax = 12.101 
            text = "The port is near, the bells I hear, the people all exulting," 
        intervals [7]:
            xmin = 12.101 
            xmax = 12.59 
            text = "" 
        intervals [8]:
            xmin = 12.59 
            xmax = 16.54 
            text = "While follow eyes the steady keel, the vessel grim and daring;" 
        intervals [9]:
            xmin = 16.54 
            xmax = 17.056 
            text = "" 
        intervals [10]:
            xmin = 17.056 
            xmax = 18.899 
            text = "But O heart! heart! heart!" 
        intervals [11]:
            xmin = 18.899 
            xmax = 19.369 
            text = "" 
        intervals [12]:
            xmin = 19.369 
            xmax = 21.129 
            text = "O the bleeding drops of red," 
        intervals [13]:
            xmin = 21.129 
            xmax = 21.503 
            text = "" 
        intervals [14]:
            xmin = 21.503 
            xmax = 23.456 
            text = "Where on the deck my Captain lies," 
        intervals [15]:
            xmin = 23.456 
            xmax = 23.816 
            text = "" 
        intervals [16]:
            xmin = 23.816 
            xmax = 25.178 
            text = "Fallen cold and dead." 
        intervals [17]:
            xmin = 25.178 
            xmax = 26.569 
            text = "" 
        intervals [18]:
            xmin = 26.569 
            xmax = 29.848 
            text = "O Captain! my Captain! rise up and hear the bells;" 
        intervals [19]:
            xmin = 29.848 
            xmax = 30.376 
            text = "" 
        intervals [20]:
            xmin = 30.376 
            xmax = 34.746 
            text = "Rise up- for you the flag is flung- for you the bugle trills," 
        intervals [21]:
            xmin = 34.746 
            xmax = 35.045 
            text = "" 
        intervals [22]:
            xmin = 35.045 
            xmax = 39.295 
            text = "For you bouquets and ribbon’d wreaths- for you the shores a-crowding," 
        intervals [23]:
            xmin = 39.295 
            xmax = 39.822 
            text = "" 
        intervals [24]:
            xmin = 39.822 
            xmax = 44.012 
            text = "For you they call, the swaying mass, their eager faces turning;" 
        intervals [25]:
            xmin = 44.012 
            xmax = 44.697 
            text = "" 
        intervals [26]:
            xmin = 44.697 
            xmax = 46.637 
            text = "Here Captain! dear father!" 
        intervals [27]:
            xmin = 46.637 
            xmax = 46.949 
            text = "" 
        intervals [28]:
            xmin = 46.949 
            xmax = 48.469 
            text = "This arm beneath your head!" 
        intervals [29]:
            xmin = 48.469 
            xmax = 49.021 
            text = "" 
        intervals [30]:
            xmin = 49.021 
            xmax = 51.001 
            text = "It is some dream that on the deck," 
        intervals [31]:
            xmin = 51.001 
            xmax = 51.313 
            text = "" 
        intervals [32]:
            xmin = 51.313 
            xmax = 53.034 
            text = "You’ve fallen cold and dead." 
        intervals [33]:
            xmin = 53.034 
            xmax = 54.317 
            text = "" 
        intervals [34]:
            xmin = 54.317 
            xmax = 57.837 
            text = "My Captain does not answer, his lips are pale and still," 
        intervals [35]:
            xmin = 57.837 
            xmax = 58.501 
            text = "" 
        intervals [36]:
            xmin = 58.501 
            xmax = 62.401 
            text = "My father does not feel my arm, he has no pulse nor will," 
        intervals [37]:
            xmin = 62.401 
            xmax = 63.111 
            text = "" 
        intervals [38]:
            xmin = 63.111 
            xmax = 67.254 
            text = "The ship is anchor’d safe and sound, its voyage closed and done," 
        intervals [39]:
            xmin = 67.254 
            xmax = 67.515 
            text = "" 
        intervals [40]:
            xmin = 67.515 
            xmax = 71.545 
            text = "From fearful trip the victor ship comes in with object won;" 
        intervals [41]:
            xmin = 71.545 
            xmax = 72.253 
            text = "" 
        intervals [42]:
            xmin = 72.253 
            xmax = 74.853 
            text = "Exult O shores, and ring O bells!" 
        intervals [43]:
            xmin = 74.853 
            xmax = 75.298 
            text = "" 
        intervals [44]:
            xmin = 75.298 
            xmax = 76.957 
            text = "But I with mournful tread," 
        intervals [45]:
            xmin = 76.957 
            xmax = 77.382 
            text = "" 
        intervals [46]:
            xmin = 77.382 
            xmax = 79.492 
            text = "Walk the deck my Captain lies," 
        intervals [47]:
            xmin = 79.492 
            xmax = 79.735 
            text = "" 
        intervals [48]:
            xmin = 79.735 
            xmax = 81.656 
            text = "Fallen cold and dead." 
        intervals [49]:
            xmin = 81.656 
            xmax = 81.869 
            text = "" 
