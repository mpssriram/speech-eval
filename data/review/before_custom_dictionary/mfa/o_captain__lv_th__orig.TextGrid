            xmax = 0.16 
            text = "" 
        intervals [2]:
            xmin = 0.16 
            xmax = 3.214 
            text = "O Captain! my Captain! our fearful trip is done," 
        intervals [3]:
            xmin = 3.214 
            xmax = 3.674 
            text = "" 
        intervals [4]:
            xmin = 3.674 
            xmax = 7.248 
            text = "The ship has weather’d every rack, the prize we sought is won," 
        intervals [5]:
            xmin = 7.248 
            xmax = 7.718 
            text = "" 
        intervals [6]:
            xmin = 7.718 
            xmax = 11.408 
            text = "The port is near, the bells I hear, the people all exulting," 
        intervals [7]:
            xmin = 11.408 
            xmax = 11.733 
            text = "" 
        intervals [8]:
            xmin = 11.733 
            xmax = 15.873 
            text = "While follow eyes the steady keel, the vessel grim and daring;" 
        intervals [9]:
            xmin = 15.873 
            xmax = 16.619 
            text = "" 
        intervals [10]:
            xmin = 16.619 
            xmax = 18.745 
            text = "But O heart! heart! heart!" 
        intervals [11]:
            xmin = 18.745 
            xmax = 18.925 
            text = "" 
        intervals [12]:
            xmin = 18.925 
            xmax = 20.685 
            text = "O the bleeding drops of red," 
        intervals [13]:
            xmin = 20.685 
            xmax = 20.878 
            text = "" 
        intervals [14]:
            xmin = 20.878 
            xmax = 23.001 
            text = "Where on the deck my Captain lies," 
        intervals [15]:
            xmin = 23.001 
            xmax = 24.413 
            text = "Fallen cold and dead." 
        intervals [16]:
            xmin = 24.413 
            xmax = 25.063 
            text = "" 
        intervals [17]:
            xmin = 25.063 
            xmax = 28.023 
            text = "O Captain! my Captain! rise up and hear the bells;" 
        intervals [18]:
            xmin = 28.023 
            xmax = 28.249 
            text = "" 
        intervals [19]:
            xmin = 28.249 
            xmax = 32.919 
            text = "Rise up- for you the flag is flung- for you the bugle trills," 
        intervals [20]:
            xmin = 32.919 
            xmax = 33.246 
            text = "" 
        intervals [21]:
            xmin = 33.246 
            xmax = 37.186 
            text = "For you bouquets and ribbon’d wreaths- for you the shores a-crowding," 
        intervals [22]:
            xmin = 37.186 
            xmax = 37.572 
            text = "" 
        intervals [23]:
            xmin = 37.572 
            xmax = 41.522 
            text = "For you they call, the swaying mass, their eager faces turning;" 
        intervals [24]:
            xmin = 41.522 
            xmax = 42.039 
            text = "" 
        intervals [25]:
            xmin = 42.039 
            xmax = 43.862 
            text = "Here Captain! dear father!" 
        intervals [26]:
            xmin = 43.862 
            xmax = 45.272 
            text = "This arm beneath your head!" 
        intervals [27]:
            xmin = 45.272 
            xmax = 45.882 
            text = "" 
        intervals [28]:
            xmin = 45.882 
            xmax = 47.622 
            text = "It is some dream that on the deck," 
        intervals [29]:
            xmin = 47.622 
            xmax = 49.282 
            text = "You’ve fallen cold and dead." 
        intervals [30]:
            xmin = 49.282 
            xmax = 50.235 
            text = "" 
        intervals [31]:
            xmin = 50.235 
            xmax = 54.215 
            text = "My Captain does not answer, his lips are pale and still," 
        intervals [32]:
            xmin = 54.215 
            xmax = 55.001 
            text = "" 
        intervals [33]:
            xmin = 55.001 
            xmax = 58.861 
            text = "My father does not feel my arm, he has no pulse nor will," 
        intervals [34]:
            xmin = 58.861 
            xmax = 59.607 
            text = "" 
        intervals [35]:
            xmin = 59.607 
            xmax = 63.597 
            text = "The ship is anchor’d safe and sound, its voyage closed and done," 
        intervals [36]:
            xmin = 63.597 
            xmax = 64.132 
            text = "" 
        intervals [37]:
            xmin = 64.132 
            xmax = 67.796 
            text = "From fearful trip the victor ship comes in with object won;" 
        intervals [38]:
            xmin = 67.796 
            xmax = 68.326 
            text = "" 
        intervals [39]:
            xmin = 68.326 
            xmax = 71.12 
            text = "Exult O shores, and ring O bells!" 
        intervals [40]:
            xmin = 71.12 
            xmax = 71.281 
            text = "" 
        intervals [41]:
            xmin = 71.281 
            xmax = 73.091 
            text = "But I with mournful tread," 
        intervals [42]:
            xmin = 73.091 
            xmax = 73.373 
            text = "" 
        intervals [43]:
            xmin = 73.373 
            xmax = 75.683 
            text = "Walk the deck my Captain lies," 
        intervals [44]:
            xmin = 75.683 
            xmax = 76.048 
            text = "" 
        intervals [45]:
            xmin = 76.048 
            xmax = 78.258 
            text = "Fallen cold and dead." 
        intervals [46]:
            xmin = 78.258 
            xmax = 78.534 
            text = "" 
