    item [2]:
        class = "IntervalTier" 
        name = "sentences" 
        xmin = 0 
        xmax = 92.244 
        intervals: size = 49 
        intervals [1]:
            xmin = 0 
            xmax = 0.14 
            text = "" 
        intervals [2]:
            xmin = 0.14 
            xmax = 4.19 
            text = "O Captain! my Captain! our fearful trip is done," 
        intervals [3]:
            xmin = 4.19 
            xmax = 4.747 
            text = "" 
        intervals [4]:
            xmin = 4.747 
            xmax = 8.767 
            text = "The ship has weather’d every rack, the prize we sought is won," 
        intervals [5]:
            xmin = 8.767 
            xmax = 9.424 
            text = "" 
        intervals [6]:
            xmin = 9.424 
            xmax = 13.094 
            text = "The port is near, the bells I hear, the people all exulting," 
        intervals [7]:
            xmin = 13.094 
            xmax = 13.711 
            text = "" 
        intervals [8]:
            xmin = 13.711 
            xmax = 18.031 
            text = "While follow eyes the steady keel, the vessel grim and daring;" 
        intervals [9]:
            xmin = 18.031 
            xmax = 18.768 
            text = "" 
        intervals [10]:
            xmin = 18.768 
            xmax = 20.66 
            text = "But O heart! heart! heart!" 
        intervals [11]:
            xmin = 20.66 
            xmax = 21.55 
            text = "" 
        intervals [12]:
            xmin = 21.55 
            xmax = 23.31 
            text = "O the bleeding drops of red," 
        intervals [13]:
            xmin = 23.31 
            xmax = 23.994 
            text = "" 
        intervals [14]:
            xmin = 23.994 
            xmax = 25.925 
            text = "Where on the deck my Captain lies," 
        intervals [15]:
            xmin = 25.925 
            xmax = 26.435 
            text = "" 
        intervals [16]:
            xmin = 26.435 
            xmax = 27.767 
            text = "Fallen cold and dead." 
        intervals [17]:
            xmin = 27.767 
            xmax = 28.897 
            text = "" 
        intervals [18]:
            xmin = 28.897 
            xmax = 32.997 
            text = "O Captain! my Captain! rise up and hear the bells;" 
        intervals [19]:
            xmin = 32.997 
            xmax = 33.533 
            text = "" 
        intervals [20]:
            xmin = 33.533 
            xmax = 37.573 
            text = "Rise up- for you the flag is flung- for you the bugle trills," 
        intervals [21]:
            xmin = 37.573 
            xmax = 38.238 
            text = "" 
        intervals [22]:
            xmin = 38.238 
            xmax = 42.348 
            text = "For you bouquets and ribbon’d wreaths- for you the shores a-crowding," 
        intervals [23]:
            xmin = 42.348 
            xmax = 43.022 
            text = "" 
        intervals [24]:
            xmin = 43.022 
            xmax = 46.712 
            text = "For you they call, the swaying mass, their eager faces turning;" 
        intervals [25]:
            xmin = 46.712 
            xmax = 47.297 
            text = "" 
        intervals [26]:
            xmin = 47.297 
            xmax = 49.059 
            text = "Here Captain! dear father!" 
        intervals [27]:
            xmin = 49.059 
            xmax = 49.599 
            text = "" 
        intervals [28]:
            xmin = 49.599 
            xmax = 51.089 
            text = "This arm beneath your head!" 
        intervals [29]:
            xmin = 51.089 
            xmax = 51.673 
            text = "" 
        intervals [30]:
            xmin = 51.673 
            xmax = 53.493 
            text = "It is some dream that on the deck," 
        intervals [31]:
            xmin = 53.493 
            xmax = 53.846 
            text = "" 
        intervals [32]:
            xmin = 53.846 
            xmax = 55.546 
            text = "You’ve fallen cold and dead." 
        intervals [33]:
            xmin = 55.546 
            xmax = 57.241 
            text = "" 
        intervals [34]:
            xmin = 57.241 
            xmax = 61.201 
            text = "My Captain does not answer, his lips are pale and still," 
        intervals [35]:
            xmin = 61.201 
            xmax = 61.937 
            text = "" 
        intervals [36]:
            xmin = 61.937 
            xmax = 66.187 
            text = "My father does not feel my arm, he has no pulse nor will," 
        intervals [37]:
            xmin = 66.187 
            xmax = 66.954 
            text = "" 
        intervals [38]:
            xmin = 66.954 
            xmax = 71.144 
            text = "The ship is anchor’d safe and sound, its voyage closed and done," 
        intervals [39]:
            xmin = 71.144 
            xmax = 71.884 
            text = "" 
        intervals [40]:
            xmin = 71.884 
            xmax = 75.591 
            text = "From fearful trip the victor ship comes in with object won;" 
        intervals [41]:
            xmin = 75.591 
            xmax = 76.411 
            text = "" 
        intervals [42]:
            xmin = 76.411 
            xmax = 79.291 
            text = "Exult O shores, and ring O bells!" 
        intervals [43]:
            xmin = 79.291 
            xmax = 79.88 
            text = "" 
        intervals [44]:
            xmin = 79.88 
            xmax = 81.64 
            text = "But I with mournful tread," 
        intervals [45]:
            xmin = 81.64 
            xmax = 82.345 
            text = "" 
        intervals [46]:
            xmin = 82.345 
            xmax = 84.485 
            text = "Walk the deck my Captain lies," 
        intervals [47]:
            xmin = 84.485 
            xmax = 84.93 
            text = "" 
        intervals [48]:
            xmin = 84.93 
            xmax = 91.8 
            text = "Fallen cold and dead." 
        intervals [49]:
            xmin = 91.8 
            xmax = 92.244 
            text = "" 
