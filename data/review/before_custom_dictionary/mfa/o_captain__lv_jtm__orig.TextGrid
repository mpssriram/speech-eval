    item [2]:
        class = "IntervalTier" 
        name = "sentences" 
        xmin = 0 
        xmax = 97.208 
        intervals: size = 48 
        intervals [1]:
            xmin = 0 
            xmax = 0.13 
            text = "" 
        intervals [2]:
            xmin = 0.13 
            xmax = 3.92 
            text = "O Captain! my Captain! our fearful trip is done," 
        intervals [3]:
            xmin = 3.92 
            xmax = 4.285 
            text = "" 
        intervals [4]:
            xmin = 4.285 
            xmax = 8.462 
            text = "The ship has weather’d every rack, the prize we sought is won," 
        intervals [5]:
            xmin = 8.462 
            xmax = 9.123 
            text = "" 
        intervals [6]:
            xmin = 9.123 
            xmax = 13.233 
            text = "The port is near, the bells I hear, the people all exulting," 
        intervals [7]:
            xmin = 13.233 
            xmax = 13.669 
            text = "" 
        intervals [8]:
            xmin = 13.669 
            xmax = 18.299 
            text = "While follow eyes the steady keel, the vessel grim and daring;" 
        intervals [9]:
            xmin = 18.299 
            xmax = 19.309 
            text = "" 
        intervals [10]:
            xmin = 19.309 
            xmax = 23.089 
            text = "But O heart! heart! heart!" 
        intervals [11]:
            xmin = 23.089 
            xmax = 24.095 
            text = "" 
        intervals [12]:
            xmin = 24.095 
            xmax = 26.719 
            text = "O the bleeding drops of red," 
        intervals [13]:
            xmin = 26.719 
            xmax = 27.34 
            text = "" 
        intervals [14]:
            xmin = 27.34 
            xmax = 29.913 
            text = "Where on the deck my Captain lies," 
        intervals [15]:
            xmin = 29.913 
            xmax = 30.114 
            text = "" 
        intervals [16]:
            xmin = 30.114 
            xmax = 31.827 
            text = "Fallen cold and dead." 
        intervals [17]:
            xmin = 31.827 
            xmax = 33.857 
            text = "" 
        intervals [18]:
            xmin = 33.857 
            xmax = 37.587 
            text = "O Captain! my Captain! rise up and hear the bells;" 
        intervals [19]:
            xmin = 37.587 
            xmax = 37.935 
            text = "" 
        intervals [20]:
            xmin = 37.935 
            xmax = 42.405 
            text = "Rise up- for you the flag is flung- for you the bugle trills," 
        intervals [21]:
            xmin = 42.405 
            xmax = 42.852 
            text = "" 
        intervals [22]:
            xmin = 42.852 
            xmax = 47.008 
            text = "For you bouquets and ribbon’d wreaths- for you the shores a-crowding," 
        intervals [23]:
            xmin = 47.008 
            xmax = 47.739 
            text = "" 
        intervals [24]:
            xmin = 47.739 
            xmax = 52.196 
            text = "For you they call, the swaying mass, their eager faces turning;" 
        intervals [25]:
            xmin = 52.196 
            xmax = 52.857 
            text = "" 
        intervals [26]:
            xmin = 52.857 
            xmax = 54.861 
            text = "Here Captain! dear father!" 
        intervals [27]:
            xmin = 54.861 
            xmax = 56.413 
            text = "This arm beneath your head!" 
        intervals [28]:
            xmin = 56.413 
            xmax = 56.983 
            text = "" 
        intervals [29]:
            xmin = 56.983 
            xmax = 59.233 
            text = "It is some dream that on the deck," 
        intervals [30]:
            xmin = 59.233 
            xmax = 59.388 
            text = "" 
        intervals [31]:
            xmin = 59.388 
            xmax = 61.611 
            text = "You’ve fallen cold and dead." 
        intervals [32]:
            xmin = 61.611 
            xmax = 64.106 
            text = "" 
        intervals [33]:
            xmin = 64.106 
            xmax = 68.696 
            text = "My Captain does not answer, his lips are pale and still," 
        intervals [34]:
            xmin = 68.696 
            xmax = 69.675 
            text = "" 
        intervals [35]:
            xmin = 69.675 
            xmax = 74.745 
            text = "My father does not feel my arm, he has no pulse nor will," 
        intervals [36]:
            xmin = 74.745 
            xmax = 75.823 
            text = "" 
        intervals [37]:
            xmin = 75.823 
            xmax = 79.943 
            text = "The ship is anchor’d safe and sound, its voyage closed and done," 
        intervals [38]:
            xmin = 79.943 
            xmax = 80.288 
            text = "" 
        intervals [39]:
            xmin = 80.288 
            xmax = 84.463 
            text = "From fearful trip the victor ship comes in with object won;" 
        intervals [40]:
            xmin = 84.463 
            xmax = 85.813 
            text = "" 
        intervals [41]:
            xmin = 85.813 
            xmax = 88.613 
            text = "Exult O shores, and ring O bells!" 
        intervals [42]:
            xmin = 88.613 
            xmax = 89.119 
            text = "" 
        intervals [43]:
            xmin = 89.119 
            xmax = 91.081 
            text = "But I with mournful tread," 
        intervals [44]:
            xmin = 91.081 
            xmax = 92.081 
            text = "" 
        intervals [45]:
            xmin = 92.081 
            xmax = 94.475 
            text = "Walk the deck my Captain lies," 
        intervals [46]:
            xmin = 94.475 
            xmax = 94.595 
            text = "" 
        intervals [47]:
            xmin = 94.595 
            xmax = 97.105 
            text = "Fallen cold and dead." 
        intervals [48]:
            xmin = 97.105 
            xmax = 97.208 
            text = "" 
