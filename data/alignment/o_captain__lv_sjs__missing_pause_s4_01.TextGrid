    item [2]:
        class = "IntervalTier" 
        name = "sentences" 
        xmin = 0 
        xmax = 97.595 
        intervals: size = 48 
        intervals [1]:
            xmin = 0 
            xmax = 0.05 
            text = "" 
        intervals [2]:
            xmin = 0.05 
            xmax = 3.9 
            text = "O Captain! my Captain! our fearful trip is done," 
        intervals [3]:
            xmin = 3.9 
            xmax = 4.53 
            text = "" 
        intervals [4]:
            xmin = 4.53 
            xmax = 7.64 
            text = "The ship has weather’d every rack, the prize we sought is won," 
        intervals [5]:
            xmin = 7.64 
            xmax = 8.56 
            text = "" 
        intervals [6]:
            xmin = 8.56 
            xmax = 12.62 
            text = "The port is near, the bells I hear, the people all exulting," 
        intervals [7]:
            xmin = 12.62 
            xmax = 12.68 
            text = "" 
        intervals [8]:
            xmin = 12.68 
            xmax = 16.41 
            text = "While follow eyes the steady keel, the vessel grim and daring;" 
        intervals [9]:
            xmin = 16.41 
            xmax = 18.17 
            text = "" 
        intervals [10]:
            xmin = 18.17 
            xmax = 21.77 
            text = "But O heart! heart! heart!" 
        intervals [11]:
            xmin = 21.77 
            xmax = 23.3 
            text = "" 
        intervals [12]:
            xmin = 23.3 
            xmax = 25.04 
            text = "O the bleeding drops of red," 
        intervals [13]:
            xmin = 25.04 
            xmax = 26.07 
            text = "" 
        intervals [14]:
            xmin = 26.07 
            xmax = 27.98 
            text = "Where on the deck my Captain lies," 
        intervals [15]:
            xmin = 27.98 
            xmax = 29.39 
            text = "Fallen cold and dead." 
        intervals [16]:
            xmin = 29.39 
            xmax = 31.4 
            text = "" 
        intervals [17]:
            xmin = 31.4 
            xmax = 34.97 
            text = "O Captain! my Captain! rise up and hear the bells;" 
        intervals [18]:
            xmin = 34.97 
            xmax = 35.24 
            text = "" 
        intervals [19]:
            xmin = 35.24 
            xmax = 38.75 
            text = "Rise up- for you the flag is flung- for you the bugle trills," 
        intervals [20]:
            xmin = 38.75 
            xmax = 39.39 
            text = "" 
        intervals [21]:
            xmin = 39.39 
            xmax = 43.15 
            text = "For you bouquets and ribbon’d wreaths- for you the shores a-crowding," 
        intervals [22]:
            xmin = 43.15 
            xmax = 44.05 
            text = "" 
        intervals [23]:
            xmin = 44.05 
            xmax = 47.95 
            text = "For you they call, the swaying mass, their eager faces turning;" 
        intervals [24]:
            xmin = 47.95 
            xmax = 49.87 
            text = "" 
        intervals [25]:
            xmin = 49.87 
            xmax = 51.48 
            text = "Here Captain! dear father!" 
        intervals [26]:
            xmin = 51.48 
            xmax = 51.95 
            text = "" 
        intervals [27]:
            xmin = 51.95 
            xmax = 53.19 
            text = "This arm beneath your head!" 
        intervals [28]:
            xmin = 53.19 
            xmax = 54.04 
            text = "" 
        intervals [29]:
            xmin = 54.04 
            xmax = 55.81 
            text = "It is some dream that on the deck," 
        intervals [30]:
            xmin = 55.81 
            xmax = 55.96 
            text = "" 
        intervals [31]:
            xmin = 55.96 
            xmax = 57.24 
            text = "You’ve fallen cold and dead." 
        intervals [32]:
            xmin = 57.24 
            xmax = 59.83 
            text = "" 
        intervals [33]:
            xmin = 59.83 
            xmax = 64.02 
            text = "My Captain does not answer, his lips are pale and still," 
        intervals [34]:
            xmin = 64.02 
            xmax = 65.15 
            text = "" 
        intervals [35]:
            xmin = 65.15 
            xmax = 69.88 
            text = "My father does not feel my arm, he has no pulse nor will," 
        intervals [36]:
            xmin = 69.88 
            xmax = 71.67 
            text = "" 
        intervals [37]:
            xmin = 71.67 
            xmax = 75.93 
            text = "The ship is anchor’d safe and sound, its voyage closed and done," 
        intervals [38]:
            xmin = 75.93 
            xmax = 76.56 
            text = "" 
        intervals [39]:
            xmin = 76.56 
            xmax = 80.35 
            text = "From fearful trip the victor ship comes in with object won;" 
        intervals [40]:
            xmin = 80.35 
            xmax = 81.54 
            text = "" 
        intervals [41]:
            xmin = 81.54 
            xmax = 83.76 
            text = "Exult O shores, and ring O bells!" 
        intervals [42]:
            xmin = 83.76 
            xmax = 84.6 
            text = "" 
        intervals [43]:
            xmin = 84.6 
            xmax = 86.43 
            text = "But I with mournful tread," 
        intervals [44]:
            xmin = 86.43 
            xmax = 87.48 
            text = "" 
        intervals [45]:
            xmin = 87.48 
            xmax = 89.36 
            text = "Walk the deck my Captain lies," 
        intervals [46]:
            xmin = 89.36 
            xmax = 90.23 
            text = "" 
        intervals [47]:
            xmin = 90.23 
            xmax = 97.01 
            text = "Fallen cold and dead." 
        intervals [48]:
            xmin = 97.01 
            xmax = 97.595 
            text = "" 
