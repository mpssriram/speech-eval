    item [2]:
        class = "IntervalTier" 
        name = "sentences" 
        xmin = 0 
        xmax = 86.225 
        intervals: size = 47 
        intervals [1]:
            xmin = 0 
            xmax = 0.14 
            text = "" 
        intervals [2]:
            xmin = 0.14 
            xmax = 2.91 
            text = "O Captain! my Captain! our fearful trip is done," 
        intervals [3]:
            xmin = 2.91 
            xmax = 3.55 
            text = "" 
        intervals [4]:
            xmin = 3.55 
            xmax = 7.64 
            text = "The ship has weather’d every rack, the prize we sought is won," 
        intervals [5]:
            xmin = 7.64 
            xmax = 8.16 
            text = "" 
        intervals [6]:
            xmin = 8.16 
            xmax = 12.01 
            text = "The port is near, the bells I hear, the people are exulting," 
        intervals [7]:
            xmin = 12.01 
            xmax = 12.83 
            text = "" 
        intervals [8]:
            xmin = 12.83 
            xmax = 17.01 
            text = "While follow eyes the steady keel, the vessel grim and daring;" 
        intervals [9]:
            xmin = 17.01 
            xmax = 17.39 
            text = "" 
        intervals [10]:
            xmin = 17.39 
            xmax = 19.87 
            text = "But O heart! heart! heart!" 
        intervals [11]:
            xmin = 19.87 
            xmax = 20.41 
            text = "" 
        intervals [12]:
            xmin = 20.41 
            xmax = 22.38 
            text = "O the bleeding drops of red," 
        intervals [13]:
            xmin = 22.38 
            xmax = 22.87 
            text = "" 
        intervals [14]:
            xmin = 22.87 
            xmax = 24.81 
            text = "Where on the deck my Captain lies," 
        intervals [15]:
            xmin = 24.81 
            xmax = 24.84 
            text = "" 
        intervals [16]:
            xmin = 24.84 
            xmax = 26.61 
            text = "Fallen cold and dead." 
        intervals [17]:
            xmin = 26.61 
            xmax = 27.59 
            text = "" 
        intervals [18]:
            xmin = 27.59 
            xmax = 30.77 
            text = "O Captain! my Captain! rise up and hear the bells;" 
        intervals [19]:
            xmin = 30.77 
            xmax = 31.13 
            text = "" 
        intervals [20]:
            xmin = 31.13 
            xmax = 35.86 
            text = "Rise up- for you the flag is flung- for you the bugle trills," 
        intervals [21]:
            xmin = 35.86 
            xmax = 36.11 
            text = "" 
        intervals [22]:
            xmin = 36.11 
            xmax = 41.08 
            text = "For you bouquets and ribbon’d wreaths- for you the shores a-crowding," 
        intervals [23]:
            xmin = 41.08 
            xmax = 41.59 
            text = "" 
        intervals [24]:
            xmin = 41.59 
            xmax = 45.52 
            text = "For you they call, the swaying mass, their eager faces turning;" 
        intervals [25]:
            xmin = 45.52 
            xmax = 46.35 
            text = "" 
        intervals [26]:
            xmin = 46.35 
            xmax = 47.85 
            text = "Here Captain! dear father!" 
        intervals [27]:
            xmin = 47.85 
            xmax = 49.34 
            text = "This arm beneath your head!" 
        intervals [28]:
            xmin = 49.34 
            xmax = 49.9 
            text = "" 
        intervals [29]:
            xmin = 49.9 
            xmax = 52.35 
            text = "It is some dream that on the deck," 
        intervals [30]:
            xmin = 52.35 
            xmax = 52.39 
            text = "" 
        intervals [31]:
            xmin = 52.39 
            xmax = 53.73 
            text = "You’ve fallen cold and dead." 
        intervals [32]:
            xmin = 53.73 
            xmax = 54.73 
            text = "" 
        intervals [33]:
            xmin = 54.73 
            xmax = 59.05 
            text = "My Captain does not answer, his lips are pale and still," 
        intervals [34]:
            xmin = 59.05 
            xmax = 63.59 
            text = "My father does not feel my arm, he has no pulse nor will," 
        intervals [35]:
            xmin = 63.59 
            xmax = 64.1 
            text = "" 
        intervals [36]:
            xmin = 64.1 
            xmax = 68.26 
            text = "The ship is anchor’d safe and sound, its voyage closed and done," 
        intervals [37]:
            xmin = 68.26 
            xmax = 68.74 
            text = "" 
        intervals [38]:
            xmin = 68.74 
            xmax = 72.71 
            text = "From fearful trip the victor ship comes in with object won;" 
        intervals [39]:
            xmin = 72.71 
            xmax = 73.47 
            text = "" 
        intervals [40]:
            xmin = 73.47 
            xmax = 76.4 
            text = "Exult O shores, and ring O bells!" 
        intervals [41]:
            xmin = 76.4 
            xmax = 76.79 
            text = "" 
        intervals [42]:
            xmin = 76.79 
            xmax = 79.7 
            text = "But I with mournful tread," 
        intervals [43]:
            xmin = 79.7 
            xmax = 80.5 
            text = "" 
        intervals [44]:
            xmin = 80.5 
            xmax = 82.67 
            text = "Walk the deck my Captain lies," 
        intervals [45]:
            xmin = 82.67 
            xmax = 83.33 
            text = "" 
        intervals [46]:
            xmin = 83.33 
            xmax = 85.96 
            text = "Fallen cold and dead. End" 
        intervals [47]:
            xmin = 85.96 
            xmax = 86.225 
            text = "" 
