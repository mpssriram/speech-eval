    item [2]:
        class = "IntervalTier" 
        name = "sentences" 
        xmin = 0 
        xmax = 113.028 
        intervals: size = 36 
        intervals [1]:
            xmin = 0 
            xmax = 3.946 
            text = "O Captain! my Captain! our fearful trip is done," 
        intervals [2]:
            xmin = 3.946 
            xmax = 8.482 
            text = "The ship has weather’d every rack, the prize we sought is won," 
        intervals [3]:
            xmin = 8.482 
            xmax = 8.563 
            text = "" 
        intervals [4]:
            xmin = 8.563 
            xmax = 12.989 
            text = "The port is near, the bells I hear, the people all exulting," 
        intervals [5]:
            xmin = 12.989 
            xmax = 19.338 
            text = "While follow eyes the steady keel, the vessel grim and daring;" 
        intervals [6]:
            xmin = 19.338 
            xmax = 19.64 
            text = "" 
        intervals [7]:
            xmin = 19.64 
            xmax = 23.264 
            text = "But O heart! heart! heart!" 
        intervals [8]:
            xmin = 23.264 
            xmax = 23.505 
            text = "" 
        intervals [9]:
            xmin = 23.505 
            xmax = 25.838 
            text = "O the bleeding drops of red," 
        intervals [10]:
            xmin = 25.838 
            xmax = 29.628 
            text = "Where on the deck my Captain lies," 
        intervals [11]:
            xmin = 29.628 
            xmax = 31.744 
            text = "Fallen cold and dead." 
        intervals [12]:
            xmin = 31.744 
            xmax = 33.207 
            text = "" 
        intervals [13]:
            xmin = 33.207 
            xmax = 37.912 
            text = "O Captain! my Captain! rise up and hear the bells;" 
        intervals [14]:
            xmin = 37.912 
            xmax = 37.993 
            text = "" 
        intervals [15]:
            xmin = 37.993 
            xmax = 43.059 
            text = "Rise up- for you the flag is flung- for you the bugle trills," 
        intervals [16]:
            xmin = 43.059 
            xmax = 47.104 
            text = "For you bouquets and ribbon’d wreaths- for you the shores a-crowding," 
        intervals [17]:
            xmin = 47.104 
            xmax = 47.746 
            text = "" 
        intervals [18]:
            xmin = 47.746 
            xmax = 52.612 
            text = "For you they call, the swaying mass, their eager faces turning;" 
        intervals [19]:
            xmin = 52.612 
            xmax = 52.652 
            text = "" 
        intervals [20]:
            xmin = 52.652 
            xmax = 55.175 
            text = "Here Captain! dear father!" 
        intervals [21]:
            xmin = 55.175 
            xmax = 57.468 
            text = "This arm beneath your head!" 
        intervals [22]:
            xmin = 57.468 
            xmax = 59.941 
            text = "It is some dream that on the deck," 
        intervals [23]:
            xmin = 59.941 
            xmax = 62.224 
            text = "You’ve fallen cold and dead." 
        intervals [24]:
            xmin = 62.224 
            xmax = 63.366 
            text = "" 
        intervals [25]:
            xmin = 63.366 
            xmax = 68.412 
            text = "My Captain does not answer, his lips are pale and still," 
        intervals [26]:
            xmin = 68.412 
            xmax = 68.573 
            text = "" 
        intervals [27]:
            xmin = 68.573 
            xmax = 73.209 
            text = "My father does not feel my arm, he has no pulse nor will," 
        intervals [28]:
            xmin = 73.209 
            xmax = 78.887 
            text = "The ship is anchor’d safe and sound, its voyage closed and done," 
        intervals [29]:
            xmin = 78.887 
            xmax = 79.088 
            text = "" 
        intervals [30]:
            xmin = 79.088 
            xmax = 83.513 
            text = "From fearful trip the victor ship comes in with object won;" 
        intervals [31]:
            xmin = 83.513 
            xmax = 87.883 
            text = "Exult O shores, and ring O bells!" 
        intervals [32]:
            xmin = 87.883 
            xmax = 90.456 
            text = "But I with mournful tread," 
        intervals [33]:
            xmin = 90.456 
            xmax = 90.897 
            text = "" 
        intervals [34]:
            xmin = 90.897 
            xmax = 93.879 
            text = "Walk the deck my Captain lies," 
        intervals [35]:
            xmin = 93.879 
            xmax = 94 
            text = "" 
        intervals [36]:
            xmin = 94 
            xmax = 113.028 
            text = "Fallen cold and dead." 
