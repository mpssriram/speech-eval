    item [2]:
        class = "IntervalTier" 
        name = "sentences" 
        xmin = 0 
        xmax = 86.761 
        intervals: size = 40 
        intervals [1]:
            xmin = 0 
            xmax = 3.474 
            text = "O Captain! my Captain! our fearful trip is done," 
        intervals [2]:
            xmin = 3.474 
            xmax = 3.675 
            text = "" 
        intervals [3]:
            xmin = 3.675 
            xmax = 7.319 
            text = "The ship has weather’d every rack, the prize we sought is won," 
        intervals [4]:
            xmin = 7.319 
            xmax = 7.7 
            text = "" 
        intervals [5]:
            xmin = 7.7 
            xmax = 12.085 
            text = "The port is near, the bells I hear, the people all exulting," 
        intervals [6]:
            xmin = 12.085 
            xmax = 12.286 
            text = "" 
        intervals [7]:
            xmin = 12.286 
            xmax = 16.71 
            text = "While follow eyes the steady keel, the vessel grim and daring;" 
        intervals [8]:
            xmin = 16.71 
            xmax = 17.372 
            text = "" 
        intervals [9]:
            xmin = 17.372 
            xmax = 19.904 
            text = "But O heart! heart! heart!" 
        intervals [10]:
            xmin = 19.904 
            xmax = 22.629 
            text = "O the bleeding drops of red," 
        intervals [11]:
            xmin = 22.629 
            xmax = 22.95 
            text = "" 
        intervals [12]:
            xmin = 22.95 
            xmax = 25.252 
            text = "Where on the deck my Captain lies," 
        intervals [13]:
            xmin = 25.252 
            xmax = 27.495 
            text = "Fallen cold and dead." 
        intervals [14]:
            xmin = 27.495 
            xmax = 32.94 
            text = "O Captain! my Captain! rise up and hear the bells;" 
        intervals [15]:
            xmin = 32.94 
            xmax = 33.101 
            text = "" 
        intervals [16]:
            xmin = 33.101 
            xmax = 37.225 
            text = "Rise up- for you the flag is flung- for you the bugle trills," 
        intervals [17]:
            xmin = 37.225 
            xmax = 37.426 
            text = "" 
        intervals [18]:
            xmin = 37.426 
            xmax = 41.009 
            text = "For you bouquets and ribbon’d wreaths- for you the shores a-crowding," 
        intervals [19]:
            xmin = 41.009 
            xmax = 41.67 
            text = "" 
        intervals [20]:
            xmin = 41.67 
            xmax = 45.594 
            text = "For you they call, the swaying mass, their eager faces turning;" 
        intervals [21]:
            xmin = 45.594 
            xmax = 46.215 
            text = "" 
        intervals [22]:
            xmin = 46.215 
            xmax = 47.937 
            text = "Here Captain! dear father!" 
        intervals [23]:
            xmin = 47.937 
            xmax = 50.279 
            text = "This arm beneath your head!" 
        intervals [24]:
            xmin = 50.279 
            xmax = 50.507 
            text = "" 
        intervals [25]:
            xmin = 50.507 
            xmax = 52.789 
            text = "It is some dream that on the deck," 
        intervals [26]:
            xmin = 52.789 
            xmax = 55.291 
            text = "You’ve fallen cold and dead." 
        intervals [27]:
            xmin = 55.291 
            xmax = 56.814 
            text = "" 
        intervals [28]:
            xmin = 56.814 
            xmax = 60.958 
            text = "My Captain does not answer, his lips are pale and still," 
        intervals [29]:
            xmin = 60.958 
            xmax = 61.439 
            text = "" 
        intervals [30]:
            xmin = 61.439 
            xmax = 65.593 
            text = "My father does not feel my arm, he has no pulse nor will," 
        intervals [31]:
            xmin = 65.593 
            xmax = 70.568 
            text = "The ship is anchor’d safe and sound, its voyage closed and done," 
        intervals [32]:
            xmin = 70.568 
            xmax = 70.729 
            text = "" 
        intervals [33]:
            xmin = 70.729 
            xmax = 74.512 
            text = "From fearful trip the victor ship comes in with object won;" 
        intervals [34]:
            xmin = 74.512 
            xmax = 75.053 
            text = "" 
        intervals [35]:
            xmin = 75.053 
            xmax = 78.036 
            text = "Exult O shores, and ring O bells!" 
        intervals [36]:
            xmin = 78.036 
            xmax = 78.137 
            text = "" 
        intervals [37]:
            xmin = 78.137 
            xmax = 80.999 
            text = "But I with mournful tread," 
        intervals [38]:
            xmin = 80.999 
            xmax = 81.099 
            text = "" 
        intervals [39]:
            xmin = 81.099 
            xmax = 83.644 
            text = "Walk the deck my Captain lies," 
        intervals [40]:
            xmin = 83.644 
            xmax = 86.761 
            text = "Fallen cold and dead." 
