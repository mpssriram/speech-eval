    item [2]:
        class = "IntervalTier" 
        name = "sentences" 
        xmin = 0 
        xmax = 92.244 
        intervals: size = 40 
        intervals [1]:
            xmin = 0 
            xmax = 4.456 
            text = "O Captain! my Captain! our fearful trip is done," 
        intervals [2]:
            xmin = 4.456 
            xmax = 4.517 
            text = "" 
        intervals [3]:
            xmin = 4.517 
            xmax = 9.023 
            text = "The ship has weather’d every rack, the prize we sought is won," 
        intervals [4]:
            xmin = 9.023 
            xmax = 9.204 
            text = "" 
        intervals [5]:
            xmin = 9.204 
            xmax = 13.41 
            text = "The port is near, the bells I hear, the people all exulting," 
        intervals [6]:
            xmin = 13.41 
            xmax = 13.471 
            text = "" 
        intervals [7]:
            xmin = 13.471 
            xmax = 18.288 
            text = "While follow eyes the steady keel, the vessel grim and daring;" 
        intervals [8]:
            xmin = 18.288 
            xmax = 18.508 
            text = "" 
        intervals [9]:
            xmin = 18.508 
            xmax = 20.67 
            text = "But O heart! heart! heart!" 
        intervals [10]:
            xmin = 20.67 
            xmax = 23.573 
            text = "O the bleeding drops of red," 
        intervals [11]:
            xmin = 23.573 
            xmax = 23.714 
            text = "" 
        intervals [12]:
            xmin = 23.714 
            xmax = 25.935 
            text = "Where on the deck my Captain lies," 
        intervals [13]:
            xmin = 25.935 
            xmax = 27.777 
            text = "Fallen cold and dead." 
        intervals [14]:
            xmin = 27.777 
            xmax = 33.182 
            text = "O Captain! my Captain! rise up and hear the bells;" 
        intervals [15]:
            xmin = 33.182 
            xmax = 33.323 
            text = "" 
        intervals [16]:
            xmin = 33.323 
            xmax = 37.767 
            text = "Rise up- for you the flag is flung- for you the bugle trills," 
        intervals [17]:
            xmin = 37.767 
            xmax = 38.028 
            text = "" 
        intervals [18]:
            xmin = 38.028 
            xmax = 43.032 
            text = "For you bouquets and ribbon’d wreaths- for you the shores a-crowding," 
        intervals [19]:
            xmin = 43.032 
            xmax = 46.996 
            text = "For you they call, the swaying mass, their eager faces turning;" 
        intervals [20]:
            xmin = 46.996 
            xmax = 47.037 
            text = "" 
        intervals [21]:
            xmin = 47.037 
            xmax = 49.069 
            text = "Here Captain! dear father!" 
        intervals [22]:
            xmin = 49.069 
            xmax = 51.322 
            text = "This arm beneath your head!" 
        intervals [23]:
            xmin = 51.322 
            xmax = 51.463 
            text = "" 
        intervals [24]:
            xmin = 51.463 
            xmax = 53.665 
            text = "It is some dream that on the deck," 
        intervals [25]:
            xmin = 53.665 
            xmax = 55.788 
            text = "You’ve fallen cold and dead." 
        intervals [26]:
            xmin = 55.788 
            xmax = 57.011 
            text = "" 
        intervals [27]:
            xmin = 57.011 
            xmax = 61.436 
            text = "My Captain does not answer, his lips are pale and still," 
        intervals [28]:
            xmin = 61.436 
            xmax = 61.737 
            text = "" 
        intervals [29]:
            xmin = 61.737 
            xmax = 66.443 
            text = "My father does not feel my arm, he has no pulse nor will," 
        intervals [30]:
            xmin = 66.443 
            xmax = 66.704 
            text = "" 
        intervals [31]:
            xmin = 66.704 
            xmax = 71.61 
            text = "The ship is anchor’d safe and sound, its voyage closed and done," 
        intervals [32]:
            xmin = 71.61 
            xmax = 71.614 
            text = "" 
        intervals [33]:
            xmin = 71.614 
            xmax = 75.602 
            text = "From fearful trip the victor ship comes in with object won;" 
        intervals [34]:
            xmin = 75.602 
            xmax = 79.509 
            text = "Exult O shores, and ring O bells!" 
        intervals [35]:
            xmin = 79.509 
            xmax = 79.61 
            text = "" 
        intervals [36]:
            xmin = 79.61 
            xmax = 81.913 
            text = "But I with mournful tread," 
        intervals [37]:
            xmin = 81.913 
            xmax = 82.115 
            text = "" 
        intervals [38]:
            xmin = 82.115 
            xmax = 84.659 
            text = "Walk the deck my Captain lies," 
        intervals [39]:
            xmin = 84.659 
            xmax = 84.74 
            text = "" 
        intervals [40]:
            xmin = 84.74 
            xmax = 92.244 
            text = "Fallen cold and dead." 
