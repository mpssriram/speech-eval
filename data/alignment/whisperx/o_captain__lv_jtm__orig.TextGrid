    item [2]:
        class = "IntervalTier" 
        name = "sentences" 
        xmin = 0 
        xmax = 97.208 
        intervals: size = 34 
        intervals [1]:
            xmin = 0 
            xmax = 4.095 
            text = "O Captain! my Captain! our fearful trip is done," 
        intervals [2]:
            xmin = 4.095 
            xmax = 8.482 
            text = "The ship has weather’d every rack, the prize we sought is won," 
        intervals [3]:
            xmin = 8.482 
            xmax = 8.883 
            text = "" 
        intervals [4]:
            xmin = 8.883 
            xmax = 13.47 
            text = "The port is near, the bells I hear, the people all exulting," 
        intervals [5]:
            xmin = 13.47 
            xmax = 18.697 
            text = "While follow eyes the steady keel, the vessel grim and daring;" 
        intervals [6]:
            xmin = 18.697 
            xmax = 19.309 
            text = "" 
        intervals [7]:
            xmin = 19.309 
            xmax = 23.565 
            text = "But O heart! heart! heart!" 
        intervals [8]:
            xmin = 23.565 
            xmax = 26.739 
            text = "O the bleeding drops of red," 
        intervals [9]:
            xmin = 26.739 
            xmax = 27.1 
            text = "" 
        intervals [10]:
            xmin = 27.1 
            xmax = 29.924 
            text = "Where on the deck my Captain lies," 
        intervals [11]:
            xmin = 29.924 
            xmax = 31.837 
            text = "Fallen cold and dead." 
        intervals [12]:
            xmin = 31.837 
            xmax = 37.785 
            text = "O Captain! my Captain! rise up and hear the bells;" 
        intervals [13]:
            xmin = 37.785 
            xmax = 42.581 
            text = "Rise up- for you the flag is flung- for you the bugle trills," 
        intervals [14]:
            xmin = 42.581 
            xmax = 42.662 
            text = "" 
        intervals [15]:
            xmin = 42.662 
            xmax = 47.028 
            text = "For you bouquets and ribbon’d wreaths- for you the shores a-crowding," 
        intervals [16]:
            xmin = 47.028 
            xmax = 47.469 
            text = "" 
        intervals [17]:
            xmin = 47.469 
            xmax = 52.216 
            text = "For you they call, the swaying mass, their eager faces turning;" 
        intervals [18]:
            xmin = 52.216 
            xmax = 52.637 
            text = "" 
        intervals [19]:
            xmin = 52.637 
            xmax = 54.871 
            text = "Here Captain! dear father!" 
        intervals [20]:
            xmin = 54.871 
            xmax = 56.423 
            text = "This arm beneath your head!" 
        intervals [21]:
            xmin = 56.423 
            xmax = 59.398 
            text = "It is some dream that on the deck," 
        intervals [22]:
            xmin = 59.398 
            xmax = 61.631 
            text = "You’ve fallen cold and dead." 
        intervals [23]:
            xmin = 61.631 
            xmax = 63.916 
            text = "" 
        intervals [24]:
            xmin = 63.916 
            xmax = 68.943 
            text = "My Captain does not answer, his lips are pale and still," 
        intervals [25]:
            xmin = 68.943 
            xmax = 69.465 
            text = "" 
        intervals [26]:
            xmin = 69.465 
            xmax = 75.113 
            text = "My father does not feel my arm, he has no pulse nor will," 
        intervals [27]:
            xmin = 75.113 
            xmax = 75.533 
            text = "" 
        intervals [28]:
            xmin = 75.533 
            xmax = 80.128 
            text = "The ship is anchor’d safe and sound, its voyage closed and done," 
        intervals [29]:
            xmin = 80.128 
            xmax = 84.473 
            text = "From fearful trip the victor ship comes in with object won;" 
        intervals [30]:
            xmin = 84.473 
            xmax = 88.788 
            text = "Exult O shores, and ring O bells!" 
        intervals [31]:
            xmin = 88.788 
            xmax = 88.869 
            text = "" 
        intervals [32]:
            xmin = 88.869 
            xmax = 91.091 
            text = "But I with mournful tread," 
        intervals [33]:
            xmin = 91.091 
            xmax = 94.485 
            text = "Walk the deck my Captain lies," 
        intervals [34]:
            xmin = 94.485 
            xmax = 97.208 
            text = "Fallen cold and dead." 
