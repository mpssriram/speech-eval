    item [2]:
        class = "IntervalTier" 
        name = "sentences" 
        xmin = 0 
        xmax = 87.288 
        intervals: size = 37 
        intervals [1]:
            xmin = 0 
            xmax = 3.533 
            text = "O Captain! my Captain! our fearful trip is done," 
        intervals [2]:
            xmin = 3.533 
            xmax = 3.614 
            text = "" 
        intervals [3]:
            xmin = 3.614 
            xmax = 7.588 
            text = "The ship has weather’d every rack, the prize we sought is won," 
        intervals [4]:
            xmin = 7.588 
            xmax = 11.712 
            text = "The port is near, the bells I hear, the people all exulting," 
        intervals [5]:
            xmin = 11.712 
            xmax = 15.545 
            text = "While follow eyes the steady keel, the vessel grim and daring;" 
        intervals [6]:
            xmin = 15.545 
            xmax = 15.846 
            text = "" 
        intervals [7]:
            xmin = 15.846 
            xmax = 18.829 
            text = "But O heart! heart! heart!" 
        intervals [8]:
            xmin = 18.829 
            xmax = 20.56 
            text = "O the bleeding drops of red," 
        intervals [9]:
            xmin = 20.56 
            xmax = 22.733 
            text = "Where on the deck my Captain lies," 
        intervals [10]:
            xmin = 22.733 
            xmax = 24.634 
            text = "Fallen cold and dead." 
        intervals [11]:
            xmin = 24.634 
            xmax = 25.295 
            text = "" 
        intervals [12]:
            xmin = 25.295 
            xmax = 28.538 
            text = "O Captain! my Captain! rise up and hear the bells;" 
        intervals [13]:
            xmin = 28.538 
            xmax = 32.341 
            text = "Rise up- for you the flag is flung- for you the bugle trills," 
        intervals [14]:
            xmin = 32.341 
            xmax = 32.422 
            text = "" 
        intervals [15]:
            xmin = 32.422 
            xmax = 36.966 
            text = "For you bouquets and ribbon’d wreaths- for you the shores a-crowding," 
        intervals [16]:
            xmin = 36.966 
            xmax = 37.047 
            text = "" 
        intervals [17]:
            xmin = 37.047 
            xmax = 41.264 
            text = "For you they call, the swaying mass, their eager faces turning;" 
        intervals [18]:
            xmin = 41.264 
            xmax = 43.5 
            text = "Here Captain! dear father!" 
        intervals [19]:
            xmin = 43.5 
            xmax = 43.501 
            text = "" 
        intervals [20]:
            xmin = 43.501 
            xmax = 45.362 
            text = "This arm beneath your head!" 
        intervals [21]:
            xmin = 45.362 
            xmax = 45.523 
            text = "" 
        intervals [22]:
            xmin = 45.523 
            xmax = 47.635 
            text = "It is some dream that on the deck," 
        intervals [23]:
            xmin = 47.635 
            xmax = 49.647 
            text = "You’ve fallen cold and dead." 
        intervals [24]:
            xmin = 49.647 
            xmax = 50.068 
            text = "" 
        intervals [25]:
            xmin = 50.068 
            xmax = 53.792 
            text = "My Captain does not answer, his lips are pale and still," 
        intervals [26]:
            xmin = 53.792 
            xmax = 53.872 
            text = "" 
        intervals [27]:
            xmin = 53.872 
            xmax = 58.157 
            text = "My father does not feel my arm, he has no pulse nor will," 
        intervals [28]:
            xmin = 58.157 
            xmax = 58.318 
            text = "" 
        intervals [29]:
            xmin = 58.318 
            xmax = 62.072 
            text = "The ship is anchor’d safe and sound, its voyage closed and done," 
        intervals [30]:
            xmin = 62.072 
            xmax = 65.805 
            text = "From fearful trip the victor ship comes in with object won;" 
        intervals [31]:
            xmin = 65.805 
            xmax = 67.168 
            text = "" 
        intervals [32]:
            xmin = 67.168 
            xmax = 69.79 
            text = "Exult O shores, and ring O bells!" 
        intervals [33]:
            xmin = 69.79 
            xmax = 69.794 
            text = "" 
        intervals [34]:
            xmin = 69.794 
            xmax = 71.458 
            text = "But I with mournful tread," 
        intervals [35]:
            xmin = 71.458 
            xmax = 71.899 
            text = "" 
        intervals [36]:
            xmin = 71.899 
            xmax = 74.105 
            text = "Walk the deck my Captain lies," 
        intervals [37]:
            xmin = 74.105 
            xmax = 87.288 
            text = "Fallen cold and dead." 
