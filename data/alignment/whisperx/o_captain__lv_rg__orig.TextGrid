    item [2]:
        class = "IntervalTier" 
        name = "sentences" 
        xmin = 0 
        xmax = 92.089 
        intervals: size = 39 
        intervals [1]:
            xmin = 0 
            xmax = 0.21 
            text = "" 
        intervals [2]:
            xmin = 0.21 
            xmax = 4.174 
            text = "O Captain! my Captain! our fearful trip is done," 
        intervals [3]:
            xmin = 4.174 
            xmax = 9.058 
            text = "The ship has weather’d every rack, the prize we sought is won," 
        intervals [4]:
            xmin = 9.058 
            xmax = 9.559 
            text = "" 
        intervals [5]:
            xmin = 9.559 
            xmax = 14.123 
            text = "The port is near, the bells I hear, the people all exulting," 
        intervals [6]:
            xmin = 14.123 
            xmax = 14.504 
            text = "" 
        intervals [7]:
            xmin = 14.504 
            xmax = 19.147 
            text = "While follow eyes the steady keel, the vessel grim and daring;" 
        intervals [8]:
            xmin = 19.147 
            xmax = 19.669 
            text = "" 
        intervals [9]:
            xmin = 19.669 
            xmax = 22.221 
            text = "But O heart! heart! heart!" 
        intervals [10]:
            xmin = 22.221 
            xmax = 25.153 
            text = "O the bleeding drops of red," 
        intervals [11]:
            xmin = 25.153 
            xmax = 25.434 
            text = "" 
        intervals [12]:
            xmin = 25.434 
            xmax = 27.676 
            text = "Where on the deck my Captain lies," 
        intervals [13]:
            xmin = 27.676 
            xmax = 30.378 
            text = "Fallen cold and dead." 
        intervals [14]:
            xmin = 30.378 
            xmax = 31.566 
            text = "" 
        intervals [15]:
            xmin = 31.566 
            xmax = 35.671 
            text = "O Captain! my Captain! rise up and hear the bells;" 
        intervals [16]:
            xmin = 35.671 
            xmax = 36.013 
            text = "" 
        intervals [17]:
            xmin = 36.013 
            xmax = 40.8 
            text = "Rise up- for you the flag is flung- for you the bugle trills," 
        intervals [18]:
            xmin = 40.8 
            xmax = 40.901 
            text = "" 
        intervals [19]:
            xmin = 40.901 
            xmax = 46.028 
            text = "For you bouquets and ribbon’d wreaths- for you the shores a-crowding," 
        intervals [20]:
            xmin = 46.028 
            xmax = 46.189 
            text = "" 
        intervals [21]:
            xmin = 46.189 
            xmax = 50.735 
            text = "For you they call, the swaying mass, their eager faces turning;" 
        intervals [22]:
            xmin = 50.735 
            xmax = 51.397 
            text = "" 
        intervals [23]:
            xmin = 51.397 
            xmax = 53.37 
            text = "Here Captain! dear father!" 
        intervals [24]:
            xmin = 53.37 
            xmax = 55.163 
            text = "This arm beneath your head!" 
        intervals [25]:
            xmin = 55.163 
            xmax = 57.917 
            text = "It is some dream that on the deck," 
        intervals [26]:
            xmin = 57.917 
            xmax = 60.17 
            text = "You’ve fallen cold and dead." 
        intervals [27]:
            xmin = 60.17 
            xmax = 60.782 
            text = "" 
        intervals [28]:
            xmin = 60.782 
            xmax = 65.526 
            text = "My Captain does not answer, his lips are pale and still," 
        intervals [29]:
            xmin = 65.526 
            xmax = 65.987 
            text = "" 
        intervals [30]:
            xmin = 65.987 
            xmax = 70.551 
            text = "My father does not feel my arm, he has no pulse nor will," 
        intervals [31]:
            xmin = 70.551 
            xmax = 71.472 
            text = "" 
        intervals [32]:
            xmin = 71.472 
            xmax = 75.796 
            text = "The ship is anchor’d safe and sound, its voyage closed and done," 
        intervals [33]:
            xmin = 75.796 
            xmax = 80.781 
            text = "From fearful trip the victor ship comes in with object won;" 
        intervals [34]:
            xmin = 80.781 
            xmax = 84.765 
            text = "Exult O shores, and ring O bells!" 
        intervals [35]:
            xmin = 84.765 
            xmax = 84.805 
            text = "" 
        intervals [36]:
            xmin = 84.805 
            xmax = 87.007 
            text = "But I with mournful tread," 
        intervals [37]:
            xmin = 87.007 
            xmax = 87.328 
            text = "" 
        intervals [38]:
            xmin = 87.328 
            xmax = 89.98 
            text = "Walk the deck my Captain lies," 
        intervals [39]:
            xmin = 89.98 
            xmax = 92.089 
            text = "Fallen cold and dead." 
