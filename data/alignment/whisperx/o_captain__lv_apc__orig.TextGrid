    item [2]:
        class = "IntervalTier" 
        name = "sentences" 
        xmin = 0 
        xmax = 109.304 
        intervals: size = 39 
        intervals [1]:
            xmin = 0 
            xmax = 7.36 
            text = "two thousand and six O Captain! my Captain! our fearful trip is done," 
        intervals [2]:
            xmin = 7.36 
            xmax = 12.127 
            text = "The ship has weather’d every rack, the prize we sought is won," 
        intervals [3]:
            xmin = 12.127 
            xmax = 17.521 
            text = "The port is near, the bells I hear, the people all exulting," 
        intervals [4]:
            xmin = 17.521 
            xmax = 22.932 
            text = "While follow eyes the steady keel, the vessel grim and daring;" 
        intervals [5]:
            xmin = 22.932 
            xmax = 23.393 
            text = "" 
        intervals [6]:
            xmin = 23.393 
            xmax = 26.205 
            text = "But O heart! heart! heart!" 
        intervals [7]:
            xmin = 26.205 
            xmax = 29.338 
            text = "O the bleeding drops of red," 
        intervals [8]:
            xmin = 29.338 
            xmax = 29.359 
            text = "" 
        intervals [9]:
            xmin = 29.359 
            xmax = 31.68 
            text = "Where on the deck my Captain lies," 
        intervals [10]:
            xmin = 31.68 
            xmax = 33.262 
            text = "Fallen cold and dead." 
        intervals [11]:
            xmin = 33.262 
            xmax = 37.906 
            text = "O Captain! my Captain! rise up and hear the bells;" 
        intervals [12]:
            xmin = 37.906 
            xmax = 37.987 
            text = "" 
        intervals [13]:
            xmin = 37.987 
            xmax = 43.592 
            text = "Rise up- for you the flag is flung- for you the bugle trills," 
        intervals [14]:
            xmin = 43.592 
            xmax = 43.672 
            text = "" 
        intervals [15]:
            xmin = 43.672 
            xmax = 48.361 
            text = "For you bouquets and ribbon’d wreaths- for you the shores a-crowding," 
        intervals [16]:
            xmin = 48.361 
            xmax = 48.402 
            text = "" 
        intervals [17]:
            xmin = 48.402 
            xmax = 54.25 
            text = "For you they call, the swaying mass, their eager faces turning;" 
        intervals [18]:
            xmin = 54.25 
            xmax = 54.472 
            text = "" 
        intervals [19]:
            xmin = 54.472 
            xmax = 57.276 
            text = "Here Captain! dear father!" 
        intervals [20]:
            xmin = 57.276 
            xmax = 60.2 
            text = "This arm beneath your head!" 
        intervals [21]:
            xmin = 60.2 
            xmax = 60.502 
            text = "" 
        intervals [22]:
            xmin = 60.502 
            xmax = 63.706 
            text = "It is some dream that on the deck," 
        intervals [23]:
            xmin = 63.706 
            xmax = 63.907 
            text = "" 
        intervals [24]:
            xmin = 63.907 
            xmax = 66.891 
            text = "You’ve fallen cold and dead." 
        intervals [25]:
            xmin = 66.891 
            xmax = 68.275 
            text = "" 
        intervals [26]:
            xmin = 68.275 
            xmax = 73.983 
            text = "My Captain does not answer, his lips are pale and still," 
        intervals [27]:
            xmin = 73.983 
            xmax = 74.435 
            text = "" 
        intervals [28]:
            xmin = 74.435 
            xmax = 80.54 
            text = "My father does not feel my arm, he has no pulse nor will," 
        intervals [29]:
            xmin = 80.54 
            xmax = 81.242 
            text = "" 
        intervals [30]:
            xmin = 81.242 
            xmax = 87.427 
            text = "The ship is anchor’d safe and sound, its voyage closed and done," 
        intervals [31]:
            xmin = 87.427 
            xmax = 88.109 
            text = "" 
        intervals [32]:
            xmin = 88.109 
            xmax = 94.194 
            text = "From fearful trip the victor ship comes in with object won;" 
        intervals [33]:
            xmin = 94.194 
            xmax = 95.176 
            text = "" 
        intervals [34]:
            xmin = 95.176 
            xmax = 99.239 
            text = "Exult O shores, and ring O bells!" 
        intervals [35]:
            xmin = 99.239 
            xmax = 99.58 
            text = "" 
        intervals [36]:
            xmin = 99.58 
            xmax = 103.103 
            text = "But I with mournful tread," 
        intervals [37]:
            xmin = 103.103 
            xmax = 103.107 
            text = "" 
        intervals [38]:
            xmin = 103.107 
            xmax = 105.738 
            text = "Walk the deck my Captain lies," 
        intervals [39]:
            xmin = 105.738 
            xmax = 109.304 
            text = "Fallen cold and dead." 
