    item [2]:
        class = "IntervalTier" 
        name = "sentences" 
        xmin = 0 
        xmax = 109.316 
        intervals: size = 30 
        intervals [1]:
            xmin = 0 
            xmax = 14.846 
            text = "O Captain! my Captain! our fearful trip is done," 
        intervals [2]:
            xmin = 14.846 
            xmax = 18.821 
            text = "The ship has weather’d every rack, the prize we sought is won," 
        intervals [3]:
            xmin = 18.821 
            xmax = 23.536 
            text = "The port is near, the bells I hear, the people all exulting," 
        intervals [4]:
            xmin = 23.536 
            xmax = 29.164 
            text = "While follow eyes the steady keel, the vessel grim and daring;" 
        intervals [5]:
            xmin = 29.164 
            xmax = 32.2 
            text = "But O heart! heart! heart!" 
        intervals [6]:
            xmin = 32.2 
            xmax = 34.833 
            text = "O the bleeding drops of red," 
        intervals [7]:
            xmin = 34.833 
            xmax = 35.114 
            text = "" 
        intervals [8]:
            xmin = 35.114 
            xmax = 38.018 
            text = "Where on the deck my Captain lies," 
        intervals [9]:
            xmin = 38.018 
            xmax = 41.422 
            text = "Fallen cold and dead." 
        intervals [10]:
            xmin = 41.422 
            xmax = 46.37 
            text = "O Captain! my Captain! rise up and hear the bells;" 
        intervals [11]:
            xmin = 46.37 
            xmax = 50.364 
            text = "Rise up- for you the flag is flung- for you the bugle trills," 
        intervals [12]:
            xmin = 50.364 
            xmax = 54.56 
            text = "For you bouquets and ribbon’d wreaths- for you the shores a-crowding," 
        intervals [13]:
            xmin = 54.56 
            xmax = 55.622 
            text = "" 
        intervals [14]:
            xmin = 55.622 
            xmax = 61.034 
            text = "For you they call, the swaying mass, their eager faces turning;" 
        intervals [15]:
            xmin = 61.034 
            xmax = 63.439 
            text = "Here Captain! dear father!" 
        intervals [16]:
            xmin = 63.439 
            xmax = 65.223 
            text = "This arm beneath your head!" 
        intervals [17]:
            xmin = 65.223 
            xmax = 67.769 
            text = "It is some dream that on the deck," 
        intervals [18]:
            xmin = 67.769 
            xmax = 70.504 
            text = "You’ve fallen cold and dead." 
        intervals [19]:
            xmin = 70.504 
            xmax = 71.588 
            text = "" 
        intervals [20]:
            xmin = 71.588 
            xmax = 78.122 
            text = "My Captain does not answer, his lips are pale and still," 
        intervals [21]:
            xmin = 78.122 
            xmax = 78.83 
            text = "" 
        intervals [22]:
            xmin = 78.83 
            xmax = 85.077 
            text = "My father does not feel my arm, he has no pulse nor will," 
        intervals [23]:
            xmin = 85.077 
            xmax = 89.943 
            text = "The ship is anchor’d safe and sound, its voyage closed and done," 
        intervals [24]:
            xmin = 89.943 
            xmax = 94.899 
            text = "From fearful trip the victor ship comes in with object won;" 
        intervals [25]:
            xmin = 94.899 
            xmax = 98.333 
            text = "Exult O shores, and ring O bells!" 
        intervals [26]:
            xmin = 98.333 
            xmax = 99.114 
            text = "" 
        intervals [27]:
            xmin = 99.114 
            xmax = 102.789 
            text = "But I with mournful tread," 
        intervals [28]:
            xmin = 102.789 
            xmax = 105.702 
            text = "Walk the deck my Captain lies," 
        intervals [29]:
            xmin = 105.702 
            xmax = 106.223 
            text = "" 
        intervals [30]:
            xmin = 106.223 
            xmax = 109.316 
            text = "Fallen cold and dead." 
