    item [2]:
        class = "IntervalTier" 
        name = "sentences" 
        xmin = 0 
        xmax = 97.983 
        intervals: size = 36 
        intervals [1]:
            xmin = 0 
            xmax = 4.195 
            text = "O Captain! my Captain! our fearful trip is done," 
        intervals [2]:
            xmin = 4.195 
            xmax = 4.276 
            text = "" 
        intervals [3]:
            xmin = 4.276 
            xmax = 7.961 
            text = "The ship has weather’d every rack, the prize we sought is won," 
        intervals [4]:
            xmin = 7.961 
            xmax = 8.323 
            text = "" 
        intervals [5]:
            xmin = 8.323 
            xmax = 12.889 
            text = "The port is near, the bells I hear, the people all exulting," 
        intervals [6]:
            xmin = 12.889 
            xmax = 17.115 
            text = "While follow eyes the steady keel, the vessel grim and daring;" 
        intervals [7]:
            xmin = 17.115 
            xmax = 18.337 
            text = "" 
        intervals [8]:
            xmin = 18.337 
            xmax = 21.381 
            text = "But O heart! heart! heart!" 
        intervals [9]:
            xmin = 21.381 
            xmax = 23.692 
            text = "" 
        intervals [10]:
            xmin = 23.692 
            xmax = 25.694 
            text = "O the bleeding drops of red," 
        intervals [11]:
            xmin = 25.694 
            xmax = 26.215 
            text = "" 
        intervals [12]:
            xmin = 26.215 
            xmax = 28.508 
            text = "Where on the deck my Captain lies," 
        intervals [13]:
            xmin = 28.508 
            xmax = 29.669 
            text = "Fallen cold and dead." 
        intervals [14]:
            xmin = 29.669 
            xmax = 35.536 
            text = "O Captain! my Captain! rise up and hear the bells;" 
        intervals [15]:
            xmin = 35.536 
            xmax = 39.43 
            text = "Rise up- for you the flag is flung- for you the bugle trills," 
        intervals [16]:
            xmin = 39.43 
            xmax = 39.571 
            text = "" 
        intervals [17]:
            xmin = 39.571 
            xmax = 43.275 
            text = "For you bouquets and ribbon’d wreaths- for you the shores a-crowding," 
        intervals [18]:
            xmin = 43.275 
            xmax = 44.197 
            text = "" 
        intervals [19]:
            xmin = 44.197 
            xmax = 48.151 
            text = "For you they call, the swaying mass, their eager faces turning;" 
        intervals [20]:
            xmin = 48.151 
            xmax = 51.868 
            text = "Here Captain! dear father!" 
        intervals [21]:
            xmin = 51.868 
            xmax = 53.58 
            text = "This arm beneath your head!" 
        intervals [22]:
            xmin = 53.58 
            xmax = 56.262 
            text = "It is some dream that on the deck," 
        intervals [23]:
            xmin = 56.262 
            xmax = 57.964 
            text = "You’ve fallen cold and dead." 
        intervals [24]:
            xmin = 57.964 
            xmax = 59.987 
            text = "" 
        intervals [25]:
            xmin = 59.987 
            xmax = 64.651 
            text = "My Captain does not answer, his lips are pale and still," 
        intervals [26]:
            xmin = 64.651 
            xmax = 65.333 
            text = "" 
        intervals [27]:
            xmin = 65.333 
            xmax = 70.248 
            text = "My father does not feel my arm, he has no pulse nor will," 
        intervals [28]:
            xmin = 70.248 
            xmax = 76.314 
            text = "The ship is anchor’d safe and sound, its voyage closed and done," 
        intervals [29]:
            xmin = 76.314 
            xmax = 80.749 
            text = "From fearful trip the victor ship comes in with object won;" 
        intervals [30]:
            xmin = 80.749 
            xmax = 84.385 
            text = "Exult O shores, and ring O bells!" 
        intervals [31]:
            xmin = 84.385 
            xmax = 84.727 
            text = "" 
        intervals [32]:
            xmin = 84.727 
            xmax = 87.151 
            text = "But I with mournful tread," 
        intervals [33]:
            xmin = 87.151 
            xmax = 87.653 
            text = "" 
        intervals [34]:
            xmin = 87.653 
            xmax = 89.957 
            text = "Walk the deck my Captain lies," 
        intervals [35]:
            xmin = 89.957 
            xmax = 90.399 
            text = "" 
        intervals [36]:
            xmin = 90.399 
            xmax = 97.983 
            text = "Fallen cold and dead." 
