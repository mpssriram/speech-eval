    item [2]:
        class = "IntervalTier" 
        name = "sentences" 
        xmin = 0 
        xmax = 81.869 
        intervals: size = 34 
        intervals [1]:
            xmin = 0 
            xmax = 3.354 
            text = "O Captain! my Captain! our fearful trip is done," 
        intervals [2]:
            xmin = 3.354 
            xmax = 7.961 
            text = "The ship has weather’d every rack, the prize we sought is won," 
        intervals [3]:
            xmin = 7.961 
            xmax = 12.329 
            text = "The port is near, the bells I hear, the people all exulting," 
        intervals [4]:
            xmin = 12.329 
            xmax = 12.33 
            text = "" 
        intervals [5]:
            xmin = 12.33 
            xmax = 16.795 
            text = "While follow eyes the steady keel, the vessel grim and daring;" 
        intervals [6]:
            xmin = 16.795 
            xmax = 16.796 
            text = "" 
        intervals [7]:
            xmin = 16.796 
            xmax = 18.909 
            text = "But O heart! heart! heart!" 
        intervals [8]:
            xmin = 18.909 
            xmax = 21.343 
            text = "O the bleeding drops of red," 
        intervals [9]:
            xmin = 21.343 
            xmax = 23.466 
            text = "Where on the deck my Captain lies," 
        intervals [10]:
            xmin = 23.466 
            xmax = 25.188 
            text = "Fallen cold and dead." 
        intervals [11]:
            xmin = 25.188 
            xmax = 30.095 
            text = "O Captain! my Captain! rise up and hear the bells;" 
        intervals [12]:
            xmin = 30.095 
            xmax = 30.176 
            text = "" 
        intervals [13]:
            xmin = 30.176 
            xmax = 34.985 
            text = "Rise up- for you the flag is flung- for you the bugle trills," 
        intervals [14]:
            xmin = 34.985 
            xmax = 39.531 
            text = "For you bouquets and ribbon’d wreaths- for you the shores a-crowding," 
        intervals [15]:
            xmin = 39.531 
            xmax = 39.612 
            text = "" 
        intervals [16]:
            xmin = 39.612 
            xmax = 44.296 
            text = "For you they call, the swaying mass, their eager faces turning;" 
        intervals [17]:
            xmin = 44.296 
            xmax = 44.477 
            text = "" 
        intervals [18]:
            xmin = 44.477 
            xmax = 46.829 
            text = "Here Captain! dear father!" 
        intervals [19]:
            xmin = 46.829 
            xmax = 48.741 
            text = "This arm beneath your head!" 
        intervals [20]:
            xmin = 48.741 
            xmax = 48.821 
            text = "" 
        intervals [21]:
            xmin = 48.821 
            xmax = 51.154 
            text = "It is some dream that on the deck," 
        intervals [22]:
            xmin = 51.154 
            xmax = 53.305 
            text = "You’ve fallen cold and dead." 
        intervals [23]:
            xmin = 53.305 
            xmax = 54.107 
            text = "" 
        intervals [24]:
            xmin = 54.107 
            xmax = 58.07 
            text = "My Captain does not answer, his lips are pale and still," 
        intervals [25]:
            xmin = 58.07 
            xmax = 58.311 
            text = "" 
        intervals [26]:
            xmin = 58.311 
            xmax = 62.841 
            text = "My father does not feel my arm, he has no pulse nor will," 
        intervals [27]:
            xmin = 62.841 
            xmax = 67.274 
            text = "The ship is anchor’d safe and sound, its voyage closed and done," 
        intervals [28]:
            xmin = 67.274 
            xmax = 67.335 
            text = "" 
        intervals [29]:
            xmin = 67.335 
            xmax = 71.741 
            text = "From fearful trip the victor ship comes in with object won;" 
        intervals [30]:
            xmin = 71.741 
            xmax = 72.123 
            text = "" 
        intervals [31]:
            xmin = 72.123 
            xmax = 75.067 
            text = "Exult O shores, and ring O bells!" 
        intervals [32]:
            xmin = 75.067 
            xmax = 77.201 
            text = "But I with mournful tread," 
        intervals [33]:
            xmin = 77.201 
            xmax = 79.625 
            text = "Walk the deck my Captain lies," 
        intervals [34]:
            xmin = 79.625 
            xmax = 81.869 
            text = "Fallen cold and dead." 
