    item [2]:
        class = "IntervalTier" 
        name = "sentences" 
        xmin = 0 
        xmax = 70.595 
        intervals: size = 32 
        intervals [1]:
            xmin = 0 
            xmax = 3.034 
            text = "O Captain! my Captain! our fearful trip is done," 
        intervals [2]:
            xmin = 3.034 
            xmax = 6.639 
            text = "The ship has weather’d every rack, the prize we sought is won," 
        intervals [3]:
            xmin = 6.639 
            xmax = 10.004 
            text = "The port is near, the bells I hear, the people all exulting," 
        intervals [4]:
            xmin = 10.004 
            xmax = 10.005 
            text = "" 
        intervals [5]:
            xmin = 10.005 
            xmax = 13.87 
            text = "While follow eyes the steady keel, the vessel grim and daring;" 
        intervals [6]:
            xmin = 13.87 
            xmax = 13.911 
            text = "" 
        intervals [7]:
            xmin = 13.911 
            xmax = 16.264 
            text = "But O heart! heart! heart!" 
        intervals [8]:
            xmin = 16.264 
            xmax = 17.847 
            text = "O the bleeding drops of red," 
        intervals [9]:
            xmin = 17.847 
            xmax = 19.56 
            text = "Where on the deck my Captain lies," 
        intervals [10]:
            xmin = 19.56 
            xmax = 21.502 
            text = "Fallen cold and dead." 
        intervals [11]:
            xmin = 21.502 
            xmax = 22.53 
            text = "" 
        intervals [12]:
            xmin = 22.53 
            xmax = 25.723 
            text = "O Captain! my Captain! rise up and hear the bells;" 
        intervals [13]:
            xmin = 25.723 
            xmax = 29.357 
            text = "Rise up- for you the flag is flung- for you the bugle trills," 
        intervals [14]:
            xmin = 29.357 
            xmax = 32.72 
            text = "For you bouquets and ribbon’d wreaths- for you the shores a-crowding," 
        intervals [15]:
            xmin = 32.72 
            xmax = 33.241 
            text = "" 
        intervals [16]:
            xmin = 33.241 
            xmax = 36.715 
            text = "For you they call, the swaying mass, their eager faces turning;" 
        intervals [17]:
            xmin = 36.715 
            xmax = 39.328 
            text = "Here Captain! dear father!" 
        intervals [18]:
            xmin = 39.328 
            xmax = 40.88 
            text = "This arm beneath your head!" 
        intervals [19]:
            xmin = 40.88 
            xmax = 42.741 
            text = "It is some dream that on the deck," 
        intervals [20]:
            xmin = 42.741 
            xmax = 44.713 
            text = "You’ve fallen cold and dead." 
        intervals [21]:
            xmin = 44.713 
            xmax = 45.274 
            text = "" 
        intervals [22]:
            xmin = 45.274 
            xmax = 49.264 
            text = "My Captain does not answer, his lips are pale and still," 
        intervals [23]:
            xmin = 49.264 
            xmax = 53.416 
            text = "My father does not feel my arm, he has no pulse nor will," 
        intervals [24]:
            xmin = 53.416 
            xmax = 53.577 
            text = "" 
        intervals [25]:
            xmin = 53.577 
            xmax = 57.603 
            text = "The ship is anchor’d safe and sound, its voyage closed and done," 
        intervals [26]:
            xmin = 57.603 
            xmax = 57.805 
            text = "" 
        intervals [27]:
            xmin = 57.805 
            xmax = 61.6 
            text = "From fearful trip the victor ship comes in with object won;" 
        intervals [28]:
            xmin = 61.6 
            xmax = 64.144 
            text = "Exult O shores, and ring O bells!" 
        intervals [29]:
            xmin = 64.144 
            xmax = 66.298 
            text = "But I with mournful tread," 
        intervals [30]:
            xmin = 66.298 
            xmax = 66.339 
            text = "" 
        intervals [31]:
            xmin = 66.339 
            xmax = 68.442 
            text = "Walk the deck my Captain lies," 
        intervals [32]:
            xmin = 68.442 
            xmax = 70.595 
            text = "Fallen cold and dead." 
