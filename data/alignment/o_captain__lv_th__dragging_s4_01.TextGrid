            xmin = 3.67 
            xmax = 9.3 
            text = "The ship has weather’d every rack, the prize we sought is won," 
        intervals [5]:
            xmin = 9.3 
            xmax = 9.68 
            text = "" 
        intervals [6]:
            xmin = 9.68 
            xmax = 13.38 
            text = "The port is near, the bells I hear, the people all exulting," 
        intervals [7]:
            xmin = 13.38 
            xmax = 13.7 
            text = "" 
        intervals [8]:
            xmin = 13.7 
            xmax = 17.84 
            text = "While follow eyes the steady keel, the vessel grim and daring;" 
        intervals [9]:
            xmin = 17.84 
            xmax = 18.59 
            text = "" 
        intervals [10]:
            xmin = 18.59 
            xmax = 20.83 
            text = "But O heart! heart! heart!" 
        intervals [11]:
            xmin = 20.83 
            xmax = 20.89 
            text = "" 
        intervals [12]:
            xmin = 20.89 
            xmax = 22.68 
            text = "O the bleeding drops of red," 
        intervals [13]:
            xmin = 22.68 
            xmax = 22.85 
            text = "" 
        intervals [14]:
            xmin = 22.85 
            xmax = 24.91 
            text = "Where on the deck my Captain lies," 
        intervals [15]:
            xmin = 24.91 
            xmax = 26.62 
            text = "Fallen cold and dead." 
        intervals [16]:
            xmin = 26.62 
            xmax = 27.04 
            text = "" 
        intervals [17]:
            xmin = 27.04 
            xmax = 29.99 
            text = "O Captain! my Captain! rise up and hear the bells;" 
        intervals [18]:
            xmin = 29.99 
            xmax = 30.22 
            text = "" 
        intervals [19]:
            xmin = 30.22 
            xmax = 34.89 
            text = "Rise up- for you the flag is flung- for you the bugle trills," 
        intervals [20]:
            xmin = 34.89 
            xmax = 35.21 
            text = "" 
        intervals [21]:
            xmin = 35.21 
            xmax = 39.16 
            text = "For you bouquets and ribbon’d wreaths- for you the shores a-crowding," 
        intervals [22]:
            xmin = 39.16 
            xmax = 39.54 
            text = "" 
        intervals [23]:
            xmin = 39.54 
            xmax = 43.49 
            text = "For you they call, the swaying mass, their eager faces turning;" 
        intervals [24]:
            xmin = 43.49 
            xmax = 44 
            text = "" 
        intervals [25]:
            xmin = 44 
            xmax = 45.75 
            text = "Here Captain! dear father!" 
        intervals [26]:
            xmin = 45.75 
            xmax = 47.25 
            text = "This arm beneath your head!" 
        intervals [27]:
            xmin = 47.25 
            xmax = 47.85 
            text = "" 
        intervals [28]:
            xmin = 47.85 
            xmax = 49.59 
            text = "It is some dream that on the deck," 
        intervals [29]:
            xmin = 49.59 
            xmax = 51.25 
            text = "You’ve fallen cold and dead." 
        intervals [30]:
            xmin = 51.25 
            xmax = 52.21 
            text = "" 
        intervals [31]:
            xmin = 52.21 
            xmax = 56.19 
            text = "My Captain does not answer, his lips are pale and still," 
        intervals [32]:
            xmin = 56.19 
            xmax = 56.97 
            text = "" 
        intervals [33]:
            xmin = 56.97 
            xmax = 60.83 
            text = "My father does not feel my arm, he has no pulse nor will," 
        intervals [34]:
            xmin = 60.83 
            xmax = 61.58 
            text = "" 
        intervals [35]:
            xmin = 61.58 
            xmax = 65.57 
            text = "The ship is anchor’d safe and sound, its voyage closed and done," 
        intervals [36]:
            xmin = 65.57 
            xmax = 66.1 
            text = "" 
        intervals [37]:
            xmin = 66.1 
            xmax = 69.85 
            text = "From fearful trip the victor ship comes in with object won;" 
        intervals [38]:
            xmin = 69.85 
            xmax = 70.3 
            text = "" 
        intervals [39]:
            xmin = 70.3 
            xmax = 73.08 
            text = "Exult O shores, and ring O bells!" 
        intervals [40]:
            xmin = 73.08 
            xmax = 73.25 
            text = "" 
        intervals [41]:
            xmin = 73.25 
            xmax = 75.06 
            text = "But I with mournful tread," 
        intervals [42]:
            xmin = 75.06 
            xmax = 75.34 
            text = "" 
        intervals [43]:
            xmin = 75.34 
            xmax = 77.65 
            text = "Walk the deck my Captain lies," 
        intervals [44]:
            xmin = 77.65 
            xmax = 78.02 
            text = "" 
        intervals [45]:
            xmin = 78.02 
            xmax = 80.29 
            text = "Fallen cold and dead." 
        intervals [46]:
