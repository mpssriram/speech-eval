    item [2]:
        class = "IntervalTier" 
        name = "sentences" 
        xmin = 0 
        xmax = 81.57 
        intervals: size = 49 
        intervals [1]:
            xmin = 0 
            xmax = 0.14 
            text = "" 
        intervals [2]:
            xmin = 0.14 
            xmax = 3.43 
            text = "O Captain! my Captain! our fearful trip is done," 
        intervals [3]:
            xmin = 3.43 
            xmax = 3.7 
            text = "" 
        intervals [4]:
            xmin = 3.7 
            xmax = 7.6 
            text = "The ship has weather’d every rack, the prize we sought is won," 
        intervals [5]:
            xmin = 7.6 
            xmax = 7.91 
            text = "" 
        intervals [6]:
            xmin = 7.91 
            xmax = 11.8 
            text = "The port is near, the bells I hear, the people all exulting," 
        intervals [7]:
            xmin = 11.8 
            xmax = 12.29 
            text = "" 
        intervals [8]:
            xmin = 12.29 
            xmax = 16.26 
            text = "While follow eyes the steady keel, the vessel grim and daring;" 
        intervals [9]:
            xmin = 16.26 
            xmax = 16.76 
            text = "" 
        intervals [10]:
            xmin = 16.76 
            xmax = 18.78 
            text = "But O heart! heart! heart!" 
        intervals [11]:
            xmin = 18.78 
            xmax = 19.07 
            text = "" 
        intervals [12]:
            xmin = 19.07 
            xmax = 20.83 
            text = "O the bleeding drops of red," 
        intervals [13]:
            xmin = 20.83 
            xmax = 21.21 
            text = "" 
        intervals [14]:
            xmin = 21.21 
            xmax = 23.23 
            text = "Where on the deck my Captain lies," 
        intervals [15]:
            xmin = 23.23 
            xmax = 23.49 
            text = "" 
        intervals [16]:
            xmin = 23.49 
            xmax = 25.1 
            text = "Fallen cold and dead." 
        intervals [17]:
            xmin = 25.1 
            xmax = 26.27 
            text = "" 
        intervals [18]:
            xmin = 26.27 
            xmax = 29.55 
            text = "O Captain! my Captain! rise up and hear the bells;" 
        intervals [19]:
            xmin = 29.55 
            xmax = 30.07 
            text = "" 
        intervals [20]:
            xmin = 30.07 
            xmax = 34.45 
            text = "Rise up- for you the flag is flung- for you the bugle trills," 
        intervals [21]:
            xmin = 34.45 
            xmax = 34.75 
            text = "" 
        intervals [22]:
            xmin = 34.75 
            xmax = 39 
            text = "For you bouquets and ribbon’d wreaths- for you the shores a-crowding," 
        intervals [23]:
            xmin = 39 
            xmax = 39.53 
            text = "" 
        intervals [24]:
            xmin = 39.53 
            xmax = 43.71 
            text = "For you they call, the swaying mass, their eager faces turning;" 
        intervals [25]:
            xmin = 43.71 
            xmax = 44.4 
            text = "" 
        intervals [26]:
            xmin = 44.4 
            xmax = 46.34 
            text = "Here Captain! dear father!" 
        intervals [27]:
            xmin = 46.34 
            xmax = 46.65 
            text = "" 
        intervals [28]:
            xmin = 46.65 
            xmax = 48.17 
            text = "This arm beneath your head!" 
        intervals [29]:
            xmin = 48.17 
            xmax = 48.73 
            text = "" 
        intervals [30]:
            xmin = 48.73 
            xmax = 50.7 
            text = "It is some dream that on the deck," 
        intervals [31]:
            xmin = 50.7 
            xmax = 51.01 
            text = "" 
        intervals [32]:
            xmin = 51.01 
            xmax = 52.74 
            text = "You’ve fallen cold and dead." 
        intervals [33]:
            xmin = 52.74 
            xmax = 54.02 
            text = "" 
        intervals [34]:
            xmin = 54.02 
            xmax = 57.54 
            text = "My Captain does not answer, his lips are pale and still," 
        intervals [35]:
            xmin = 57.54 
            xmax = 58.2 
            text = "" 
        intervals [36]:
            xmin = 58.2 
            xmax = 62.07 
            text = "My father does not feel my arm, he has no pulse nor will," 
        intervals [37]:
            xmin = 62.07 
            xmax = 62.81 
            text = "" 
        intervals [38]:
            xmin = 62.81 
            xmax = 66.76 
            text = "The ship is anchor’d safe and sound, its voyage closed and done," 
        intervals [39]:
            xmin = 66.76 
            xmax = 67.22 
            text = "" 
        intervals [40]:
            xmin = 67.22 
            xmax = 71.26 
            text = "From fearful trip the victor ship comes in with object won;" 
        intervals [41]:
            xmin = 71.26 
            xmax = 71.96 
            text = "" 
        intervals [42]:
            xmin = 71.96 
            xmax = 74.56 
            text = "Exult O shores, and ring O bells!" 
        intervals [43]:
            xmin = 74.56 
            xmax = 75 
            text = "" 
        intervals [44]:
            xmin = 75 
            xmax = 76.66 
            text = "But I with mournful tread," 
        intervals [45]:
            xmin = 76.66 
            xmax = 77.09 
            text = "" 
        intervals [46]:
            xmin = 77.09 
            xmax = 79.19 
            text = "Walk the deck my Captain lies," 
        intervals [47]:
            xmin = 79.19 
            xmax = 79.43 
            text = "" 
        intervals [48]:
            xmin = 79.43 
            xmax = 81.36 
            text = "Fallen cold and dead." 
        intervals [49]:
            xmin = 81.36 
            xmax = 81.57 
            text = "" 
