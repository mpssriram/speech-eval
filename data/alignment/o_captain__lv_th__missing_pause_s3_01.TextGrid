            xmin = 3.67 
            xmax = 7.33 
            text = "The ship has weather’d every rack, the prize we sought is won," 
        intervals [5]:
            xmin = 7.33 
            xmax = 7.71 
            text = "" 
        intervals [6]:
            xmin = 7.71 
            xmax = 11.41 
            text = "The port is near, the bells I hear, the people all exulting," 
        intervals [7]:
            xmin = 11.41 
            xmax = 11.73 
            text = "" 
        intervals [8]:
            xmin = 11.73 
            xmax = 15.87 
            text = "While follow eyes the steady keel, the vessel grim and daring;" 
        intervals [9]:
            xmin = 15.87 
            xmax = 16.62 
            text = "" 
        intervals [10]:
            xmin = 16.62 
            xmax = 18.86 
            text = "But O heart! heart! heart!" 
        intervals [11]:
            xmin = 18.86 
            xmax = 18.93 
            text = "" 
        intervals [12]:
            xmin = 18.93 
            xmax = 20.71 
            text = "O the bleeding drops of red," 
        intervals [13]:
            xmin = 20.71 
            xmax = 20.88 
            text = "" 
        intervals [14]:
            xmin = 20.88 
            xmax = 22.94 
            text = "Where on the deck my Captain lies," 
        intervals [15]:
            xmin = 22.94 
            xmax = 24.65 
            text = "Fallen cold and dead." 
        intervals [16]:
            xmin = 24.65 
            xmax = 25.07 
            text = "" 
        intervals [17]:
            xmin = 25.07 
            xmax = 28.02 
            text = "O Captain! my Captain! rise up and hear the bells;" 
        intervals [18]:
            xmin = 28.02 
            xmax = 28.25 
            text = "" 
        intervals [19]:
            xmin = 28.25 
            xmax = 32.64 
            text = "Rise up- for you the flag is flung- for you the bugle trills," 
        intervals [20]:
            xmin = 32.64 
            xmax = 32.96 
            text = "" 
        intervals [21]:
            xmin = 32.96 
            xmax = 36.91 
            text = "For you bouquets and ribbon’d wreaths- for you the shores a-crowding," 
        intervals [22]:
            xmin = 36.91 
            xmax = 37.29 
            text = "" 
        intervals [23]:
            xmin = 37.29 
            xmax = 41.24 
            text = "For you they call, the swaying mass, their eager faces turning;" 
        intervals [24]:
            xmin = 41.24 
            xmax = 41.76 
            text = "" 
        intervals [25]:
            xmin = 41.76 
            xmax = 43.5 
            text = "Here Captain! dear father!" 
        intervals [26]:
            xmin = 43.5 
            xmax = 45 
            text = "This arm beneath your head!" 
        intervals [27]:
            xmin = 45 
            xmax = 45.6 
            text = "" 
        intervals [28]:
            xmin = 45.6 
            xmax = 47.34 
            text = "It is some dream that on the deck," 
        intervals [29]:
            xmin = 47.34 
            xmax = 49.01 
            text = "You’ve fallen cold and dead." 
        intervals [30]:
            xmin = 49.01 
            xmax = 49.96 
            text = "" 
        intervals [31]:
            xmin = 49.96 
            xmax = 53.94 
            text = "My Captain does not answer, his lips are pale and still," 
        intervals [32]:
            xmin = 53.94 
            xmax = 54.72 
            text = "" 
        intervals [33]:
            xmin = 54.72 
            xmax = 58.58 
            text = "My father does not feel my arm, he has no pulse nor will," 
        intervals [34]:
            xmin = 58.58 
            xmax = 59.33 
            text = "" 
        intervals [35]:
            xmin = 59.33 
            xmax = 63.32 
            text = "The ship is anchor’d safe and sound, its voyage closed and done," 
        intervals [36]:
            xmin = 63.32 
            xmax = 63.85 
            text = "" 
        intervals [37]:
            xmin = 63.85 
            xmax = 67.6 
            text = "From fearful trip the victor ship comes in with object won;" 
        intervals [38]:
            xmin = 67.6 
            xmax = 68.05 
            text = "" 
        intervals [39]:
            xmin = 68.05 
            xmax = 70.83 
            text = "Exult O shores, and ring O bells!" 
        intervals [40]:
            xmin = 70.83 
            xmax = 70.94 
            text = "" 
        intervals [41]:
            xmin = 70.94 
            xmax = 72.81 
            text = "But I with mournful tread," 
        intervals [42]:
            xmin = 72.81 
            xmax = 73.09 
            text = "" 
        intervals [43]:
            xmin = 73.09 
            xmax = 75.41 
            text = "Walk the deck my Captain lies," 
        intervals [44]:
            xmin = 75.41 
            xmax = 75.77 
            text = "" 
        intervals [45]:
            xmin = 75.77 
            xmax = 78.04 
            text = "Fallen cold and dead." 
        intervals [46]:
            xmin = 78.04 
