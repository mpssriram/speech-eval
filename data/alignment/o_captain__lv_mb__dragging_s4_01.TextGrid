    item [2]:
        class = "IntervalTier" 
        name = "sentences" 
        xmin = 0 
        xmax = 83.593 
        intervals: size = 49 
        intervals [1]:
            xmin = 0 
            xmax = 0.14 
            text = "" 
        intervals [2]:
            xmin = 0.14 
            xmax = 3.43 
            text = "O Captain! my Captain! our fearful trip is done," 
        intervals [3]:
            xmin = 3.43 
            xmax = 3.7 
            text = "" 
        intervals [4]:
            xmin = 3.7 
            xmax = 7.6 
            text = "The ship has weather’d every rack, the prize we sought is won," 
        intervals [5]:
            xmin = 7.6 
            xmax = 8.21 
            text = "" 
        intervals [6]:
            xmin = 8.21 
            xmax = 13.83 
            text = "The port is near, the bells I hear, the people all exulting," 
        intervals [7]:
            xmin = 13.83 
            xmax = 14.32 
            text = "" 
        intervals [8]:
            xmin = 14.32 
            xmax = 18.28 
            text = "While follow eyes the steady keel, the vessel grim and daring;" 
        intervals [9]:
            xmin = 18.28 
            xmax = 18.78 
            text = "" 
        intervals [10]:
            xmin = 18.78 
            xmax = 20.8 
            text = "But O heart! heart! heart!" 
        intervals [11]:
            xmin = 20.8 
            xmax = 21.09 
            text = "" 
        intervals [12]:
            xmin = 21.09 
            xmax = 22.85 
            text = "O the bleeding drops of red," 
        intervals [13]:
            xmin = 22.85 
            xmax = 23.23 
            text = "" 
        intervals [14]:
            xmin = 23.23 
            xmax = 25.26 
            text = "Where on the deck my Captain lies," 
        intervals [15]:
            xmin = 25.26 
            xmax = 25.52 
            text = "" 
        intervals [16]:
            xmin = 25.52 
            xmax = 27.12 
            text = "Fallen cold and dead." 
        intervals [17]:
            xmin = 27.12 
            xmax = 28.29 
            text = "" 
        intervals [18]:
            xmin = 28.29 
            xmax = 31.57 
            text = "O Captain! my Captain! rise up and hear the bells;" 
        intervals [19]:
            xmin = 31.57 
            xmax = 32.1 
            text = "" 
        intervals [20]:
            xmin = 32.1 
            xmax = 36.47 
            text = "Rise up- for you the flag is flung- for you the bugle trills," 
        intervals [21]:
            xmin = 36.47 
            xmax = 36.77 
            text = "" 
        intervals [22]:
            xmin = 36.77 
            xmax = 41.02 
            text = "For you bouquets and ribbon’d wreaths- for you the shores a-crowding," 
        intervals [23]:
            xmin = 41.02 
            xmax = 41.55 
            text = "" 
        intervals [24]:
            xmin = 41.55 
            xmax = 45.73 
            text = "For you they call, the swaying mass, their eager faces turning;" 
        intervals [25]:
            xmin = 45.73 
            xmax = 46.42 
            text = "" 
        intervals [26]:
            xmin = 46.42 
            xmax = 48.36 
            text = "Here Captain! dear father!" 
        intervals [27]:
            xmin = 48.36 
            xmax = 48.68 
            text = "" 
        intervals [28]:
            xmin = 48.68 
            xmax = 50.22 
            text = "This arm beneath your head!" 
        intervals [29]:
            xmin = 50.22 
            xmax = 50.75 
            text = "" 
        intervals [30]:
            xmin = 50.75 
            xmax = 52.73 
            text = "It is some dream that on the deck," 
        intervals [31]:
            xmin = 52.73 
            xmax = 53.04 
            text = "" 
        intervals [32]:
            xmin = 53.04 
            xmax = 54.76 
            text = "You’ve fallen cold and dead." 
        intervals [33]:
            xmin = 54.76 
            xmax = 56.04 
            text = "" 
        intervals [34]:
            xmin = 56.04 
            xmax = 59.56 
            text = "My Captain does not answer, his lips are pale and still," 
        intervals [35]:
            xmin = 59.56 
            xmax = 60.22 
            text = "" 
        intervals [36]:
            xmin = 60.22 
            xmax = 64.13 
            text = "My father does not feel my arm, he has no pulse nor will," 
        intervals [37]:
            xmin = 64.13 
            xmax = 64.84 
            text = "" 
        intervals [38]:
            xmin = 64.84 
            xmax = 68.78 
            text = "The ship is anchor’d safe and sound, its voyage closed and done," 
        intervals [39]:
            xmin = 68.78 
            xmax = 69.24 
            text = "" 
        intervals [40]:
            xmin = 69.24 
            xmax = 73.27 
            text = "From fearful trip the victor ship comes in with object won;" 
        intervals [41]:
            xmin = 73.27 
            xmax = 73.98 
            text = "" 
        intervals [42]:
            xmin = 73.98 
            xmax = 76.58 
            text = "Exult O shores, and ring O bells!" 
        intervals [43]:
            xmin = 76.58 
            xmax = 77.02 
            text = "" 
        intervals [44]:
            xmin = 77.02 
            xmax = 78.68 
            text = "But I with mournful tread," 
        intervals [45]:
            xmin = 78.68 
            xmax = 79.11 
            text = "" 
        intervals [46]:
            xmin = 79.11 
            xmax = 81.21 
            text = "Walk the deck my Captain lies," 
        intervals [47]:
            xmin = 81.21 
            xmax = 81.45 
            text = "" 
        intervals [48]:
            xmin = 81.45 
            xmax = 83.38 
            text = "Fallen cold and dead." 
        intervals [49]:
            xmin = 83.38 
            xmax = 83.593 
            text = "" 
