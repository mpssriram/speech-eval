    item [2]:
        class = "IntervalTier" 
        name = "sentences" 
        xmin = 0 
        xmax = 97.641 
        intervals: size = 48 
        intervals [1]:
            xmin = 0 
            xmax = 0.13 
            text = "" 
        intervals [2]:
            xmin = 0.13 
            xmax = 3.92 
            text = "O Captain! my Captain! our fearful trip is done," 
        intervals [3]:
            xmin = 3.92 
            xmax = 4.28 
            text = "" 
        intervals [4]:
            xmin = 4.28 
            xmax = 8.62 
            text = "The ship has weather’d every rack, the prize we sought is won," 
        intervals [5]:
            xmin = 8.62 
            xmax = 9.55 
            text = "" 
        intervals [6]:
            xmin = 9.55 
            xmax = 13.67 
            text = "The port is near, the bells I hear, the people all exulting," 
        intervals [7]:
            xmin = 13.67 
            xmax = 14.11 
            text = "" 
        intervals [8]:
            xmin = 14.11 
            xmax = 18.73 
            text = "While follow eyes the steady keel, the vessel grim and daring;" 
        intervals [9]:
            xmin = 18.73 
            xmax = 20.05 
            text = "" 
        intervals [10]:
            xmin = 20.05 
            xmax = 23.54 
            text = "But O heart! heart! heart!" 
        intervals [11]:
            xmin = 23.54 
            xmax = 24.52 
            text = "" 
        intervals [12]:
            xmin = 24.52 
            xmax = 26.92 
            text = "O the bleeding drops of red," 
        intervals [13]:
            xmin = 26.92 
            xmax = 27.77 
            text = "" 
        intervals [14]:
            xmin = 27.77 
            xmax = 30.22 
            text = "Where on the deck my Captain lies," 
        intervals [15]:
            xmin = 30.22 
            xmax = 30.53 
            text = "" 
        intervals [16]:
            xmin = 30.53 
            xmax = 32.45 
            text = "Fallen cold and dead." 
        intervals [17]:
            xmin = 32.45 
            xmax = 34.29 
            text = "" 
        intervals [18]:
            xmin = 34.29 
            xmax = 38.02 
            text = "O Captain! my Captain! rise up and hear the bells;" 
        intervals [19]:
            xmin = 38.02 
            xmax = 38.37 
            text = "" 
        intervals [20]:
            xmin = 38.37 
            xmax = 42.84 
            text = "Rise up- for you the flag is flung- for you the bugle trills," 
        intervals [21]:
            xmin = 42.84 
            xmax = 43.28 
            text = "" 
        intervals [22]:
            xmin = 43.28 
            xmax = 47.81 
            text = "For you bouquets and ribbon’d wreaths- for you the shores a-crowding," 
        intervals [23]:
            xmin = 47.81 
            xmax = 48.17 
            text = "" 
        intervals [24]:
            xmin = 48.17 
            xmax = 52.46 
            text = "For you they call, the swaying mass, their eager faces turning;" 
        intervals [25]:
            xmin = 52.46 
            xmax = 53.29 
            text = "" 
        intervals [26]:
            xmin = 53.29 
            xmax = 55.31 
            text = "Here Captain! dear father!" 
        intervals [27]:
            xmin = 55.31 
            xmax = 56.96 
            text = "This arm beneath your head!" 
        intervals [28]:
            xmin = 56.96 
            xmax = 57.41 
            text = "" 
        intervals [29]:
            xmin = 57.41 
            xmax = 59.66 
            text = "It is some dream that on the deck," 
        intervals [30]:
            xmin = 59.66 
            xmax = 59.98 
            text = "" 
        intervals [31]:
            xmin = 59.98 
            xmax = 61.83 
            text = "You’ve fallen cold and dead." 
        intervals [32]:
            xmin = 61.83 
            xmax = 64.54 
            text = "" 
        intervals [33]:
            xmin = 64.54 
            xmax = 69.17 
            text = "My Captain does not answer, his lips are pale and still," 
        intervals [34]:
            xmin = 69.17 
            xmax = 70.1 
            text = "" 
        intervals [35]:
            xmin = 70.1 
            xmax = 75.18 
            text = "My father does not feel my arm, he has no pulse nor will," 
        intervals [36]:
            xmin = 75.18 
            xmax = 76.26 
            text = "" 
        intervals [37]:
            xmin = 76.26 
            xmax = 80.38 
            text = "The ship is anchor’d safe and sound, its voyage closed and done," 
        intervals [38]:
            xmin = 80.38 
            xmax = 80.72 
            text = "" 
        intervals [39]:
            xmin = 80.72 
            xmax = 85.02 
            text = "From fearful trip the victor ship comes in with object won;" 
        intervals [40]:
            xmin = 85.02 
            xmax = 86.23 
            text = "" 
        intervals [41]:
            xmin = 86.23 
            xmax = 89.04 
            text = "Exult O shores, and ring O bells!" 
        intervals [42]:
            xmin = 89.04 
            xmax = 89.55 
            text = "" 
        intervals [43]:
            xmin = 89.55 
            xmax = 91.6 
            text = "But I with mournful tread," 
        intervals [44]:
            xmin = 91.6 
            xmax = 92.51 
            text = "" 
        intervals [45]:
            xmin = 92.51 
            xmax = 94.89 
            text = "Walk the deck my Captain lies," 
        intervals [46]:
            xmin = 94.89 
            xmax = 95.03 
            text = "" 
        intervals [47]:
            xmin = 95.03 
            xmax = 97.56 
            text = "Fallen cold and dead." 
        intervals [48]:
            xmin = 97.56 
            xmax = 97.641 
            text = "" 
