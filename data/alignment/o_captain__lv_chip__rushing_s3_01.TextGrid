    item [2]:
        class = "IntervalTier" 
        name = "sentences" 
        xmin = 0 
        xmax = 108.656 
        intervals: size = 44 
        intervals [1]:
            xmin = 0 
            xmax = 0.25 
            text = "" 
        intervals [2]:
            xmin = 0.25 
            xmax = 6.03 
            text = "O Captain! my Captain! our fearful trip is done," 
        intervals [3]:
            xmin = 6.03 
            xmax = 6.26 
            text = "" 
        intervals [4]:
            xmin = 6.26 
            xmax = 14.9 
            text = "The ship has weather’d every rack, the prize we sought is won," 
        intervals [5]:
            xmin = 14.9 
            xmax = 15.3 
            text = "" 
        intervals [6]:
            xmin = 15.3 
            xmax = 23.25 
            text = "The port is near, the bells I hear, the people all exulting," 
        intervals [7]:
            xmin = 23.25 
            xmax = 23.78 
            text = "" 
        intervals [8]:
            xmin = 23.78 
            xmax = 27.98 
            text = "While follow eyes the steady keel, the vessel grim and daring;" 
        intervals [9]:
            xmin = 27.98 
            xmax = 28.65 
            text = "" 
        intervals [10]:
            xmin = 28.65 
            xmax = 31.74 
            text = "But O heart! heart! heart!" 
        intervals [11]:
            xmin = 31.74 
            xmax = 34.02 
            text = "O the bleeding drops of red," 
        intervals [12]:
            xmin = 34.02 
            xmax = 34.69 
            text = "" 
        intervals [13]:
            xmin = 34.69 
            xmax = 37.31 
            text = "Where on the deck my Captain lies," 
        intervals [14]:
            xmin = 37.31 
            xmax = 38.27 
            text = "" 
        intervals [15]:
            xmin = 38.27 
            xmax = 40.87 
            text = "Fallen cold and dead." 
        intervals [16]:
            xmin = 40.87 
            xmax = 42.14 
            text = "" 
        intervals [17]:
            xmin = 42.14 
            xmax = 45.52 
            text = "O Captain! my Captain! rise up and hear the bells;" 
        intervals [18]:
            xmin = 45.52 
            xmax = 45.84 
            text = "" 
        intervals [19]:
            xmin = 45.84 
            xmax = 49.47 
            text = "Rise up- for you the flag is flung- for you the bugle trills," 
        intervals [20]:
            xmin = 49.47 
            xmax = 49.87 
            text = "" 
        intervals [21]:
            xmin = 49.87 
            xmax = 54.33 
            text = "For you bouquets and ribbon’d wreaths- for you the shores a-crowding," 
        intervals [22]:
            xmin = 54.33 
            xmax = 55.16 
            text = "" 
        intervals [23]:
            xmin = 55.16 
            xmax = 60.14 
            text = "For you they call, the swaying mass, their eager faces turning;" 
        intervals [24]:
            xmin = 60.14 
            xmax = 60.56 
            text = "" 
        intervals [25]:
            xmin = 60.56 
            xmax = 62.56 
            text = "Here Captain! dear father!" 
        intervals [26]:
            xmin = 62.56 
            xmax = 63.01 
            text = "" 
        intervals [27]:
            xmin = 63.01 
            xmax = 64.8 
            text = "This arm beneath your head!" 
        intervals [28]:
            xmin = 64.8 
            xmax = 66.98 
            text = "It is some dream that on the deck," 
        intervals [29]:
            xmin = 66.98 
            xmax = 67.07 
            text = "" 
        intervals [30]:
            xmin = 67.07 
            xmax = 69.44 
            text = "You’ve fallen cold and dead." 
        intervals [31]:
            xmin = 69.44 
            xmax = 71.13 
            text = "" 
        intervals [32]:
            xmin = 71.13 
            xmax = 76.93 
            text = "My Captain does not answer, his lips are pale and still," 
        intervals [33]:
            xmin = 76.93 
            xmax = 78.48 
            text = "" 
        intervals [34]:
            xmin = 78.48 
            xmax = 84.23 
            text = "My father does not feel my arm, he has no pulse nor will," 
        intervals [35]:
            xmin = 84.23 
            xmax = 84.66 
            text = "" 
        intervals [36]:
            xmin = 84.66 
            xmax = 89.36 
            text = "The ship is anchor’d safe and sound, its voyage closed and done," 
        intervals [37]:
            xmin = 89.36 
            xmax = 94.32 
            text = "From fearful trip the victor ship comes in with object won;" 
        intervals [38]:
            xmin = 94.32 
            xmax = 97.48 
            text = "Exult O shores, and ring O bells!" 
        intervals [39]:
            xmin = 97.48 
            xmax = 98.7 
            text = "" 
        intervals [40]:
            xmin = 98.7 
            xmax = 102.14 
            text = "But I with mournful tread," 
        intervals [41]:
            xmin = 102.14 
            xmax = 104.63 
            text = "Walk the deck my Captain lies," 
        intervals [42]:
            xmin = 104.63 
            xmax = 105.71 
            text = "" 
        intervals [43]:
            xmin = 105.71 
            xmax = 108.33 
            text = "Fallen cold and dead." 
        intervals [44]:
            xmin = 108.33 
            xmax = 108.656 
            text = "" 
