    item [2]:
        class = "IntervalTier" 
        name = "sentences" 
        xmin = 0 
        xmax = 97.091 
        intervals: size = 48 
        intervals [1]:
            xmin = 0 
            xmax = 0.13 
            text = "" 
        intervals [2]:
            xmin = 0.13 
            xmax = 3.78 
            text = "O Captain! my Captain! our fearful trip is done," 
        intervals [3]:
            xmin = 3.78 
            xmax = 4.16 
            text = "" 
        intervals [4]:
            xmin = 4.16 
            xmax = 8.07 
            text = "The ship has weather’d every rack, the prize we sought is won," 
        intervals [5]:
            xmin = 8.07 
            xmax = 9 
            text = "" 
        intervals [6]:
            xmin = 9 
            xmax = 13.12 
            text = "The port is near, the bells I hear, the people all exulting," 
        intervals [7]:
            xmin = 13.12 
            xmax = 13.56 
            text = "" 
        intervals [8]:
            xmin = 13.56 
            xmax = 18.18 
            text = "While follow eyes the steady keel, the vessel grim and daring;" 
        intervals [9]:
            xmin = 18.18 
            xmax = 19.5 
            text = "" 
        intervals [10]:
            xmin = 19.5 
            xmax = 22.99 
            text = "But O heart! heart! heart!" 
        intervals [11]:
            xmin = 22.99 
            xmax = 23.97 
            text = "" 
        intervals [12]:
            xmin = 23.97 
            xmax = 26.37 
            text = "O the bleeding drops of red," 
        intervals [13]:
            xmin = 26.37 
            xmax = 27.22 
            text = "" 
        intervals [14]:
            xmin = 27.22 
            xmax = 29.67 
            text = "Where on the deck my Captain lies," 
        intervals [15]:
            xmin = 29.67 
            xmax = 29.99 
            text = "" 
        intervals [16]:
            xmin = 29.99 
            xmax = 31.9 
            text = "Fallen cold and dead." 
        intervals [17]:
            xmin = 31.9 
            xmax = 33.74 
            text = "" 
        intervals [18]:
            xmin = 33.74 
            xmax = 37.47 
            text = "O Captain! my Captain! rise up and hear the bells;" 
        intervals [19]:
            xmin = 37.47 
            xmax = 37.82 
            text = "" 
        intervals [20]:
            xmin = 37.82 
            xmax = 42.29 
            text = "Rise up- for you the flag is flung- for you the bugle trills," 
        intervals [21]:
            xmin = 42.29 
            xmax = 42.73 
            text = "" 
        intervals [22]:
            xmin = 42.73 
            xmax = 47.26 
            text = "For you bouquets and ribbon’d wreaths- for you the shores a-crowding," 
        intervals [23]:
            xmin = 47.26 
            xmax = 47.62 
            text = "" 
        intervals [24]:
            xmin = 47.62 
            xmax = 51.91 
            text = "For you they call, the swaying mass, their eager faces turning;" 
        intervals [25]:
            xmin = 51.91 
            xmax = 52.74 
            text = "" 
        intervals [26]:
            xmin = 52.74 
            xmax = 54.76 
            text = "Here Captain! dear father!" 
        intervals [27]:
            xmin = 54.76 
            xmax = 56.41 
            text = "This arm beneath your head!" 
        intervals [28]:
            xmin = 56.41 
            xmax = 56.86 
            text = "" 
        intervals [29]:
            xmin = 56.86 
            xmax = 59.11 
            text = "It is some dream that on the deck," 
        intervals [30]:
            xmin = 59.11 
            xmax = 59.42 
            text = "" 
        intervals [31]:
            xmin = 59.42 
            xmax = 61.28 
            text = "You’ve fallen cold and dead." 
        intervals [32]:
            xmin = 61.28 
            xmax = 63.99 
            text = "" 
        intervals [33]:
            xmin = 63.99 
            xmax = 68.62 
            text = "My Captain does not answer, his lips are pale and still," 
        intervals [34]:
            xmin = 68.62 
            xmax = 69.55 
            text = "" 
        intervals [35]:
            xmin = 69.55 
            xmax = 74.63 
            text = "My father does not feel my arm, he has no pulse nor will," 
        intervals [36]:
            xmin = 74.63 
            xmax = 75.71 
            text = "" 
        intervals [37]:
            xmin = 75.71 
            xmax = 79.83 
            text = "The ship is anchor’d safe and sound, its voyage closed and done," 
        intervals [38]:
            xmin = 79.83 
            xmax = 80.18 
            text = "" 
        intervals [39]:
            xmin = 80.18 
            xmax = 84.47 
            text = "From fearful trip the victor ship comes in with object won;" 
        intervals [40]:
            xmin = 84.47 
            xmax = 85.7 
            text = "" 
        intervals [41]:
            xmin = 85.7 
            xmax = 88.49 
            text = "Exult O shores, and ring O bells!" 
        intervals [42]:
            xmin = 88.49 
            xmax = 89 
            text = "" 
        intervals [43]:
            xmin = 89 
            xmax = 91.04 
            text = "But I with mournful tread," 
        intervals [44]:
            xmin = 91.04 
            xmax = 91.96 
            text = "" 
        intervals [45]:
            xmin = 91.96 
            xmax = 94.34 
            text = "Walk the deck my Captain lies," 
        intervals [46]:
            xmin = 94.34 
            xmax = 94.48 
            text = "" 
        intervals [47]:
            xmin = 94.48 
            xmax = 97.01 
            text = "Fallen cold and dead." 
        intervals [48]:
            xmin = 97.01 
            xmax = 97.091 
            text = "" 
