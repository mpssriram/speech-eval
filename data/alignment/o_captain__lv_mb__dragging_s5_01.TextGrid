    item [2]:
        class = "IntervalTier" 
        name = "sentences" 
        xmin = 0 
        xmax = 83.339 
        intervals: size = 49 
        intervals [1]:
            xmin = 0 
            xmax = 0.14 
            text = "" 
        intervals [2]:
            xmin = 0.14 
            xmax = 3.43 
            text = "O Captain! my Captain! our fearful trip is done," 
        intervals [3]:
            xmin = 3.43 
            xmax = 3.7 
            text = "" 
        intervals [4]:
            xmin = 3.7 
            xmax = 9.07 
            text = "The ship has weather’d every rack, the prize we sought is won," 
        intervals [5]:
            xmin = 9.07 
            xmax = 9.68 
            text = "" 
        intervals [6]:
            xmin = 9.68 
            xmax = 13.57 
            text = "The port is near, the bells I hear, the people all exulting," 
        intervals [7]:
            xmin = 13.57 
            xmax = 14.06 
            text = "" 
        intervals [8]:
            xmin = 14.06 
            xmax = 18.01 
            text = "While follow eyes the steady keel, the vessel grim and daring;" 
        intervals [9]:
            xmin = 18.01 
            xmax = 18.53 
            text = "" 
        intervals [10]:
            xmin = 18.53 
            xmax = 20.55 
            text = "But O heart! heart! heart!" 
        intervals [11]:
            xmin = 20.55 
            xmax = 20.84 
            text = "" 
        intervals [12]:
            xmin = 20.84 
            xmax = 22.6 
            text = "O the bleeding drops of red," 
        intervals [13]:
            xmin = 22.6 
            xmax = 22.97 
            text = "" 
        intervals [14]:
            xmin = 22.97 
            xmax = 25 
            text = "Where on the deck my Captain lies," 
        intervals [15]:
            xmin = 25 
            xmax = 25.26 
            text = "" 
        intervals [16]:
            xmin = 25.26 
            xmax = 26.87 
            text = "Fallen cold and dead." 
        intervals [17]:
            xmin = 26.87 
            xmax = 28.03 
            text = "" 
        intervals [18]:
            xmin = 28.03 
            xmax = 31.32 
            text = "O Captain! my Captain! rise up and hear the bells;" 
        intervals [19]:
            xmin = 31.32 
            xmax = 31.84 
            text = "" 
        intervals [20]:
            xmin = 31.84 
            xmax = 36.22 
            text = "Rise up- for you the flag is flung- for you the bugle trills," 
        intervals [21]:
            xmin = 36.22 
            xmax = 36.52 
            text = "" 
        intervals [22]:
            xmin = 36.52 
            xmax = 40.77 
            text = "For you bouquets and ribbon’d wreaths- for you the shores a-crowding," 
        intervals [23]:
            xmin = 40.77 
            xmax = 41.29 
            text = "" 
        intervals [24]:
            xmin = 41.29 
            xmax = 45.48 
            text = "For you they call, the swaying mass, their eager faces turning;" 
        intervals [25]:
            xmin = 45.48 
            xmax = 46.17 
            text = "" 
        intervals [26]:
            xmin = 46.17 
            xmax = 48.11 
            text = "Here Captain! dear father!" 
        intervals [27]:
            xmin = 48.11 
            xmax = 48.42 
            text = "" 
        intervals [28]:
            xmin = 48.42 
            xmax = 49.94 
            text = "This arm beneath your head!" 
        intervals [29]:
            xmin = 49.94 
            xmax = 50.49 
            text = "" 
        intervals [30]:
            xmin = 50.49 
            xmax = 52.47 
            text = "It is some dream that on the deck," 
        intervals [31]:
            xmin = 52.47 
            xmax = 52.78 
            text = "" 
        intervals [32]:
            xmin = 52.78 
            xmax = 54.52 
            text = "You’ve fallen cold and dead." 
        intervals [33]:
            xmin = 54.52 
            xmax = 55.79 
            text = "" 
        intervals [34]:
            xmin = 55.79 
            xmax = 59.31 
            text = "My Captain does not answer, his lips are pale and still," 
        intervals [35]:
            xmin = 59.31 
            xmax = 59.97 
            text = "" 
        intervals [36]:
            xmin = 59.97 
            xmax = 63.83 
            text = "My father does not feel my arm, he has no pulse nor will," 
        intervals [37]:
            xmin = 63.83 
            xmax = 64.58 
            text = "" 
        intervals [38]:
            xmin = 64.58 
            xmax = 68.53 
            text = "The ship is anchor’d safe and sound, its voyage closed and done," 
        intervals [39]:
            xmin = 68.53 
            xmax = 68.98 
            text = "" 
        intervals [40]:
            xmin = 68.98 
            xmax = 73.03 
            text = "From fearful trip the victor ship comes in with object won;" 
        intervals [41]:
            xmin = 73.03 
            xmax = 73.73 
            text = "" 
        intervals [42]:
            xmin = 73.73 
            xmax = 76.33 
            text = "Exult O shores, and ring O bells!" 
        intervals [43]:
            xmin = 76.33 
            xmax = 76.77 
            text = "" 
        intervals [44]:
            xmin = 76.77 
            xmax = 78.43 
            text = "But I with mournful tread," 
        intervals [45]:
            xmin = 78.43 
            xmax = 78.85 
            text = "" 
        intervals [46]:
            xmin = 78.85 
            xmax = 80.96 
            text = "Walk the deck my Captain lies," 
        intervals [47]:
            xmin = 80.96 
            xmax = 81.2 
            text = "" 
        intervals [48]:
            xmin = 81.2 
            xmax = 83.18 
            text = "Fallen cold and dead." 
        intervals [49]:
            xmin = 83.18 
            xmax = 83.339 
            text = "" 
