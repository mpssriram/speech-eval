    item [2]:
        class = "IntervalTier" 
        name = "sentences" 
        xmin = 0 
        xmax = 91.484 
        intervals: size = 49 
        intervals [1]:
            xmin = 0 
            xmax = 0.14 
            text = "" 
        intervals [2]:
            xmin = 0.14 
            xmax = 4.19 
            text = "O Captain! my Captain! our fearful trip is done," 
        intervals [3]:
            xmin = 4.19 
            xmax = 4.75 
            text = "" 
        intervals [4]:
            xmin = 4.75 
            xmax = 8.76 
            text = "The ship has weather’d every rack, the prize we sought is won," 
        intervals [5]:
            xmin = 8.76 
            xmax = 9.41 
            text = "" 
        intervals [6]:
            xmin = 9.41 
            xmax = 13.09 
            text = "The port is near, the bells I hear, the people all exulting," 
        intervals [7]:
            xmin = 13.09 
            xmax = 13.71 
            text = "" 
        intervals [8]:
            xmin = 13.71 
            xmax = 18.03 
            text = "While follow eyes the steady keel, the vessel grim and daring;" 
        intervals [9]:
            xmin = 18.03 
            xmax = 18.77 
            text = "" 
        intervals [10]:
            xmin = 18.77 
            xmax = 20.87 
            text = "But O heart! heart! heart!" 
        intervals [11]:
            xmin = 20.87 
            xmax = 21.55 
            text = "" 
        intervals [12]:
            xmin = 21.55 
            xmax = 22.57 
            text = "O the bleeding drops of red," 
        intervals [13]:
            xmin = 22.57 
            xmax = 23.24 
            text = "" 
        intervals [14]:
            xmin = 23.24 
            xmax = 25.31 
            text = "Where on the deck my Captain lies," 
        intervals [15]:
            xmin = 25.31 
            xmax = 25.67 
            text = "" 
        intervals [16]:
            xmin = 25.67 
            xmax = 27.23 
            text = "Fallen cold and dead." 
        intervals [17]:
            xmin = 27.23 
            xmax = 28.14 
            text = "" 
        intervals [18]:
            xmin = 28.14 
            xmax = 32.23 
            text = "O Captain! my Captain! rise up and hear the bells;" 
        intervals [19]:
            xmin = 32.23 
            xmax = 32.78 
            text = "" 
        intervals [20]:
            xmin = 32.78 
            xmax = 36.81 
            text = "Rise up- for you the flag is flung- for you the bugle trills," 
        intervals [21]:
            xmin = 36.81 
            xmax = 37.48 
            text = "" 
        intervals [22]:
            xmin = 37.48 
            xmax = 41.56 
            text = "For you bouquets and ribbon’d wreaths- for you the shores a-crowding," 
        intervals [23]:
            xmin = 41.56 
            xmax = 42.1 
            text = "" 
        intervals [24]:
            xmin = 42.1 
            xmax = 45.97 
            text = "For you they call, the swaying mass, their eager faces turning;" 
        intervals [25]:
            xmin = 45.97 
            xmax = 46.54 
            text = "" 
        intervals [26]:
            xmin = 46.54 
            xmax = 48.37 
            text = "Here Captain! dear father!" 
        intervals [27]:
            xmin = 48.37 
            xmax = 48.83 
            text = "" 
        intervals [28]:
            xmin = 48.83 
            xmax = 50.34 
            text = "This arm beneath your head!" 
        intervals [29]:
            xmin = 50.34 
            xmax = 50.91 
            text = "" 
        intervals [30]:
            xmin = 50.91 
            xmax = 52.73 
            text = "It is some dream that on the deck," 
        intervals [31]:
            xmin = 52.73 
            xmax = 53.09 
            text = "" 
        intervals [32]:
            xmin = 53.09 
            xmax = 54.78 
            text = "You’ve fallen cold and dead." 
        intervals [33]:
            xmin = 54.78 
            xmax = 56.48 
            text = "" 
        intervals [34]:
            xmin = 56.48 
            xmax = 60.44 
            text = "My Captain does not answer, his lips are pale and still," 
        intervals [35]:
            xmin = 60.44 
            xmax = 61.18 
            text = "" 
        intervals [36]:
            xmin = 61.18 
            xmax = 65.42 
            text = "My father does not feel my arm, he has no pulse nor will," 
        intervals [37]:
            xmin = 65.42 
            xmax = 66.19 
            text = "" 
        intervals [38]:
            xmin = 66.19 
            xmax = 70.39 
            text = "The ship is anchor’d safe and sound, its voyage closed and done," 
        intervals [39]:
            xmin = 70.39 
            xmax = 71.13 
            text = "" 
        intervals [40]:
            xmin = 71.13 
            xmax = 74.95 
            text = "From fearful trip the victor ship comes in with object won;" 
        intervals [41]:
            xmin = 74.95 
            xmax = 75.66 
            text = "" 
        intervals [42]:
            xmin = 75.66 
            xmax = 78.53 
            text = "Exult O shores, and ring O bells!" 
        intervals [43]:
            xmin = 78.53 
            xmax = 79.12 
            text = "" 
        intervals [44]:
            xmin = 79.12 
            xmax = 80.88 
            text = "But I with mournful tread," 
        intervals [45]:
            xmin = 80.88 
            xmax = 81.59 
            text = "" 
        intervals [46]:
            xmin = 81.59 
            xmax = 83.73 
            text = "Walk the deck my Captain lies," 
        intervals [47]:
            xmin = 83.73 
            xmax = 84.17 
            text = "" 
        intervals [48]:
            xmin = 84.17 
            xmax = 91.04 
            text = "Fallen cold and dead." 
        intervals [49]:
            xmin = 91.04 
            xmax = 91.484 
            text = "" 
