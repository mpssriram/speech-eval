    item [2]:
        class = "IntervalTier" 
        name = "sentences" 
        xmin = 0 
        xmax = 81.184 
        intervals: size = 49 
        intervals [1]:
            xmin = 0 
            xmax = 0.14 
            text = "" 
        intervals [2]:
            xmin = 0.14 
            xmax = 3.43 
            text = "O Captain! my Captain! our fearful trip is done," 
        intervals [3]:
            xmin = 3.43 
            xmax = 3.7 
            text = "" 
        intervals [4]:
            xmin = 3.7 
            xmax = 6.92 
            text = "The ship has weather’d every rack, the prize we sought is won," 
        intervals [5]:
            xmin = 6.92 
            xmax = 7.52 
            text = "" 
        intervals [6]:
            xmin = 7.52 
            xmax = 11.42 
            text = "The port is near, the bells I hear, the people all exulting," 
        intervals [7]:
            xmin = 11.42 
            xmax = 11.91 
            text = "" 
        intervals [8]:
            xmin = 11.91 
            xmax = 15.87 
            text = "While follow eyes the steady keel, the vessel grim and daring;" 
        intervals [9]:
            xmin = 15.87 
            xmax = 16.37 
            text = "" 
        intervals [10]:
            xmin = 16.37 
            xmax = 18.39 
            text = "But O heart! heart! heart!" 
        intervals [11]:
            xmin = 18.39 
            xmax = 18.68 
            text = "" 
        intervals [12]:
            xmin = 18.68 
            xmax = 20.45 
            text = "O the bleeding drops of red," 
        intervals [13]:
            xmin = 20.45 
            xmax = 20.82 
            text = "" 
        intervals [14]:
            xmin = 20.82 
            xmax = 22.85 
            text = "Where on the deck my Captain lies," 
        intervals [15]:
            xmin = 22.85 
            xmax = 23.13 
            text = "" 
        intervals [16]:
            xmin = 23.13 
            xmax = 24.72 
            text = "Fallen cold and dead." 
        intervals [17]:
            xmin = 24.72 
            xmax = 25.88 
            text = "" 
        intervals [18]:
            xmin = 25.88 
            xmax = 29.16 
            text = "O Captain! my Captain! rise up and hear the bells;" 
        intervals [19]:
            xmin = 29.16 
            xmax = 29.69 
            text = "" 
        intervals [20]:
            xmin = 29.69 
            xmax = 34.06 
            text = "Rise up- for you the flag is flung- for you the bugle trills," 
        intervals [21]:
            xmin = 34.06 
            xmax = 34.36 
            text = "" 
        intervals [22]:
            xmin = 34.36 
            xmax = 38.61 
            text = "For you bouquets and ribbon’d wreaths- for you the shores a-crowding," 
        intervals [23]:
            xmin = 38.61 
            xmax = 39.14 
            text = "" 
        intervals [24]:
            xmin = 39.14 
            xmax = 43.37 
            text = "For you they call, the swaying mass, their eager faces turning;" 
        intervals [25]:
            xmin = 43.37 
            xmax = 44.01 
            text = "" 
        intervals [26]:
            xmin = 44.01 
            xmax = 45.96 
            text = "Here Captain! dear father!" 
        intervals [27]:
            xmin = 45.96 
            xmax = 46.27 
            text = "" 
        intervals [28]:
            xmin = 46.27 
            xmax = 47.81 
            text = "This arm beneath your head!" 
        intervals [29]:
            xmin = 47.81 
            xmax = 48.34 
            text = "" 
        intervals [30]:
            xmin = 48.34 
            xmax = 50.32 
            text = "It is some dream that on the deck," 
        intervals [31]:
            xmin = 50.32 
            xmax = 50.63 
            text = "" 
        intervals [32]:
            xmin = 50.63 
            xmax = 52.39 
            text = "You’ve fallen cold and dead." 
        intervals [33]:
            xmin = 52.39 
            xmax = 53.63 
            text = "" 
        intervals [34]:
            xmin = 53.63 
            xmax = 57.15 
            text = "My Captain does not answer, his lips are pale and still," 
        intervals [35]:
            xmin = 57.15 
            xmax = 57.81 
            text = "" 
        intervals [36]:
            xmin = 57.81 
            xmax = 61.72 
            text = "My father does not feel my arm, he has no pulse nor will," 
        intervals [37]:
            xmin = 61.72 
            xmax = 62.43 
            text = "" 
        intervals [38]:
            xmin = 62.43 
            xmax = 66.37 
            text = "The ship is anchor’d safe and sound, its voyage closed and done," 
        intervals [39]:
            xmin = 66.37 
            xmax = 66.83 
            text = "" 
        intervals [40]:
            xmin = 66.83 
            xmax = 70.86 
            text = "From fearful trip the victor ship comes in with object won;" 
        intervals [41]:
            xmin = 70.86 
            xmax = 71.57 
            text = "" 
        intervals [42]:
            xmin = 71.57 
            xmax = 74.17 
            text = "Exult O shores, and ring O bells!" 
        intervals [43]:
            xmin = 74.17 
            xmax = 74.61 
            text = "" 
        intervals [44]:
            xmin = 74.61 
            xmax = 76.27 
            text = "But I with mournful tread," 
        intervals [45]:
            xmin = 76.27 
            xmax = 76.7 
            text = "" 
        intervals [46]:
            xmin = 76.7 
            xmax = 78.8 
            text = "Walk the deck my Captain lies," 
        intervals [47]:
            xmin = 78.8 
            xmax = 79.05 
            text = "" 
        intervals [48]:
            xmin = 79.05 
            xmax = 80.97 
            text = "Fallen cold and dead." 
        intervals [49]:
            xmin = 80.97 
            xmax = 81.184 
            text = "" 
