    item [2]:
        class = "IntervalTier" 
        name = "sentences" 
        xmin = 0 
        xmax = 112.143 
        intervals: size = 47 
        intervals [1]:
            xmin = 0 
            xmax = 7.46 
            text = "two thousand and six O Captain! my Captain! our fearful trip is done," 
        intervals [2]:
            xmin = 7.46 
            xmax = 8.19 
            text = "" 
        intervals [3]:
            xmin = 8.19 
            xmax = 12.23 
            text = "The ship has weather’d every rack, the prize we sought is won," 
        intervals [4]:
            xmin = 12.23 
            xmax = 13.05 
            text = "" 
        intervals [5]:
            xmin = 13.05 
            xmax = 17.1 
            text = "The port is near, the bells I hear, the people all exulting," 
        intervals [6]:
            xmin = 17.1 
            xmax = 17.79 
            text = "" 
        intervals [7]:
            xmin = 17.79 
            xmax = 22.66 
            text = "While follow eyes the steady keel, the vessel grim and daring;" 
        intervals [8]:
            xmin = 22.66 
            xmax = 23.65 
            text = "" 
        intervals [9]:
            xmin = 23.65 
            xmax = 26.53 
            text = "But O heart! heart! heart!" 
        intervals [10]:
            xmin = 26.53 
            xmax = 27.2 
            text = "" 
        intervals [11]:
            xmin = 27.2 
            xmax = 29.06 
            text = "O the bleeding drops of red," 
        intervals [12]:
            xmin = 29.06 
            xmax = 29.64 
            text = "" 
        intervals [13]:
            xmin = 29.64 
            xmax = 31.73 
            text = "Where on the deck my Captain lies," 
        intervals [14]:
            xmin = 31.73 
            xmax = 33.48 
            text = "Fallen cold and dead." 
        intervals [15]:
            xmin = 33.48 
            xmax = 34.56 
            text = "" 
        intervals [16]:
            xmin = 34.56 
            xmax = 37.73 
            text = "O Captain! my Captain! rise up and hear the bells;" 
        intervals [17]:
            xmin = 37.73 
            xmax = 38.21 
            text = "" 
        intervals [18]:
            xmin = 38.21 
            xmax = 43.42 
            text = "Rise up- for you the flag is flung- for you the bugle trills," 
        intervals [19]:
            xmin = 43.42 
            xmax = 43.85 
            text = "" 
        intervals [20]:
            xmin = 43.85 
            xmax = 48.75 
            text = "For you bouquets and ribbon’d wreaths- for you the shores a-crowding," 
        intervals [21]:
            xmin = 48.75 
            xmax = 49.56 
            text = "" 
        intervals [22]:
            xmin = 49.56 
            xmax = 53.98 
            text = "For you they call, the swaying mass, their eager faces turning;" 
        intervals [23]:
            xmin = 53.98 
            xmax = 54.66 
            text = "" 
        intervals [24]:
            xmin = 54.66 
            xmax = 57.37 
            text = "Here Captain! dear father!" 
        intervals [25]:
            xmin = 57.37 
            xmax = 58.04 
            text = "" 
        intervals [26]:
            xmin = 58.04 
            xmax = 59.94 
            text = "This arm beneath your head!" 
        intervals [27]:
            xmin = 59.94 
            xmax = 60.67 
            text = "" 
        intervals [28]:
            xmin = 60.67 
            xmax = 63.47 
            text = "It is some dream that on the deck," 
        intervals [29]:
            xmin = 63.47 
            xmax = 64.14 
            text = "" 
        intervals [30]:
            xmin = 64.14 
            xmax = 66.69 
            text = "You’ve fallen cold and dead." 
        intervals [31]:
            xmin = 66.69 
            xmax = 68.45 
            text = "" 
        intervals [32]:
            xmin = 68.45 
            xmax = 73.57 
            text = "My Captain does not answer, his lips are pale and still," 
        intervals [33]:
            xmin = 73.57 
            xmax = 74.73 
            text = "" 
        intervals [34]:
            xmin = 74.73 
            xmax = 83.2 
            text = "My father does not feel my arm, he has no pulse nor will," 
        intervals [35]:
            xmin = 83.2 
            xmax = 84.34 
            text = "" 
        intervals [36]:
            xmin = 84.34 
            xmax = 90.08 
            text = "The ship is anchor’d safe and sound, its voyage closed and done," 
        intervals [37]:
            xmin = 90.08 
            xmax = 91.11 
            text = "" 
        intervals [38]:
            xmin = 91.11 
            xmax = 96.89 
            text = "From fearful trip the victor ship comes in with object won;" 
        intervals [39]:
            xmin = 96.89 
            xmax = 98.16 
            text = "" 
        intervals [40]:
            xmin = 98.16 
            xmax = 102.01 
            text = "Exult O shores, and ring O bells!" 
        intervals [41]:
            xmin = 102.01 
            xmax = 102.65 
            text = "" 
        intervals [42]:
            xmin = 102.65 
            xmax = 105.49 
            text = "But I with mournful tread," 
        intervals [43]:
            xmin = 105.49 
            xmax = 106.24 
            text = "" 
        intervals [44]:
            xmin = 106.24 
            xmax = 108.86 
            text = "Walk the deck my Captain lies," 
        intervals [45]:
            xmin = 108.86 
            xmax = 109.58 
            text = "" 
        intervals [46]:
            xmin = 109.58 
            xmax = 111.93 
            text = "Fallen cold and dead." 
        intervals [47]:
            xmin = 111.93 
            xmax = 112.143 
            text = "" 
