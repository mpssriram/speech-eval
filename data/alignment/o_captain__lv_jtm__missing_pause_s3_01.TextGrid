    item [2]:
        class = "IntervalTier" 
        name = "sentences" 
        xmin = 0 
        xmax = 96.501 
        intervals: size = 48 
        intervals [1]:
            xmin = 0 
            xmax = 0.13 
            text = "" 
        intervals [2]:
            xmin = 0.13 
            xmax = 3.92 
            text = "O Captain! my Captain! our fearful trip is done," 
        intervals [3]:
            xmin = 3.92 
            xmax = 4.28 
            text = "" 
        intervals [4]:
            xmin = 4.28 
            xmax = 8.18 
            text = "The ship has weather’d every rack, the prize we sought is won," 
        intervals [5]:
            xmin = 8.18 
            xmax = 9.12 
            text = "" 
        intervals [6]:
            xmin = 9.12 
            xmax = 13.23 
            text = "The port is near, the bells I hear, the people all exulting," 
        intervals [7]:
            xmin = 13.23 
            xmax = 13.67 
            text = "" 
        intervals [8]:
            xmin = 13.67 
            xmax = 18.3 
            text = "While follow eyes the steady keel, the vessel grim and daring;" 
        intervals [9]:
            xmin = 18.3 
            xmax = 18.91 
            text = "" 
        intervals [10]:
            xmin = 18.91 
            xmax = 22.4 
            text = "But O heart! heart! heart!" 
        intervals [11]:
            xmin = 22.4 
            xmax = 23.38 
            text = "" 
        intervals [12]:
            xmin = 23.38 
            xmax = 25.78 
            text = "O the bleeding drops of red," 
        intervals [13]:
            xmin = 25.78 
            xmax = 26.63 
            text = "" 
        intervals [14]:
            xmin = 26.63 
            xmax = 29.08 
            text = "Where on the deck my Captain lies," 
        intervals [15]:
            xmin = 29.08 
            xmax = 29.4 
            text = "" 
        intervals [16]:
            xmin = 29.4 
            xmax = 31.31 
            text = "Fallen cold and dead." 
        intervals [17]:
            xmin = 31.31 
            xmax = 33.15 
            text = "" 
        intervals [18]:
            xmin = 33.15 
            xmax = 36.88 
            text = "O Captain! my Captain! rise up and hear the bells;" 
        intervals [19]:
            xmin = 36.88 
            xmax = 37.23 
            text = "" 
        intervals [20]:
            xmin = 37.23 
            xmax = 41.7 
            text = "Rise up- for you the flag is flung- for you the bugle trills," 
        intervals [21]:
            xmin = 41.7 
            xmax = 42.14 
            text = "" 
        intervals [22]:
            xmin = 42.14 
            xmax = 46.67 
            text = "For you bouquets and ribbon’d wreaths- for you the shores a-crowding," 
        intervals [23]:
            xmin = 46.67 
            xmax = 47.03 
            text = "" 
        intervals [24]:
            xmin = 47.03 
            xmax = 51.32 
            text = "For you they call, the swaying mass, their eager faces turning;" 
        intervals [25]:
            xmin = 51.32 
            xmax = 52.15 
            text = "" 
        intervals [26]:
            xmin = 52.15 
            xmax = 54.17 
            text = "Here Captain! dear father!" 
        intervals [27]:
            xmin = 54.17 
            xmax = 55.82 
            text = "This arm beneath your head!" 
        intervals [28]:
            xmin = 55.82 
            xmax = 56.27 
            text = "" 
        intervals [29]:
            xmin = 56.27 
            xmax = 58.52 
            text = "It is some dream that on the deck," 
        intervals [30]:
            xmin = 58.52 
            xmax = 58.83 
            text = "" 
        intervals [31]:
            xmin = 58.83 
            xmax = 60.69 
            text = "You’ve fallen cold and dead." 
        intervals [32]:
            xmin = 60.69 
            xmax = 63.4 
            text = "" 
        intervals [33]:
            xmin = 63.4 
            xmax = 68.03 
            text = "My Captain does not answer, his lips are pale and still," 
        intervals [34]:
            xmin = 68.03 
            xmax = 68.96 
            text = "" 
        intervals [35]:
            xmin = 68.96 
            xmax = 74.04 
            text = "My father does not feel my arm, he has no pulse nor will," 
        intervals [36]:
            xmin = 74.04 
            xmax = 75.12 
            text = "" 
        intervals [37]:
            xmin = 75.12 
            xmax = 79.23 
            text = "The ship is anchor’d safe and sound, its voyage closed and done," 
        intervals [38]:
            xmin = 79.23 
            xmax = 79.59 
            text = "" 
        intervals [39]:
            xmin = 79.59 
            xmax = 83.88 
            text = "From fearful trip the victor ship comes in with object won;" 
        intervals [40]:
            xmin = 83.88 
            xmax = 85.11 
            text = "" 
        intervals [41]:
            xmin = 85.11 
            xmax = 87.9 
            text = "Exult O shores, and ring O bells!" 
        intervals [42]:
            xmin = 87.9 
            xmax = 88.41 
            text = "" 
        intervals [43]:
            xmin = 88.41 
            xmax = 90.46 
            text = "But I with mournful tread," 
        intervals [44]:
            xmin = 90.46 
            xmax = 91.37 
            text = "" 
        intervals [45]:
            xmin = 91.37 
            xmax = 93.75 
            text = "Walk the deck my Captain lies," 
        intervals [46]:
            xmin = 93.75 
            xmax = 93.88 
            text = "" 
        intervals [47]:
            xmin = 93.88 
            xmax = 96.42 
            text = "Fallen cold and dead." 
        intervals [48]:
            xmin = 96.42 
            xmax = 96.501 
            text = "" 
