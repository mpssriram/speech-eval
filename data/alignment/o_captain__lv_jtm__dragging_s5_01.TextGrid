    item [2]:
        class = "IntervalTier" 
        name = "sentences" 
        xmin = 0 
        xmax = 101.318 
        intervals: size = 48 
        intervals [1]:
            xmin = 0 
            xmax = 0.13 
            text = "" 
        intervals [2]:
            xmin = 0.13 
            xmax = 3.92 
            text = "O Captain! my Captain! our fearful trip is done," 
        intervals [3]:
            xmin = 3.92 
            xmax = 4.28 
            text = "" 
        intervals [4]:
            xmin = 4.28 
            xmax = 8.18 
            text = "The ship has weather’d every rack, the prize we sought is won," 
        intervals [5]:
            xmin = 8.18 
            xmax = 9.1 
            text = "" 
        intervals [6]:
            xmin = 9.1 
            xmax = 17.28 
            text = "The port is near, the bells I hear, the people all exulting," 
        intervals [7]:
            xmin = 17.28 
            xmax = 17.78 
            text = "" 
        intervals [8]:
            xmin = 17.78 
            xmax = 22.41 
            text = "While follow eyes the steady keel, the vessel grim and daring;" 
        intervals [9]:
            xmin = 22.41 
            xmax = 23.72 
            text = "" 
        intervals [10]:
            xmin = 23.72 
            xmax = 27.2 
            text = "But O heart! heart! heart!" 
        intervals [11]:
            xmin = 27.2 
            xmax = 28.2 
            text = "" 
        intervals [12]:
            xmin = 28.2 
            xmax = 30.6 
            text = "O the bleeding drops of red," 
        intervals [13]:
            xmin = 30.6 
            xmax = 31.45 
            text = "" 
        intervals [14]:
            xmin = 31.45 
            xmax = 33.88 
            text = "Where on the deck my Captain lies," 
        intervals [15]:
            xmin = 33.88 
            xmax = 34.22 
            text = "" 
        intervals [16]:
            xmin = 34.22 
            xmax = 36.13 
            text = "Fallen cold and dead." 
        intervals [17]:
            xmin = 36.13 
            xmax = 37.97 
            text = "" 
        intervals [18]:
            xmin = 37.97 
            xmax = 41.69 
            text = "O Captain! my Captain! rise up and hear the bells;" 
        intervals [19]:
            xmin = 41.69 
            xmax = 42.05 
            text = "" 
        intervals [20]:
            xmin = 42.05 
            xmax = 46.51 
            text = "Rise up- for you the flag is flung- for you the bugle trills," 
        intervals [21]:
            xmin = 46.51 
            xmax = 46.96 
            text = "" 
        intervals [22]:
            xmin = 46.96 
            xmax = 51.49 
            text = "For you bouquets and ribbon’d wreaths- for you the shores a-crowding," 
        intervals [23]:
            xmin = 51.49 
            xmax = 51.85 
            text = "" 
        intervals [24]:
            xmin = 51.85 
            xmax = 56.14 
            text = "For you they call, the swaying mass, their eager faces turning;" 
        intervals [25]:
            xmin = 56.14 
            xmax = 56.96 
            text = "" 
        intervals [26]:
            xmin = 56.96 
            xmax = 58.99 
            text = "Here Captain! dear father!" 
        intervals [27]:
            xmin = 58.99 
            xmax = 60.65 
            text = "This arm beneath your head!" 
        intervals [28]:
            xmin = 60.65 
            xmax = 61.09 
            text = "" 
        intervals [29]:
            xmin = 61.09 
            xmax = 63.34 
            text = "It is some dream that on the deck," 
        intervals [30]:
            xmin = 63.34 
            xmax = 63.65 
            text = "" 
        intervals [31]:
            xmin = 63.65 
            xmax = 65.51 
            text = "You’ve fallen cold and dead." 
        intervals [32]:
            xmin = 65.51 
            xmax = 68.22 
            text = "" 
        intervals [33]:
            xmin = 68.22 
            xmax = 72.84 
            text = "My Captain does not answer, his lips are pale and still," 
        intervals [34]:
            xmin = 72.84 
            xmax = 73.78 
            text = "" 
        intervals [35]:
            xmin = 73.78 
            xmax = 78.91 
            text = "My father does not feel my arm, he has no pulse nor will," 
        intervals [36]:
            xmin = 78.91 
            xmax = 79.94 
            text = "" 
        intervals [37]:
            xmin = 79.94 
            xmax = 84.05 
            text = "The ship is anchor’d safe and sound, its voyage closed and done," 
        intervals [38]:
            xmin = 84.05 
            xmax = 84.4 
            text = "" 
        intervals [39]:
            xmin = 84.4 
            xmax = 88.69 
            text = "From fearful trip the victor ship comes in with object won;" 
        intervals [40]:
            xmin = 88.69 
            xmax = 89.93 
            text = "" 
        intervals [41]:
            xmin = 89.93 
            xmax = 92.71 
            text = "Exult O shores, and ring O bells!" 
        intervals [42]:
            xmin = 92.71 
            xmax = 93.23 
            text = "" 
        intervals [43]:
            xmin = 93.23 
            xmax = 95.27 
            text = "But I with mournful tread," 
        intervals [44]:
            xmin = 95.27 
            xmax = 96.19 
            text = "" 
        intervals [45]:
            xmin = 96.19 
            xmax = 98.56 
            text = "Walk the deck my Captain lies," 
        intervals [46]:
            xmin = 98.56 
            xmax = 98.66 
            text = "" 
        intervals [47]:
            xmin = 98.66 
            xmax = 101.22 
            text = "Fallen cold and dead." 
        intervals [48]:
            xmin = 101.22 
            xmax = 101.318 
            text = "" 
