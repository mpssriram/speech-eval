    item [2]:
        class = "IntervalTier" 
        name = "sentences" 
        xmin = 0 
        xmax = 85.036 
        intervals: size = 49 
        intervals [1]:
            xmin = 0 
            xmax = 0.13 
            text = "" 
        intervals [2]:
            xmin = 0.13 
            xmax = 2.83 
            text = "O Captain! my Captain! our fearful trip is done," 
        intervals [3]:
            xmin = 2.83 
            xmax = 3.41 
            text = "" 
        intervals [4]:
            xmin = 3.41 
            xmax = 6.9 
            text = "The ship has weather’d every rack, the prize we sought is won," 
        intervals [5]:
            xmin = 6.9 
            xmax = 7.37 
            text = "" 
        intervals [6]:
            xmin = 7.37 
            xmax = 10.89 
            text = "The port is near, the bells I hear, the people all exulting," 
        intervals [7]:
            xmin = 10.89 
            xmax = 11.55 
            text = "" 
        intervals [8]:
            xmin = 11.55 
            xmax = 14.75 
            text = "While follow eyes the steady keel, the vessel grim and daring;" 
        intervals [9]:
            xmin = 14.75 
            xmax = 15.67 
            text = "" 
        intervals [10]:
            xmin = 15.67 
            xmax = 17.7 
            text = "But O heart! heart! heart!" 
        intervals [11]:
            xmin = 17.7 
            xmax = 18.26 
            text = "" 
        intervals [12]:
            xmin = 18.26 
            xmax = 19.96 
            text = "O the bleeding drops of red," 
        intervals [13]:
            xmin = 19.96 
            xmax = 20.21 
            text = "" 
        intervals [14]:
            xmin = 20.21 
            xmax = 22.21 
            text = "Where on the deck my Captain lies," 
        intervals [15]:
            xmin = 22.21 
            xmax = 22.47 
            text = "" 
        intervals [16]:
            xmin = 22.47 
            xmax = 23.92 
            text = "Fallen cold and dead." 
        intervals [17]:
            xmin = 23.92 
            xmax = 25.03 
            text = "" 
        intervals [18]:
            xmin = 25.03 
            xmax = 27.92 
            text = "O Captain! my Captain! rise up and hear the bells;" 
        intervals [19]:
            xmin = 27.92 
            xmax = 28.27 
            text = "" 
        intervals [20]:
            xmin = 28.27 
            xmax = 31.68 
            text = "Rise up- for you the flag is flung- for you the bugle trills," 
        intervals [21]:
            xmin = 31.68 
            xmax = 32.22 
            text = "" 
        intervals [22]:
            xmin = 32.22 
            xmax = 36.28 
            text = "For you bouquets and ribbon’d wreaths- for you the shores a-crowding," 
        intervals [23]:
            xmin = 36.28 
            xmax = 36.84 
            text = "" 
        intervals [24]:
            xmin = 36.84 
            xmax = 40.44 
            text = "For you they call, the swaying mass, their eager faces turning;" 
        intervals [25]:
            xmin = 40.44 
            xmax = 41.07 
            text = "" 
        intervals [26]:
            xmin = 41.07 
            xmax = 42.83 
            text = "Here Captain! dear father!" 
        intervals [27]:
            xmin = 42.83 
            xmax = 43.32 
            text = "" 
        intervals [28]:
            xmin = 43.32 
            xmax = 44.67 
            text = "This arm beneath your head!" 
        intervals [29]:
            xmin = 44.67 
            xmax = 45.27 
            text = "" 
        intervals [30]:
            xmin = 45.27 
            xmax = 47.08 
            text = "It is some dream that on the deck," 
        intervals [31]:
            xmin = 47.08 
            xmax = 47.33 
            text = "" 
        intervals [32]:
            xmin = 47.33 
            xmax = 48.98 
            text = "You’ve fallen cold and dead." 
        intervals [33]:
            xmin = 48.98 
            xmax = 49.85 
            text = "" 
        intervals [34]:
            xmin = 49.85 
            xmax = 53.14 
            text = "My Captain does not answer, his lips are pale and still," 
        intervals [35]:
            xmin = 53.14 
            xmax = 53.64 
            text = "" 
        intervals [36]:
            xmin = 53.64 
            xmax = 57.51 
            text = "My father does not feel my arm, he has no pulse nor will," 
        intervals [37]:
            xmin = 57.51 
            xmax = 58.12 
            text = "" 
        intervals [38]:
            xmin = 58.12 
            xmax = 61.45 
            text = "The ship is anchor’d safe and sound, its voyage closed and done," 
        intervals [39]:
            xmin = 61.45 
            xmax = 61.82 
            text = "" 
        intervals [40]:
            xmin = 61.82 
            xmax = 65.5 
            text = "From fearful trip the victor ship comes in with object won;" 
        intervals [41]:
            xmin = 65.5 
            xmax = 66.19 
            text = "" 
        intervals [42]:
            xmin = 66.19 
            xmax = 68.95 
            text = "Exult O shores, and ring O bells!" 
        intervals [43]:
            xmin = 68.95 
            xmax = 69.63 
            text = "" 
        intervals [44]:
            xmin = 69.63 
            xmax = 71.15 
            text = "But I with mournful tread," 
        intervals [45]:
            xmin = 71.15 
            xmax = 71.68 
            text = "" 
        intervals [46]:
            xmin = 71.68 
            xmax = 73.49 
            text = "Walk the deck my Captain lies," 
        intervals [47]:
            xmin = 73.49 
            xmax = 73.77 
            text = "" 
        intervals [48]:
            xmin = 73.77 
            xmax = 81.63 
            text = "Fallen cold and dead." 
        intervals [49]:
            xmin = 81.63 
            xmax = 85.036 
            text = "" 
