    item [2]:
        class = "IntervalTier" 
        name = "sentences" 
        xmin = 0 
        xmax = 99.483 
        intervals: size = 48 
        intervals [1]:
            xmin = 0 
            xmax = 0.05 
            text = "" 
        intervals [2]:
            xmin = 0.05 
            xmax = 3.9 
            text = "O Captain! my Captain! our fearful trip is done," 
        intervals [3]:
            xmin = 3.9 
            xmax = 4.53 
            text = "" 
        intervals [4]:
            xmin = 4.53 
            xmax = 7.64 
            text = "The ship has weather’d every rack, the prize we sought is won," 
        intervals [5]:
            xmin = 7.64 
            xmax = 8.56 
            text = "" 
        intervals [6]:
            xmin = 8.56 
            xmax = 12.62 
            text = "The port is near, the bells I hear, the people all exulting," 
        intervals [7]:
            xmin = 12.62 
            xmax = 13.06 
            text = "" 
        intervals [8]:
            xmin = 13.06 
            xmax = 18.29 
            text = "While follow eyes the steady keel, the vessel grim and daring;" 
        intervals [9]:
            xmin = 18.29 
            xmax = 20.06 
            text = "" 
        intervals [10]:
            xmin = 20.06 
            xmax = 23.65 
            text = "But O heart! heart! heart!" 
        intervals [11]:
            xmin = 23.65 
            xmax = 25.19 
            text = "" 
        intervals [12]:
            xmin = 25.19 
            xmax = 26.93 
            text = "O the bleeding drops of red," 
        intervals [13]:
            xmin = 26.93 
            xmax = 27.95 
            text = "" 
        intervals [14]:
            xmin = 27.95 
            xmax = 29.87 
            text = "Where on the deck my Captain lies," 
        intervals [15]:
            xmin = 29.87 
            xmax = 31.28 
            text = "Fallen cold and dead." 
        intervals [16]:
            xmin = 31.28 
            xmax = 33.28 
            text = "" 
        intervals [17]:
            xmin = 33.28 
            xmax = 36.86 
            text = "O Captain! my Captain! rise up and hear the bells;" 
        intervals [18]:
            xmin = 36.86 
            xmax = 37.12 
            text = "" 
        intervals [19]:
            xmin = 37.12 
            xmax = 40.64 
            text = "Rise up- for you the flag is flung- for you the bugle trills," 
        intervals [20]:
            xmin = 40.64 
            xmax = 41.28 
            text = "" 
        intervals [21]:
            xmin = 41.28 
            xmax = 45.06 
            text = "For you bouquets and ribbon’d wreaths- for you the shores a-crowding," 
        intervals [22]:
            xmin = 45.06 
            xmax = 45.93 
            text = "" 
        intervals [23]:
            xmin = 45.93 
            xmax = 49.84 
            text = "For you they call, the swaying mass, their eager faces turning;" 
        intervals [24]:
            xmin = 49.84 
            xmax = 51.76 
            text = "" 
        intervals [25]:
            xmin = 51.76 
            xmax = 53.37 
            text = "Here Captain! dear father!" 
        intervals [26]:
            xmin = 53.37 
            xmax = 53.84 
            text = "" 
        intervals [27]:
            xmin = 53.84 
            xmax = 55.08 
            text = "This arm beneath your head!" 
        intervals [28]:
            xmin = 55.08 
            xmax = 55.92 
            text = "" 
        intervals [29]:
            xmin = 55.92 
            xmax = 57.7 
            text = "It is some dream that on the deck," 
        intervals [30]:
            xmin = 57.7 
            xmax = 57.85 
            text = "" 
        intervals [31]:
            xmin = 57.85 
            xmax = 59.13 
            text = "You’ve fallen cold and dead." 
        intervals [32]:
            xmin = 59.13 
            xmax = 61.72 
            text = "" 
        intervals [33]:
            xmin = 61.72 
            xmax = 65.91 
            text = "My Captain does not answer, his lips are pale and still," 
        intervals [34]:
            xmin = 65.91 
            xmax = 67.04 
            text = "" 
        intervals [35]:
            xmin = 67.04 
            xmax = 71.73 
            text = "My father does not feel my arm, he has no pulse nor will," 
        intervals [36]:
            xmin = 71.73 
            xmax = 73.56 
            text = "" 
        intervals [37]:
            xmin = 73.56 
            xmax = 77.82 
            text = "The ship is anchor’d safe and sound, its voyage closed and done," 
        intervals [38]:
            xmin = 77.82 
            xmax = 78.45 
            text = "" 
        intervals [39]:
            xmin = 78.45 
            xmax = 82.24 
            text = "From fearful trip the victor ship comes in with object won;" 
        intervals [40]:
            xmin = 82.24 
            xmax = 83.43 
            text = "" 
        intervals [41]:
            xmin = 83.43 
            xmax = 85.65 
            text = "Exult O shores, and ring O bells!" 
        intervals [42]:
            xmin = 85.65 
            xmax = 86.48 
            text = "" 
        intervals [43]:
            xmin = 86.48 
            xmax = 88.32 
            text = "But I with mournful tread," 
        intervals [44]:
            xmin = 88.32 
            xmax = 89.37 
            text = "" 
        intervals [45]:
            xmin = 89.37 
            xmax = 91.25 
            text = "Walk the deck my Captain lies," 
        intervals [46]:
            xmin = 91.25 
            xmax = 92.12 
            text = "" 
        intervals [47]:
            xmin = 92.12 
            xmax = 98.9 
            text = "Fallen cold and dead." 
        intervals [48]:
            xmin = 98.9 
            xmax = 99.483 
            text = "" 
