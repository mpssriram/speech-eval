    item [2]:
        class = "IntervalTier" 
        name = "sentences" 
        xmin = 0 
        xmax = 76.936 
        intervals: size = 34 
        intervals [1]:
            xmin = 0 
            xmax = 6.91 
            text = "Ladies and gentlemen, I'd planned to speak to you tonight to report on the state of the Union, but the events of the earlier today have led me to change those plans." 
        intervals [2]:
            xmin = 6.91 
            xmax = 7.36 
            text = "" 
        intervals [3]:
            xmin = 7.36 
            xmax = 9.23 
            text = "Today is a day for mourning and remembering." 
        intervals [4]:
            xmin = 9.23 
            xmax = 9.49 
            text = "" 
        intervals [5]:
            xmin = 9.49 
            xmax = 13.22 
            text = "Nancy and I are pained to the core by the tragedy of the shuttle Challenger." 
        intervals [6]:
            xmin = 13.22 
            xmax = 13.75 
            text = "" 
        intervals [7]:
            xmin = 13.75 
            xmax = 16.34 
            text = "We know we share this pain with all the people of our country." 
        intervals [8]:
            xmin = 16.34 
            xmax = 16.9 
            text = "" 
        intervals [9]:
            xmin = 16.9 
            xmax = 18.33 
            text = "This is truly a national loss." 
        intervals [10]:
            xmin = 18.33 
            xmax = 18.63 
            text = "" 
        intervals [11]:
            xmin = 18.63 
            xmax = 23.75 
            text = "Nineteen years ago, almost to the day, we lost three astronauts in a terrible accident on the ground." 
        intervals [12]:
            xmin = 23.75 
            xmax = 24.08 
            text = "" 
        intervals [13]:
            xmin = 24.08 
            xmax = 26.16 
            text = "But we've never lost an astronaut in a flight;" 
        intervals [14]:
            xmin = 26.16 
            xmax = 26.82 
            text = "" 
        intervals [15]:
            xmin = 26.82 
            xmax = 28.31 
            text = "We've never had a tragedy like this." 
        intervals [16]:
            xmin = 28.31 
            xmax = 28.63 
            text = "" 
        intervals [17]:
            xmin = 28.63 
            xmax = 31.77 
            text = "Perhaps we've forgotten the courage it took for the crew of the shuttle." 
        intervals [18]:
            xmin = 31.77 
            xmax = 32.88 
            text = "" 
        intervals [19]:
            xmin = 32.88 
            xmax = 37.64 
            text = "But they, the Challenger Seven, were aware of the dangers, but overcame them and did their jobs brilliantly." 
        intervals [20]:
            xmin = 37.64 
            xmax = 38.35 
            text = "" 
        intervals [21]:
            xmin = 38.35 
            xmax = 39.86 
            text = "We mourn the seven heroes:" 
        intervals [22]:
            xmin = 39.86 
            xmax = 40.22 
            text = "" 
        intervals [23]:
            xmin = 40.22 
            xmax = 48.01 
            text = "Michael Smith, Dick Scobee, Judith Resnik, Ronald McNair, Ellison Onizuka, Gregory Jarvis, and Christa McAuliffe." 
        intervals [24]:
            xmin = 48.01 
            xmax = 48.64 
            text = "" 
        intervals [25]:
            xmin = 48.64 
            xmax = 50.48 
            text = "We mourn their loss as a nation together." 
        intervals [26]:
            xmin = 50.48 
            xmax = 50.87 
            text = "" 
        intervals [27]:
            xmin = 50.87 
            xmax = 55.42 
            text = "For the families of the seven, we cannot bear, as you do, the full impact of this tragedy." 
        intervals [28]:
            xmin = 55.42 
            xmax = 56.44 
            text = "" 
        intervals [29]:
            xmin = 56.44 
            xmax = 60.89 
            text = "But we feel the loss, and we are thinking about you so much." 
        intervals [30]:
            xmin = 60.89 
            xmax = 62.12 
            text = "" 
        intervals [31]:
            xmin = 62.12 
            xmax = 72.15 
            text = "Your loved ones were daring and brave, and they had that special grace, that special spirit that says, ``Give me a challenge, and I'll meet it with joy.''" 
        intervals [32]:
            xmin = 72.15 
            xmax = 72.63 
            text = "" 
        intervals [33]:
            xmin = 72.63 
            xmax = 76.25 
            text = "They had a hunger to explore the universe and discover its truths." 
        intervals [34]:
            xmin = 76.25 
            xmax = 76.936 
            text = "" 
