    item [2]:
        class = "IntervalTier" 
        name = "sentences" 
        xmin = 0 
        xmax = 114.587 
        intervals: size = 48 
        intervals [1]:
            xmin = 0 
            xmax = 0.29 
            text = "" 
        intervals [2]:
            xmin = 0.29 
            xmax = 3.77 
            text = "O Captain! my Captain! our fearful trip is done," 
        intervals [3]:
            xmin = 3.77 
            xmax = 4.2 
            text = "" 
        intervals [4]:
            xmin = 4.2 
            xmax = 8.28 
            text = "The ship has weather’d every rack, the prize we sought is won," 
        intervals [5]:
            xmin = 8.28 
            xmax = 8.83 
            text = "" 
        intervals [6]:
            xmin = 8.83 
            xmax = 13.34 
            text = "The port is near, the bells I hear, the people all exulting," 
        intervals [7]:
            xmin = 13.34 
            xmax = 13.98 
            text = "" 
        intervals [8]:
            xmin = 13.98 
            xmax = 19.06 
            text = "While follow eyes the steady keel, the vessel grim and daring;" 
        intervals [9]:
            xmin = 19.06 
            xmax = 19.87 
            text = "" 
        intervals [10]:
            xmin = 19.87 
            xmax = 22.83 
            text = "But O heart! heart! heart!" 
        intervals [11]:
            xmin = 22.83 
            xmax = 23.53 
            text = "" 
        intervals [12]:
            xmin = 23.53 
            xmax = 26 
            text = "O the bleeding drops of red," 
        intervals [13]:
            xmin = 26 
            xmax = 26.54 
            text = "" 
        intervals [14]:
            xmin = 26.54 
            xmax = 29.38 
            text = "Where on the deck my Captain lies," 
        intervals [15]:
            xmin = 29.38 
            xmax = 29.75 
            text = "" 
        intervals [16]:
            xmin = 29.75 
            xmax = 31.48 
            text = "Fallen cold and dead." 
        intervals [17]:
            xmin = 31.48 
            xmax = 33.4 
            text = "" 
        intervals [18]:
            xmin = 33.4 
            xmax = 37.68 
            text = "O Captain! my Captain! rise up and hear the bells;" 
        intervals [19]:
            xmin = 37.68 
            xmax = 38.11 
            text = "" 
        intervals [20]:
            xmin = 38.11 
            xmax = 42.93 
            text = "Rise up- for you the flag is flung- for you the bugle trills," 
        intervals [21]:
            xmin = 42.93 
            xmax = 43.34 
            text = "" 
        intervals [22]:
            xmin = 43.34 
            xmax = 47.52 
            text = "For you bouquets and ribbon’d wreaths- for you the shores a-crowding," 
        intervals [23]:
            xmin = 47.52 
            xmax = 48.05 
            text = "" 
        intervals [24]:
            xmin = 48.05 
            xmax = 52.31 
            text = "For you they call, the swaying mass, their eager faces turning;" 
        intervals [25]:
            xmin = 52.31 
            xmax = 52.85 
            text = "" 
        intervals [26]:
            xmin = 52.85 
            xmax = 54.98 
            text = "Here Captain! dear father!" 
        intervals [27]:
            xmin = 54.98 
            xmax = 55.32 
            text = "" 
        intervals [28]:
            xmin = 55.32 
            xmax = 57.14 
            text = "This arm beneath your head!" 
        intervals [29]:
            xmin = 57.14 
            xmax = 57.65 
            text = "" 
        intervals [30]:
            xmin = 57.65 
            xmax = 61.56 
            text = "It is some dream that on the deck," 
        intervals [31]:
            xmin = 61.56 
            xmax = 63.48 
            text = "You’ve fallen cold and dead." 
        intervals [32]:
            xmin = 63.48 
            xmax = 65.14 
            text = "" 
        intervals [33]:
            xmin = 65.14 
            xmax = 69.72 
            text = "My Captain does not answer, his lips are pale and still," 
        intervals [34]:
            xmin = 69.72 
            xmax = 70.36 
            text = "" 
        intervals [35]:
            xmin = 70.36 
            xmax = 74.77 
            text = "My father does not feel my arm, he has no pulse nor will," 
        intervals [36]:
            xmin = 74.77 
            xmax = 75.49 
            text = "" 
        intervals [37]:
            xmin = 75.49 
            xmax = 80.19 
            text = "The ship is anchor’d safe and sound, its voyage closed and done," 
        intervals [38]:
            xmin = 80.19 
            xmax = 80.89 
            text = "" 
        intervals [39]:
            xmin = 80.89 
            xmax = 85.22 
            text = "From fearful trip the victor ship comes in with object won;" 
        intervals [40]:
            xmin = 85.22 
            xmax = 86.15 
            text = "" 
        intervals [41]:
            xmin = 86.15 
            xmax = 89.33 
            text = "Exult O shores, and ring O bells!" 
        intervals [42]:
            xmin = 89.33 
            xmax = 89.65 
            text = "" 
        intervals [43]:
            xmin = 89.65 
            xmax = 91.67 
            text = "But I with mournful tread," 
        intervals [44]:
            xmin = 91.67 
            xmax = 92.64 
            text = "" 
        intervals [45]:
            xmin = 92.64 
            xmax = 95.14 
            text = "Walk the deck my Captain lies," 
        intervals [46]:
            xmin = 95.14 
            xmax = 95.86 
            text = "" 
        intervals [47]:
            xmin = 95.86 
            xmax = 105.54 
            text = "Fallen cold and dead." 
        intervals [48]:
            xmin = 105.54 
            xmax = 114.587 
            text = "" 
