    item [2]:
        class = "IntervalTier" 
        name = "sentences" 
        xmin = 0 
        xmax = 86.784 
        intervals: size = 48 
        intervals [1]:
            xmin = 0 
            xmax = 0.14 
            text = "" 
        intervals [2]:
            xmin = 0.14 
            xmax = 2.91 
            text = "O Captain! my Captain! our fearful trip is done," 
        intervals [3]:
            xmin = 2.91 
            xmax = 3.55 
            text = "" 
        intervals [4]:
            xmin = 3.55 
            xmax = 7.64 
            text = "The ship has weather’d every rack, the prize we sought is won," 
        intervals [5]:
            xmin = 7.64 
            xmax = 8.16 
            text = "" 
        intervals [6]:
            xmin = 8.16 
            xmax = 12.01 
            text = "The port is near, the bells I hear, the people are exulting," 
        intervals [7]:
            xmin = 12.01 
            xmax = 12.83 
            text = "" 
        intervals [8]:
            xmin = 12.83 
            xmax = 17.01 
            text = "While follow eyes the steady keel, the vessel grim and daring;" 
        intervals [9]:
            xmin = 17.01 
            xmax = 17.39 
            text = "" 
        intervals [10]:
            xmin = 17.39 
            xmax = 19.87 
            text = "But O heart! heart! heart!" 
        intervals [11]:
            xmin = 19.87 
            xmax = 20.41 
            text = "" 
        intervals [12]:
            xmin = 20.41 
            xmax = 22.38 
            text = "O the bleeding drops of red," 
        intervals [13]:
            xmin = 22.38 
            xmax = 22.87 
            text = "" 
        intervals [14]:
            xmin = 22.87 
            xmax = 25 
            text = "Where on the deck my Captain lies," 
        intervals [15]:
            xmin = 25 
            xmax = 25.03 
            text = "" 
        intervals [16]:
            xmin = 25.03 
            xmax = 26.8 
            text = "Fallen cold and dead." 
        intervals [17]:
            xmin = 26.8 
            xmax = 27.78 
            text = "" 
        intervals [18]:
            xmin = 27.78 
            xmax = 30.95 
            text = "O Captain! my Captain! rise up and hear the bells;" 
        intervals [19]:
            xmin = 30.95 
            xmax = 31.32 
            text = "" 
        intervals [20]:
            xmin = 31.32 
            xmax = 36.04 
            text = "Rise up- for you the flag is flung- for you the bugle trills," 
        intervals [21]:
            xmin = 36.04 
            xmax = 36.3 
            text = "" 
        intervals [22]:
            xmin = 36.3 
            xmax = 41.27 
            text = "For you bouquets and ribbon’d wreaths- for you the shores a-crowding," 
        intervals [23]:
            xmin = 41.27 
            xmax = 41.78 
            text = "" 
        intervals [24]:
            xmin = 41.78 
            xmax = 46.06 
            text = "For you they call, the swaying mass, their eager faces turning;" 
        intervals [25]:
            xmin = 46.06 
            xmax = 46.9 
            text = "" 
        intervals [26]:
            xmin = 46.9 
            xmax = 48.39 
            text = "Here Captain! dear father!" 
        intervals [27]:
            xmin = 48.39 
            xmax = 48.43 
            text = "" 
        intervals [28]:
            xmin = 48.43 
            xmax = 49.9 
            text = "This arm beneath your head!" 
        intervals [29]:
            xmin = 49.9 
            xmax = 50.46 
            text = "" 
        intervals [30]:
            xmin = 50.46 
            xmax = 52.91 
            text = "It is some dream that on the deck," 
        intervals [31]:
            xmin = 52.91 
            xmax = 52.95 
            text = "" 
        intervals [32]:
            xmin = 52.95 
            xmax = 54.29 
            text = "You’ve fallen cold and dead." 
        intervals [33]:
            xmin = 54.29 
            xmax = 55.29 
            text = "" 
        intervals [34]:
            xmin = 55.29 
            xmax = 59.61 
            text = "My Captain does not answer, his lips are pale and still," 
        intervals [35]:
            xmin = 59.61 
            xmax = 64.14 
            text = "My father does not feel my arm, he has no pulse nor will," 
        intervals [36]:
            xmin = 64.14 
            xmax = 64.66 
            text = "" 
        intervals [37]:
            xmin = 64.66 
            xmax = 68.82 
            text = "The ship is anchor’d safe and sound, its voyage closed and done," 
        intervals [38]:
            xmin = 68.82 
            xmax = 69.3 
            text = "" 
        intervals [39]:
            xmin = 69.3 
            xmax = 73.26 
            text = "From fearful trip the victor ship comes in with object won;" 
        intervals [40]:
            xmin = 73.26 
            xmax = 74.03 
            text = "" 
        intervals [41]:
            xmin = 74.03 
            xmax = 76.94 
            text = "Exult O shores, and ring O bells!" 
        intervals [42]:
            xmin = 76.94 
            xmax = 77.35 
            text = "" 
        intervals [43]:
            xmin = 77.35 
            xmax = 80.26 
            text = "But I with mournful tread," 
        intervals [44]:
            xmin = 80.26 
            xmax = 81.06 
            text = "" 
        intervals [45]:
            xmin = 81.06 
            xmax = 83.23 
            text = "Walk the deck my Captain lies," 
        intervals [46]:
            xmin = 83.23 
            xmax = 83.89 
            text = "" 
        intervals [47]:
            xmin = 83.89 
            xmax = 86.52 
            text = "Fallen cold and dead. End" 
        intervals [48]:
            xmin = 86.52 
            xmax = 86.784 
            text = "" 
