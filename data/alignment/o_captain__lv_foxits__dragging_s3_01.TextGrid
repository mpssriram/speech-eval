    item [2]:
        class = "IntervalTier" 
        name = "sentences" 
        xmin = 0 
        xmax = 93.545 
        intervals: size = 49 
        intervals [1]:
            xmin = 0 
            xmax = 0.14 
            text = "" 
        intervals [2]:
            xmin = 0.14 
            xmax = 4.19 
            text = "O Captain! my Captain! our fearful trip is done," 
        intervals [3]:
            xmin = 4.19 
            xmax = 4.75 
            text = "" 
        intervals [4]:
            xmin = 4.75 
            xmax = 8.76 
            text = "The ship has weather’d every rack, the prize we sought is won," 
        intervals [5]:
            xmin = 8.76 
            xmax = 9.41 
            text = "" 
        intervals [6]:
            xmin = 9.41 
            xmax = 13.09 
            text = "The port is near, the bells I hear, the people all exulting," 
        intervals [7]:
            xmin = 13.09 
            xmax = 13.71 
            text = "" 
        intervals [8]:
            xmin = 13.71 
            xmax = 19.33 
            text = "While follow eyes the steady keel, the vessel grim and daring;" 
        intervals [9]:
            xmin = 19.33 
            xmax = 20.07 
            text = "" 
        intervals [10]:
            xmin = 20.07 
            xmax = 22.17 
            text = "But O heart! heart! heart!" 
        intervals [11]:
            xmin = 22.17 
            xmax = 22.85 
            text = "" 
        intervals [12]:
            xmin = 22.85 
            xmax = 24.62 
            text = "O the bleeding drops of red," 
        intervals [13]:
            xmin = 24.62 
            xmax = 25.3 
            text = "" 
        intervals [14]:
            xmin = 25.3 
            xmax = 27.37 
            text = "Where on the deck my Captain lies," 
        intervals [15]:
            xmin = 27.37 
            xmax = 27.73 
            text = "" 
        intervals [16]:
            xmin = 27.73 
            xmax = 29.29 
            text = "Fallen cold and dead." 
        intervals [17]:
            xmin = 29.29 
            xmax = 30.2 
            text = "" 
        intervals [18]:
            xmin = 30.2 
            xmax = 34.3 
            text = "O Captain! my Captain! rise up and hear the bells;" 
        intervals [19]:
            xmin = 34.3 
            xmax = 34.84 
            text = "" 
        intervals [20]:
            xmin = 34.84 
            xmax = 38.87 
            text = "Rise up- for you the flag is flung- for you the bugle trills," 
        intervals [21]:
            xmin = 38.87 
            xmax = 39.54 
            text = "" 
        intervals [22]:
            xmin = 39.54 
            xmax = 43.65 
            text = "For you bouquets and ribbon’d wreaths- for you the shores a-crowding," 
        intervals [23]:
            xmin = 43.65 
            xmax = 44.15 
            text = "" 
        intervals [24]:
            xmin = 44.15 
            xmax = 48.03 
            text = "For you they call, the swaying mass, their eager faces turning;" 
        intervals [25]:
            xmin = 48.03 
            xmax = 48.6 
            text = "" 
        intervals [26]:
            xmin = 48.6 
            xmax = 50.43 
            text = "Here Captain! dear father!" 
        intervals [27]:
            xmin = 50.43 
            xmax = 50.9 
            text = "" 
        intervals [28]:
            xmin = 50.9 
            xmax = 52.4 
            text = "This arm beneath your head!" 
        intervals [29]:
            xmin = 52.4 
            xmax = 52.97 
            text = "" 
        intervals [30]:
            xmin = 52.97 
            xmax = 54.8 
            text = "It is some dream that on the deck," 
        intervals [31]:
            xmin = 54.8 
            xmax = 55.15 
            text = "" 
        intervals [32]:
            xmin = 55.15 
            xmax = 56.84 
            text = "You’ve fallen cold and dead." 
        intervals [33]:
            xmin = 56.84 
            xmax = 58.54 
            text = "" 
        intervals [34]:
            xmin = 58.54 
            xmax = 62.5 
            text = "My Captain does not answer, his lips are pale and still," 
        intervals [35]:
            xmin = 62.5 
            xmax = 63.24 
            text = "" 
        intervals [36]:
            xmin = 63.24 
            xmax = 67.48 
            text = "My father does not feel my arm, he has no pulse nor will," 
        intervals [37]:
            xmin = 67.48 
            xmax = 68.25 
            text = "" 
        intervals [38]:
            xmin = 68.25 
            xmax = 72.45 
            text = "The ship is anchor’d safe and sound, its voyage closed and done," 
        intervals [39]:
            xmin = 72.45 
            xmax = 73.19 
            text = "" 
        intervals [40]:
            xmin = 73.19 
            xmax = 77.01 
            text = "From fearful trip the victor ship comes in with object won;" 
        intervals [41]:
            xmin = 77.01 
            xmax = 77.72 
            text = "" 
        intervals [42]:
            xmin = 77.72 
            xmax = 80.59 
            text = "Exult O shores, and ring O bells!" 
        intervals [43]:
            xmin = 80.59 
            xmax = 81.18 
            text = "" 
        intervals [44]:
            xmin = 81.18 
            xmax = 82.94 
            text = "But I with mournful tread," 
        intervals [45]:
            xmin = 82.94 
            xmax = 83.65 
            text = "" 
        intervals [46]:
            xmin = 83.65 
            xmax = 85.79 
            text = "Walk the deck my Captain lies," 
        intervals [47]:
            xmin = 85.79 
            xmax = 86.23 
            text = "" 
        intervals [48]:
            xmin = 86.23 
            xmax = 93.1 
            text = "Fallen cold and dead." 
        intervals [49]:
            xmin = 93.1 
            xmax = 93.545 
            text = "" 
