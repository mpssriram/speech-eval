    item [2]:
        class = "IntervalTier" 
        name = "sentences" 
        xmin = 0 
        xmax = 83.21 
        intervals: size = 21 
        intervals [1]:
            xmin = 0 
            xmax = 0.23 
            text = "" 
        intervals [2]:
            xmin = 0.23 
            xmax = 8.48 
            text = "Four score and seven years ago our fathers brought forth on this continent, a new nation, conceived in Liberty, and dedicated to the proposition that all men are created equal." 
        intervals [3]:
            xmin = 8.48 
            xmax = 8.85 
            text = "" 
        intervals [4]:
            xmin = 8.85 
            xmax = 14.71 
            text = "Now we are engaged in a great civil war, testing whether that nation, or any nation so conceived and so dedicated, can long endure." 
        intervals [5]:
            xmin = 14.71 
            xmax = 15.19 
            text = "" 
        intervals [6]:
            xmin = 15.19 
            xmax = 17.57 
            text = "We are met on a great battle-field of that war." 
        intervals [7]:
            xmin = 17.57 
            xmax = 17.98 
            text = "" 
        intervals [8]:
            xmin = 17.98 
            xmax = 24.64 
            text = "We have come to dedicate a portion of that field, as a final resting place for those who here gave their lives that that nation might live." 
        intervals [9]:
            xmin = 24.64 
            xmax = 25.13 
            text = "" 
        intervals [10]:
            xmin = 25.13 
            xmax = 27.83 
            text = "It is all to get altogether fitting and proper that we should do this." 
        intervals [11]:
            xmin = 27.83 
            xmax = 28.09 
            text = "" 
        intervals [12]:
            xmin = 28.09 
            xmax = 33.09 
            text = "But, in a larger sense, we cannot dedicate we cannot consecrate we cannot hallow this ground." 
        intervals [13]:
            xmin = 33.09 
            xmax = 33.42 
            text = "" 
        intervals [14]:
            xmin = 33.42 
            xmax = 39.55 
            text = "The brave men, living and dead, who struggled here, have consecrated it, far above our poor power to add or detract." 
        intervals [15]:
            xmin = 39.55 
            xmax = 39.82 
            text = "" 
        intervals [16]:
            xmin = 39.82 
            xmax = 46.22 
            text = "The world will little note, nor long remember what we say here, but it can never forget what they did here." 
        intervals [17]:
            xmin = 46.22 
            xmax = 46.48 
            text = "" 
        intervals [18]:
            xmin = 46.48 
            xmax = 55.24 
            text = "It is for us the living, rather, to be dedicated here to the unfinished work which they who fought here have thus far so nobly advanced." 
        intervals [19]:
            xmin = 55.24 
            xmax = 55.7 
            text = "" 
        intervals [20]:
            xmin = 55.7 
            xmax = 82.44 
            text = "It is rather for us to be here dedicated to the great task remaining before us that from these honored dead we can take increased devotion to that cause for which they gave the last full measure of devotion that we here highly resolve that these dead shall not died in vain that this nation, and under God, shall have a new birth of freedom and that government of the people, by the people, for the people, shall not perish from the earth." 
        intervals [21]:
            xmin = 82.44 
            xmax = 83.21 
            text = "" 
