    item [2]:
        class = "IntervalTier" 
        name = "sentences" 
        xmin = 0 
        xmax = 92.556 
        intervals: size = 49 
        intervals [1]:
            xmin = 0 
            xmax = 0.14 
            text = "" 
        intervals [2]:
            xmin = 0.14 
            xmax = 4.19 
            text = "O Captain! my Captain! our fearful trip is done," 
        intervals [3]:
            xmin = 4.19 
            xmax = 4.75 
            text = "" 
        intervals [4]:
            xmin = 4.75 
            xmax = 9.08 
            text = "The ship has weather’d every rack, the prize we sought is won," 
        intervals [5]:
            xmin = 9.08 
            xmax = 9.72 
            text = "" 
        intervals [6]:
            xmin = 9.72 
            xmax = 13.4 
            text = "The port is near, the bells I hear, the people all exulting," 
        intervals [7]:
            xmin = 13.4 
            xmax = 14.02 
            text = "" 
        intervals [8]:
            xmin = 14.02 
            xmax = 18.34 
            text = "While follow eyes the steady keel, the vessel grim and daring;" 
        intervals [9]:
            xmin = 18.34 
            xmax = 19.08 
            text = "" 
        intervals [10]:
            xmin = 19.08 
            xmax = 21.18 
            text = "But O heart! heart! heart!" 
        intervals [11]:
            xmin = 21.18 
            xmax = 21.86 
            text = "" 
        intervals [12]:
            xmin = 21.86 
            xmax = 23.63 
            text = "O the bleeding drops of red," 
        intervals [13]:
            xmin = 23.63 
            xmax = 24.31 
            text = "" 
        intervals [14]:
            xmin = 24.31 
            xmax = 26.39 
            text = "Where on the deck my Captain lies," 
        intervals [15]:
            xmin = 26.39 
            xmax = 26.74 
            text = "" 
        intervals [16]:
            xmin = 26.74 
            xmax = 28.33 
            text = "Fallen cold and dead." 
        intervals [17]:
            xmin = 28.33 
            xmax = 29.21 
            text = "" 
        intervals [18]:
            xmin = 29.21 
            xmax = 33.31 
            text = "O Captain! my Captain! rise up and hear the bells;" 
        intervals [19]:
            xmin = 33.31 
            xmax = 33.85 
            text = "" 
        intervals [20]:
            xmin = 33.85 
            xmax = 37.88 
            text = "Rise up- for you the flag is flung- for you the bugle trills," 
        intervals [21]:
            xmin = 37.88 
            xmax = 38.55 
            text = "" 
        intervals [22]:
            xmin = 38.55 
            xmax = 42.66 
            text = "For you bouquets and ribbon’d wreaths- for you the shores a-crowding," 
        intervals [23]:
            xmin = 42.66 
            xmax = 43.17 
            text = "" 
        intervals [24]:
            xmin = 43.17 
            xmax = 47.03 
            text = "For you they call, the swaying mass, their eager faces turning;" 
        intervals [25]:
            xmin = 47.03 
            xmax = 47.61 
            text = "" 
        intervals [26]:
            xmin = 47.61 
            xmax = 49.45 
            text = "Here Captain! dear father!" 
        intervals [27]:
            xmin = 49.45 
            xmax = 49.91 
            text = "" 
        intervals [28]:
            xmin = 49.91 
            xmax = 51.41 
            text = "This arm beneath your head!" 
        intervals [29]:
            xmin = 51.41 
            xmax = 51.98 
            text = "" 
        intervals [30]:
            xmin = 51.98 
            xmax = 53.81 
            text = "It is some dream that on the deck," 
        intervals [31]:
            xmin = 53.81 
            xmax = 54.16 
            text = "" 
        intervals [32]:
            xmin = 54.16 
            xmax = 55.86 
            text = "You’ve fallen cold and dead." 
        intervals [33]:
            xmin = 55.86 
            xmax = 57.55 
            text = "" 
        intervals [34]:
            xmin = 57.55 
            xmax = 61.51 
            text = "My Captain does not answer, his lips are pale and still," 
        intervals [35]:
            xmin = 61.51 
            xmax = 62.25 
            text = "" 
        intervals [36]:
            xmin = 62.25 
            xmax = 66.49 
            text = "My father does not feel my arm, he has no pulse nor will," 
        intervals [37]:
            xmin = 66.49 
            xmax = 67.26 
            text = "" 
        intervals [38]:
            xmin = 67.26 
            xmax = 71.46 
            text = "The ship is anchor’d safe and sound, its voyage closed and done," 
        intervals [39]:
            xmin = 71.46 
            xmax = 72.2 
            text = "" 
        intervals [40]:
            xmin = 72.2 
            xmax = 76.02 
            text = "From fearful trip the victor ship comes in with object won;" 
        intervals [41]:
            xmin = 76.02 
            xmax = 76.73 
            text = "" 
        intervals [42]:
            xmin = 76.73 
            xmax = 79.6 
            text = "Exult O shores, and ring O bells!" 
        intervals [43]:
            xmin = 79.6 
            xmax = 80.19 
            text = "" 
        intervals [44]:
            xmin = 80.19 
            xmax = 81.95 
            text = "But I with mournful tread," 
        intervals [45]:
            xmin = 81.95 
            xmax = 82.66 
            text = "" 
        intervals [46]:
            xmin = 82.66 
            xmax = 84.8 
            text = "Walk the deck my Captain lies," 
        intervals [47]:
            xmin = 84.8 
            xmax = 85.24 
            text = "" 
        intervals [48]:
            xmin = 85.24 
            xmax = 92.12 
            text = "Fallen cold and dead." 
        intervals [49]:
            xmin = 92.12 
            xmax = 92.556 
            text = "" 
