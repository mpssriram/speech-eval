    item [2]:
        class = "IntervalTier" 
        name = "sentences" 
        xmin = 0 
        xmax = 109.096 
        intervals: size = 47 
        intervals [1]:
            xmin = 0 
            xmax = 7.46 
            text = "two thousand and six O Captain! my Captain! our fearful trip is done," 
        intervals [2]:
            xmin = 7.46 
            xmax = 8.19 
            text = "" 
        intervals [3]:
            xmin = 8.19 
            xmax = 12.23 
            text = "The ship has weather’d every rack, the prize we sought is won," 
        intervals [4]:
            xmin = 12.23 
            xmax = 13.06 
            text = "" 
        intervals [5]:
            xmin = 13.06 
            xmax = 17.1 
            text = "The port is near, the bells I hear, the people all exulting," 
        intervals [6]:
            xmin = 17.1 
            xmax = 17.59 
            text = "" 
        intervals [7]:
            xmin = 17.59 
            xmax = 22.46 
            text = "While follow eyes the steady keel, the vessel grim and daring;" 
        intervals [8]:
            xmin = 22.46 
            xmax = 23.44 
            text = "" 
        intervals [9]:
            xmin = 23.44 
            xmax = 26.32 
            text = "But O heart! heart! heart!" 
        intervals [10]:
            xmin = 26.32 
            xmax = 26.99 
            text = "" 
        intervals [11]:
            xmin = 26.99 
            xmax = 28.85 
            text = "O the bleeding drops of red," 
        intervals [12]:
            xmin = 28.85 
            xmax = 29.43 
            text = "" 
        intervals [13]:
            xmin = 29.43 
            xmax = 31.53 
            text = "Where on the deck my Captain lies," 
        intervals [14]:
            xmin = 31.53 
            xmax = 33.27 
            text = "Fallen cold and dead." 
        intervals [15]:
            xmin = 33.27 
            xmax = 34.35 
            text = "" 
        intervals [16]:
            xmin = 34.35 
            xmax = 37.52 
            text = "O Captain! my Captain! rise up and hear the bells;" 
        intervals [17]:
            xmin = 37.52 
            xmax = 38 
            text = "" 
        intervals [18]:
            xmin = 38 
            xmax = 43.21 
            text = "Rise up- for you the flag is flung- for you the bugle trills," 
        intervals [19]:
            xmin = 43.21 
            xmax = 43.64 
            text = "" 
        intervals [20]:
            xmin = 43.64 
            xmax = 48.54 
            text = "For you bouquets and ribbon’d wreaths- for you the shores a-crowding," 
        intervals [21]:
            xmin = 48.54 
            xmax = 49.35 
            text = "" 
        intervals [22]:
            xmin = 49.35 
            xmax = 53.77 
            text = "For you they call, the swaying mass, their eager faces turning;" 
        intervals [23]:
            xmin = 53.77 
            xmax = 54.46 
            text = "" 
        intervals [24]:
            xmin = 54.46 
            xmax = 57.16 
            text = "Here Captain! dear father!" 
        intervals [25]:
            xmin = 57.16 
            xmax = 57.82 
            text = "" 
        intervals [26]:
            xmin = 57.82 
            xmax = 59.74 
            text = "This arm beneath your head!" 
        intervals [27]:
            xmin = 59.74 
            xmax = 60.47 
            text = "" 
        intervals [28]:
            xmin = 60.47 
            xmax = 63.27 
            text = "It is some dream that on the deck," 
        intervals [29]:
            xmin = 63.27 
            xmax = 63.93 
            text = "" 
        intervals [30]:
            xmin = 63.93 
            xmax = 66.48 
            text = "You’ve fallen cold and dead." 
        intervals [31]:
            xmin = 66.48 
            xmax = 68.24 
            text = "" 
        intervals [32]:
            xmin = 68.24 
            xmax = 73.36 
            text = "My Captain does not answer, his lips are pale and still," 
        intervals [33]:
            xmin = 73.36 
            xmax = 74.53 
            text = "" 
        intervals [34]:
            xmin = 74.53 
            xmax = 80.16 
            text = "My father does not feel my arm, he has no pulse nor will," 
        intervals [35]:
            xmin = 80.16 
            xmax = 81.28 
            text = "" 
        intervals [36]:
            xmin = 81.28 
            xmax = 87.04 
            text = "The ship is anchor’d safe and sound, its voyage closed and done," 
        intervals [37]:
            xmin = 87.04 
            xmax = 88.07 
            text = "" 
        intervals [38]:
            xmin = 88.07 
            xmax = 93.84 
            text = "From fearful trip the victor ship comes in with object won;" 
        intervals [39]:
            xmin = 93.84 
            xmax = 95.11 
            text = "" 
        intervals [40]:
            xmin = 95.11 
            xmax = 98.97 
            text = "Exult O shores, and ring O bells!" 
        intervals [41]:
            xmin = 98.97 
            xmax = 99.6 
            text = "" 
        intervals [42]:
            xmin = 99.6 
            xmax = 102.49 
            text = "But I with mournful tread," 
        intervals [43]:
            xmin = 102.49 
            xmax = 103.19 
            text = "" 
        intervals [44]:
            xmin = 103.19 
            xmax = 105.82 
            text = "Walk the deck my Captain lies," 
        intervals [45]:
            xmin = 105.82 
            xmax = 106.55 
            text = "" 
        intervals [46]:
            xmin = 106.55 
            xmax = 108.88 
            text = "Fallen cold and dead." 
        intervals [47]:
            xmin = 108.88 
            xmax = 109.096 
            text = "" 
