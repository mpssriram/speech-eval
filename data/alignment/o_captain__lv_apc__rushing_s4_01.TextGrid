    item [2]:
        class = "IntervalTier" 
        name = "sentences" 
        xmin = 0 
        xmax = 107.916 
        intervals: size = 47 
        intervals [1]:
            xmin = 0 
            xmax = 7.46 
            text = "two thousand and six O Captain! my Captain! our fearful trip is done," 
        intervals [2]:
            xmin = 7.46 
            xmax = 8.19 
            text = "" 
        intervals [3]:
            xmin = 8.19 
            xmax = 12.24 
            text = "The ship has weather’d every rack, the prize we sought is won," 
        intervals [4]:
            xmin = 12.24 
            xmax = 13.05 
            text = "" 
        intervals [5]:
            xmin = 13.05 
            xmax = 15.71 
            text = "The port is near, the bells I hear, the people all exulting," 
        intervals [6]:
            xmin = 15.71 
            xmax = 16.41 
            text = "" 
        intervals [7]:
            xmin = 16.41 
            xmax = 21.28 
            text = "While follow eyes the steady keel, the vessel grim and daring;" 
        intervals [8]:
            xmin = 21.28 
            xmax = 22.26 
            text = "" 
        intervals [9]:
            xmin = 22.26 
            xmax = 25.14 
            text = "But O heart! heart! heart!" 
        intervals [10]:
            xmin = 25.14 
            xmax = 25.81 
            text = "" 
        intervals [11]:
            xmin = 25.81 
            xmax = 27.67 
            text = "O the bleeding drops of red," 
        intervals [12]:
            xmin = 27.67 
            xmax = 28.25 
            text = "" 
        intervals [13]:
            xmin = 28.25 
            xmax = 30.35 
            text = "Where on the deck my Captain lies," 
        intervals [14]:
            xmin = 30.35 
            xmax = 32.09 
            text = "Fallen cold and dead." 
        intervals [15]:
            xmin = 32.09 
            xmax = 33.17 
            text = "" 
        intervals [16]:
            xmin = 33.17 
            xmax = 36.34 
            text = "O Captain! my Captain! rise up and hear the bells;" 
        intervals [17]:
            xmin = 36.34 
            xmax = 36.82 
            text = "" 
        intervals [18]:
            xmin = 36.82 
            xmax = 42.03 
            text = "Rise up- for you the flag is flung- for you the bugle trills," 
        intervals [19]:
            xmin = 42.03 
            xmax = 42.46 
            text = "" 
        intervals [20]:
            xmin = 42.46 
            xmax = 47.36 
            text = "For you bouquets and ribbon’d wreaths- for you the shores a-crowding," 
        intervals [21]:
            xmin = 47.36 
            xmax = 48.17 
            text = "" 
        intervals [22]:
            xmin = 48.17 
            xmax = 52.59 
            text = "For you they call, the swaying mass, their eager faces turning;" 
        intervals [23]:
            xmin = 52.59 
            xmax = 53.28 
            text = "" 
        intervals [24]:
            xmin = 53.28 
            xmax = 55.98 
            text = "Here Captain! dear father!" 
        intervals [25]:
            xmin = 55.98 
            xmax = 56.65 
            text = "" 
        intervals [26]:
            xmin = 56.65 
            xmax = 58.56 
            text = "This arm beneath your head!" 
        intervals [27]:
            xmin = 58.56 
            xmax = 59.29 
            text = "" 
        intervals [28]:
            xmin = 59.29 
            xmax = 62.09 
            text = "It is some dream that on the deck," 
        intervals [29]:
            xmin = 62.09 
            xmax = 62.75 
            text = "" 
        intervals [30]:
            xmin = 62.75 
            xmax = 65.3 
            text = "You’ve fallen cold and dead." 
        intervals [31]:
            xmin = 65.3 
            xmax = 67.06 
            text = "" 
        intervals [32]:
            xmin = 67.06 
            xmax = 72.18 
            text = "My Captain does not answer, his lips are pale and still," 
        intervals [33]:
            xmin = 72.18 
            xmax = 73.35 
            text = "" 
        intervals [34]:
            xmin = 73.35 
            xmax = 78.98 
            text = "My father does not feel my arm, he has no pulse nor will," 
        intervals [35]:
            xmin = 78.98 
            xmax = 80.1 
            text = "" 
        intervals [36]:
            xmin = 80.1 
            xmax = 85.86 
            text = "The ship is anchor’d safe and sound, its voyage closed and done," 
        intervals [37]:
            xmin = 85.86 
            xmax = 86.89 
            text = "" 
        intervals [38]:
            xmin = 86.89 
            xmax = 92.66 
            text = "From fearful trip the victor ship comes in with object won;" 
        intervals [39]:
            xmin = 92.66 
            xmax = 93.93 
            text = "" 
        intervals [40]:
            xmin = 93.93 
            xmax = 97.79 
            text = "Exult O shores, and ring O bells!" 
        intervals [41]:
            xmin = 97.79 
            xmax = 98.42 
            text = "" 
        intervals [42]:
            xmin = 98.42 
            xmax = 101.31 
            text = "But I with mournful tread," 
        intervals [43]:
            xmin = 101.31 
            xmax = 102.01 
            text = "" 
        intervals [44]:
            xmin = 102.01 
            xmax = 104.64 
            text = "Walk the deck my Captain lies," 
        intervals [45]:
            xmin = 104.64 
            xmax = 105.37 
            text = "" 
        intervals [46]:
            xmin = 105.37 
            xmax = 107.7 
            text = "Fallen cold and dead." 
        intervals [47]:
            xmin = 107.7 
            xmax = 107.916 
            text = "" 
