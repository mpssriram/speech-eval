        name = "sentences" 
        xmin = 0 
        xmax = 116.028 
        intervals: size = 48 
        intervals [1]:
            xmin = 0 
            xmax = 0.29 
            text = "" 
        intervals [2]:
            xmin = 0.29 
            xmax = 3.77 
            text = "O Captain! my Captain! our fearful trip is done," 
        intervals [3]:
            xmin = 3.77 
            xmax = 4.2 
            text = "" 
        intervals [4]:
            xmin = 4.2 
            xmax = 8.28 
            text = "The ship has weather’d every rack, the prize we sought is won," 
        intervals [5]:
            xmin = 8.28 
            xmax = 8.83 
            text = "" 
        intervals [6]:
            xmin = 8.83 
            xmax = 13.34 
            text = "The port is near, the bells I hear, the people all exulting," 
        intervals [7]:
            xmin = 13.34 
            xmax = 13.98 
            text = "" 
        intervals [8]:
            xmin = 13.98 
            xmax = 22.06 
            text = "While follow eyes the steady keel, the vessel grim and daring;" 
        intervals [9]:
            xmin = 22.06 
            xmax = 22.87 
            text = "" 
        intervals [10]:
            xmin = 22.87 
            xmax = 25.83 
            text = "But O heart! heart! heart!" 
        intervals [11]:
            xmin = 25.83 
            xmax = 26.52 
            text = "" 
        intervals [12]:
            xmin = 26.52 
            xmax = 29 
            text = "O the bleeding drops of red," 
        intervals [13]:
            xmin = 29 
            xmax = 29.53 
            text = "" 
        intervals [14]:
            xmin = 29.53 
            xmax = 32.38 
            text = "Where on the deck my Captain lies," 
        intervals [15]:
            xmin = 32.38 
            xmax = 32.75 
            text = "" 
        intervals [16]:
            xmin = 32.75 
            xmax = 34.48 
            text = "Fallen cold and dead." 
        intervals [17]:
            xmin = 34.48 
            xmax = 36.4 
            text = "" 
        intervals [18]:
            xmin = 36.4 
            xmax = 40.68 
            text = "O Captain! my Captain! rise up and hear the bells;" 
        intervals [19]:
            xmin = 40.68 
            xmax = 41.11 
            text = "" 
        intervals [20]:
            xmin = 41.11 
            xmax = 45.93 
            text = "Rise up- for you the flag is flung- for you the bugle trills," 
        intervals [21]:
            xmin = 45.93 
            xmax = 46.34 
            text = "" 
        intervals [22]:
            xmin = 46.34 
            xmax = 50.52 
            text = "For you bouquets and ribbon’d wreaths- for you the shores a-crowding," 
        intervals [23]:
            xmin = 50.52 
            xmax = 51.05 
            text = "" 
        intervals [24]:
            xmin = 51.05 
            xmax = 55.31 
            text = "For you they call, the swaying mass, their eager faces turning;" 
        intervals [25]:
            xmin = 55.31 
            xmax = 55.85 
            text = "" 
        intervals [26]:
            xmin = 55.85 
            xmax = 57.98 
            text = "Here Captain! dear father!" 
        intervals [27]:
            xmin = 57.98 
            xmax = 58.32 
            text = "" 
        intervals [28]:
            xmin = 58.32 
            xmax = 60.14 
            text = "This arm beneath your head!" 
        intervals [29]:
            xmin = 60.14 
            xmax = 60.65 
            text = "" 
        intervals [30]:
            xmin = 60.65 
            xmax = 63 
            text = "It is some dream that on the deck," 
        intervals [31]:
            xmin = 63 
            xmax = 64.92 
            text = "You’ve fallen cold and dead." 
        intervals [32]:
            xmin = 64.92 
            xmax = 66.58 
            text = "" 
        intervals [33]:
            xmin = 66.58 
            xmax = 71.16 
            text = "My Captain does not answer, his lips are pale and still," 
        intervals [34]:
            xmin = 71.16 
            xmax = 71.8 
            text = "" 
        intervals [35]:
            xmin = 71.8 
            xmax = 76.21 
            text = "My father does not feel my arm, he has no pulse nor will," 
        intervals [36]:
            xmin = 76.21 
            xmax = 76.93 
            text = "" 
        intervals [37]:
            xmin = 76.93 
            xmax = 81.63 
            text = "The ship is anchor’d safe and sound, its voyage closed and done," 
        intervals [38]:
            xmin = 81.63 
            xmax = 82.33 
            text = "" 
        intervals [39]:
            xmin = 82.33 
            xmax = 86.66 
            text = "From fearful trip the victor ship comes in with object won;" 
        intervals [40]:
            xmin = 86.66 
            xmax = 87.59 
            text = "" 
        intervals [41]:
            xmin = 87.59 
            xmax = 90.77 
            text = "Exult O shores, and ring O bells!" 
        intervals [42]:
            xmin = 90.77 
            xmax = 91.09 
            text = "" 
        intervals [43]:
            xmin = 91.09 
            xmax = 93.11 
            text = "But I with mournful tread," 
        intervals [44]:
            xmin = 93.11 
            xmax = 94.08 
            text = "" 
        intervals [45]:
            xmin = 94.08 
            xmax = 96.58 
            text = "Walk the deck my Captain lies," 
        intervals [46]:
            xmin = 96.58 
            xmax = 97.3 
            text = "" 
        intervals [47]:
            xmin = 97.3 
            xmax = 106.98 
            text = "Fallen cold and dead." 
        intervals [48]:
            xmin = 106.98 
            xmax = 116.028 
            text = "" 
