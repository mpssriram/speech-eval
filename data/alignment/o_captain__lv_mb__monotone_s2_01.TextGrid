    item [2]:
        class = "IntervalTier" 
        name = "sentences" 
        xmin = 0 
        xmax = 81.869 
        intervals: size = 49 
        intervals [1]:
            xmin = 0 
            xmax = 0.14 
            text = "" 
        intervals [2]:
            xmin = 0.14 
            xmax = 3.43 
            text = "O Captain! my Captain! our fearful trip is done," 
        intervals [3]:
            xmin = 3.43 
            xmax = 3.7 
            text = "" 
        intervals [4]:
            xmin = 3.7 
            xmax = 7.6 
            text = "The ship has weather’d every rack, the prize we sought is won," 
        intervals [5]:
            xmin = 7.6 
            xmax = 8.21 
            text = "" 
        intervals [6]:
            xmin = 8.21 
            xmax = 12.1 
            text = "The port is near, the bells I hear, the people all exulting," 
        intervals [7]:
            xmin = 12.1 
            xmax = 12.59 
            text = "" 
        intervals [8]:
            xmin = 12.59 
            xmax = 16.54 
            text = "While follow eyes the steady keel, the vessel grim and daring;" 
        intervals [9]:
            xmin = 16.54 
            xmax = 17.06 
            text = "" 
        intervals [10]:
            xmin = 17.06 
            xmax = 19.08 
            text = "But O heart! heart! heart!" 
        intervals [11]:
            xmin = 19.08 
            xmax = 19.37 
            text = "" 
        intervals [12]:
            xmin = 19.37 
            xmax = 21.13 
            text = "O the bleeding drops of red," 
        intervals [13]:
            xmin = 21.13 
            xmax = 21.5 
            text = "" 
        intervals [14]:
            xmin = 21.5 
            xmax = 23.53 
            text = "Where on the deck my Captain lies," 
        intervals [15]:
            xmin = 23.53 
            xmax = 23.79 
            text = "" 
        intervals [16]:
            xmin = 23.79 
            xmax = 25.4 
            text = "Fallen cold and dead." 
        intervals [17]:
            xmin = 25.4 
            xmax = 26.56 
            text = "" 
        intervals [18]:
            xmin = 26.56 
            xmax = 29.85 
            text = "O Captain! my Captain! rise up and hear the bells;" 
        intervals [19]:
            xmin = 29.85 
            xmax = 30.37 
            text = "" 
        intervals [20]:
            xmin = 30.37 
            xmax = 34.75 
            text = "Rise up- for you the flag is flung- for you the bugle trills," 
        intervals [21]:
            xmin = 34.75 
            xmax = 35.05 
            text = "" 
        intervals [22]:
            xmin = 35.05 
            xmax = 39.3 
            text = "For you bouquets and ribbon’d wreaths- for you the shores a-crowding," 
        intervals [23]:
            xmin = 39.3 
            xmax = 39.82 
            text = "" 
        intervals [24]:
            xmin = 39.82 
            xmax = 44.01 
            text = "For you they call, the swaying mass, their eager faces turning;" 
        intervals [25]:
            xmin = 44.01 
            xmax = 44.7 
            text = "" 
        intervals [26]:
            xmin = 44.7 
            xmax = 46.64 
            text = "Here Captain! dear father!" 
        intervals [27]:
            xmin = 46.64 
            xmax = 46.95 
            text = "" 
        intervals [28]:
            xmin = 46.95 
            xmax = 48.47 
            text = "This arm beneath your head!" 
        intervals [29]:
            xmin = 48.47 
            xmax = 49.02 
            text = "" 
        intervals [30]:
            xmin = 49.02 
            xmax = 51 
            text = "It is some dream that on the deck," 
        intervals [31]:
            xmin = 51 
            xmax = 51.31 
            text = "" 
        intervals [32]:
            xmin = 51.31 
            xmax = 53.05 
            text = "You’ve fallen cold and dead." 
        intervals [33]:
            xmin = 53.05 
            xmax = 54.32 
            text = "" 
        intervals [34]:
            xmin = 54.32 
            xmax = 57.84 
            text = "My Captain does not answer, his lips are pale and still," 
        intervals [35]:
            xmin = 57.84 
            xmax = 58.5 
            text = "" 
        intervals [36]:
            xmin = 58.5 
            xmax = 62.37 
            text = "My father does not feel my arm, he has no pulse nor will," 
        intervals [37]:
            xmin = 62.37 
            xmax = 63.11 
            text = "" 
        intervals [38]:
            xmin = 63.11 
            xmax = 67.06 
            text = "The ship is anchor’d safe and sound, its voyage closed and done," 
        intervals [39]:
            xmin = 67.06 
            xmax = 67.51 
            text = "" 
        intervals [40]:
            xmin = 67.51 
            xmax = 71.56 
            text = "From fearful trip the victor ship comes in with object won;" 
        intervals [41]:
            xmin = 71.56 
            xmax = 72.26 
            text = "" 
        intervals [42]:
            xmin = 72.26 
            xmax = 74.86 
            text = "Exult O shores, and ring O bells!" 
        intervals [43]:
            xmin = 74.86 
            xmax = 75.3 
            text = "" 
        intervals [44]:
            xmin = 75.3 
            xmax = 76.96 
            text = "But I with mournful tread," 
        intervals [45]:
            xmin = 76.96 
            xmax = 77.38 
            text = "" 
        intervals [46]:
            xmin = 77.38 
            xmax = 79.49 
            text = "Walk the deck my Captain lies," 
        intervals [47]:
            xmin = 79.49 
            xmax = 79.73 
            text = "" 
        intervals [48]:
            xmin = 79.73 
            xmax = 81.66 
            text = "Fallen cold and dead." 
        intervals [49]:
            xmin = 81.66 
            xmax = 81.869 
            text = "" 
