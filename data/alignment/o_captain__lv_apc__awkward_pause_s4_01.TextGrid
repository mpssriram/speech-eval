    item [2]:
        class = "IntervalTier" 
        name = "sentences" 
        xmin = 0 
        xmax = 111.504 
        intervals: size = 47 
        intervals [1]:
            xmin = 0 
            xmax = 7.46 
            text = "two thousand and six O Captain! my Captain! our fearful trip is done," 
        intervals [2]:
            xmin = 7.46 
            xmax = 8.19 
            text = "" 
        intervals [3]:
            xmin = 8.19 
            xmax = 12.24 
            text = "The ship has weather’d every rack, the prize we sought is won," 
        intervals [4]:
            xmin = 12.24 
            xmax = 13.06 
            text = "" 
        intervals [5]:
            xmin = 13.06 
            xmax = 17.1 
            text = "The port is near, the bells I hear, the people all exulting," 
        intervals [6]:
            xmin = 17.1 
            xmax = 17.79 
            text = "" 
        intervals [7]:
            xmin = 17.79 
            xmax = 24.86 
            text = "While follow eyes the steady keel, the vessel grim and daring;" 
        intervals [8]:
            xmin = 24.86 
            xmax = 25.85 
            text = "" 
        intervals [9]:
            xmin = 25.85 
            xmax = 28.73 
            text = "But O heart! heart! heart!" 
        intervals [10]:
            xmin = 28.73 
            xmax = 29.4 
            text = "" 
        intervals [11]:
            xmin = 29.4 
            xmax = 31.26 
            text = "O the bleeding drops of red," 
        intervals [12]:
            xmin = 31.26 
            xmax = 31.84 
            text = "" 
        intervals [13]:
            xmin = 31.84 
            xmax = 33.93 
            text = "Where on the deck my Captain lies," 
        intervals [14]:
            xmin = 33.93 
            xmax = 35.68 
            text = "Fallen cold and dead." 
        intervals [15]:
            xmin = 35.68 
            xmax = 36.76 
            text = "" 
        intervals [16]:
            xmin = 36.76 
            xmax = 39.93 
            text = "O Captain! my Captain! rise up and hear the bells;" 
        intervals [17]:
            xmin = 39.93 
            xmax = 40.41 
            text = "" 
        intervals [18]:
            xmin = 40.41 
            xmax = 45.62 
            text = "Rise up- for you the flag is flung- for you the bugle trills," 
        intervals [19]:
            xmin = 45.62 
            xmax = 46.05 
            text = "" 
        intervals [20]:
            xmin = 46.05 
            xmax = 50.95 
            text = "For you bouquets and ribbon’d wreaths- for you the shores a-crowding," 
        intervals [21]:
            xmin = 50.95 
            xmax = 51.75 
            text = "" 
        intervals [22]:
            xmin = 51.75 
            xmax = 56.18 
            text = "For you they call, the swaying mass, their eager faces turning;" 
        intervals [23]:
            xmin = 56.18 
            xmax = 56.86 
            text = "" 
        intervals [24]:
            xmin = 56.86 
            xmax = 59.57 
            text = "Here Captain! dear father!" 
        intervals [25]:
            xmin = 59.57 
            xmax = 60.23 
            text = "" 
        intervals [26]:
            xmin = 60.23 
            xmax = 62.14 
            text = "This arm beneath your head!" 
        intervals [27]:
            xmin = 62.14 
            xmax = 62.87 
            text = "" 
        intervals [28]:
            xmin = 62.87 
            xmax = 65.67 
            text = "It is some dream that on the deck," 
        intervals [29]:
            xmin = 65.67 
            xmax = 66.34 
            text = "" 
        intervals [30]:
            xmin = 66.34 
            xmax = 68.89 
            text = "You’ve fallen cold and dead." 
        intervals [31]:
            xmin = 68.89 
            xmax = 70.65 
            text = "" 
        intervals [32]:
            xmin = 70.65 
            xmax = 75.77 
            text = "My Captain does not answer, his lips are pale and still," 
        intervals [33]:
            xmin = 75.77 
            xmax = 76.93 
            text = "" 
        intervals [34]:
            xmin = 76.93 
            xmax = 82.57 
            text = "My father does not feel my arm, he has no pulse nor will," 
        intervals [35]:
            xmin = 82.57 
            xmax = 83.69 
            text = "" 
        intervals [36]:
            xmin = 83.69 
            xmax = 89.44 
            text = "The ship is anchor’d safe and sound, its voyage closed and done," 
        intervals [37]:
            xmin = 89.44 
            xmax = 90.48 
            text = "" 
        intervals [38]:
            xmin = 90.48 
            xmax = 96.25 
            text = "From fearful trip the victor ship comes in with object won;" 
        intervals [39]:
            xmin = 96.25 
            xmax = 97.52 
            text = "" 
        intervals [40]:
            xmin = 97.52 
            xmax = 101.37 
            text = "Exult O shores, and ring O bells!" 
        intervals [41]:
            xmin = 101.37 
            xmax = 102.01 
            text = "" 
        intervals [42]:
            xmin = 102.01 
            xmax = 104.89 
            text = "But I with mournful tread," 
        intervals [43]:
            xmin = 104.89 
            xmax = 105.6 
            text = "" 
        intervals [44]:
            xmin = 105.6 
            xmax = 108.23 
            text = "Walk the deck my Captain lies," 
        intervals [45]:
            xmin = 108.23 
            xmax = 108.96 
            text = "" 
        intervals [46]:
            xmin = 108.96 
            xmax = 111.29 
            text = "Fallen cold and dead." 
        intervals [47]:
            xmin = 111.29 
            xmax = 111.504 
            text = "" 
