    item [2]:
        class = "IntervalTier" 
        name = "sentences" 
        xmin = 0 
        xmax = 98.208 
        intervals: size = 48 
        intervals [1]:
            xmin = 0 
            xmax = 0.13 
            text = "" 
        intervals [2]:
            xmin = 0.13 
            xmax = 3.92 
            text = "O Captain! my Captain! our fearful trip is done," 
        intervals [3]:
            xmin = 3.92 
            xmax = 4.28 
            text = "" 
        intervals [4]:
            xmin = 4.28 
            xmax = 8.18 
            text = "The ship has weather’d every rack, the prize we sought is won," 
        intervals [5]:
            xmin = 8.18 
            xmax = 9.12 
            text = "" 
        intervals [6]:
            xmin = 9.12 
            xmax = 14.23 
            text = "The port is near, the bells I hear, the people all exulting," 
        intervals [7]:
            xmin = 14.23 
            xmax = 14.67 
            text = "" 
        intervals [8]:
            xmin = 14.67 
            xmax = 19.3 
            text = "While follow eyes the steady keel, the vessel grim and daring;" 
        intervals [9]:
            xmin = 19.3 
            xmax = 20.61 
            text = "" 
        intervals [10]:
            xmin = 20.61 
            xmax = 24.09 
            text = "But O heart! heart! heart!" 
        intervals [11]:
            xmin = 24.09 
            xmax = 25.09 
            text = "" 
        intervals [12]:
            xmin = 25.09 
            xmax = 27.49 
            text = "O the bleeding drops of red," 
        intervals [13]:
            xmin = 27.49 
            xmax = 28.34 
            text = "" 
        intervals [14]:
            xmin = 28.34 
            xmax = 30.77 
            text = "Where on the deck my Captain lies," 
        intervals [15]:
            xmin = 30.77 
            xmax = 31.11 
            text = "" 
        intervals [16]:
            xmin = 31.11 
            xmax = 33.02 
            text = "Fallen cold and dead." 
        intervals [17]:
            xmin = 33.02 
            xmax = 34.85 
            text = "" 
        intervals [18]:
            xmin = 34.85 
            xmax = 38.58 
            text = "O Captain! my Captain! rise up and hear the bells;" 
        intervals [19]:
            xmin = 38.58 
            xmax = 38.94 
            text = "" 
        intervals [20]:
            xmin = 38.94 
            xmax = 43.4 
            text = "Rise up- for you the flag is flung- for you the bugle trills," 
        intervals [21]:
            xmin = 43.4 
            xmax = 43.85 
            text = "" 
        intervals [22]:
            xmin = 43.85 
            xmax = 48.38 
            text = "For you bouquets and ribbon’d wreaths- for you the shores a-crowding," 
        intervals [23]:
            xmin = 48.38 
            xmax = 48.74 
            text = "" 
        intervals [24]:
            xmin = 48.74 
            xmax = 53.03 
            text = "For you they call, the swaying mass, their eager faces turning;" 
        intervals [25]:
            xmin = 53.03 
            xmax = 53.85 
            text = "" 
        intervals [26]:
            xmin = 53.85 
            xmax = 55.88 
            text = "Here Captain! dear father!" 
        intervals [27]:
            xmin = 55.88 
            xmax = 57.54 
            text = "This arm beneath your head!" 
        intervals [28]:
            xmin = 57.54 
            xmax = 57.98 
            text = "" 
        intervals [29]:
            xmin = 57.98 
            xmax = 60.23 
            text = "It is some dream that on the deck," 
        intervals [30]:
            xmin = 60.23 
            xmax = 60.54 
            text = "" 
        intervals [31]:
            xmin = 60.54 
            xmax = 62.4 
            text = "You’ve fallen cold and dead." 
        intervals [32]:
            xmin = 62.4 
            xmax = 65.11 
            text = "" 
        intervals [33]:
            xmin = 65.11 
            xmax = 69.73 
            text = "My Captain does not answer, his lips are pale and still," 
        intervals [34]:
            xmin = 69.73 
            xmax = 70.67 
            text = "" 
        intervals [35]:
            xmin = 70.67 
            xmax = 75.8 
            text = "My father does not feel my arm, he has no pulse nor will," 
        intervals [36]:
            xmin = 75.8 
            xmax = 76.83 
            text = "" 
        intervals [37]:
            xmin = 76.83 
            xmax = 80.94 
            text = "The ship is anchor’d safe and sound, its voyage closed and done," 
        intervals [38]:
            xmin = 80.94 
            xmax = 81.29 
            text = "" 
        intervals [39]:
            xmin = 81.29 
            xmax = 85.58 
            text = "From fearful trip the victor ship comes in with object won;" 
        intervals [40]:
            xmin = 85.58 
            xmax = 86.82 
            text = "" 
        intervals [41]:
            xmin = 86.82 
            xmax = 89.6 
            text = "Exult O shores, and ring O bells!" 
        intervals [42]:
            xmin = 89.6 
            xmax = 90.12 
            text = "" 
        intervals [43]:
            xmin = 90.12 
            xmax = 92.16 
            text = "But I with mournful tread," 
        intervals [44]:
            xmin = 92.16 
            xmax = 93.08 
            text = "" 
        intervals [45]:
            xmin = 93.08 
            xmax = 95.45 
            text = "Walk the deck my Captain lies," 
        intervals [46]:
            xmin = 95.45 
            xmax = 95.55 
            text = "" 
        intervals [47]:
            xmin = 95.55 
            xmax = 98.11 
            text = "Fallen cold and dead." 
        intervals [48]:
            xmin = 98.11 
            xmax = 98.208 
            text = "" 
