    item [2]:
        class = "IntervalTier" 
        name = "sentences" 
        xmin = 0 
        xmax = 107.718 
        intervals: size = 43 
        intervals [1]:
            xmin = 0 
            xmax = 0.25 
            text = "" 
        intervals [2]:
            xmin = 0.25 
            xmax = 6.03 
            text = "O Captain! my Captain! our fearful trip is done," 
        intervals [3]:
            xmin = 6.03 
            xmax = 6.26 
            text = "" 
        intervals [4]:
            xmin = 6.26 
            xmax = 17.19 
            text = "The ship has weather’d every rack, the prize we sought is won," 
        intervals [5]:
            xmin = 17.19 
            xmax = 21.65 
            text = "The port is near, the bells I hear, the people all exulting," 
        intervals [6]:
            xmin = 21.65 
            xmax = 22.18 
            text = "" 
        intervals [7]:
            xmin = 22.18 
            xmax = 27.04 
            text = "While follow eyes the steady keel, the vessel grim and daring;" 
        intervals [8]:
            xmin = 27.04 
            xmax = 27.71 
            text = "" 
        intervals [9]:
            xmin = 27.71 
            xmax = 30.8 
            text = "But O heart! heart! heart!" 
        intervals [10]:
            xmin = 30.8 
            xmax = 33.08 
            text = "O the bleeding drops of red," 
        intervals [11]:
            xmin = 33.08 
            xmax = 33.75 
            text = "" 
        intervals [12]:
            xmin = 33.75 
            xmax = 36.31 
            text = "Where on the deck my Captain lies," 
        intervals [13]:
            xmin = 36.31 
            xmax = 37.33 
            text = "" 
        intervals [14]:
            xmin = 37.33 
            xmax = 39.92 
            text = "Fallen cold and dead." 
        intervals [15]:
            xmin = 39.92 
            xmax = 41.2 
            text = "" 
        intervals [16]:
            xmin = 41.2 
            xmax = 44.58 
            text = "O Captain! my Captain! rise up and hear the bells;" 
        intervals [17]:
            xmin = 44.58 
            xmax = 44.9 
            text = "" 
        intervals [18]:
            xmin = 44.9 
            xmax = 48.53 
            text = "Rise up- for you the flag is flung- for you the bugle trills," 
        intervals [19]:
            xmin = 48.53 
            xmax = 48.93 
            text = "" 
        intervals [20]:
            xmin = 48.93 
            xmax = 53.39 
            text = "For you bouquets and ribbon’d wreaths- for you the shores a-crowding," 
        intervals [21]:
            xmin = 53.39 
            xmax = 54.22 
            text = "" 
        intervals [22]:
            xmin = 54.22 
            xmax = 59.2 
            text = "For you they call, the swaying mass, their eager faces turning;" 
        intervals [23]:
            xmin = 59.2 
            xmax = 59.62 
            text = "" 
        intervals [24]:
            xmin = 59.62 
            xmax = 61.62 
            text = "Here Captain! dear father!" 
        intervals [25]:
            xmin = 61.62 
            xmax = 62.07 
            text = "" 
        intervals [26]:
            xmin = 62.07 
            xmax = 63.86 
            text = "This arm beneath your head!" 
        intervals [27]:
            xmin = 63.86 
            xmax = 66.04 
            text = "It is some dream that on the deck," 
        intervals [28]:
            xmin = 66.04 
            xmax = 66.14 
            text = "" 
        intervals [29]:
            xmin = 66.14 
            xmax = 68.5 
            text = "You’ve fallen cold and dead." 
        intervals [30]:
            xmin = 68.5 
            xmax = 70.19 
            text = "" 
        intervals [31]:
            xmin = 70.19 
            xmax = 75.99 
            text = "My Captain does not answer, his lips are pale and still," 
        intervals [32]:
            xmin = 75.99 
            xmax = 77.54 
            text = "" 
        intervals [33]:
            xmin = 77.54 
            xmax = 83.29 
            text = "My father does not feel my arm, he has no pulse nor will," 
        intervals [34]:
            xmin = 83.29 
            xmax = 83.72 
            text = "" 
        intervals [35]:
            xmin = 83.72 
            xmax = 88.42 
            text = "The ship is anchor’d safe and sound, its voyage closed and done," 
        intervals [36]:
            xmin = 88.42 
            xmax = 93.39 
            text = "From fearful trip the victor ship comes in with object won;" 
        intervals [37]:
            xmin = 93.39 
            xmax = 96.56 
            text = "Exult O shores, and ring O bells!" 
        intervals [38]:
            xmin = 96.56 
            xmax = 97.76 
            text = "" 
        intervals [39]:
            xmin = 97.76 
            xmax = 101.2 
            text = "But I with mournful tread," 
        intervals [40]:
            xmin = 101.2 
            xmax = 103.69 
            text = "Walk the deck my Captain lies," 
        intervals [41]:
            xmin = 103.69 
            xmax = 104.77 
            text = "" 
        intervals [42]:
            xmin = 104.77 
            xmax = 107.39 
            text = "Fallen cold and dead." 
        intervals [43]:
            xmin = 107.39 
            xmax = 107.718 
            text = "" 
