    item [2]:
        class = "IntervalTier" 
        name = "sentences" 
        xmin = 0 
        xmax = 94.444 
        intervals: size = 49 
        intervals [1]:
            xmin = 0 
            xmax = 0.14 
            text = "" 
        intervals [2]:
            xmin = 0.14 
            xmax = 4.19 
            text = "O Captain! my Captain! our fearful trip is done," 
        intervals [3]:
            xmin = 4.19 
            xmax = 4.75 
            text = "" 
        intervals [4]:
            xmin = 4.75 
            xmax = 8.76 
            text = "The ship has weather’d every rack, the prize we sought is won," 
        intervals [5]:
            xmin = 8.76 
            xmax = 9.41 
            text = "" 
        intervals [6]:
            xmin = 9.41 
            xmax = 13.09 
            text = "The port is near, the bells I hear, the people all exulting," 
        intervals [7]:
            xmin = 13.09 
            xmax = 13.71 
            text = "" 
        intervals [8]:
            xmin = 13.71 
            xmax = 18.03 
            text = "While follow eyes the steady keel, the vessel grim and daring;" 
        intervals [9]:
            xmin = 18.03 
            xmax = 18.77 
            text = "" 
        intervals [10]:
            xmin = 18.77 
            xmax = 20.87 
            text = "But O heart! heart! heart!" 
        intervals [11]:
            xmin = 20.87 
            xmax = 21.55 
            text = "" 
        intervals [12]:
            xmin = 21.55 
            xmax = 23.31 
            text = "O the bleeding drops of red," 
        intervals [13]:
            xmin = 23.31 
            xmax = 24 
            text = "" 
        intervals [14]:
            xmin = 24 
            xmax = 26.07 
            text = "Where on the deck my Captain lies," 
        intervals [15]:
            xmin = 26.07 
            xmax = 26.43 
            text = "" 
        intervals [16]:
            xmin = 26.43 
            xmax = 30.19 
            text = "Fallen cold and dead." 
        intervals [17]:
            xmin = 30.19 
            xmax = 31.1 
            text = "" 
        intervals [18]:
            xmin = 31.1 
            xmax = 35.19 
            text = "O Captain! my Captain! rise up and hear the bells;" 
        intervals [19]:
            xmin = 35.19 
            xmax = 35.74 
            text = "" 
        intervals [20]:
            xmin = 35.74 
            xmax = 39.77 
            text = "Rise up- for you the flag is flung- for you the bugle trills," 
        intervals [21]:
            xmin = 39.77 
            xmax = 40.44 
            text = "" 
        intervals [22]:
            xmin = 40.44 
            xmax = 44.55 
            text = "For you bouquets and ribbon’d wreaths- for you the shores a-crowding," 
        intervals [23]:
            xmin = 44.55 
            xmax = 45.06 
            text = "" 
        intervals [24]:
            xmin = 45.06 
            xmax = 48.93 
            text = "For you they call, the swaying mass, their eager faces turning;" 
        intervals [25]:
            xmin = 48.93 
            xmax = 49.5 
            text = "" 
        intervals [26]:
            xmin = 49.5 
            xmax = 51.33 
            text = "Here Captain! dear father!" 
        intervals [27]:
            xmin = 51.33 
            xmax = 51.8 
            text = "" 
        intervals [28]:
            xmin = 51.8 
            xmax = 53.3 
            text = "This arm beneath your head!" 
        intervals [29]:
            xmin = 53.3 
            xmax = 53.87 
            text = "" 
        intervals [30]:
            xmin = 53.87 
            xmax = 55.69 
            text = "It is some dream that on the deck," 
        intervals [31]:
            xmin = 55.69 
            xmax = 56.05 
            text = "" 
        intervals [32]:
            xmin = 56.05 
            xmax = 57.74 
            text = "You’ve fallen cold and dead." 
        intervals [33]:
            xmin = 57.74 
            xmax = 59.44 
            text = "" 
        intervals [34]:
            xmin = 59.44 
            xmax = 63.4 
            text = "My Captain does not answer, his lips are pale and still," 
        intervals [35]:
            xmin = 63.4 
            xmax = 64.14 
            text = "" 
        intervals [36]:
            xmin = 64.14 
            xmax = 68.38 
            text = "My father does not feel my arm, he has no pulse nor will," 
        intervals [37]:
            xmin = 68.38 
            xmax = 69.15 
            text = "" 
        intervals [38]:
            xmin = 69.15 
            xmax = 73.35 
            text = "The ship is anchor’d safe and sound, its voyage closed and done," 
        intervals [39]:
            xmin = 73.35 
            xmax = 74.09 
            text = "" 
        intervals [40]:
            xmin = 74.09 
            xmax = 77.91 
            text = "From fearful trip the victor ship comes in with object won;" 
        intervals [41]:
            xmin = 77.91 
            xmax = 78.62 
            text = "" 
        intervals [42]:
            xmin = 78.62 
            xmax = 81.49 
            text = "Exult O shores, and ring O bells!" 
        intervals [43]:
            xmin = 81.49 
            xmax = 82.08 
            text = "" 
        intervals [44]:
            xmin = 82.08 
            xmax = 83.84 
            text = "But I with mournful tread," 
        intervals [45]:
            xmin = 83.84 
            xmax = 84.55 
            text = "" 
        intervals [46]:
            xmin = 84.55 
            xmax = 86.69 
            text = "Walk the deck my Captain lies," 
        intervals [47]:
            xmin = 86.69 
            xmax = 87.13 
            text = "" 
        intervals [48]:
            xmin = 87.13 
            xmax = 94 
            text = "Fallen cold and dead." 
        intervals [49]:
            xmin = 94 
            xmax = 94.444 
            text = "" 
