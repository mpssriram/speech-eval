    item [2]:
        class = "IntervalTier" 
        name = "sentences" 
        xmin = 0 
        xmax = 98.164 
        intervals: size = 48 
        intervals [1]:
            xmin = 0 
            xmax = 0.13 
            text = "" 
        intervals [2]:
            xmin = 0.13 
            xmax = 3.92 
            text = "O Captain! my Captain! our fearful trip is done," 
        intervals [3]:
            xmin = 3.92 
            xmax = 4.28 
            text = "" 
        intervals [4]:
            xmin = 4.28 
            xmax = 8.18 
            text = "The ship has weather’d every rack, the prize we sought is won," 
        intervals [5]:
            xmin = 8.18 
            xmax = 9.12 
            text = "" 
        intervals [6]:
            xmin = 9.12 
            xmax = 13.23 
            text = "The port is near, the bells I hear, the people all exulting," 
        intervals [7]:
            xmin = 13.23 
            xmax = 13.67 
            text = "" 
        intervals [8]:
            xmin = 13.67 
            xmax = 18.3 
            text = "While follow eyes the steady keel, the vessel grim and daring;" 
        intervals [9]:
            xmin = 18.3 
            xmax = 19.61 
            text = "" 
        intervals [10]:
            xmin = 19.61 
            xmax = 23.09 
            text = "But O heart! heart! heart!" 
        intervals [11]:
            xmin = 23.09 
            xmax = 24.09 
            text = "" 
        intervals [12]:
            xmin = 24.09 
            xmax = 26.49 
            text = "O the bleeding drops of red," 
        intervals [13]:
            xmin = 26.49 
            xmax = 27.34 
            text = "" 
        intervals [14]:
            xmin = 27.34 
            xmax = 29.77 
            text = "Where on the deck my Captain lies," 
        intervals [15]:
            xmin = 29.77 
            xmax = 30.12 
            text = "" 
        intervals [16]:
            xmin = 30.12 
            xmax = 32.02 
            text = "Fallen cold and dead." 
        intervals [17]:
            xmin = 32.02 
            xmax = 33.85 
            text = "" 
        intervals [18]:
            xmin = 33.85 
            xmax = 37.58 
            text = "O Captain! my Captain! rise up and hear the bells;" 
        intervals [19]:
            xmin = 37.58 
            xmax = 37.94 
            text = "" 
        intervals [20]:
            xmin = 37.94 
            xmax = 42.4 
            text = "Rise up- for you the flag is flung- for you the bugle trills," 
        intervals [21]:
            xmin = 42.4 
            xmax = 42.85 
            text = "" 
        intervals [22]:
            xmin = 42.85 
            xmax = 47.38 
            text = "For you bouquets and ribbon’d wreaths- for you the shores a-crowding," 
        intervals [23]:
            xmin = 47.38 
            xmax = 47.74 
            text = "" 
        intervals [24]:
            xmin = 47.74 
            xmax = 52.03 
            text = "For you they call, the swaying mass, their eager faces turning;" 
        intervals [25]:
            xmin = 52.03 
            xmax = 52.85 
            text = "" 
        intervals [26]:
            xmin = 52.85 
            xmax = 54.88 
            text = "Here Captain! dear father!" 
        intervals [27]:
            xmin = 54.88 
            xmax = 56.54 
            text = "This arm beneath your head!" 
        intervals [28]:
            xmin = 56.54 
            xmax = 56.97 
            text = "" 
        intervals [29]:
            xmin = 56.97 
            xmax = 60.18 
            text = "It is some dream that on the deck," 
        intervals [30]:
            xmin = 60.18 
            xmax = 60.49 
            text = "" 
        intervals [31]:
            xmin = 60.49 
            xmax = 62.35 
            text = "You’ve fallen cold and dead." 
        intervals [32]:
            xmin = 62.35 
            xmax = 65.06 
            text = "" 
        intervals [33]:
            xmin = 65.06 
            xmax = 69.69 
            text = "My Captain does not answer, his lips are pale and still," 
        intervals [34]:
            xmin = 69.69 
            xmax = 70.63 
            text = "" 
        intervals [35]:
            xmin = 70.63 
            xmax = 75.76 
            text = "My father does not feel my arm, he has no pulse nor will," 
        intervals [36]:
            xmin = 75.76 
            xmax = 76.78 
            text = "" 
        intervals [37]:
            xmin = 76.78 
            xmax = 80.9 
            text = "The ship is anchor’d safe and sound, its voyage closed and done," 
        intervals [38]:
            xmin = 80.9 
            xmax = 81.25 
            text = "" 
        intervals [39]:
            xmin = 81.25 
            xmax = 85.54 
            text = "From fearful trip the victor ship comes in with object won;" 
        intervals [40]:
            xmin = 85.54 
            xmax = 86.77 
            text = "" 
        intervals [41]:
            xmin = 86.77 
            xmax = 89.57 
            text = "Exult O shores, and ring O bells!" 
        intervals [42]:
            xmin = 89.57 
            xmax = 90.07 
            text = "" 
        intervals [43]:
            xmin = 90.07 
            xmax = 92.12 
            text = "But I with mournful tread," 
        intervals [44]:
            xmin = 92.12 
            xmax = 93.03 
            text = "" 
        intervals [45]:
            xmin = 93.03 
            xmax = 95.41 
            text = "Walk the deck my Captain lies," 
        intervals [46]:
            xmin = 95.41 
            xmax = 95.55 
            text = "" 
        intervals [47]:
            xmin = 95.55 
            xmax = 98.06 
            text = "Fallen cold and dead." 
        intervals [48]:
            xmin = 98.06 
            xmax = 98.164 
            text = "" 
