{
  "recording_id": "o_captain__lv_chip__orig",
  "schema": "sentence_windows/v1",
  "sentences": [
    {
      "char_end": 48,
      "char_start": 0,
      "end": 14.986,
      "i": 0,
      "interpolated_boundary": false,
      "start": 0.0,
      "text": "O Captain! my Captain! our fearful trip is done,",
      "valid": true
    },
    {
      "char_end": 111,
      "char_start": 49,
      "end": 18.961,
      "i": 1,
      "interpolated_boundary": false,
      "start": 14.686,
      "text": "The ship has weather\u2019d every rack, the prize we sought is won,",
      "valid": true
    },
    {
      "char_end": 172,
      "char_start": 112,
      "end": 23.516,
      "i": 2,
      "interpolated_boundary": false,
      "start": 18.661,
      "text": "The port is near, the bells I hear, the people all exulting,",
      "valid": true
    },
    {
      "char_end": 235,
      "char_start": 173,
      "end": 29.302,
      "i": 3,
      "interpolated_boundary": false,
      "start": 23.536,
      "text": "While follow eyes the steady keel, the vessel grim and daring;",
      "valid": true
    },
    {
      "char_end": 269,
      "char_start": 243,
      "end": 32.34,
      "i": 4,
      "interpolated_boundary": false,
      "start": 29.006,
      "text": "But O heart! heart! heart!",
      "valid": true
    },
    {
      "char_end": 307,
      "char_start": 279,
      "end": 34.813,
      "i": 5,
      "interpolated_boundary": true,
      "start": 32.04,
      "text": "O the bleeding drops of red,",
      "valid": true
    },
    {
      "char_end": 353,
      "char_start": 319,
      "end": 38.158,
      "i": 6,
      "interpolated_boundary": false,
      "start": 35.114,
      "text": "Where on the deck my Captain lies,",
      "valid": true
    },
    {
      "char_end": 388,
      "char_start": 367,
      "end": 41.562,
      "i": 7,
      "interpolated_boundary": false,
      "start": 37.858,
      "text": "Fallen cold and dead.",
      "valid": true
    },
    {
      "char_end": 439,
      "char_start": 389,
      "end": 46.429,
      "i": 8,
      "interpolated_boundary": true,
      "start": 41.263,
      "text": "O Captain! my Captain! rise up and hear the bells;",
      "valid": true
    },
    {
      "char_end": 501,
      "char_start": 440,
      "end": 50.374,
      "i": 9,
      "interpolated_boundary": false,
      "start": 46.29,
      "text": "Rise up- for you the flag is flung- for you the bugle trills,",
      "valid": true
    },
    {
      "char_end": 571,
      "char_start": 502,
      "end": 54.54,
      "i": 10,
      "interpolated_boundary": true,
      "start": 50.335,
      "text": "For you bouquets and ribbon\u2019d wreaths- for you the shores a-crowding,",
      "valid": true
    },
    {
      "char_end": 635,
      "char_start": 572,
      "end": 61.023,
      "i": 11,
      "interpolated_boundary": false,
      "start": 55.622,
      "text": "For you they call, the swaying mass, their eager faces turning;",
      "valid": true
    },
    {
      "char_end": 669,
      "char_start": 643,
      "end": 63.448,
      "i": 12,
      "interpolated_boundary": false,
      "start": 61.024,
      "text": "Here Captain! dear father!",
      "valid": true
    },
    {
      "char_end": 706,
      "char_start": 679,
      "end": 65.363,
      "i": 13,
      "interpolated_boundary": false,
      "start": 63.409,
      "text": "This arm beneath your head!",
      "valid": true
    },
    {
      "char_end": 752,
      "char_start": 718,
      "end": 67.909,
      "i": 14,
      "interpolated_boundary": true,
      "start": 65.063,
      "text": "It is some dream that on the deck,",
      "valid": true
    },
    {
      "char_end": 794,
      "char_start": 766,
      "end": 70.484,
      "i": 15,
      "interpolated_boundary": false,
      "start": 67.609,
      "text": "You\u2019ve fallen cold and dead.",
      "valid": true
    },
    {
      "char_end": 851,
      "char_start": 795,
      "end": 78.102,
      "i": 16,
      "interpolated_boundary": false,
      "start": 71.588,
      "text": "My Captain does not answer, his lips are pale and still,",
      "valid": true
    },
    {
      "char_end": 909,
      "char_start": 852,
      "end": 85.077,
      "i": 17,
      "interpolated_boundary": false,
      "start": 78.83,
      "text": "My father does not feel my arm, he has no pulse nor will,",
      "valid": true
    },
    {
      "char_end": 974,
      "char_start": 910,
      "end": 90.083,
      "i": 18,
      "interpolated_boundary": false,
      "start": 85.057,
      "text": "The ship is anchor\u2019d safe and sound, its voyage closed and done,",
      "valid": true
    },
    {
      "char_end": 1034,
      "char_start": 975,
      "end": 95.039,
      "i": 19,
      "interpolated_boundary": false,
      "start": 89.783,
      "text": "From fearful trip the victor ship comes in with object won;",
      "valid": true
    },
    {
      "char_end": 1075,
      "char_start": 1042,
      "end": 98.313,
      "i": 20,
      "interpolated_boundary": true,
      "start": 94.739,
      "text": "Exult O shores, and ring O bells!",
      "valid": true
    },
    {
      "char_end": 1111,
      "char_start": 1085,
      "end": 102.929,
      "i": 21,
      "interpolated_boundary": false,
      "start": 99.114,
      "text": "But I with mournful tread,",
      "valid": true
    },
    {
      "char_end": 1153,
      "char_start": 1123,
      "end": 105.682,
      "i": 22,
      "interpolated_boundary": false,
      "start": 102.629,
      "text": "Walk the deck my Captain lies,",
      "valid": true
    },
    {
      "char_end": 1188,
      "char_start": 1167,
      "end": 109.316,
      "i": 23,
      "interpolated_boundary": false,
      "start": 106.223,
      "text": "Fallen cold and dead.",
      "valid": true
    }
  ],
