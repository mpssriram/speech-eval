{
  "recording_id": "o_captain__lv_md__orig",
  "schema": "sentence_windows/v1",
  "sentences": [
    {
      "char_end": 48,
      "char_start": 0,
      "end": 3.935,
      "i": 0,
      "interpolated_boundary": false,
      "start": 0.0,
      "text": "O Captain! my Captain! our fearful trip is done,",
      "valid": true
    },
    {
      "char_end": 111,
      "char_start": 49,
      "end": 8.462,
      "i": 1,
      "interpolated_boundary": false,
      "start": 3.936,
      "text": "The ship has weather\u2019d every rack, the prize we sought is won,",
      "valid": true
    },
    {
      "char_end": 172,
      "char_start": 112,
      "end": 13.13,
      "i": 2,
      "interpolated_boundary": false,
      "start": 8.563,
      "text": "The port is near, the bells I hear, the people all exulting,",
      "valid": true
    },
    {
      "char_end": 235,
      "char_start": 173,
      "end": 19.318,
      "i": 3,
      "interpolated_boundary": true,
      "start": 12.829,
      "text": "While follow eyes the steady keel, the vessel grim and daring;",
      "valid": true
    },
    {
      "char_end": 269,
      "char_start": 243,
      "end": 23.244,
      "i": 4,
      "interpolated_boundary": false,
      "start": 19.64,
      "text": "But O heart! heart! heart!",
      "valid": true
    },
    {
      "char_end": 307,
      "char_start": 279,
      "end": 25.978,
      "i": 5,
      "interpolated_boundary": false,
      "start": 23.505,
      "text": "O the bleeding drops of red,",
      "valid": true
    },
    {
      "char_end": 353,
      "char_start": 319,
      "end": 29.768,
      "i": 6,
      "interpolated_boundary": true,
      "start": 25.678,
      "text": "Where on the deck my Captain lies,",
      "valid": true
    },
    {
      "char_end": 388,
      "char_start": 367,
      "end": 31.724,
      "i": 7,
      "interpolated_boundary": false,
      "start": 29.468,
      "text": "Fallen cold and dead.",
      "valid": true
    },
    {
      "char_end": 439,
      "char_start": 389,
      "end": 37.892,
      "i": 8,
      "interpolated_boundary": false,
      "start": 33.207,
      "text": "O Captain! my Captain! rise up and hear the bells;",
      "valid": true
    },
    {
      "char_end": 501,
      "char_start": 440,
      "end": 43.079,
      "i": 9,
      "interpolated_boundary": false,
      "start": 37.993,
      "text": "Rise up- for you the flag is flung- for you the bugle trills,",
      "valid": true
    },
    {
      "char_end": 571,
      "char_start": 502,
      "end": 47.084,
      "i": 10,
      "interpolated_boundary": true,
      "start": 43.02,
      "text": "For you bouquets and ribbon\u2019d wreaths- for you the shores a-crowding,",
      "valid": true
    },
    {
      "char_end": 635,
      "char_start": 572,
      "end": 52.592,
      "i": 11,
      "interpolated_boundary": false,
      "start": 47.746,
      "text": "For you they call, the swaying mass, their eager faces turning;",
      "valid": true
    },
    {
      "char_end": 669,
      "char_start": 643,
      "end": 55.255,
      "i": 12,
      "interpolated_boundary": false,
      "start": 52.652,
      "text": "Here Captain! dear father!",
      "valid": true
    },
    {
      "char_end": 706,
      "char_start": 679,
      "end": 57.558,
      "i": 13,
      "interpolated_boundary": false,
      "start": 55.076,
      "text": "This arm beneath your head!",
      "valid": true
    },
    {
      "char_end": 752,
      "char_start": 718,
      "end": 60.081,
      "i": 14,
      "interpolated_boundary": false,
      "start": 57.358,
      "text": "It is some dream that on the deck,",
      "valid": true
    },
    {
      "char_end": 794,
      "char_start": 766,
      "end": 62.204,
      "i": 15,
      "interpolated_boundary": false,
      "start": 59.781,
      "text": "You\u2019ve fallen cold and dead.",
      "valid": true
    },
    {
      "char_end": 851,
      "char_start": 795,
      "end": 68.392,
      "i": 16,
      "interpolated_boundary": false,
      "start": 63.366,
      "text": "My Captain does not answer, his lips are pale and still,",
      "valid": true
    },
    {
      "char_end": 909,
      "char_start": 852,
      "end": 73.349,
      "i": 17,
      "interpolated_boundary": false,
      "start": 68.573,
      "text": "My father does not feel my arm, he has no pulse nor will,",
      "valid": true
    },
    {
      "char_end": 974,
      "char_start": 910,
      "end": 78.867,
      "i": 18,
      "interpolated_boundary": false,
      "start": 73.049,
      "text": "The ship is anchor\u2019d safe and sound, its voyage closed and done,",
      "valid": true
    },
    {
      "char_end": 1034,
      "char_start": 975,
      "end": 83.654,
      "i": 19,
      "interpolated_boundary": false,
      "start": 79.088,
      "text": "From fearful trip the victor ship comes in with object won;",
      "valid": true
    },
    {
      "char_end": 1075,
      "char_start": 1042,
      "end": 87.933,
      "i": 20,
      "interpolated_boundary": true,
      "start": 83.353,
      "text": "Exult O shores, and ring O bells!",
      "valid": true
    },
    {
      "char_end": 1111,
      "char_start": 1085,
      "end": 90.436,
      "i": 21,
      "interpolated_boundary": false,
      "start": 87.814,
      "text": "But I with mournful tread,",
      "valid": true
    },
    {
      "char_end": 1153,
      "char_start": 1123,
      "end": 93.859,
      "i": 22,
      "interpolated_boundary": false,
      "start": 90.897,
      "text": "Walk the deck my Captain lies,",
      "valid": true
    },
    {
      "char_end": 1188,
      "char_start": 1167,
      "end": 113.028,
      "i": 23,
      "interpolated_boundary": false,
      "start": 94.0,
      "text": "Fallen cold and dead.",
      "valid": true
    }
  ],
