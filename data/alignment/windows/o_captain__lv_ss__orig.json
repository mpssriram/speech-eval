{
  "recording_id": "o_captain__lv_ss__orig",
  "schema": "sentence_windows/v1",
  "sentences": [
    {
      "char_end": 48,
      "char_start": 0,
      "end": 3.513,
      "i": 0,
      "interpolated_boundary": false,
      "start": 0.0,
      "text": "O Captain! my Captain! our fearful trip is done,",
      "valid": true
    },
    {
      "char_end": 111,
      "char_start": 49,
      "end": 7.577,
      "i": 1,
      "interpolated_boundary": false,
      "start": 3.614,
      "text": "The ship has weather\u2019d every rack, the prize we sought is won,",
      "valid": true
    },
    {
      "char_end": 172,
      "char_start": 112,
      "end": 11.722,
      "i": 2,
      "interpolated_boundary": false,
      "start": 7.578,
      "text": "The port is near, the bells I hear, the people all exulting,",
      "valid": true
    },
    {
      "char_end": 235,
      "char_start": 173,
      "end": 15.525,
      "i": 3,
      "interpolated_boundary": false,
      "start": 11.682,
      "text": "While follow eyes the steady keel, the vessel grim and daring;",
      "valid": true
    },
    {
      "char_end": 269,
      "char_start": 243,
      "end": 18.969,
      "i": 4,
      "interpolated_boundary": false,
      "start": 15.846,
      "text": "But O heart! heart! heart!",
      "valid": true
    },
    {
      "char_end": 307,
      "char_start": 279,
      "end": 20.7,
      "i": 5,
      "interpolated_boundary": false,
      "start": 18.669,
      "text": "O the bleeding drops of red,",
      "valid": true
    },
    {
      "char_end": 353,
      "char_start": 319,
      "end": 22.812,
      "i": 6,
      "interpolated_boundary": false,
      "start": 20.4,
      "text": "Where on the deck my Captain lies,",
      "valid": true
    },
    {
      "char_end": 388,
      "char_start": 367,
      "end": 24.614,
      "i": 7,
      "interpolated_boundary": false,
      "start": 22.633,
      "text": "Fallen cold and dead.",
      "valid": true
    },
    {
      "char_end": 439,
      "char_start": 389,
      "end": 28.558,
      "i": 8,
      "interpolated_boundary": false,
      "start": 25.295,
      "text": "O Captain! my Captain! rise up and hear the bells;",
      "valid": true
    },
    {
      "char_end": 501,
      "char_start": 440,
      "end": 32.321,
      "i": 9,
      "interpolated_boundary": false,
      "start": 28.498,
      "text": "Rise up- for you the flag is flung- for you the bugle trills,",
      "valid": true
    },
    {
      "char_end": 571,
      "char_start": 502,
      "end": 36.946,
      "i": 10,
      "interpolated_boundary": false,
      "start": 32.422,
      "text": "For you bouquets and ribbon\u2019d wreaths- for you the shores a-crowding,",
      "valid": true
    },
    {
      "char_end": 635,
      "char_start": 572,
      "end": 41.29,
      "i": 11,
      "interpolated_boundary": false,
      "start": 37.047,
      "text": "For you they call, the swaying mass, their eager faces turning;",
      "valid": true
    },
    {
      "char_end": 669,
      "char_start": 643,
      "end": 43.48,
      "i": 12,
      "interpolated_boundary": false,
      "start": 41.218,
      "text": "Here Captain! dear father!",
      "valid": true
    },
    {
      "char_end": 706,
      "char_start": 679,
      "end": 45.342,
      "i": 13,
      "interpolated_boundary": false,
      "start": 43.501,
      "text": "This arm beneath your head!",
      "valid": true
    },
    {
      "char_end": 752,
      "char_start": 718,
      "end": 47.705,
      "i": 14,
      "interpolated_boundary": false,
      "start": 45.523,
      "text": "It is some dream that on the deck,",
      "valid": true
    },
    {
      "char_end": 794,
      "char_start": 766,
      "end": 49.627,
      "i": 15,
      "interpolated_boundary": false,
      "start": 47.545,
      "text": "You\u2019ve fallen cold and dead.",
      "valid": true
    },
    {
      "char_end": 851,
      "char_start": 795,
      "end": 53.772,
      "i": 16,
      "interpolated_boundary": false,
      "start": 50.068,
      "text": "My Captain does not answer, his lips are pale and still,",
      "valid": true
    },
    {
      "char_end": 909,
      "char_start": 852,
      "end": 58.137,
      "i": 17,
      "interpolated_boundary": false,
      "start": 53.872,
      "text": "My father does not feel my arm, he has no pulse nor will,",
      "valid": true
    },
    {
      "char_end": 974,
      "char_start": 910,
      "end": 62.121,
      "i": 18,
      "interpolated_boundary": false,
      "start": 58.318,
      "text": "The ship is anchor\u2019d safe and sound, its voyage closed and done,",
      "valid": true
    },
    {
      "char_end": 1034,
      "char_start": 975,
      "end": 65.785,
      "i": 19,
      "interpolated_boundary": true,
      "start": 62.002,
      "text": "From fearful trip the victor ship comes in with object won;",
      "valid": true
    },
    {
      "char_end": 1075,
      "char_start": 1042,
      "end": 69.77,
      "i": 20,
      "interpolated_boundary": true,
      "start": 67.168,
      "text": "Exult O shores, and ring O bells!",
      "valid": true
    },
    {
      "char_end": 1111,
      "char_start": 1085,
      "end": 71.437,
      "i": 21,
      "interpolated_boundary": true,
      "start": 69.794,
      "text": "But I with mournful tread,",
      "valid": true
    },
    {
      "char_end": 1153,
      "char_start": 1123,
      "end": 74.124,
      "i": 22,
      "interpolated_boundary": false,
      "start": 71.899,
      "text": "Walk the deck my Captain lies,",
      "valid": true
    },
    {
      "char_end": 1188,
      "char_start": 1167,
      "end": 87.288,
      "i": 23,
      "interpolated_boundary": false,
      "start": 74.065,
      "text": "Fallen cold and dead.",
      "valid": true
    }
  ],
