{
  "recording_id": "o_captain__lv_mac__orig",
  "schema": "sentence_windows/v1",
  "sentences": [
    {
      "char_end": 48,
      "char_start": 0,
      "end": 3.054,
      "i": 0,
      "interpolated_boundary": false,
      "start": 0.0,
      "text": "O Captain! my Captain! our fearful trip is done,",
      "valid": true
    },
    {
      "char_end": 111,
      "char_start": 49,
      "end": 6.739,
      "i": 1,
      "interpolated_boundary": false,
      "start": 2.995,
      "text": "The ship has weather\u2019d every rack, the prize we sought is won,",
      "valid": true
    },
    {
      "char_end": 172,
      "char_start": 112,
      "end": 9.984,
      "i": 2,
      "interpolated_boundary": false,
      "start": 6.52,
      "text": "The port is near, the bells I hear, the people all exulting,",
      "valid": true
    },
    {
      "char_end": 235,
      "char_start": 173,
      "end": 13.85,
      "i": 3,
      "interpolated_boundary": false,
      "start": 10.005,
      "text": "While follow eyes the steady keel, the vessel grim and daring;",
      "valid": true
    },
    {
      "char_end": 269,
      "char_start": 243,
      "end": 16.374,
      "i": 4,
      "interpolated_boundary": false,
      "start": 13.911,
      "text": "But O heart! heart! heart!",
      "valid": true
    },
    {
      "char_end": 307,
      "char_start": 279,
      "end": 17.987,
      "i": 5,
      "interpolated_boundary": false,
      "start": 16.135,
      "text": "O the bleeding drops of red,",
      "valid": true
    },
    {
      "char_end": 353,
      "char_start": 319,
      "end": 19.7,
      "i": 6,
      "interpolated_boundary": false,
      "start": 17.687,
      "text": "Where on the deck my Captain lies,",
      "valid": true
    },
    {
      "char_end": 388,
      "char_start": 367,
      "end": 21.482,
      "i": 7,
      "interpolated_boundary": false,
      "start": 19.4,
      "text": "Fallen cold and dead.",
      "valid": true
    },
    {
      "char_end": 439,
      "char_start": 389,
      "end": 25.863,
      "i": 8,
      "interpolated_boundary": false,
      "start": 22.53,
      "text": "O Captain! my Captain! rise up and hear the bells;",
      "valid": true
    },
    {
      "char_end": 501,
      "char_start": 440,
      "end": 29.377,
      "i": 9,
      "interpolated_boundary": false,
      "start": 25.563,
      "text": "Rise up- for you the flag is flung- for you the bugle trills,",
      "valid": true
    },
    {
      "char_end": 571,
      "char_start": 502,
      "end": 32.7,
      "i": 10,
      "interpolated_boundary": true,
      "start": 29.317,
      "text": "For you bouquets and ribbon\u2019d wreaths- for you the shores a-crowding,",
      "valid": true
    },
    {
      "char_end": 635,
      "char_start": 572,
      "end": 36.855,
      "i": 11,
      "interpolated_boundary": false,
      "start": 33.241,
      "text": "For you they call, the swaying mass, their eager faces turning;",
      "valid": true
    },
    {
      "char_end": 669,
      "char_start": 643,
      "end": 39.468,
      "i": 12,
      "interpolated_boundary": true,
      "start": 36.555,
      "text": "Here Captain! dear father!",
      "valid": true
    },
    {
      "char_end": 706,
      "char_start": 679,
      "end": 40.949,
      "i": 13,
      "interpolated_boundary": false,
      "start": 39.168,
      "text": "This arm beneath your head!",
      "valid": true
    },
    {
      "char_end": 752,
      "char_start": 718,
      "end": 42.881,
      "i": 14,
      "interpolated_boundary": false,
      "start": 40.79,
      "text": "It is some dream that on the deck,",
      "valid": true
    },
    {
      "char_end": 794,
      "char_start": 766,
      "end": 44.693,
      "i": 15,
      "interpolated_boundary": false,
      "start": 42.581,
      "text": "You\u2019ve fallen cold and dead.",
      "valid": true
    },
    {
      "char_end": 851,
      "char_start": 795,
      "end": 49.258,
      "i": 16,
      "interpolated_boundary": false,
      "start": 45.274,
      "text": "My Captain does not answer, his lips are pale and still,",
      "valid": true
    },
    {
      "char_end": 909,
      "char_start": 852,
      "end": 53.396,
      "i": 17,
      "interpolated_boundary": false,
      "start": 49.25,
      "text": "My father does not feel my arm, he has no pulse nor will,",
      "valid": true
    },
    {
      "char_end": 974,
      "char_start": 910,
      "end": 57.583,
      "i": 18,
      "interpolated_boundary": false,
      "start": 53.577,
      "text": "The ship is anchor\u2019d safe and sound, its voyage closed and done,",
      "valid": true
    },
    {
      "char_end": 1034,
      "char_start": 975,
      "end": 61.69,
      "i": 19,
      "interpolated_boundary": false,
      "start": 57.805,
      "text": "From fearful trip the victor ship comes in with object won;",
      "valid": true
    },
    {
      "char_end": 1075,
      "char_start": 1042,
      "end": 64.154,
      "i": 20,
      "interpolated_boundary": false,
      "start": 61.491,
      "text": "Exult O shores, and ring O bells!",
      "valid": true
    },
    {
      "char_end": 1111,
      "char_start": 1085,
      "end": 66.278,
      "i": 21,
      "interpolated_boundary": false,
      "start": 64.115,
      "text": "But I with mournful tread,",
      "valid": true
    },
    {
      "char_end": 1153,
      "char_start": 1123,
      "end": 68.542,
      "i": 22,
      "interpolated_boundary": false,
      "start": 66.339,
      "text": "Walk the deck my Captain lies,",
      "valid": true
    },
    {
      "char_end": 1188,
      "char_start": 1167,
      "end": 70.595,
      "i": 23,
      "interpolated_boundary": false,
      "start": 68.322,
      "text": "Fallen cold and dead.",
      "valid": true
    }
  ],
