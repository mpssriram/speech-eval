{
  "recording_id": "o_captain__lv_s__orig",
  "schema": "sentence_windows/v1",
  "sentences": [
    {
      "char_end": 48,
      "char_start": 0,
      "end": 3.454,
      "i": 0,
      "interpolated_boundary": false,
      "start": 0.0,
      "text": "O Captain! my Captain! our fearful trip is done,",
      "valid": true
    },
    {
      "char_end": 111,
      "char_start": 49,
      "end": 7.299,
      "i": 1,
      "interpolated_boundary": false,
      "start": 3.675,
      "text": "The ship has weather\u2019d every rack, the prize we sought is won,",
      "valid": true
    },
    {
      "char_end": 172,
      "char_start": 112,
      "end": 12.065,
      "i": 2,
      "interpolated_boundary": false,
      "start": 7.7,
      "text": "The port is near, the bells I hear, the people all exulting,",
      "valid": true
    },
    {
      "char_end": 235,
      "char_start": 173,
      "end": 16.69,
      "i": 3,
      "interpolated_boundary": false,
      "start": 12.286,
      "text": "While follow eyes the steady keel, the vessel grim and daring;",
      "valid": true
    },
    {
      "char_end": 269,
      "char_start": 243,
      "end": 20.044,
      "i": 4,
      "interpolated_boundary": false,
      "start": 17.372,
      "text": "But O heart! heart! heart!",
      "valid": true
    },
    {
      "char_end": 307,
      "char_start": 279,
      "end": 22.609,
      "i": 5,
      "interpolated_boundary": true,
      "start": 19.745,
      "text": "O the bleeding drops of red,",
      "valid": true
    },
    {
      "char_end": 353,
      "char_start": 319,
      "end": 25.392,
      "i": 6,
      "interpolated_boundary": false,
      "start": 22.95,
      "text": "Where on the deck my Captain lies,",
      "valid": true
    },
    {
      "char_end": 388,
      "char_start": 367,
      "end": 27.634,
      "i": 7,
      "interpolated_boundary": false,
      "start": 25.092,
      "text": "Fallen cold and dead.",
      "valid": true
    },
    {
      "char_end": 439,
      "char_start": 389,
      "end": 32.92,
      "i": 8,
      "interpolated_boundary": true,
      "start": 27.335,
      "text": "O Captain! my Captain! rise up and hear the bells;",
      "valid": true
    },
    {
      "char_end": 501,
      "char_start": 440,
      "end": 37.205,
      "i": 9,
      "interpolated_boundary": false,
      "start": 33.101,
      "text": "Rise up- for you the flag is flung- for you the bugle trills,",
      "valid": true
    },
    {
      "char_end": 571,
      "char_start": 502,
      "end": 40.989,
      "i": 10,
      "interpolated_boundary": true,
      "start": 37.426,
      "text": "For you bouquets and ribbon\u2019d wreaths- for you the shores a-crowding,",
      "valid": true
    },
    {
      "char_end": 635,
      "char_start": 572,
      "end": 45.574,
      "i": 11,
      "interpolated_boundary": false,
      "start": 41.67,
      "text": "For you they call, the swaying mass, their eager faces turning;",
      "valid": true
    },
    {
      "char_end": 669,
      "char_start": 643,
      "end": 48.077,
      "i": 12,
      "interpolated_boundary": false,
      "start": 46.215,
      "text": "Here Captain! dear father!",
      "valid": true
    },
    {
      "char_end": 706,
      "char_start": 679,
      "end": 50.259,
      "i": 13,
      "interpolated_boundary": false,
      "start": 47.777,
      "text": "This arm beneath your head!",
      "valid": true
    },
    {
      "char_end": 752,
      "char_start": 718,
      "end": 52.929,
      "i": 14,
      "interpolated_boundary": false,
      "start": 50.507,
      "text": "It is some dream that on the deck,",
      "valid": true
    },
    {
      "char_end": 794,
      "char_start": 766,
      "end": 55.271,
      "i": 15,
      "interpolated_boundary": false,
      "start": 52.629,
      "text": "You\u2019ve fallen cold and dead.",
      "valid": true
    },
    {
      "char_end": 851,
      "char_start": 795,
      "end": 60.938,
      "i": 16,
      "interpolated_boundary": false,
      "start": 56.814,
      "text": "My Captain does not answer, his lips are pale and still,",
      "valid": true
    },
    {
      "char_end": 909,
      "char_start": 852,
      "end": 65.733,
      "i": 17,
      "interpolated_boundary": false,
      "start": 61.439,
      "text": "My father does not feel my arm, he has no pulse nor will,",
      "valid": true
    },
    {
      "char_end": 974,
      "char_start": 910,
      "end": 70.548,
      "i": 18,
      "interpolated_boundary": false,
      "start": 65.433,
      "text": "The ship is anchor\u2019d safe and sound, its voyage closed and done,",
      "valid": true
    },
    {
      "char_end": 1034,
      "char_start": 975,
      "end": 74.492,
      "i": 19,
      "interpolated_boundary": false,
      "start": 70.729,
      "text": "From fearful trip the victor ship comes in with object won;",
      "valid": true
    },
    {
      "char_end": 1075,
      "char_start": 1042,
      "end": 78.016,
      "i": 20,
      "interpolated_boundary": false,
      "start": 75.053,
      "text": "Exult O shores, and ring O bells!",
      "valid": true
    },
    {
      "char_end": 1111,
      "char_start": 1085,
      "end": 80.979,
      "i": 21,
      "interpolated_boundary": false,
      "start": 78.137,
      "text": "But I with mournful tread,",
      "valid": true
    },
    {
      "char_end": 1153,
      "char_start": 1123,
      "end": 83.784,
      "i": 22,
      "interpolated_boundary": false,
      "start": 81.099,
      "text": "Walk the deck my Captain lies,",
      "valid": true
    },
    {
      "char_end": 1188,
      "char_start": 1167,
      "end": 86.761,
      "i": 23,
      "interpolated_boundary": false,
      "start": 83.484,
      "text": "Fallen cold and dead.",
      "valid": true
    }
  ],
