{
  "recording_id": "o_captain__lv_foxits__orig",
  "schema": "sentence_windows/v1",
  "sentences": [
    {
      "char_end": 48,
      "char_start": 0,
      "end": 4.436,
      "i": 0,
      "interpolated_boundary": false,
      "start": 0.0,
      "text": "O Captain! my Captain! our fearful trip is done,",
      "valid": true
    },
    {
      "char_end": 111,
      "char_start": 49,
      "end": 9.003,
      "i": 1,
      "interpolated_boundary": false,
      "start": 4.517,
      "text": "The ship has weather\u2019d every rack, the prize we sought is won,",
      "valid": true
    },
    {
      "char_end": 172,
      "char_start": 112,
      "end": 13.39,
      "i": 2,
      "interpolated_boundary": false,
      "start": 9.204,
      "text": "The port is near, the bells I hear, the people all exulting,",
      "valid": true
    },
    {
      "char_end": 235,
      "char_start": 173,
      "end": 18.268,
      "i": 3,
      "interpolated_boundary": false,
      "start": 13.471,
      "text": "While follow eyes the steady keel, the vessel grim and daring;",
      "valid": true
    },
    {
      "char_end": 269,
      "char_start": 243,
      "end": 20.81,
      "i": 4,
      "interpolated_boundary": false,
      "start": 18.508,
      "text": "But O heart! heart! heart!",
      "valid": true
    },
    {
      "char_end": 307,
      "char_start": 279,
      "end": 23.553,
      "i": 5,
      "interpolated_boundary": true,
      "start": 20.51,
      "text": "O the bleeding drops of red,",
      "valid": true
    },
    {
      "char_end": 353,
      "char_start": 319,
      "end": 26.075,
      "i": 6,
      "interpolated_boundary": false,
      "start": 23.714,
      "text": "Where on the deck my Captain lies,",
      "valid": true
    },
    {
      "char_end": 388,
      "char_start": 367,
      "end": 27.917,
      "i": 7,
      "interpolated_boundary": false,
      "start": 25.775,
      "text": "Fallen cold and dead.",
      "valid": true
    },
    {
      "char_end": 439,
      "char_start": 389,
      "end": 33.162,
      "i": 8,
      "interpolated_boundary": true,
      "start": 27.617,
      "text": "O Captain! my Captain! rise up and hear the bells;",
      "valid": true
    },
    {
      "char_end": 501,
      "char_start": 440,
      "end": 37.747,
      "i": 9,
      "interpolated_boundary": false,
      "start": 33.323,
      "text": "Rise up- for you the flag is flung- for you the bugle trills,",
      "valid": true
    },
    {
      "char_end": 571,
      "char_start": 502,
      "end": 43.172,
      "i": 10,
      "interpolated_boundary": true,
      "start": 38.028,
      "text": "For you bouquets and ribbon\u2019d wreaths- for you the shores a-crowding,",
      "valid": true
    },
    {
      "char_end": 635,
      "char_start": 572,
      "end": 46.976,
      "i": 11,
      "interpolated_boundary": false,
      "start": 42.872,
      "text": "For you they call, the swaying mass, their eager faces turning;",
      "valid": true
    },
    {
      "char_end": 669,
      "char_start": 643,
      "end": 49.209,
      "i": 12,
      "interpolated_boundary": false,
      "start": 47.037,
      "text": "Here Captain! dear father!",
      "valid": true
    },
    {
      "char_end": 706,
      "char_start": 679,
      "end": 51.302,
      "i": 13,
      "interpolated_boundary": false,
      "start": 48.909,
      "text": "This arm beneath your head!",
      "valid": true
    },
    {
      "char_end": 752,
      "char_start": 718,
      "end": 53.725,
      "i": 14,
      "interpolated_boundary": false,
      "start": 51.463,
      "text": "It is some dream that on the deck,",
      "valid": true
    },
    {
      "char_end": 794,
      "char_start": 766,
      "end": 55.768,
      "i": 15,
      "interpolated_boundary": false,
      "start": 53.586,
      "text": "You\u2019ve fallen cold and dead.",
      "valid": true
    },
    {
      "char_end": 851,
      "char_start": 795,
      "end": 61.416,
      "i": 16,
      "interpolated_boundary": false,
      "start": 57.011,
      "text": "My Captain does not answer, his lips are pale and still,",
      "valid": true
    },
    {
      "char_end": 909,
      "char_start": 852,
      "end": 66.423,
      "i": 17,
      "interpolated_boundary": false,
      "start": 61.737,
      "text": "My father does not feel my arm, he has no pulse nor will,",
      "valid": true
    },
    {
      "char_end": 974,
      "char_start": 910,
      "end": 71.59,
      "i": 18,
      "interpolated_boundary": false,
      "start": 66.704,
      "text": "The ship is anchor\u2019d safe and sound, its voyage closed and done,",
      "valid": true
    },
    {
      "char_end": 1034,
      "char_start": 975,
      "end": 75.742,
      "i": 19,
      "interpolated_boundary": false,
      "start": 71.614,
      "text": "From fearful trip the victor ship comes in with object won;",
      "valid": true
    },
    {
      "char_end": 1075,
      "char_start": 1042,
      "end": 79.489,
      "i": 20,
      "interpolated_boundary": true,
      "start": 75.441,
      "text": "Exult O shores, and ring O bells!",
      "valid": true
    },
    {
      "char_end": 1111,
      "char_start": 1085,
      "end": 81.893,
      "i": 21,
      "interpolated_boundary": false,
      "start": 79.61,
      "text": "But I with mournful tread,",
      "valid": true
    },
    {
      "char_end": 1153,
      "char_start": 1123,
      "end": 84.639,
      "i": 22,
      "interpolated_boundary": false,
      "start": 82.115,
      "text": "Walk the deck my Captain lies,",
      "valid": true
    },
    {
      "char_end": 1188,
      "char_start": 1167,
      "end": 92.244,
      "i": 23,
      "interpolated_boundary": false,
      "start": 84.74,
      "text": "Fallen cold and dead.",
      "valid": true
    }
  ],
