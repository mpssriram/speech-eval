{
  "cut_end_s": 121.611,
  "cut_start_s": 12.307,
  "recording_id": "o_captain__lv_apc__orig",
  "schema": "sentence_windows/v1",
  "sentences": [
    {
      "char_end": 53,
      "char_start": 0,
      "end": 7.5,
      "i": 0,
      "interpolated_boundary": false,
      "start": 0.0,
      "text": "2006 O Captain! my Captain! our fearful trip is done,",
      "valid": true
    },
    {
      "char_end": 116,
      "char_start": 54,
      "end": 12.267,
      "i": 1,
      "interpolated_boundary": false,
      "start": 7.2,
      "text": "The ship has weather\u2019d every rack, the prize we sought is won,",
      "valid": true
    },
    {
      "char_end": 177,
      "char_start": 117,
      "end": 17.515,
      "i": 2,
      "interpolated_boundary": false,
      "start": 11.967,
      "text": "The port is near, the bells I hear, the people all exulting,",
      "valid": true
    },
    {
      "char_end": 240,
      "char_start": 178,
      "end": 22.912,
      "i": 3,
      "interpolated_boundary": false,
      "start": 17.507,
      "text": "While follow eyes the steady keel, the vessel grim and daring;",
      "valid": true
    },
    {
      "char_end": 274,
      "char_start": 248,
      "end": 26.345,
      "i": 4,
      "interpolated_boundary": false,
      "start": 23.393,
      "text": "But O heart! heart! heart!",
      "valid": true
    },
    {
      "char_end": 312,
      "char_start": 284,
      "end": 29.318,
      "i": 5,
      "interpolated_boundary": true,
      "start": 26.045,
      "text": "O the bleeding drops of red,",
      "valid": true
    },
    {
      "char_end": 358,
      "char_start": 324,
      "end": 31.82,
      "i": 6,
      "interpolated_boundary": false,
      "start": 29.359,
      "text": "Where on the deck my Captain lies,",
      "valid": true
    },
    {
      "char_end": 393,
      "char_start": 372,
      "end": 33.402,
      "i": 7,
      "interpolated_boundary": false,
      "start": 31.52,
      "text": "Fallen cold and dead.",
      "valid": true
    },
    {
      "char_end": 444,
      "char_start": 394,
      "end": 37.886,
      "i": 8,
      "interpolated_boundary": true,
      "start": 33.102,
      "text": "O Captain! my Captain! rise up and hear the bells;",
      "valid": true
    },
    {
      "char_end": 506,
      "char_start": 445,
      "end": 43.572,
      "i": 9,
      "interpolated_boundary": false,
      "start": 37.987,
      "text": "Rise up- for you the flag is flung- for you the bugle trills,",
      "valid": true
    },
    {
      "char_end": 576,
      "char_start": 507,
      "end": 48.341,
      "i": 10,
      "interpolated_boundary": true,
      "start": 43.672,
      "text": "For you bouquets and ribbon\u2019d wreaths- for you the shores a-crowding,",
      "valid": true
    },
    {
      "char_end": 640,
      "char_start": 577,
      "end": 54.23,
      "i": 11,
      "interpolated_boundary": false,
      "start": 48.402,
      "text": "For you they call, the swaying mass, their eager faces turning;",
      "valid": true
    },
    {
      "char_end": 674,
      "char_start": 648,
      "end": 57.416,
      "i": 12,
      "interpolated_boundary": false,
      "start": 54.472,
      "text": "Here Captain! dear father!",
      "valid": true
    },
    {
      "char_end": 711,
      "char_start": 684,
      "end": 60.18,
      "i": 13,
      "interpolated_boundary": false,
      "start": 57.116,
      "text": "This arm beneath your head!",
      "valid": true
    },
    {
      "char_end": 757,
      "char_start": 723,
      "end": 63.686,
      "i": 14,
      "interpolated_boundary": false,
      "start": 60.502,
      "text": "It is some dream that on the deck,",
      "valid": true
    },
    {
      "char_end": 799,
      "char_start": 771,
      "end": 66.871,
      "i": 15,
      "interpolated_boundary": false,
      "start": 63.907,
      "text": "You\u2019ve fallen cold and dead.",
      "valid": true
    },
    {
      "char_end": 856,
      "char_start": 800,
      "end": 73.963,
      "i": 16,
      "interpolated_boundary": false,
      "start": 68.275,
      "text": "My Captain does not answer, his lips are pale and still,",
      "valid": true
    },
    {
      "char_end": 914,
      "char_start": 857,
      "end": 80.52,
      "i": 17,
      "interpolated_boundary": false,
      "start": 74.435,
      "text": "My father does not feel my arm, he has no pulse nor will,",
      "valid": true
    },
    {
      "char_end": 979,
      "char_start": 915,
      "end": 87.407,
      "i": 18,
      "interpolated_boundary": false,
      "start": 81.242,
      "text": "The ship is anchor\u2019d safe and sound, its voyage closed and done,",
      "valid": true
    },
    {
      "char_end": 1039,
      "char_start": 980,
      "end": 94.174,
      "i": 19,
      "interpolated_boundary": false,
      "start": 88.109,
      "text": "From fearful trip the victor ship comes in with object won;",
      "valid": true
    },
    {
      "char_end": 1080,
      "char_start": 1047,
      "end": 99.219,
      "i": 20,
      "interpolated_boundary": false,
      "start": 95.176,
      "text": "Exult O shores, and ring O bells!",
      "valid": true
    },
    {
      "char_end": 1116,
      "char_start": 1090,
      "end": 103.083,
      "i": 21,
      "interpolated_boundary": false,
      "start": 99.58,
      "text": "But I with mournful tread,",
      "valid": true
    },
    {
      "char_end": 1158,
      "char_start": 1128,
      "end": 105.878,
      "i": 22,
      "interpolated_boundary": false,
      "start": 103.107,
      "text": "Walk the deck my Captain lies,",
      "valid": true
    },
    {
      "char_end": 1193,
      "char_start": 1172,
      "end": 109.304,
      "i": 23,
      "interpolated_boundary": false,
      "start": 105.578,
      "text": "Fallen cold and dead.",
      "valid": true
    }
  ],
