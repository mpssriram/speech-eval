  "sentences": [
    {
      "char_end": 69,
      "char_start": 0,
      "end": 7.5,
      "i": 0,
      "interpolated_boundary": false,
      "start": 0.0,
      "text": "two thousand and six O Captain! my Captain! our fearful trip is done,",
      "valid": true
    },
    {
      "char_end": 132,
      "char_start": 70,
      "end": 12.267,
      "i": 1,
      "interpolated_boundary": false,
      "start": 7.2,
      "text": "The ship has weather\u2019d every rack, the prize we sought is won,",
      "valid": true
    },
    {
      "char_end": 193,
      "char_start": 133,
      "end": 17.515,
      "i": 2,
      "interpolated_boundary": false,
      "start": 11.967,
      "text": "The port is near, the bells I hear, the people all exulting,",
      "valid": true
    },
    {
      "char_end": 256,
      "char_start": 194,
      "end": 22.912,
      "i": 3,
      "interpolated_boundary": false,
      "start": 17.507,
      "text": "While follow eyes the steady keel, the vessel grim and daring;",
      "valid": true
    },
    {
      "char_end": 290,
      "char_start": 264,
      "end": 26.345,
      "i": 4,
      "interpolated_boundary": false,
      "start": 23.393,
      "text": "But O heart! heart! heart!",
      "valid": true
    },
    {
      "char_end": 328,
      "char_start": 300,
      "end": 29.318,
      "i": 5,
      "interpolated_boundary": true,
      "start": 26.045,
      "text": "O the bleeding drops of red,",
      "valid": true
    },
    {
      "char_end": 374,
      "char_start": 340,
      "end": 31.82,
      "i": 6,
      "interpolated_boundary": false,
      "start": 29.359,
      "text": "Where on the deck my Captain lies,",
      "valid": true
    },
    {
      "char_end": 409,
      "char_start": 388,
      "end": 33.402,
      "i": 7,
      "interpolated_boundary": false,
      "start": 31.52,
      "text": "Fallen cold and dead.",
      "valid": true
    },
    {
      "char_end": 460,
      "char_start": 410,
      "end": 37.886,
      "i": 8,
      "interpolated_boundary": true,
      "start": 33.102,
      "text": "O Captain! my Captain! rise up and hear the bells;",
      "valid": true
    },
    {
      "char_end": 522,
      "char_start": 461,
      "end": 43.572,
      "i": 9,
      "interpolated_boundary": false,
      "start": 37.987,
      "text": "Rise up- for you the flag is flung- for you the bugle trills,",
      "valid": true
    },
    {
      "char_end": 592,
      "char_start": 523,
      "end": 48.341,
      "i": 10,
      "interpolated_boundary": true,
      "start": 43.672,
      "text": "For you bouquets and ribbon\u2019d wreaths- for you the shores a-crowding,",
      "valid": true
    },
    {
      "char_end": 656,
      "char_start": 593,
      "end": 54.23,
      "i": 11,
      "interpolated_boundary": false,
      "start": 48.402,
      "text": "For you they call, the swaying mass, their eager faces turning;",
      "valid": true
    },
    {
      "char_end": 690,
      "char_start": 664,
      "end": 57.416,
      "i": 12,
      "interpolated_boundary": false,
      "start": 54.472,
      "text": "Here Captain! dear father!",
      "valid": true
    },
    {
      "char_end": 727,
      "char_start": 700,
      "end": 60.18,
      "i": 13,
      "interpolated_boundary": false,
      "start": 57.116,
      "text": "This arm beneath your head!",
      "valid": true
    },
    {
      "char_end": 773,
      "char_start": 739,
      "end": 63.686,
      "i": 14,
      "interpolated_boundary": false,
      "start": 60.502,
      "text": "It is some dream that on the deck,",
      "valid": true
    },
    {
      "char_end": 815,
      "char_start": 787,
      "end": 66.871,
      "i": 15,
      "interpolated_boundary": false,
      "start": 63.907,
      "text": "You\u2019ve fallen cold and dead.",
      "valid": true
    },
    {
      "char_end": 872,
      "char_start": 816,
      "end": 73.963,
      "i": 16,
      "interpolated_boundary": false,
      "start": 68.275,
      "text": "My Captain does not answer, his lips are pale and still,",
      "valid": true
    },
    {
      "char_end": 930,
      "char_start": 873,
      "end": 80.52,
      "i": 17,
      "interpolated_boundary": false,
      "start": 74.435,
      "text": "My father does not feel my arm, he has no pulse nor will,",
      "valid": true
    },
    {
      "char_end": 995,
      "char_start": 931,
      "end": 87.407,
      "i": 18,
      "interpolated_boundary": false,
      "start": 81.242,
      "text": "The ship is anchor\u2019d safe and sound, its voyage closed and done,",
      "valid": true
    },
    {
      "char_end": 1055,
      "char_start": 996,
      "end": 94.174,
      "i": 19,
      "interpolated_boundary": false,
      "start": 88.109,
      "text": "From fearful trip the victor ship comes in with object won;",
      "valid": true
    },
    {
      "char_end": 1096,
      "char_start": 1063,
      "end": 99.219,
      "i": 20,
      "interpolated_boundary": false,
      "start": 95.176,
      "text": "Exult O shores, and ring O bells!",
      "valid": true
    },
    {
      "char_end": 1132,
      "char_start": 1106,
      "end": 103.083,
      "i": 21,
      "interpolated_boundary": false,
      "start": 99.58,
      "text": "But I with mournful tread,",
      "valid": true
    },
    {
      "char_end": 1174,
      "char_start": 1144,
      "end": 105.878,
      "i": 22,
      "interpolated_boundary": false,
      "start": 103.107,
      "text": "Walk the deck my Captain lies,",
      "valid": true
    },
    {
      "char_end": 1209,
      "char_start": 1188,
      "end": 109.304,
      "i": 23,
      "interpolated_boundary": false,
      "start": 105.578,
      "text": "Fallen cold and dead.",
      "valid": true
    }
  ],
