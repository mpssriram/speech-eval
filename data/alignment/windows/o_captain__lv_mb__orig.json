{
  "recording_id": "o_captain__lv_mb__orig",
  "schema": "sentence_windows/v1",
  "sentences": [
    {
      "char_end": 48,
      "char_start": 0,
      "end": 3.494,
      "i": 0,
      "interpolated_boundary": false,
      "start": 0.0,
      "text": "O Captain! my Captain! our fearful trip is done,",
      "valid": true
    },
    {
      "char_end": 111,
      "char_start": 49,
      "end": 8.019,
      "i": 1,
      "interpolated_boundary": false,
      "start": 3.194,
      "text": "The ship has weather\u2019d every rack, the prize we sought is won,",
      "valid": true
    },
    {
      "char_end": 172,
      "char_start": 112,
      "end": 12.309,
      "i": 2,
      "interpolated_boundary": false,
      "start": 7.883,
      "text": "The port is near, the bells I hear, the people all exulting,",
      "valid": true
    },
    {
      "char_end": 235,
      "char_start": 173,
      "end": 16.775,
      "i": 3,
      "interpolated_boundary": false,
      "start": 12.33,
      "text": "While follow eyes the steady keel, the vessel grim and daring;",
      "valid": true
    },
    {
      "char_end": 269,
      "char_start": 243,
      "end": 19.049,
      "i": 4,
      "interpolated_boundary": false,
      "start": 16.796,
      "text": "But O heart! heart! heart!",
      "valid": true
    },
    {
      "char_end": 307,
      "char_start": 279,
      "end": 21.402,
      "i": 5,
      "interpolated_boundary": true,
      "start": 18.749,
      "text": "O the bleeding drops of red,",
      "valid": true
    },
    {
      "char_end": 353,
      "char_start": 319,
      "end": 23.606,
      "i": 6,
      "interpolated_boundary": false,
      "start": 21.263,
      "text": "Where on the deck my Captain lies,",
      "valid": true
    },
    {
      "char_end": 388,
      "char_start": 367,
      "end": 25.328,
      "i": 7,
      "interpolated_boundary": false,
      "start": 23.306,
      "text": "Fallen cold and dead.",
      "valid": true
    },
    {
      "char_end": 439,
      "char_start": 389,
      "end": 30.075,
      "i": 8,
      "interpolated_boundary": true,
      "start": 25.029,
      "text": "O Captain! my Captain! rise up and hear the bells;",
      "valid": true
    },
    {
      "char_end": 501,
      "char_start": 440,
      "end": 35.123,
      "i": 9,
      "interpolated_boundary": false,
      "start": 30.176,
      "text": "Rise up- for you the flag is flung- for you the bugle trills,",
      "valid": true
    },
    {
      "char_end": 571,
      "char_start": 502,
      "end": 39.511,
      "i": 10,
      "interpolated_boundary": false,
      "start": 34.827,
      "text": "For you bouquets and ribbon\u2019d wreaths- for you the shores a-crowding,",
      "valid": true
    },
    {
      "char_end": 635,
      "char_start": 572,
      "end": 44.276,
      "i": 11,
      "interpolated_boundary": false,
      "start": 39.612,
      "text": "For you they call, the swaying mass, their eager faces turning;",
      "valid": true
    },
    {
      "char_end": 669,
      "char_start": 643,
      "end": 46.879,
      "i": 12,
      "interpolated_boundary": false,
      "start": 44.477,
      "text": "Here Captain! dear father!",
      "valid": true
    },
    {
      "char_end": 706,
      "char_start": 679,
      "end": 48.721,
      "i": 13,
      "interpolated_boundary": false,
      "start": 46.759,
      "text": "This arm beneath your head!",
      "valid": true
    },
    {
      "char_end": 752,
      "char_start": 718,
      "end": 51.203,
      "i": 14,
      "interpolated_boundary": false,
      "start": 48.821,
      "text": "It is some dream that on the deck,",
      "valid": true
    },
    {
      "char_end": 794,
      "char_start": 766,
      "end": 53.285,
      "i": 15,
      "interpolated_boundary": false,
      "start": 51.084,
      "text": "You\u2019ve fallen cold and dead.",
      "valid": true
    },
    {
      "char_end": 851,
      "char_start": 795,
      "end": 58.05,
      "i": 16,
      "interpolated_boundary": false,
      "start": 54.107,
      "text": "My Captain does not answer, his lips are pale and still,",
      "valid": true
    },
    {
      "char_end": 909,
      "char_start": 852,
      "end": 62.835,
      "i": 17,
      "interpolated_boundary": false,
      "start": 58.311,
      "text": "My father does not feel my arm, he has no pulse nor will,",
      "valid": true
    },
    {
      "char_end": 974,
      "char_start": 910,
      "end": 67.254,
      "i": 18,
      "interpolated_boundary": false,
      "start": 62.827,
      "text": "The ship is anchor\u2019d safe and sound, its voyage closed and done,",
      "valid": true
    },
    {
      "char_end": 1034,
      "char_start": 975,
      "end": 71.721,
      "i": 19,
      "interpolated_boundary": false,
      "start": 67.335,
      "text": "From fearful trip the victor ship comes in with object won;",
      "valid": true
    },
    {
      "char_end": 1075,
      "char_start": 1042,
      "end": 75.067,
      "i": 20,
      "interpolated_boundary": false,
      "start": 72.123,
      "text": "Exult O shores, and ring O bells!",
      "valid": true
    },
    {
      "char_end": 1111,
      "char_start": 1085,
      "end": 77.211,
      "i": 21,
      "interpolated_boundary": false,
      "start": 75.048,
      "text": "But I with mournful tread,",
      "valid": true
    },
    {
      "char_end": 1153,
      "char_start": 1123,
      "end": 79.675,
      "i": 22,
      "interpolated_boundary": false,
      "start": 77.172,
      "text": "Walk the deck my Captain lies,",
      "valid": true
    },
    {
      "char_end": 1188,
      "char_start": 1167,
      "end": 81.869,
      "i": 23,
      "interpolated_boundary": false,
      "start": 79.556,
      "text": "Fallen cold and dead.",
      "valid": true
    }
  ],
