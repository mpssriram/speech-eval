{
  "recording_id": "o_captain__lv_jtm__orig",
  "schema": "sentence_windows/v1",
  "sentences": [
    {
      "char_end": 48,
      "char_start": 0,
      "end": 4.135,
      "i": 0,
      "interpolated_boundary": false,
      "start": 0.0,
      "text": "O Captain! my Captain! our fearful trip is done,",
      "valid": true
    },
    {
      "char_end": 111,
      "char_start": 49,
      "end": 8.462,
      "i": 1,
      "interpolated_boundary": false,
      "start": 4.036,
      "text": "The ship has weather\u2019d every rack, the prize we sought is won,",
      "valid": true
    },
    {
      "char_end": 172,
      "char_start": 112,
      "end": 13.489,
      "i": 2,
      "interpolated_boundary": false,
      "start": 8.883,
      "text": "The port is near, the bells I hear, the people all exulting,",
      "valid": true
    },
    {
      "char_end": 235,
      "char_start": 173,
      "end": 18.677,
      "i": 3,
      "interpolated_boundary": false,
      "start": 13.43,
      "text": "While follow eyes the steady keel, the vessel grim and daring;",
      "valid": true
    },
    {
      "char_end": 269,
      "char_start": 243,
      "end": 23.705,
      "i": 4,
      "interpolated_boundary": false,
      "start": 19.309,
      "text": "But O heart! heart! heart!",
      "valid": true
    },
    {
      "char_end": 307,
      "char_start": 279,
      "end": 26.719,
      "i": 5,
      "interpolated_boundary": true,
      "start": 23.405,
      "text": "O the bleeding drops of red,",
      "valid": true
    },
    {
      "char_end": 353,
      "char_start": 319,
      "end": 29.923,
      "i": 6,
      "interpolated_boundary": false,
      "start": 27.1,
      "text": "Where on the deck my Captain lies,",
      "valid": true
    },
    {
      "char_end": 388,
      "char_start": 367,
      "end": 31.977,
      "i": 7,
      "interpolated_boundary": false,
      "start": 29.904,
      "text": "Fallen cold and dead.",
      "valid": true
    },
    {
      "char_end": 439,
      "char_start": 389,
      "end": 37.815,
      "i": 8,
      "interpolated_boundary": true,
      "start": 31.677,
      "text": "O Captain! my Captain! rise up and hear the bells;",
      "valid": true
    },
    {
      "char_end": 501,
      "char_start": 440,
      "end": 42.561,
      "i": 9,
      "interpolated_boundary": false,
      "start": 37.735,
      "text": "Rise up- for you the flag is flung- for you the bugle trills,",
      "valid": true
    },
    {
      "char_end": 571,
      "char_start": 502,
      "end": 47.008,
      "i": 10,
      "interpolated_boundary": true,
      "start": 42.662,
      "text": "For you bouquets and ribbon\u2019d wreaths- for you the shores a-crowding,",
      "valid": true
    },
    {
      "char_end": 635,
      "char_start": 572,
      "end": 52.196,
      "i": 11,
      "interpolated_boundary": false,
      "start": 47.469,
      "text": "For you they call, the swaying mass, their eager faces turning;",
      "valid": true
    },
    {
      "char_end": 669,
      "char_start": 643,
      "end": 55.011,
      "i": 12,
      "interpolated_boundary": false,
      "start": 52.637,
      "text": "Here Captain! dear father!",
      "valid": true
    },
    {
      "char_end": 706,
      "char_start": 679,
      "end": 56.563,
      "i": 13,
      "interpolated_boundary": false,
      "start": 54.711,
      "text": "This arm beneath your head!",
      "valid": true
    },
    {
      "char_end": 752,
      "char_start": 718,
      "end": 59.488,
      "i": 14,
      "interpolated_boundary": false,
      "start": 56.263,
      "text": "It is some dream that on the deck,",
      "valid": true
    },
    {
      "char_end": 794,
      "char_start": 766,
      "end": 61.611,
      "i": 15,
      "interpolated_boundary": false,
      "start": 59.288,
      "text": "You\u2019ve fallen cold and dead.",
      "valid": true
    },
    {
      "char_end": 851,
      "char_start": 795,
      "end": 68.923,
      "i": 16,
      "interpolated_boundary": false,
      "start": 63.916,
      "text": "My Captain does not answer, his lips are pale and still,",
      "valid": true
    },
    {
      "char_end": 909,
      "char_start": 852,
      "end": 75.093,
      "i": 17,
      "interpolated_boundary": false,
      "start": 69.465,
      "text": "My father does not feel my arm, he has no pulse nor will,",
      "valid": true
    },
    {
      "char_end": 974,
      "char_start": 910,
      "end": 80.178,
      "i": 18,
      "interpolated_boundary": false,
      "start": 75.533,
      "text": "The ship is anchor\u2019d safe and sound, its voyage closed and done,",
      "valid": true
    },
    {
      "char_end": 1034,
      "char_start": 975,
      "end": 84.613,
      "i": 19,
      "interpolated_boundary": false,
      "start": 80.058,
      "text": "From fearful trip the victor ship comes in with object won;",
      "valid": true
    },
    {
      "char_end": 1075,
      "char_start": 1042,
      "end": 88.768,
      "i": 20,
      "interpolated_boundary": true,
      "start": 84.313,
      "text": "Exult O shores, and ring O bells!",
      "valid": true
    },
    {
      "char_end": 1111,
      "char_start": 1085,
      "end": 91.231,
      "i": 21,
      "interpolated_boundary": false,
      "start": 88.869,
      "text": "But I with mournful tread,",
      "valid": true
    },
    {
      "char_end": 1153,
      "char_start": 1123,
      "end": 94.595,
      "i": 22,
      "interpolated_boundary": false,
      "start": 90.931,
      "text": "Walk the deck my Captain lies,",
      "valid": true
    },
    {
      "char_end": 1188,
      "char_start": 1167,
      "end": 97.208,
      "i": 23,
      "interpolated_boundary": false,
      "start": 94.355,
      "text": "Fallen cold and dead.",
      "valid": true
    }
  ],
