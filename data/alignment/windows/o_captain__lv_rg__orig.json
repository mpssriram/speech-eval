{
  "recording_id": "o_captain__lv_rg__orig",
  "schema": "sentence_windows/v1",
  "sentences": [
    {
      "char_end": 48,
      "char_start": 0,
      "end": 4.314,
      "i": 0,
      "interpolated_boundary": true,
      "start": 0.21,
      "text": "O Captain! my Captain! our fearful trip is done,",
      "valid": true
    },
    {
      "char_end": 111,
      "char_start": 49,
      "end": 9.038,
      "i": 1,
      "interpolated_boundary": false,
      "start": 4.014,
      "text": "The ship has weather\u2019d every rack, the prize we sought is won,",
      "valid": true
    },
    {
      "char_end": 172,
      "char_start": 112,
      "end": 14.103,
      "i": 2,
      "interpolated_boundary": false,
      "start": 9.559,
      "text": "The port is near, the bells I hear, the people all exulting,",
      "valid": true
    },
    {
      "char_end": 235,
      "char_start": 173,
      "end": 19.127,
      "i": 3,
      "interpolated_boundary": false,
      "start": 14.504,
      "text": "While follow eyes the steady keel, the vessel grim and daring;",
      "valid": true
    },
    {
      "char_end": 269,
      "char_start": 243,
      "end": 22.36,
      "i": 4,
      "interpolated_boundary": false,
      "start": 19.669,
      "text": "But O heart! heart! heart!",
      "valid": true
    },
    {
      "char_end": 307,
      "char_start": 279,
      "end": 25.133,
      "i": 5,
      "interpolated_boundary": true,
      "start": 22.061,
      "text": "O the bleeding drops of red,",
      "valid": true
    },
    {
      "char_end": 353,
      "char_start": 319,
      "end": 27.816,
      "i": 6,
      "interpolated_boundary": false,
      "start": 25.434,
      "text": "Where on the deck my Captain lies,",
      "valid": true
    },
    {
      "char_end": 388,
      "char_start": 367,
      "end": 30.358,
      "i": 7,
      "interpolated_boundary": false,
      "start": 27.516,
      "text": "Fallen cold and dead.",
      "valid": true
    },
    {
      "char_end": 439,
      "char_start": 389,
      "end": 35.651,
      "i": 8,
      "interpolated_boundary": false,
      "start": 31.566,
      "text": "O Captain! my Captain! rise up and hear the bells;",
      "valid": true
    },
    {
      "char_end": 501,
      "char_start": 440,
      "end": 40.78,
      "i": 9,
      "interpolated_boundary": false,
      "start": 36.013,
      "text": "Rise up- for you the flag is flung- for you the bugle trills,",
      "valid": true
    },
    {
      "char_end": 571,
      "char_start": 502,
      "end": 46.008,
      "i": 10,
      "interpolated_boundary": false,
      "start": 40.901,
      "text": "For you bouquets and ribbon\u2019d wreaths- for you the shores a-crowding,",
      "valid": true
    },
    {
      "char_end": 635,
      "char_start": 572,
      "end": 50.715,
      "i": 11,
      "interpolated_boundary": false,
      "start": 46.189,
      "text": "For you they call, the swaying mass, their eager faces turning;",
      "valid": true
    },
    {
      "char_end": 669,
      "char_start": 643,
      "end": 53.51,
      "i": 12,
      "interpolated_boundary": false,
      "start": 51.397,
      "text": "Here Captain! dear father!",
      "valid": true
    },
    {
      "char_end": 706,
      "char_start": 679,
      "end": 55.303,
      "i": 13,
      "interpolated_boundary": false,
      "start": 53.21,
      "text": "This arm beneath your head!",
      "valid": true
    },
    {
      "char_end": 752,
      "char_start": 718,
      "end": 57.947,
      "i": 14,
      "interpolated_boundary": false,
      "start": 55.003,
      "text": "It is some dream that on the deck,",
      "valid": true
    },
    {
      "char_end": 794,
      "char_start": 766,
      "end": 60.15,
      "i": 15,
      "interpolated_boundary": false,
      "start": 57.867,
      "text": "You\u2019ve fallen cold and dead.",
      "valid": true
    },
    {
      "char_end": 851,
      "char_start": 795,
      "end": 65.506,
      "i": 16,
      "interpolated_boundary": false,
      "start": 60.782,
      "text": "My Captain does not answer, his lips are pale and still,",
      "valid": true
    },
    {
      "char_end": 909,
      "char_start": 852,
      "end": 70.531,
      "i": 17,
      "interpolated_boundary": false,
      "start": 65.987,
      "text": "My father does not feel my arm, he has no pulse nor will,",
      "valid": true
    },
    {
      "char_end": 974,
      "char_start": 910,
      "end": 75.936,
      "i": 18,
      "interpolated_boundary": false,
      "start": 71.472,
      "text": "The ship is anchor\u2019d safe and sound, its voyage closed and done,",
      "valid": true
    },
    {
      "char_end": 1034,
      "char_start": 975,
      "end": 80.901,
      "i": 19,
      "interpolated_boundary": true,
      "start": 75.636,
      "text": "From fearful trip the victor ship comes in with object won;",
      "valid": true
    },
    {
      "char_end": 1075,
      "char_start": 1042,
      "end": 84.745,
      "i": 20,
      "interpolated_boundary": false,
      "start": 80.641,
      "text": "Exult O shores, and ring O bells!",
      "valid": true
    },
    {
      "char_end": 1111,
      "char_start": 1085,
      "end": 86.987,
      "i": 21,
      "interpolated_boundary": false,
      "start": 84.805,
      "text": "But I with mournful tread,",
      "valid": true
    },
    {
      "char_end": 1153,
      "char_start": 1123,
      "end": 90.07,
      "i": 22,
      "interpolated_boundary": false,
      "start": 87.328,
      "text": "Walk the deck my Captain lies,",
      "valid": true
    },
    {
      "char_end": 1188,
      "char_start": 1167,
      "end": 92.089,
      "i": 23,
      "interpolated_boundary": false,
      "start": 89.87,
      "text": "Fallen cold and dead.",
      "valid": true
    }
  ],
