    item [2]:
        class = "IntervalTier" 
        name = "sentences" 
        xmin = 0 
        xmax = 96.823 
        intervals: size = 48 
        intervals [1]:
            xmin = 0 
            xmax = 0.05 
            text = "" 
        intervals [2]:
            xmin = 0.05 
            xmax = 3.9 
            text = "O Captain! my Captain! our fearful trip is done," 
        intervals [3]:
            xmin = 3.9 
            xmax = 4.53 
            text = "" 
        intervals [4]:
            xmin = 4.53 
            xmax = 7.64 
            text = "The ship has weather’d every rack, the prize we sought is won," 
        intervals [5]:
            xmin = 7.64 
            xmax = 8.56 
            text = "" 
        intervals [6]:
            xmin = 8.56 
            xmax = 11.45 
            text = "The port is near, the bells I hear, the people all exulting," 
        intervals [7]:
            xmin = 11.45 
            xmax = 11.9 
            text = "" 
        intervals [8]:
            xmin = 11.9 
            xmax = 15.63 
            text = "While follow eyes the steady keel, the vessel grim and daring;" 
        intervals [9]:
            xmin = 15.63 
            xmax = 17.4 
            text = "" 
        intervals [10]:
            xmin = 17.4 
            xmax = 20.99 
            text = "But O heart! heart! heart!" 
        intervals [11]:
            xmin = 20.99 
            xmax = 22.53 
            text = "" 
        intervals [12]:
            xmin = 22.53 
            xmax = 24.27 
            text = "O the bleeding drops of red," 
        intervals [13]:
            xmin = 24.27 
            xmax = 25.29 
            text = "" 
        intervals [14]:
            xmin = 25.29 
            xmax = 27.22 
            text = "Where on the deck my Captain lies," 
        intervals [15]:
            xmin = 27.22 
            xmax = 28.62 
            text = "Fallen cold and dead." 
        intervals [16]:
            xmin = 28.62 
            xmax = 30.62 
            text = "" 
        intervals [17]:
            xmin = 30.62 
            xmax = 34.2 
            text = "O Captain! my Captain! rise up and hear the bells;" 
        intervals [18]:
            xmin = 34.2 
            xmax = 34.46 
            text = "" 
        intervals [19]:
            xmin = 34.46 
            xmax = 37.98 
            text = "Rise up- for you the flag is flung- for you the bugle trills," 
        intervals [20]:
            xmin = 37.98 
            xmax = 38.62 
            text = "" 
        intervals [21]:
            xmin = 38.62 
            xmax = 42.4 
            text = "For you bouquets and ribbon’d wreaths- for you the shores a-crowding," 
        intervals [22]:
            xmin = 42.4 
            xmax = 43.27 
            text = "" 
        intervals [23]:
            xmin = 43.27 
            xmax = 47.18 
            text = "For you they call, the swaying mass, their eager faces turning;" 
        intervals [24]:
            xmin = 47.18 
            xmax = 49.1 
            text = "" 
        intervals [25]:
            xmin = 49.1 
            xmax = 50.71 
            text = "Here Captain! dear father!" 
        intervals [26]:
            xmin = 50.71 
            xmax = 51.18 
            text = "" 
        intervals [27]:
            xmin = 51.18 
            xmax = 52.42 
            text = "This arm beneath your head!" 
        intervals [28]:
            xmin = 52.42 
            xmax = 53.26 
            text = "" 
        intervals [29]:
            xmin = 53.26 
            xmax = 55.04 
            text = "It is some dream that on the deck," 
        intervals [30]:
            xmin = 55.04 
            xmax = 55.19 
            text = "" 
        intervals [31]:
            xmin = 55.19 
            xmax = 56.47 
            text = "You’ve fallen cold and dead." 
        intervals [32]:
            xmin = 56.47 
            xmax = 59.06 
            text = "" 
        intervals [33]:
            xmin = 59.06 
            xmax = 63.25 
            text = "My Captain does not answer, his lips are pale and still," 
        intervals [34]:
            xmin = 63.25 
            xmax = 64.38 
            text = "" 
        intervals [35]:
            xmin = 64.38 
            xmax = 69.07 
            text = "My father does not feel my arm, he has no pulse nor will," 
        intervals [36]:
            xmin = 69.07 
            xmax = 70.9 
            text = "" 
        intervals [37]:
            xmin = 70.9 
            xmax = 75.16 
            text = "The ship is anchor’d safe and sound, its voyage closed and done," 
        intervals [38]:
            xmin = 75.16 
            xmax = 75.79 
            text = "" 
        intervals [39]:
            xmin = 75.79 
            xmax = 79.58 
            text = "From fearful trip the victor ship comes in with object won;" 
        intervals [40]:
            xmin = 79.58 
            xmax = 80.77 
            text = "" 
        intervals [41]:
            xmin = 80.77 
            xmax = 82.99 
            text = "Exult O shores, and ring O bells!" 
        intervals [42]:
            xmin = 82.99 
            xmax = 83.82 
            text = "" 
        intervals [43]:
            xmin = 83.82 
            xmax = 85.66 
            text = "But I with mournful tread," 
        intervals [44]:
            xmin = 85.66 
            xmax = 86.71 
            text = "" 
        intervals [45]:
            xmin = 86.71 
            xmax = 88.59 
            text = "Walk the deck my Captain lies," 
        intervals [46]:
            xmin = 88.59 
            xmax = 89.46 
            text = "" 
        intervals [47]:
            xmin = 89.46 
            xmax = 96.24 
            text = "Fallen cold and dead." 
        intervals [48]:
            xmin = 96.24 
            xmax = 96.823 
            text = "" 
