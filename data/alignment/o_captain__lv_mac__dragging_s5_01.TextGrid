            text = "O Captain! my Captain! our fearful trip is done," 
        intervals [3]:
            xmin = 2.84 
            xmax = 3.27 
            text = "" 
        intervals [4]:
            xmin = 3.27 
            xmax = 6.53 
            text = "The ship has weather’d every rack, the prize we sought is won," 
        intervals [5]:
            xmin = 6.53 
            xmax = 6.77 
            text = "" 
        intervals [6]:
            xmin = 6.77 
            xmax = 9.71 
            text = "The port is near, the bells I hear, the people all exulting," 
        intervals [7]:
            xmin = 9.71 
            xmax = 10.28 
            text = "" 
        intervals [8]:
            xmin = 10.28 
            xmax = 15.27 
            text = "While follow eyes the steady keel, the vessel grim and daring;" 
        intervals [9]:
            xmin = 15.27 
            xmax = 15.9 
            text = "" 
        intervals [10]:
            xmin = 15.9 
            xmax = 17.79 
            text = "But O heart! heart! heart!" 
        intervals [11]:
            xmin = 17.79 
            xmax = 18.07 
            text = "" 
        intervals [12]:
            xmin = 18.07 
            xmax = 19.52 
            text = "O the bleeding drops of red," 
        intervals [13]:
            xmin = 19.52 
            xmax = 21.21 
            text = "Where on the deck my Captain lies," 
        intervals [14]:
            xmin = 21.21 
            xmax = 22.84 
            text = "Fallen cold and dead." 
        intervals [15]:
            xmin = 22.84 
            xmax = 24.58 
            text = "" 
        intervals [16]:
            xmin = 24.58 
            xmax = 27.42 
            text = "O Captain! my Captain! rise up and hear the bells;" 
        intervals [17]:
            xmin = 27.42 
            xmax = 27.49 
            text = "" 
        intervals [18]:
            xmin = 27.49 
            xmax = 30.9 
            text = "Rise up- for you the flag is flung- for you the bugle trills," 
        intervals [19]:
            xmin = 30.9 
            xmax = 31.32 
            text = "" 
        intervals [20]:
            xmin = 31.32 
            xmax = 34.74 
            text = "For you bouquets and ribbon’d wreaths- for you the shores a-crowding," 
        intervals [21]:
            xmin = 34.74 
            xmax = 35.24 
            text = "" 
        intervals [22]:
            xmin = 35.24 
            xmax = 38.64 
            text = "For you they call, the swaying mass, their eager faces turning;" 
        intervals [23]:
            xmin = 38.64 
            xmax = 39.57 
            text = "" 
        intervals [24]:
            xmin = 39.57 
            xmax = 40.98 
            text = "Here Captain! dear father!" 
        intervals [25]:
            xmin = 40.98 
            xmax = 42.44 
            text = "This arm beneath your head!" 
        intervals [26]:
            xmin = 42.44 
            xmax = 42.74 
            text = "" 
        intervals [27]:
            xmin = 42.74 
            xmax = 44.36 
            text = "It is some dream that on the deck," 
        intervals [28]:
            xmin = 44.36 
            xmax = 44.46 
            text = "" 
        intervals [29]:
            xmin = 44.46 
            xmax = 46.12 
            text = "You’ve fallen cold and dead." 
        intervals [30]:
            xmin = 46.12 
            xmax = 47.23 
            text = "" 
        intervals [31]:
            xmin = 47.23 
            xmax = 50.61 
            text = "My Captain does not answer, his lips are pale and still," 
        intervals [32]:
            xmin = 50.61 
            xmax = 51.29 
            text = "" 
        intervals [33]:
            xmin = 51.29 
            xmax = 54.9 
            text = "My father does not feel my arm, he has no pulse nor will," 
        intervals [34]:
            xmin = 54.9 
            xmax = 55.57 
            text = "" 
        intervals [35]:
            xmin = 55.57 
            xmax = 59.07 
            text = "The ship is anchor’d safe and sound, its voyage closed and done," 
        intervals [36]:
            xmin = 59.07 
            xmax = 59.8 
            text = "" 
        intervals [37]:
            xmin = 59.8 
            xmax = 63.19 
            text = "From fearful trip the victor ship comes in with object won;" 
        intervals [38]:
            xmin = 63.19 
            xmax = 63.39 
            text = "" 
        intervals [39]:
            xmin = 63.39 
            xmax = 65.66 
            text = "Exult O shores, and ring O bells!" 
        intervals [40]:
            xmin = 65.66 
            xmax = 66.12 
            text = "" 
        intervals [41]:
            xmin = 66.12 
            xmax = 67.72 
            text = "But I with mournful tread," 
        intervals [42]:
            xmin = 67.72 
            xmax = 68.29 
            text = "" 
        intervals [43]:
            xmin = 68.29 
            xmax = 70.09 
            text = "Walk the deck my Captain lies," 
        intervals [44]:
            xmin = 70.09 
            xmax = 70.27 
            text = "" 
        intervals [45]:
            xmin = 70.27 
            xmax = 72.09 
            text = "Fallen cold and dead." 
        intervals [46]:
            xmin = 72.09 
