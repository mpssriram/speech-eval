    item [2]:
        class = "IntervalTier" 
        name = "sentences" 
        xmin = 0 
        xmax = 110.311 
        intervals: size = 45 
        intervals [1]:
            xmin = 0 
            xmax = 0.25 
            text = "" 
        intervals [2]:
            xmin = 0.25 
            xmax = 6.03 
            text = "O Captain! my Captain! our fearful trip is done," 
        intervals [3]:
            xmin = 6.03 
            xmax = 6.26 
            text = "" 
        intervals [4]:
            xmin = 6.26 
            xmax = 14.9 
            text = "The ship has weather’d every rack, the prize we sought is won," 
        intervals [5]:
            xmin = 14.9 
            xmax = 15.3 
            text = "" 
        intervals [6]:
            xmin = 15.3 
            xmax = 24.24 
            text = "The port is near, the bells I hear, the people all exulting," 
        intervals [7]:
            xmin = 24.24 
            xmax = 24.77 
            text = "" 
        intervals [8]:
            xmin = 24.77 
            xmax = 29.63 
            text = "While follow eyes the steady keel, the vessel grim and daring;" 
        intervals [9]:
            xmin = 29.63 
            xmax = 30.3 
            text = "" 
        intervals [10]:
            xmin = 30.3 
            xmax = 33.4 
            text = "But O heart! heart! heart!" 
        intervals [11]:
            xmin = 33.4 
            xmax = 35.67 
            text = "O the bleeding drops of red," 
        intervals [12]:
            xmin = 35.67 
            xmax = 36.34 
            text = "" 
        intervals [13]:
            xmin = 36.34 
            xmax = 38.96 
            text = "Where on the deck my Captain lies," 
        intervals [14]:
            xmin = 38.96 
            xmax = 39.93 
            text = "" 
        intervals [15]:
            xmin = 39.93 
            xmax = 42.53 
            text = "Fallen cold and dead." 
        intervals [16]:
            xmin = 42.53 
            xmax = 43.79 
            text = "" 
        intervals [17]:
            xmin = 43.79 
            xmax = 47.17 
            text = "O Captain! my Captain! rise up and hear the bells;" 
        intervals [18]:
            xmin = 47.17 
            xmax = 47.49 
            text = "" 
        intervals [19]:
            xmin = 47.49 
            xmax = 51.13 
            text = "Rise up- for you the flag is flung- for you the bugle trills," 
        intervals [20]:
            xmin = 51.13 
            xmax = 51.52 
            text = "" 
        intervals [21]:
            xmin = 51.52 
            xmax = 55.98 
            text = "For you bouquets and ribbon’d wreaths- for you the shores a-crowding," 
        intervals [22]:
            xmin = 55.98 
            xmax = 56.8 
            text = "" 
        intervals [23]:
            xmin = 56.8 
            xmax = 61.79 
            text = "For you they call, the swaying mass, their eager faces turning;" 
        intervals [24]:
            xmin = 61.79 
            xmax = 62.22 
            text = "" 
        intervals [25]:
            xmin = 62.22 
            xmax = 64.21 
            text = "Here Captain! dear father!" 
        intervals [26]:
            xmin = 64.21 
            xmax = 64.66 
            text = "" 
        intervals [27]:
            xmin = 64.66 
            xmax = 66.4 
            text = "This arm beneath your head!" 
        intervals [28]:
            xmin = 66.4 
            xmax = 66.43 
            text = "" 
        intervals [29]:
            xmin = 66.43 
            xmax = 68.63 
            text = "It is some dream that on the deck," 
        intervals [30]:
            xmin = 68.63 
            xmax = 68.73 
            text = "" 
        intervals [31]:
            xmin = 68.73 
            xmax = 71.1 
            text = "You’ve fallen cold and dead." 
        intervals [32]:
            xmin = 71.1 
            xmax = 72.78 
            text = "" 
        intervals [33]:
            xmin = 72.78 
            xmax = 78.58 
            text = "My Captain does not answer, his lips are pale and still," 
        intervals [34]:
            xmin = 78.58 
            xmax = 80.13 
            text = "" 
        intervals [35]:
            xmin = 80.13 
            xmax = 85.88 
            text = "My father does not feel my arm, he has no pulse nor will," 
        intervals [36]:
            xmin = 85.88 
            xmax = 86.31 
            text = "" 
        intervals [37]:
            xmin = 86.31 
            xmax = 91.01 
            text = "The ship is anchor’d safe and sound, its voyage closed and done," 
        intervals [38]:
            xmin = 91.01 
            xmax = 95.98 
            text = "From fearful trip the victor ship comes in with object won;" 
        intervals [39]:
            xmin = 95.98 
            xmax = 99.14 
            text = "Exult O shores, and ring O bells!" 
        intervals [40]:
            xmin = 99.14 
            xmax = 100.35 
            text = "" 
        intervals [41]:
            xmin = 100.35 
            xmax = 103.79 
            text = "But I with mournful tread," 
        intervals [42]:
            xmin = 103.79 
            xmax = 106.28 
            text = "Walk the deck my Captain lies," 
        intervals [43]:
            xmin = 106.28 
            xmax = 107.36 
            text = "" 
        intervals [44]:
            xmin = 107.36 
            xmax = 109.98 
            text = "Fallen cold and dead." 
        intervals [45]:
            xmin = 109.98 
            xmax = 110.311 
            text = "" 
