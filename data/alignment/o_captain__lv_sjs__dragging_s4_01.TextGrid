    item [2]:
        class = "IntervalTier" 
        name = "sentences" 
        xmin = 0 
        xmax = 98.755 
        intervals: size = 48 
        intervals [1]:
            xmin = 0 
            xmax = 0.05 
            text = "" 
        intervals [2]:
            xmin = 0.05 
            xmax = 3.9 
            text = "O Captain! my Captain! our fearful trip is done," 
        intervals [3]:
            xmin = 3.9 
            xmax = 4.53 
            text = "" 
        intervals [4]:
            xmin = 4.53 
            xmax = 8.42 
            text = "The ship has weather’d every rack, the prize we sought is won," 
        intervals [5]:
            xmin = 8.42 
            xmax = 9.34 
            text = "" 
        intervals [6]:
            xmin = 9.34 
            xmax = 13.38 
            text = "The port is near, the bells I hear, the people all exulting," 
        intervals [7]:
            xmin = 13.38 
            xmax = 13.84 
            text = "" 
        intervals [8]:
            xmin = 13.84 
            xmax = 17.57 
            text = "While follow eyes the steady keel, the vessel grim and daring;" 
        intervals [9]:
            xmin = 17.57 
            xmax = 19.33 
            text = "" 
        intervals [10]:
            xmin = 19.33 
            xmax = 22.93 
            text = "But O heart! heart! heart!" 
        intervals [11]:
            xmin = 22.93 
            xmax = 24.46 
            text = "" 
        intervals [12]:
            xmin = 24.46 
            xmax = 26.2 
            text = "O the bleeding drops of red," 
        intervals [13]:
            xmin = 26.2 
            xmax = 27.23 
            text = "" 
        intervals [14]:
            xmin = 27.23 
            xmax = 29.14 
            text = "Where on the deck my Captain lies," 
        intervals [15]:
            xmin = 29.14 
            xmax = 30.55 
            text = "Fallen cold and dead." 
        intervals [16]:
            xmin = 30.55 
            xmax = 32.56 
            text = "" 
        intervals [17]:
            xmin = 32.56 
            xmax = 36.13 
            text = "O Captain! my Captain! rise up and hear the bells;" 
        intervals [18]:
            xmin = 36.13 
            xmax = 36.4 
            text = "" 
        intervals [19]:
            xmin = 36.4 
            xmax = 39.91 
            text = "Rise up- for you the flag is flung- for you the bugle trills," 
        intervals [20]:
            xmin = 39.91 
            xmax = 40.55 
            text = "" 
        intervals [21]:
            xmin = 40.55 
            xmax = 44.31 
            text = "For you bouquets and ribbon’d wreaths- for you the shores a-crowding," 
        intervals [22]:
            xmin = 44.31 
            xmax = 45.21 
            text = "" 
        intervals [23]:
            xmin = 45.21 
            xmax = 49.11 
            text = "For you they call, the swaying mass, their eager faces turning;" 
        intervals [24]:
            xmin = 49.11 
            xmax = 51.03 
            text = "" 
        intervals [25]:
            xmin = 51.03 
            xmax = 52.64 
            text = "Here Captain! dear father!" 
        intervals [26]:
            xmin = 52.64 
            xmax = 53.11 
            text = "" 
        intervals [27]:
            xmin = 53.11 
            xmax = 54.35 
            text = "This arm beneath your head!" 
        intervals [28]:
            xmin = 54.35 
            xmax = 55.2 
            text = "" 
        intervals [29]:
            xmin = 55.2 
            xmax = 56.97 
            text = "It is some dream that on the deck," 
        intervals [30]:
            xmin = 56.97 
            xmax = 57.12 
            text = "" 
        intervals [31]:
            xmin = 57.12 
            xmax = 58.4 
            text = "You’ve fallen cold and dead." 
        intervals [32]:
            xmin = 58.4 
            xmax = 60.99 
            text = "" 
        intervals [33]:
            xmin = 60.99 
            xmax = 65.18 
            text = "My Captain does not answer, his lips are pale and still," 
        intervals [34]:
            xmin = 65.18 
            xmax = 66.31 
            text = "" 
        intervals [35]:
            xmin = 66.31 
            xmax = 71.04 
            text = "My father does not feel my arm, he has no pulse nor will," 
        intervals [36]:
            xmin = 71.04 
            xmax = 72.83 
            text = "" 
        intervals [37]:
            xmin = 72.83 
            xmax = 77.09 
            text = "The ship is anchor’d safe and sound, its voyage closed and done," 
        intervals [38]:
            xmin = 77.09 
            xmax = 77.72 
            text = "" 
        intervals [39]:
            xmin = 77.72 
            xmax = 81.51 
            text = "From fearful trip the victor ship comes in with object won;" 
        intervals [40]:
            xmin = 81.51 
            xmax = 82.7 
            text = "" 
        intervals [41]:
            xmin = 82.7 
            xmax = 84.92 
            text = "Exult O shores, and ring O bells!" 
        intervals [42]:
            xmin = 84.92 
            xmax = 85.76 
            text = "" 
        intervals [43]:
            xmin = 85.76 
            xmax = 87.59 
            text = "But I with mournful tread," 
        intervals [44]:
            xmin = 87.59 
            xmax = 88.64 
            text = "" 
        intervals [45]:
            xmin = 88.64 
            xmax = 90.52 
            text = "Walk the deck my Captain lies," 
        intervals [46]:
            xmin = 90.52 
            xmax = 91.39 
            text = "" 
        intervals [47]:
            xmin = 91.39 
            xmax = 98.17 
            text = "Fallen cold and dead." 
        intervals [48]:
            xmin = 98.17 
            xmax = 98.755 
            text = "" 
