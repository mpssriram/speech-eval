    item [2]:
        class = "IntervalTier" 
        name = "sentences" 
        xmin = 0 
        xmax = 97.845 
        intervals: size = 48 
        intervals [1]:
            xmin = 0 
            xmax = 0.05 
            text = "" 
        intervals [2]:
            xmin = 0.05 
            xmax = 3.75 
            text = "O Captain! my Captain! our fearful trip is done," 
        intervals [3]:
            xmin = 3.75 
            xmax = 4.39 
            text = "" 
        intervals [4]:
            xmin = 4.39 
            xmax = 7.51 
            text = "The ship has weather’d every rack, the prize we sought is won," 
        intervals [5]:
            xmin = 7.51 
            xmax = 8.43 
            text = "" 
        intervals [6]:
            xmin = 8.43 
            xmax = 12.47 
            text = "The port is near, the bells I hear, the people all exulting," 
        intervals [7]:
            xmin = 12.47 
            xmax = 12.93 
            text = "" 
        intervals [8]:
            xmin = 12.93 
            xmax = 16.66 
            text = "While follow eyes the steady keel, the vessel grim and daring;" 
        intervals [9]:
            xmin = 16.66 
            xmax = 18.42 
            text = "" 
        intervals [10]:
            xmin = 18.42 
            xmax = 22.02 
            text = "But O heart! heart! heart!" 
        intervals [11]:
            xmin = 22.02 
            xmax = 23.55 
            text = "" 
        intervals [12]:
            xmin = 23.55 
            xmax = 25.29 
            text = "O the bleeding drops of red," 
        intervals [13]:
            xmin = 25.29 
            xmax = 26.32 
            text = "" 
        intervals [14]:
            xmin = 26.32 
            xmax = 28.23 
            text = "Where on the deck my Captain lies," 
        intervals [15]:
            xmin = 28.23 
            xmax = 29.64 
            text = "Fallen cold and dead." 
        intervals [16]:
            xmin = 29.64 
            xmax = 31.65 
            text = "" 
        intervals [17]:
            xmin = 31.65 
            xmax = 35.22 
            text = "O Captain! my Captain! rise up and hear the bells;" 
        intervals [18]:
            xmin = 35.22 
            xmax = 35.49 
            text = "" 
        intervals [19]:
            xmin = 35.49 
            xmax = 39 
            text = "Rise up- for you the flag is flung- for you the bugle trills," 
        intervals [20]:
            xmin = 39 
            xmax = 39.64 
            text = "" 
        intervals [21]:
            xmin = 39.64 
            xmax = 43.4 
            text = "For you bouquets and ribbon’d wreaths- for you the shores a-crowding," 
        intervals [22]:
            xmin = 43.4 
            xmax = 44.3 
            text = "" 
        intervals [23]:
            xmin = 44.3 
            xmax = 48.2 
            text = "For you they call, the swaying mass, their eager faces turning;" 
        intervals [24]:
            xmin = 48.2 
            xmax = 50.12 
            text = "" 
        intervals [25]:
            xmin = 50.12 
            xmax = 51.73 
            text = "Here Captain! dear father!" 
        intervals [26]:
            xmin = 51.73 
            xmax = 52.2 
            text = "" 
        intervals [27]:
            xmin = 52.2 
            xmax = 53.44 
            text = "This arm beneath your head!" 
        intervals [28]:
            xmin = 53.44 
            xmax = 54.29 
            text = "" 
        intervals [29]:
            xmin = 54.29 
            xmax = 56.06 
            text = "It is some dream that on the deck," 
        intervals [30]:
            xmin = 56.06 
            xmax = 56.21 
            text = "" 
        intervals [31]:
            xmin = 56.21 
            xmax = 57.49 
            text = "You’ve fallen cold and dead." 
        intervals [32]:
            xmin = 57.49 
            xmax = 60.08 
            text = "" 
        intervals [33]:
            xmin = 60.08 
            xmax = 64.28 
            text = "My Captain does not answer, his lips are pale and still," 
        intervals [34]:
            xmin = 64.28 
            xmax = 65.4 
            text = "" 
        intervals [35]:
            xmin = 65.4 
            xmax = 70.13 
            text = "My father does not feel my arm, he has no pulse nor will," 
        intervals [36]:
            xmin = 70.13 
            xmax = 71.92 
            text = "" 
        intervals [37]:
            xmin = 71.92 
            xmax = 76.18 
            text = "The ship is anchor’d safe and sound, its voyage closed and done," 
        intervals [38]:
            xmin = 76.18 
            xmax = 76.81 
            text = "" 
        intervals [39]:
            xmin = 76.81 
            xmax = 80.6 
            text = "From fearful trip the victor ship comes in with object won;" 
        intervals [40]:
            xmin = 80.6 
            xmax = 81.79 
            text = "" 
        intervals [41]:
            xmin = 81.79 
            xmax = 84.01 
            text = "Exult O shores, and ring O bells!" 
        intervals [42]:
            xmin = 84.01 
            xmax = 84.85 
            text = "" 
        intervals [43]:
            xmin = 84.85 
            xmax = 86.68 
            text = "But I with mournful tread," 
        intervals [44]:
            xmin = 86.68 
            xmax = 87.73 
            text = "" 
        intervals [45]:
            xmin = 87.73 
            xmax = 89.61 
            text = "Walk the deck my Captain lies," 
        intervals [46]:
            xmin = 89.61 
            xmax = 90.48 
            text = "" 
        intervals [47]:
            xmin = 90.48 
            xmax = 97.26 
            text = "Fallen cold and dead." 
        intervals [48]:
            xmin = 97.26 
            xmax = 97.845 
            text = "" 
