    item [2]:
        class = "IntervalTier" 
        name = "sentences" 
        xmin = 0 
        xmax = 87.343 
        intervals: size = 49 
        intervals [1]:
            xmin = 0 
            xmax = 0.15 
            text = "" 
        intervals [2]:
            xmin = 0.15 
            xmax = 3.33 
            text = "O Captain! my Captain! our fearful trip is done," 
        intervals [3]:
            xmin = 3.33 
            xmax = 3.93 
            text = "" 
        intervals [4]:
            xmin = 3.93 
            xmax = 7.15 
            text = "The ship has weather’d every rack, the prize we sought is won," 
        intervals [5]:
            xmin = 7.15 
            xmax = 7.94 
            text = "" 
        intervals [6]:
            xmin = 7.94 
            xmax = 12.45 
            text = "The port is near, the bells I hear, the people all exulting," 
        intervals [7]:
            xmin = 12.45 
            xmax = 13.09 
            text = "" 
        intervals [8]:
            xmin = 13.09 
            xmax = 17.03 
            text = "While follow eyes the steady keel, the vessel grim and daring;" 
        intervals [9]:
            xmin = 17.03 
            xmax = 18.18 
            text = "" 
        intervals [10]:
            xmin = 18.18 
            xmax = 20.64 
            text = "But O heart! heart! heart!" 
        intervals [11]:
            xmin = 20.64 
            xmax = 21.32 
            text = "" 
        intervals [12]:
            xmin = 21.32 
            xmax = 23.09 
            text = "O the bleeding drops of red," 
        intervals [13]:
            xmin = 23.09 
            xmax = 23.8 
            text = "" 
        intervals [14]:
            xmin = 23.8 
            xmax = 25.98 
            text = "Where on the deck my Captain lies," 
        intervals [15]:
            xmin = 25.98 
            xmax = 26.28 
            text = "" 
        intervals [16]:
            xmin = 26.28 
            xmax = 28.38 
            text = "Fallen cold and dead." 
        intervals [17]:
            xmin = 28.38 
            xmax = 29.94 
            text = "" 
        intervals [18]:
            xmin = 29.94 
            xmax = 33.32 
            text = "O Captain! my Captain! rise up and hear the bells;" 
        intervals [19]:
            xmin = 33.32 
            xmax = 33.92 
            text = "" 
        intervals [20]:
            xmin = 33.92 
            xmax = 37.63 
            text = "Rise up- for you the flag is flung- for you the bugle trills," 
        intervals [21]:
            xmin = 37.63 
            xmax = 38.25 
            text = "" 
        intervals [22]:
            xmin = 38.25 
            xmax = 41.8 
            text = "For you bouquets and ribbon’d wreaths- for you the shores a-crowding," 
        intervals [23]:
            xmin = 41.8 
            xmax = 42.46 
            text = "" 
        intervals [24]:
            xmin = 42.46 
            xmax = 45.95 
            text = "For you they call, the swaying mass, their eager faces turning;" 
        intervals [25]:
            xmin = 45.95 
            xmax = 47.03 
            text = "" 
        intervals [26]:
            xmin = 47.03 
            xmax = 48.58 
            text = "Here Captain! dear father!" 
        intervals [27]:
            xmin = 48.58 
            xmax = 48.98 
            text = "" 
        intervals [28]:
            xmin = 48.98 
            xmax = 50.46 
            text = "This arm beneath your head!" 
        intervals [29]:
            xmin = 50.46 
            xmax = 51.38 
            text = "" 
        intervals [30]:
            xmin = 51.38 
            xmax = 53.36 
            text = "It is some dream that on the deck," 
        intervals [31]:
            xmin = 53.36 
            xmax = 53.44 
            text = "" 
        intervals [32]:
            xmin = 53.44 
            xmax = 55.7 
            text = "You’ve fallen cold and dead." 
        intervals [33]:
            xmin = 55.7 
            xmax = 57.64 
            text = "" 
        intervals [34]:
            xmin = 57.64 
            xmax = 61.38 
            text = "My Captain does not answer, his lips are pale and still," 
        intervals [35]:
            xmin = 61.38 
            xmax = 62.28 
            text = "" 
        intervals [36]:
            xmin = 62.28 
            xmax = 66.21 
            text = "My father does not feel my arm, he has no pulse nor will," 
        intervals [37]:
            xmin = 66.21 
            xmax = 67.31 
            text = "" 
        intervals [38]:
            xmin = 67.31 
            xmax = 70.92 
            text = "The ship is anchor’d safe and sound, its voyage closed and done," 
        intervals [39]:
            xmin = 70.92 
            xmax = 71.54 
            text = "" 
        intervals [40]:
            xmin = 71.54 
            xmax = 74.87 
            text = "From fearful trip the victor ship comes in with object won;" 
        intervals [41]:
            xmin = 74.87 
            xmax = 75.8 
            text = "" 
        intervals [42]:
            xmin = 75.8 
            xmax = 78.42 
            text = "Exult O shores, and ring O bells!" 
        intervals [43]:
            xmin = 78.42 
            xmax = 78.96 
            text = "" 
        intervals [44]:
            xmin = 78.96 
            xmax = 81.18 
            text = "But I with mournful tread," 
        intervals [45]:
            xmin = 81.18 
            xmax = 81.96 
            text = "" 
        intervals [46]:
            xmin = 81.96 
            xmax = 84.4 
            text = "Walk the deck my Captain lies," 
        intervals [47]:
            xmin = 84.4 
            xmax = 85.07 
            text = "" 
        intervals [48]:
            xmin = 85.07 
            xmax = 87.29 
            text = "Fallen cold and dead." 
        intervals [49]:
            xmin = 87.29 
            xmax = 87.343 
            text = "" 
