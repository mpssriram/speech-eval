    item [2]:
        class = "IntervalTier" 
        name = "sentences" 
        xmin = 0 
        xmax = 100.983 
        intervals: size = 48 
        intervals [1]:
            xmin = 0 
            xmax = 0.05 
            text = "" 
        intervals [2]:
            xmin = 0.05 
            xmax = 3.9 
            text = "O Captain! my Captain! our fearful trip is done," 
        intervals [3]:
            xmin = 3.9 
            xmax = 4.53 
            text = "" 
        intervals [4]:
            xmin = 4.53 
            xmax = 7.64 
            text = "The ship has weather’d every rack, the prize we sought is won," 
        intervals [5]:
            xmin = 7.64 
            xmax = 8.56 
            text = "" 
        intervals [6]:
            xmin = 8.56 
            xmax = 12.61 
            text = "The port is near, the bells I hear, the people all exulting," 
        intervals [7]:
            xmin = 12.61 
            xmax = 13.06 
            text = "" 
        intervals [8]:
            xmin = 13.06 
            xmax = 19.79 
            text = "While follow eyes the steady keel, the vessel grim and daring;" 
        intervals [9]:
            xmin = 19.79 
            xmax = 21.56 
            text = "" 
        intervals [10]:
            xmin = 21.56 
            xmax = 25.15 
            text = "But O heart! heart! heart!" 
        intervals [11]:
            xmin = 25.15 
            xmax = 26.69 
            text = "" 
        intervals [12]:
            xmin = 26.69 
            xmax = 28.43 
            text = "O the bleeding drops of red," 
        intervals [13]:
            xmin = 28.43 
            xmax = 29.45 
            text = "" 
        intervals [14]:
            xmin = 29.45 
            xmax = 31.37 
            text = "Where on the deck my Captain lies," 
        intervals [15]:
            xmin = 31.37 
            xmax = 32.78 
            text = "Fallen cold and dead." 
        intervals [16]:
            xmin = 32.78 
            xmax = 34.78 
            text = "" 
        intervals [17]:
            xmin = 34.78 
            xmax = 38.36 
            text = "O Captain! my Captain! rise up and hear the bells;" 
        intervals [18]:
            xmin = 38.36 
            xmax = 38.62 
            text = "" 
        intervals [19]:
            xmin = 38.62 
            xmax = 42.14 
            text = "Rise up- for you the flag is flung- for you the bugle trills," 
        intervals [20]:
            xmin = 42.14 
            xmax = 42.78 
            text = "" 
        intervals [21]:
            xmin = 42.78 
            xmax = 46.56 
            text = "For you bouquets and ribbon’d wreaths- for you the shores a-crowding," 
        intervals [22]:
            xmin = 46.56 
            xmax = 47.43 
            text = "" 
        intervals [23]:
            xmin = 47.43 
            xmax = 51.34 
            text = "For you they call, the swaying mass, their eager faces turning;" 
        intervals [24]:
            xmin = 51.34 
            xmax = 53.26 
            text = "" 
        intervals [25]:
            xmin = 53.26 
            xmax = 54.87 
            text = "Here Captain! dear father!" 
        intervals [26]:
            xmin = 54.87 
            xmax = 55.34 
            text = "" 
        intervals [27]:
            xmin = 55.34 
            xmax = 56.58 
            text = "This arm beneath your head!" 
        intervals [28]:
            xmin = 56.58 
            xmax = 57.42 
            text = "" 
        intervals [29]:
            xmin = 57.42 
            xmax = 59.2 
            text = "It is some dream that on the deck," 
        intervals [30]:
            xmin = 59.2 
            xmax = 59.35 
            text = "" 
        intervals [31]:
            xmin = 59.35 
            xmax = 60.63 
            text = "You’ve fallen cold and dead." 
        intervals [32]:
            xmin = 60.63 
            xmax = 63.22 
            text = "" 
        intervals [33]:
            xmin = 63.22 
            xmax = 67.41 
            text = "My Captain does not answer, his lips are pale and still," 
        intervals [34]:
            xmin = 67.41 
            xmax = 68.54 
            text = "" 
        intervals [35]:
            xmin = 68.54 
            xmax = 73.23 
            text = "My father does not feel my arm, he has no pulse nor will," 
        intervals [36]:
            xmin = 73.23 
            xmax = 75.06 
            text = "" 
        intervals [37]:
            xmin = 75.06 
            xmax = 79.32 
            text = "The ship is anchor’d safe and sound, its voyage closed and done," 
        intervals [38]:
            xmin = 79.32 
            xmax = 79.95 
            text = "" 
        intervals [39]:
            xmin = 79.95 
            xmax = 83.74 
            text = "From fearful trip the victor ship comes in with object won;" 
        intervals [40]:
            xmin = 83.74 
            xmax = 84.93 
            text = "" 
        intervals [41]:
            xmin = 84.93 
            xmax = 87.15 
            text = "Exult O shores, and ring O bells!" 
        intervals [42]:
            xmin = 87.15 
            xmax = 87.98 
            text = "" 
        intervals [43]:
            xmin = 87.98 
            xmax = 89.82 
            text = "But I with mournful tread," 
        intervals [44]:
            xmin = 89.82 
            xmax = 90.87 
            text = "" 
        intervals [45]:
            xmin = 90.87 
            xmax = 92.75 
            text = "Walk the deck my Captain lies," 
        intervals [46]:
            xmin = 92.75 
            xmax = 93.62 
            text = "" 
        intervals [47]:
            xmin = 93.62 
            xmax = 100.4 
            text = "Fallen cold and dead." 
        intervals [48]:
            xmin = 100.4 
            xmax = 100.983 
            text = "" 
