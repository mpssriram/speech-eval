    item [2]:
        class = "IntervalTier" 
        name = "sentences" 
        xmin = 0 
        xmax = 97.557 
        intervals: size = 48 
        intervals [1]:
            xmin = 0 
            xmax = 0.05 
            text = "" 
        intervals [2]:
            xmin = 0.05 
            xmax = 3.9 
            text = "O Captain! my Captain! our fearful trip is done," 
        intervals [3]:
            xmin = 3.9 
            xmax = 4.53 
            text = "" 
        intervals [4]:
            xmin = 4.53 
            xmax = 7.64 
            text = "The ship has weather’d every rack, the prize we sought is won," 
        intervals [5]:
            xmin = 7.64 
            xmax = 8.56 
            text = "" 
        intervals [6]:
            xmin = 8.56 
            xmax = 12.62 
            text = "The port is near, the bells I hear, the people all exulting," 
        intervals [7]:
            xmin = 12.62 
            xmax = 12.65 
            text = "" 
        intervals [8]:
            xmin = 12.65 
            xmax = 16.37 
            text = "While follow eyes the steady keel, the vessel grim and daring;" 
        intervals [9]:
            xmin = 16.37 
            xmax = 18.13 
            text = "" 
        intervals [10]:
            xmin = 18.13 
            xmax = 21.73 
            text = "But O heart! heart! heart!" 
        intervals [11]:
            xmin = 21.73 
            xmax = 23.27 
            text = "" 
        intervals [12]:
            xmin = 23.27 
            xmax = 25 
            text = "O the bleeding drops of red," 
        intervals [13]:
            xmin = 25 
            xmax = 26.03 
            text = "" 
        intervals [14]:
            xmin = 26.03 
            xmax = 27.95 
            text = "Where on the deck my Captain lies," 
        intervals [15]:
            xmin = 27.95 
            xmax = 29.35 
            text = "Fallen cold and dead." 
        intervals [16]:
            xmin = 29.35 
            xmax = 31.36 
            text = "" 
        intervals [17]:
            xmin = 31.36 
            xmax = 34.93 
            text = "O Captain! my Captain! rise up and hear the bells;" 
        intervals [18]:
            xmin = 34.93 
            xmax = 35.2 
            text = "" 
        intervals [19]:
            xmin = 35.2 
            xmax = 38.72 
            text = "Rise up- for you the flag is flung- for you the bugle trills," 
        intervals [20]:
            xmin = 38.72 
            xmax = 39.35 
            text = "" 
        intervals [21]:
            xmin = 39.35 
            xmax = 43.11 
            text = "For you bouquets and ribbon’d wreaths- for you the shores a-crowding," 
        intervals [22]:
            xmin = 43.11 
            xmax = 44 
            text = "" 
        intervals [23]:
            xmin = 44 
            xmax = 47.91 
            text = "For you they call, the swaying mass, their eager faces turning;" 
        intervals [24]:
            xmin = 47.91 
            xmax = 49.84 
            text = "" 
        intervals [25]:
            xmin = 49.84 
            xmax = 51.47 
            text = "Here Captain! dear father!" 
        intervals [26]:
            xmin = 51.47 
            xmax = 51.91 
            text = "" 
        intervals [27]:
            xmin = 51.91 
            xmax = 53.15 
            text = "This arm beneath your head!" 
        intervals [28]:
            xmin = 53.15 
            xmax = 54 
            text = "" 
        intervals [29]:
            xmin = 54 
            xmax = 55.77 
            text = "It is some dream that on the deck," 
        intervals [30]:
            xmin = 55.77 
            xmax = 55.92 
            text = "" 
        intervals [31]:
            xmin = 55.92 
            xmax = 57.2 
            text = "You’ve fallen cold and dead." 
        intervals [32]:
            xmin = 57.2 
            xmax = 59.79 
            text = "" 
        intervals [33]:
            xmin = 59.79 
            xmax = 63.99 
            text = "My Captain does not answer, his lips are pale and still," 
        intervals [34]:
            xmin = 63.99 
            xmax = 65.12 
            text = "" 
        intervals [35]:
            xmin = 65.12 
            xmax = 69.84 
            text = "My father does not feel my arm, he has no pulse nor will," 
        intervals [36]:
            xmin = 69.84 
            xmax = 71.63 
            text = "" 
        intervals [37]:
            xmin = 71.63 
            xmax = 75.89 
            text = "The ship is anchor’d safe and sound, its voyage closed and done," 
        intervals [38]:
            xmin = 75.89 
            xmax = 76.52 
            text = "" 
        intervals [39]:
            xmin = 76.52 
            xmax = 80.31 
            text = "From fearful trip the victor ship comes in with object won;" 
        intervals [40]:
            xmin = 80.31 
            xmax = 81.5 
            text = "" 
        intervals [41]:
            xmin = 81.5 
            xmax = 83.73 
            text = "Exult O shores, and ring O bells!" 
        intervals [42]:
            xmin = 83.73 
            xmax = 84.56 
            text = "" 
        intervals [43]:
            xmin = 84.56 
            xmax = 86.39 
            text = "But I with mournful tread," 
        intervals [44]:
            xmin = 86.39 
            xmax = 87.45 
            text = "" 
        intervals [45]:
            xmin = 87.45 
            xmax = 89.33 
            text = "Walk the deck my Captain lies," 
        intervals [46]:
            xmin = 89.33 
            xmax = 90.2 
            text = "" 
        intervals [47]:
            xmin = 90.2 
            xmax = 96.88 
            text = "Fallen cold and dead." 
        intervals [48]:
            xmin = 96.88 
            xmax = 97.557 
            text = "" 
