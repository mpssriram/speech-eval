        intervals [1]:
            xmin = 0 
            xmax = 0.17 
            text = "" 
        intervals [2]:
            xmin = 0.17 
            xmax = 2.84 
            text = "O Captain! my Captain! our fearful trip is done," 
        intervals [3]:
            xmin = 2.84 
            xmax = 3.27 
            text = "" 
        intervals [4]:
            xmin = 3.27 
            xmax = 6.3 
            text = "The ship has weather’d every rack, the prize we sought is won," 
        intervals [5]:
            xmin = 6.3 
            xmax = 6.54 
            text = "" 
        intervals [6]:
            xmin = 6.54 
            xmax = 9.48 
            text = "The port is near, the bells I hear, the people all exulting," 
        intervals [7]:
            xmin = 9.48 
            xmax = 10.05 
            text = "" 
        intervals [8]:
            xmin = 10.05 
            xmax = 13.28 
            text = "While follow eyes the steady keel, the vessel grim and daring;" 
        intervals [9]:
            xmin = 13.28 
            xmax = 13.93 
            text = "" 
        intervals [10]:
            xmin = 13.93 
            xmax = 15.82 
            text = "But O heart! heart! heart!" 
        intervals [11]:
            xmin = 15.82 
            xmax = 16.11 
            text = "" 
        intervals [12]:
            xmin = 16.11 
            xmax = 17.55 
            text = "O the bleeding drops of red," 
        intervals [13]:
            xmin = 17.55 
            xmax = 19.24 
            text = "Where on the deck my Captain lies," 
        intervals [14]:
            xmin = 19.24 
            xmax = 20.85 
            text = "Fallen cold and dead." 
        intervals [15]:
            xmin = 20.85 
            xmax = 22.61 
            text = "" 
        intervals [16]:
            xmin = 22.61 
            xmax = 25.46 
            text = "O Captain! my Captain! rise up and hear the bells;" 
        intervals [17]:
            xmin = 25.46 
            xmax = 25.52 
            text = "" 
        intervals [18]:
            xmin = 25.52 
            xmax = 28.94 
            text = "Rise up- for you the flag is flung- for you the bugle trills," 
        intervals [19]:
            xmin = 28.94 
            xmax = 29.35 
            text = "" 
        intervals [20]:
            xmin = 29.35 
            xmax = 32.77 
            text = "For you bouquets and ribbon’d wreaths- for you the shores a-crowding," 
        intervals [21]:
            xmin = 32.77 
            xmax = 33.28 
            text = "" 
        intervals [22]:
            xmin = 33.28 
            xmax = 36.68 
            text = "For you they call, the swaying mass, their eager faces turning;" 
        intervals [23]:
            xmin = 36.68 
            xmax = 37.6 
            text = "" 
        intervals [24]:
            xmin = 37.6 
            xmax = 39.01 
            text = "Here Captain! dear father!" 
        intervals [25]:
            xmin = 39.01 
            xmax = 40.47 
            text = "This arm beneath your head!" 
        intervals [26]:
            xmin = 40.47 
            xmax = 40.77 
            text = "" 
        intervals [27]:
            xmin = 40.77 
            xmax = 42.39 
            text = "It is some dream that on the deck," 
        intervals [28]:
            xmin = 42.39 
            xmax = 42.49 
            text = "" 
        intervals [29]:
            xmin = 42.49 
            xmax = 44.18 
            text = "You’ve fallen cold and dead." 
        intervals [30]:
            xmin = 44.18 
            xmax = 45.26 
            text = "" 
        intervals [31]:
            xmin = 45.26 
            xmax = 48.64 
            text = "My Captain does not answer, his lips are pale and still," 
        intervals [32]:
            xmin = 48.64 
            xmax = 49.32 
            text = "" 
        intervals [33]:
            xmin = 49.32 
            xmax = 52.93 
            text = "My father does not feel my arm, he has no pulse nor will," 
        intervals [34]:
            xmin = 52.93 
            xmax = 53.6 
            text = "" 
        intervals [35]:
            xmin = 53.6 
            xmax = 57.1 
            text = "The ship is anchor’d safe and sound, its voyage closed and done," 
        intervals [36]:
            xmin = 57.1 
            xmax = 57.83 
            text = "" 
        intervals [37]:
            xmin = 57.83 
            xmax = 61.23 
            text = "From fearful trip the victor ship comes in with object won;" 
        intervals [38]:
            xmin = 61.23 
            xmax = 61.42 
            text = "" 
        intervals [39]:
            xmin = 61.42 
            xmax = 63.69 
            text = "Exult O shores, and ring O bells!" 
        intervals [40]:
            xmin = 63.69 
            xmax = 64.16 
            text = "" 
        intervals [41]:
            xmin = 64.16 
            xmax = 65.75 
            text = "But I with mournful tread," 
        intervals [42]:
            xmin = 65.75 
            xmax = 66.32 
            text = "" 
        intervals [43]:
            xmin = 66.32 
            xmax = 68.13 
            text = "Walk the deck my Captain lies," 
        intervals [44]:
            xmin = 68.13 
            xmax = 68.3 
            text = "" 
        intervals [45]:
            xmin = 68.3 
            xmax = 70.12 
            text = "Fallen cold and dead." 
