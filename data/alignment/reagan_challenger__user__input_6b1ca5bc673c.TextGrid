    item [2]:
        class = "IntervalTier" 
        name = "sentences" 
        xmin = 0 
        xmax = 76.42 
        intervals: size = 35 
        intervals [1]:
            xmin = 0 
            xmax = 0.07 
            text = "" 
        intervals [2]:
            xmin = 0.07 
            xmax = 7.65 
            text = "Ladies and gentlemen, I'd planned to speak to you tonight to report on the state of the Union, but the events of earlier today have led me to change those plans." 
        intervals [3]:
            xmin = 7.65 
            xmax = 8.21 
            text = "" 
        intervals [4]:
            xmin = 8.21 
            xmax = 10.41 
            text = "Today is a day for mourning and remembering." 
        intervals [5]:
            xmin = 10.41 
            xmax = 10.83 
            text = "" 
        intervals [6]:
            xmin = 10.83 
            xmax = 15.1 
            text = "Nancy and I are pained to the core by the tragedy of the shuttle Challenger." 
        intervals [7]:
            xmin = 15.1 
            xmax = 15.58 
            text = "" 
        intervals [8]:
            xmin = 15.58 
            xmax = 18.26 
            text = "We know we share this pain with all the people of our country." 
        intervals [9]:
            xmin = 18.26 
            xmax = 18.75 
            text = "" 
        intervals [10]:
            xmin = 18.75 
            xmax = 20.22 
            text = "This is truly a national loss." 
        intervals [11]:
            xmin = 20.22 
            xmax = 20.59 
            text = "" 
        intervals [12]:
            xmin = 20.59 
            xmax = 25.54 
            text = "Nineteen years ago, almost to the day, we lost three astronauts in a terrible accident on the ground." 
        intervals [13]:
            xmin = 25.54 
            xmax = 25.92 
            text = "" 
        intervals [14]:
            xmin = 25.92 
            xmax = 27.83 
            text = "But we've never lost an astronaut in flight;" 
        intervals [15]:
            xmin = 27.83 
            xmax = 28.34 
            text = "" 
        intervals [16]:
            xmin = 28.34 
            xmax = 29.8 
            text = "We've never had a tragedy like this." 
        intervals [17]:
            xmin = 29.8 
            xmax = 30.05 
            text = "" 
        intervals [18]:
            xmin = 30.05 
            xmax = 33.51 
            text = "And perhaps we have forgotten the courage it took for the crew of the shuttle." 
        intervals [19]:
            xmin = 33.51 
            xmax = 33.94 
            text = "" 
        intervals [20]:
            xmin = 33.94 
            xmax = 39.28 
            text = "But they, the Challenger Seven, were aware of the dangers, but overcame and did their jobs brilliantly." 
        intervals [21]:
            xmin = 39.28 
            xmax = 39.78 
            text = "" 
        intervals [22]:
            xmin = 39.78 
            xmax = 41.36 
            text = "We mourn the seven heroes:" 
        intervals [23]:
            xmin = 41.36 
            xmax = 41.68 
            text = "" 
        intervals [24]:
            xmin = 41.68 
            xmax = 50.26 
            text = "Michael Smith, Dick Scobee, Judith Resnik, Ronald McNair, Ellison Onizuka, Gregory Jarvis, and Christa McAuliffe." 
        intervals [25]:
            xmin = 50.26 
            xmax = 50.86 
            text = "" 
        intervals [26]:
            xmin = 50.86 
            xmax = 52.58 
            text = "We mourn their loss as a nation together." 
        intervals [27]:
            xmin = 52.58 
            xmax = 52.85 
            text = "" 
        intervals [28]:
            xmin = 52.85 
            xmax = 57.41 
            text = "For the families of the seven, we cannot bear, as you do, the full impact of this tragedy." 
        intervals [29]:
            xmin = 57.41 
            xmax = 57.81 
            text = "" 
        intervals [30]:
            xmin = 57.81 
            xmax = 62.32 
            text = "But we feel the loss, and we are thinking about you so very much." 
        intervals [31]:
            xmin = 62.32 
            xmax = 63.06 
            text = "" 
        intervals [32]:
            xmin = 63.06 
            xmax = 72.83 
            text = "Your loved ones were daring and brave, and they had that special grace, and that special spirit that they says, ``Give me a challenge, and I'll meet it with joy.''" 
        intervals [33]:
            xmin = 72.83 
            xmax = 73.35 
            text = "" 
        intervals [34]:
            xmin = 73.35 
            xmax = 76.12 
            text = "They had a hunger to explore the universe and discover its truths." 
        intervals [35]:
            xmin = 76.12 
            xmax = 76.42 
            text = "" 
