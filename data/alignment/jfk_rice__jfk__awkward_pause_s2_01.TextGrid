    item [2]:
        class = "IntervalTier" 
        name = "sentences" 
        xmin = 0 
        xmax = 158.632 
        intervals: size = 18 
        intervals [1]:
            xmin = 0 
            xmax = 2.56 
            text = "Why, thirty-five years ago, fly the Atlantic?" 
        intervals [2]:
            xmin = 2.56 
            xmax = 3.36 
            text = "" 
        intervals [3]:
            xmin = 3.36 
            xmax = 4.88 
            text = "Why does Rice play Texas?" 
        intervals [4]:
            xmin = 4.88 
            xmax = 5.49 
            text = "" 
        intervals [5]:
            xmin = 5.49 
            xmax = 16.4 
            text = "We choose to go to the moon We choose to go to the Moon." 
        intervals [6]:
            xmin = 16.4 
            xmax = 49.01 
            text = "We choose to go to the Moon in this decade and do the other things, not because they are easy, but because they are hard, because that goal will serve to organize and measure the best of our energies and skills, because that challenge is one that we are willing to accept, one we are unwilling to postpone, and one we intend to win, and the others, too." 
        intervals [7]:
            xmin = 49.01 
            xmax = 63.6 
            text = "It is for these reasons that I regard the decision last year to shift our efforts in space from low to high gear as among the most important decisions that will be made during my incumbency in the office of the Presidency." 
        intervals [8]:
            xmin = 63.6 
            xmax = 64.55 
            text = "" 
        intervals [9]:
            xmin = 64.55 
            xmax = 74.87 
            text = "In the last twenty-four hours we have seen facilities now being created for the greatest and most complex exploration in man's history." 
        intervals [10]:
            xmin = 74.87 
            xmax = 75.9 
            text = "" 
        intervals [11]:
            xmin = 75.9 
            xmax = 94.55 
            text = "We have felt the ground shake and the air shattered by the testing of a Saturn C-one booster rocket, many times as powerful as the Atlas which launched John Glenn, generating power equivalent to ten thousand automobiles with their accelerators on the floor." 
        intervals [12]:
            xmin = 94.55 
            xmax = 95.57 
            text = "" 
        intervals [13]:
            xmin = 95.57 
            xmax = 124.5 
            text = "We have seen the site where five F-one rocket engines, each one as powerful as all eight engines of the Saturn combined, will be clustered together to make the advanced Saturn missile, assembled in a new building to be built at Cape Canaveral as tall as a forty-eight story structure, as wide as a city block, and as long as two lengths of this field." 
        intervals [14]:
            xmin = 124.5 
            xmax = 125.49 
            text = "" 
        intervals [15]:
            xmin = 125.49 
            xmax = 130.97 
            text = "Within these last nineteen months at least forty-five satellites have circled the earth." 
        intervals [16]:
            xmin = 130.97 
            xmax = 131.83 
            text = "" 
        intervals [17]:
            xmin = 131.83 
            xmax = 143.07 
            text = "Some forty of them were ""made in the United States of America"" and they were far more sophisticated and supplied far more knowledge to the people of the world than those of the Soviet Union." 
        intervals [18]:
            xmin = 143.07 
            xmax = 158.632 
            text = "The Mariner spacecraft The Mariner spacecraft now on its way to Venus is the most intricate instrument in the history of space science." 
