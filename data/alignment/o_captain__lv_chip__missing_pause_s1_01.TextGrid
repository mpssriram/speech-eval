    item [2]:
        class = "IntervalTier" 
        name = "sentences" 
        xmin = 0 
        xmax = 108.752 
        intervals: size = 44 
        intervals [1]:
            xmin = 0 
            xmax = 0.25 
            text = "" 
        intervals [2]:
            xmin = 0.25 
            xmax = 3.32 
            text = "O Captain! my Captain! our fearful trip is done," 
        intervals [3]:
            xmin = 3.32 
            xmax = 3.76 
            text = "" 
        intervals [4]:
            xmin = 3.76 
            xmax = 12.07 
            text = "The ship has weather’d every rack, the prize we sought is won," 
        intervals [5]:
            xmin = 12.07 
            xmax = 22.69 
            text = "The port is near, the bells I hear, the people all exulting," 
        intervals [6]:
            xmin = 22.69 
            xmax = 23.22 
            text = "" 
        intervals [7]:
            xmin = 23.22 
            xmax = 28.08 
            text = "While follow eyes the steady keel, the vessel grim and daring;" 
        intervals [8]:
            xmin = 28.08 
            xmax = 28.74 
            text = "" 
        intervals [9]:
            xmin = 28.74 
            xmax = 31.84 
            text = "But O heart! heart! heart!" 
        intervals [10]:
            xmin = 31.84 
            xmax = 34.11 
            text = "O the bleeding drops of red," 
        intervals [11]:
            xmin = 34.11 
            xmax = 34.78 
            text = "" 
        intervals [12]:
            xmin = 34.78 
            xmax = 37.4 
            text = "Where on the deck my Captain lies," 
        intervals [13]:
            xmin = 37.4 
            xmax = 38.37 
            text = "" 
        intervals [14]:
            xmin = 38.37 
            xmax = 40.98 
            text = "Fallen cold and dead." 
        intervals [15]:
            xmin = 40.98 
            xmax = 42.23 
            text = "" 
        intervals [16]:
            xmin = 42.23 
            xmax = 45.61 
            text = "O Captain! my Captain! rise up and hear the bells;" 
        intervals [17]:
            xmin = 45.61 
            xmax = 45.94 
            text = "" 
        intervals [18]:
            xmin = 45.94 
            xmax = 49.57 
            text = "Rise up- for you the flag is flung- for you the bugle trills," 
        intervals [19]:
            xmin = 49.57 
            xmax = 49.97 
            text = "" 
        intervals [20]:
            xmin = 49.97 
            xmax = 54.42 
            text = "For you bouquets and ribbon’d wreaths- for you the shores a-crowding," 
        intervals [21]:
            xmin = 54.42 
            xmax = 55.24 
            text = "" 
        intervals [22]:
            xmin = 55.24 
            xmax = 60.23 
            text = "For you they call, the swaying mass, their eager faces turning;" 
        intervals [23]:
            xmin = 60.23 
            xmax = 60.65 
            text = "" 
        intervals [24]:
            xmin = 60.65 
            xmax = 62.66 
            text = "Here Captain! dear father!" 
        intervals [25]:
            xmin = 62.66 
            xmax = 63.1 
            text = "" 
        intervals [26]:
            xmin = 63.1 
            xmax = 64.84 
            text = "This arm beneath your head!" 
        intervals [27]:
            xmin = 64.84 
            xmax = 64.87 
            text = "" 
        intervals [28]:
            xmin = 64.87 
            xmax = 67.07 
            text = "It is some dream that on the deck," 
        intervals [29]:
            xmin = 67.07 
            xmax = 67.17 
            text = "" 
        intervals [30]:
            xmin = 67.17 
            xmax = 69.54 
            text = "You’ve fallen cold and dead." 
        intervals [31]:
            xmin = 69.54 
            xmax = 71.22 
            text = "" 
        intervals [32]:
            xmin = 71.22 
            xmax = 77.02 
            text = "My Captain does not answer, his lips are pale and still," 
        intervals [33]:
            xmin = 77.02 
            xmax = 78.57 
            text = "" 
        intervals [34]:
            xmin = 78.57 
            xmax = 84.32 
            text = "My father does not feel my arm, he has no pulse nor will," 
        intervals [35]:
            xmin = 84.32 
            xmax = 84.75 
            text = "" 
        intervals [36]:
            xmin = 84.75 
            xmax = 89.45 
            text = "The ship is anchor’d safe and sound, its voyage closed and done," 
        intervals [37]:
            xmin = 89.45 
            xmax = 94.42 
            text = "From fearful trip the victor ship comes in with object won;" 
        intervals [38]:
            xmin = 94.42 
            xmax = 97.58 
            text = "Exult O shores, and ring O bells!" 
        intervals [39]:
            xmin = 97.58 
            xmax = 98.79 
            text = "" 
        intervals [40]:
            xmin = 98.79 
            xmax = 102.24 
            text = "But I with mournful tread," 
        intervals [41]:
            xmin = 102.24 
            xmax = 104.72 
            text = "Walk the deck my Captain lies," 
        intervals [42]:
            xmin = 104.72 
            xmax = 105.8 
            text = "" 
        intervals [43]:
            xmin = 105.8 
            xmax = 108.43 
            text = "Fallen cold and dead." 
        intervals [44]:
            xmin = 108.43 
            xmax = 108.752 
            text = "" 
