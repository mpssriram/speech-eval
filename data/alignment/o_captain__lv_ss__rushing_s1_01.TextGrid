    item [2]:
        class = "IntervalTier" 
        name = "sentences" 
        xmin = 0 
        xmax = 87.064 
        intervals: size = 49 
        intervals [1]:
            xmin = 0 
            xmax = 0.13 
            text = "" 
        intervals [2]:
            xmin = 0.13 
            xmax = 3.27 
            text = "O Captain! my Captain! our fearful trip is done," 
        intervals [3]:
            xmin = 3.27 
            xmax = 3.86 
            text = "" 
        intervals [4]:
            xmin = 3.86 
            xmax = 7.35 
            text = "The ship has weather’d every rack, the prize we sought is won," 
        intervals [5]:
            xmin = 7.35 
            xmax = 7.82 
            text = "" 
        intervals [6]:
            xmin = 7.82 
            xmax = 11.34 
            text = "The port is near, the bells I hear, the people all exulting," 
        intervals [7]:
            xmin = 11.34 
            xmax = 11.99 
            text = "" 
        intervals [8]:
            xmin = 11.99 
            xmax = 14.97 
            text = "While follow eyes the steady keel, the vessel grim and daring;" 
        intervals [9]:
            xmin = 14.97 
            xmax = 15.89 
            text = "" 
        intervals [10]:
            xmin = 15.89 
            xmax = 17.92 
            text = "But O heart! heart! heart!" 
        intervals [11]:
            xmin = 17.92 
            xmax = 18.48 
            text = "" 
        intervals [12]:
            xmin = 18.48 
            xmax = 20.19 
            text = "O the bleeding drops of red," 
        intervals [13]:
            xmin = 20.19 
            xmax = 20.44 
            text = "" 
        intervals [14]:
            xmin = 20.44 
            xmax = 22.43 
            text = "Where on the deck my Captain lies," 
        intervals [15]:
            xmin = 22.43 
            xmax = 22.69 
            text = "" 
        intervals [16]:
            xmin = 22.69 
            xmax = 24.15 
            text = "Fallen cold and dead." 
        intervals [17]:
            xmin = 24.15 
            xmax = 25.25 
            text = "" 
        intervals [18]:
            xmin = 25.25 
            xmax = 28.14 
            text = "O Captain! my Captain! rise up and hear the bells;" 
        intervals [19]:
            xmin = 28.14 
            xmax = 28.5 
            text = "" 
        intervals [20]:
            xmin = 28.5 
            xmax = 31.9 
            text = "Rise up- for you the flag is flung- for you the bugle trills," 
        intervals [21]:
            xmin = 31.9 
            xmax = 32.44 
            text = "" 
        intervals [22]:
            xmin = 32.44 
            xmax = 36.48 
            text = "For you bouquets and ribbon’d wreaths- for you the shores a-crowding," 
        intervals [23]:
            xmin = 36.48 
            xmax = 37.06 
            text = "" 
        intervals [24]:
            xmin = 37.06 
            xmax = 40.66 
            text = "For you they call, the swaying mass, their eager faces turning;" 
        intervals [25]:
            xmin = 40.66 
            xmax = 41.29 
            text = "" 
        intervals [26]:
            xmin = 41.29 
            xmax = 43.05 
            text = "Here Captain! dear father!" 
        intervals [27]:
            xmin = 43.05 
            xmax = 43.54 
            text = "" 
        intervals [28]:
            xmin = 43.54 
            xmax = 44.88 
            text = "This arm beneath your head!" 
        intervals [29]:
            xmin = 44.88 
            xmax = 45.49 
            text = "" 
        intervals [30]:
            xmin = 45.49 
            xmax = 47.31 
            text = "It is some dream that on the deck," 
        intervals [31]:
            xmin = 47.31 
            xmax = 47.55 
            text = "" 
        intervals [32]:
            xmin = 47.55 
            xmax = 49.2 
            text = "You’ve fallen cold and dead." 
        intervals [33]:
            xmin = 49.2 
            xmax = 50.07 
            text = "" 
        intervals [34]:
            xmin = 50.07 
            xmax = 53.36 
            text = "My Captain does not answer, his lips are pale and still," 
        intervals [35]:
            xmin = 53.36 
            xmax = 53.86 
            text = "" 
        intervals [36]:
            xmin = 53.86 
            xmax = 57.73 
            text = "My father does not feel my arm, he has no pulse nor will," 
        intervals [37]:
            xmin = 57.73 
            xmax = 58.34 
            text = "" 
        intervals [38]:
            xmin = 58.34 
            xmax = 61.67 
            text = "The ship is anchor’d safe and sound, its voyage closed and done," 
        intervals [39]:
            xmin = 61.67 
            xmax = 62.04 
            text = "" 
        intervals [40]:
            xmin = 62.04 
            xmax = 65.73 
            text = "From fearful trip the victor ship comes in with object won;" 
        intervals [41]:
            xmin = 65.73 
            xmax = 66.41 
            text = "" 
        intervals [42]:
            xmin = 66.41 
            xmax = 69.17 
            text = "Exult O shores, and ring O bells!" 
        intervals [43]:
            xmin = 69.17 
            xmax = 69.85 
            text = "" 
        intervals [44]:
            xmin = 69.85 
            xmax = 71.37 
            text = "But I with mournful tread," 
        intervals [45]:
            xmin = 71.37 
            xmax = 71.91 
            text = "" 
        intervals [46]:
            xmin = 71.91 
            xmax = 73.72 
            text = "Walk the deck my Captain lies," 
        intervals [47]:
            xmin = 73.72 
            xmax = 74 
            text = "" 
        intervals [48]:
            xmin = 74 
            xmax = 83.66 
            text = "Fallen cold and dead." 
        intervals [49]:
            xmin = 83.66 
            xmax = 87.064 
            text = "" 
