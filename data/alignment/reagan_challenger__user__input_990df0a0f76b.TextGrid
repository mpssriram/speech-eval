    item [2]:
        class = "IntervalTier" 
        name = "sentences" 
        xmin = 0 
        xmax = 79.43 
        intervals: size = 33 
        intervals [1]:
            xmin = 0 
            xmax = 8.51 
            text = "Ladies and gentlemen, I had planned to speak to you tonight to report on the state of the Union, but the events of the earlier today have led me to change those plans." 
        intervals [2]:
            xmin = 8.51 
            xmax = 9.06 
            text = "" 
        intervals [3]:
            xmin = 9.06 
            xmax = 11.29 
            text = "Today is a day for mourning and remembering." 
        intervals [4]:
            xmin = 11.29 
            xmax = 11.78 
            text = "" 
        intervals [5]:
            xmin = 11.78 
            xmax = 15.46 
            text = "Nancy and I are pained to the core by the tragedy of the shuttle Challenger." 
        intervals [6]:
            xmin = 15.46 
            xmax = 16.02 
            text = "" 
        intervals [7]:
            xmin = 16.02 
            xmax = 19.57 
            text = "We know we share this pain with all of the people of our country." 
        intervals [8]:
            xmin = 19.57 
            xmax = 20.07 
            text = "" 
        intervals [9]:
            xmin = 20.07 
            xmax = 21.38 
            text = "This is truly a national loss." 
        intervals [10]:
            xmin = 21.38 
            xmax = 21.88 
            text = "" 
        intervals [11]:
            xmin = 21.88 
            xmax = 26.4 
            text = "Nineteen years ago, almost to the day, we lost three astronauts in a terrible accident on the ground." 
        intervals [12]:
            xmin = 26.4 
            xmax = 26.88 
            text = "" 
        intervals [13]:
            xmin = 26.88 
            xmax = 28.85 
            text = "We've never lost an astronaut in a flight;" 
        intervals [14]:
            xmin = 28.85 
            xmax = 29.67 
            text = "" 
        intervals [15]:
            xmin = 29.67 
            xmax = 31.24 
            text = "We've never had a tragedy like this." 
        intervals [16]:
            xmin = 31.24 
            xmax = 31.8 
            text = "" 
        intervals [17]:
            xmin = 31.8 
            xmax = 37.58 
            text = "And perhaps we've forgotten the courage it took for the crew of the shuttle." 
        intervals [18]:
            xmin = 37.58 
            xmax = 38.11 
            text = "" 
        intervals [19]:
            xmin = 38.11 
            xmax = 44.55 
            text = "But they, the Challenger Seven, were aware of the dangers, but overcame them and did their jobs brilliantly." 
        intervals [20]:
            xmin = 44.55 
            xmax = 44.83 
            text = "" 
        intervals [21]:
            xmin = 44.83 
            xmax = 46.08 
            text = "We mourn the seven heroes:" 
        intervals [22]:
            xmin = 46.08 
            xmax = 46.29 
            text = "" 
        intervals [23]:
            xmin = 46.29 
            xmax = 55.36 
            text = "Michael Smith, Dick Scobee, Judith Resnik, Ronald McNair, Ellison Onizuka, Gregory Jarvis, and Christa McAuliffe." 
        intervals [24]:
            xmin = 55.36 
            xmax = 55.96 
            text = "" 
        intervals [25]:
            xmin = 55.96 
            xmax = 58.18 
            text = "We mourn their loss as a nation together." 
        intervals [26]:
            xmin = 58.18 
            xmax = 58.81 
            text = "" 
        intervals [27]:
            xmin = 58.81 
            xmax = 63.22 
            text = "For the families of the seven, we cannot bear, as you do, the full impact of this tragedy." 
        intervals [28]:
            xmin = 63.22 
            xmax = 65.94 
            text = "But we feel the loss, and we are thinking about you so much." 
        intervals [29]:
            xmin = 65.94 
            xmax = 66.55 
            text = "" 
        intervals [30]:
            xmin = 66.55 
            xmax = 73.89 
            text = "Your loved ones were daring and brave, and they had that special grace, that special spirit that says, ``Give me a challenge, and I'll meet it with joy.''" 
        intervals [31]:
            xmin = 73.89 
            xmax = 74.42 
            text = "" 
        intervals [32]:
            xmin = 74.42 
            xmax = 77.26 
            text = "They had a hunger to explore the universe and discover its truths." 
        intervals [33]:
            xmin = 77.26 
            xmax = 79.43 
            text = "" 
