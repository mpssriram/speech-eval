    item [2]:
        class = "IntervalTier" 
        name = "sentences" 
        xmin = 0 
        xmax = 80.29 
        intervals: size = 35 
        intervals [1]:
            xmin = 0 
            xmax = 0.3 
            text = "" 
        intervals [2]:
            xmin = 0.3 
            xmax = 8.46 
            text = "Ladies and gentlemen, I had planned to speak to you tonight to report on the state of the Union, but the events of the earlier today have led me to change those plans." 
        intervals [3]:
            xmin = 8.46 
            xmax = 9.16 
            text = "" 
        intervals [4]:
            xmin = 9.16 
            xmax = 11.43 
            text = "Today is a day for mourning and remembering." 
        intervals [5]:
            xmin = 11.43 
            xmax = 11.82 
            text = "" 
        intervals [6]:
            xmin = 11.82 
            xmax = 15.84 
            text = "Nancy and I are pained to the core by the tragedy of the shuttle Challenger." 
        intervals [7]:
            xmin = 15.84 
            xmax = 16.72 
            text = "" 
        intervals [8]:
            xmin = 16.72 
            xmax = 19.74 
            text = "We know we share this pain with all of the people of our country." 
        intervals [9]:
            xmin = 19.74 
            xmax = 20.67 
            text = "" 
        intervals [10]:
            xmin = 20.67 
            xmax = 22.22 
            text = "This is truly a national loss." 
        intervals [11]:
            xmin = 22.22 
            xmax = 22.76 
            text = "" 
        intervals [12]:
            xmin = 22.76 
            xmax = 27.85 
            text = "Nineteen years ago, almost to the day, we lost three astronauts in a terrible accident on the ground." 
        intervals [13]:
            xmin = 27.85 
            xmax = 28.27 
            text = "" 
        intervals [14]:
            xmin = 28.27 
            xmax = 30.3 
            text = "But we've never lost an astronaut in a flight;" 
        intervals [15]:
            xmin = 30.3 
            xmax = 31.05 
            text = "" 
        intervals [16]:
            xmin = 31.05 
            xmax = 32.7 
            text = "We've never had a tragedy like this." 
        intervals [17]:
            xmin = 32.7 
            xmax = 33 
            text = "" 
        intervals [18]:
            xmin = 33 
            xmax = 36.68 
            text = "And perhaps we have forgotten the courage it took for the crew of the shuttle." 
        intervals [19]:
            xmin = 36.68 
            xmax = 37.07 
            text = "" 
        intervals [20]:
            xmin = 37.07 
            xmax = 42.35 
            text = "But they, the Challenger Seven, were aware of the dangers, but overcame them and did their jobs brilliantly." 
        intervals [21]:
            xmin = 42.35 
            xmax = 42.94 
            text = "" 
        intervals [22]:
            xmin = 42.94 
            xmax = 44.28 
            text = "We mourn the seven heroes:" 
        intervals [23]:
            xmin = 44.28 
            xmax = 44.59 
            text = "" 
        intervals [24]:
            xmin = 44.59 
            xmax = 52.05 
            text = "Michael Smith, Dick Scobee, Judith Resnik, Ronald McNair, Ellison Onizuka, Gregory Jarvis, and Christa McAuliffe." 
        intervals [25]:
            xmin = 52.05 
            xmax = 52.58 
            text = "" 
        intervals [26]:
            xmin = 52.58 
            xmax = 54.49 
            text = "We mourn their loss as a nation together." 
        intervals [27]:
            xmin = 54.49 
            xmax = 55.19 
            text = "" 
        intervals [28]:
            xmin = 55.19 
            xmax = 61.01 
            text = "For the families of the seven, we cannot bear, as you do, the full impact of this tragedy." 
        intervals [29]:
            xmin = 61.01 
            xmax = 61.36 
            text = "" 
        intervals [30]:
            xmin = 61.36 
            xmax = 64.03 
            text = "But we feel the loss, and we are thinking about you so much." 
        intervals [31]:
            xmin = 64.03 
            xmax = 64.96 
            text = "" 
        intervals [32]:
            xmin = 64.96 
            xmax = 74.61 
            text = "Your loved ones were daring and brave, and they had that special grace, that special spirit that says, ``Give me a challenge, and I'll meet it with joy.''" 
        intervals [33]:
            xmin = 74.61 
            xmax = 75.51 
            text = "" 
        intervals [34]:
            xmin = 75.51 
            xmax = 79.14 
            text = "They had a hunger to explore the universe and discover its truths." 
        intervals [35]:
            xmin = 79.14 
            xmax = 80.29 
            text = "" 
