    item [2]:
        class = "IntervalTier" 
        name = "sentences" 
        xmin = 0 
        xmax = 83.369 
        intervals: size = 49 
        intervals [1]:
            xmin = 0 
            xmax = 0.14 
            text = "" 
        intervals [2]:
            xmin = 0.14 
            xmax = 3.43 
            text = "O Captain! my Captain! our fearful trip is done," 
        intervals [3]:
            xmin = 3.43 
            xmax = 3.7 
            text = "" 
        intervals [4]:
            xmin = 3.7 
            xmax = 7.6 
            text = "The ship has weather’d every rack, the prize we sought is won," 
        intervals [5]:
            xmin = 7.6 
            xmax = 8.21 
            text = "" 
        intervals [6]:
            xmin = 8.21 
            xmax = 12.1 
            text = "The port is near, the bells I hear, the people all exulting," 
        intervals [7]:
            xmin = 12.1 
            xmax = 12.59 
            text = "" 
        intervals [8]:
            xmin = 12.59 
            xmax = 18.05 
            text = "While follow eyes the steady keel, the vessel grim and daring;" 
        intervals [9]:
            xmin = 18.05 
            xmax = 18.56 
            text = "" 
        intervals [10]:
            xmin = 18.56 
            xmax = 20.58 
            text = "But O heart! heart! heart!" 
        intervals [11]:
            xmin = 20.58 
            xmax = 20.87 
            text = "" 
        intervals [12]:
            xmin = 20.87 
            xmax = 22.63 
            text = "O the bleeding drops of red," 
        intervals [13]:
            xmin = 22.63 
            xmax = 23 
            text = "" 
        intervals [14]:
            xmin = 23 
            xmax = 25.03 
            text = "Where on the deck my Captain lies," 
        intervals [15]:
            xmin = 25.03 
            xmax = 25.29 
            text = "" 
        intervals [16]:
            xmin = 25.29 
            xmax = 26.9 
            text = "Fallen cold and dead." 
        intervals [17]:
            xmin = 26.9 
            xmax = 28.06 
            text = "" 
        intervals [18]:
            xmin = 28.06 
            xmax = 31.35 
            text = "O Captain! my Captain! rise up and hear the bells;" 
        intervals [19]:
            xmin = 31.35 
            xmax = 31.87 
            text = "" 
        intervals [20]:
            xmin = 31.87 
            xmax = 36.25 
            text = "Rise up- for you the flag is flung- for you the bugle trills," 
        intervals [21]:
            xmin = 36.25 
            xmax = 36.55 
            text = "" 
        intervals [22]:
            xmin = 36.55 
            xmax = 40.8 
            text = "For you bouquets and ribbon’d wreaths- for you the shores a-crowding," 
        intervals [23]:
            xmin = 40.8 
            xmax = 41.33 
            text = "" 
        intervals [24]:
            xmin = 41.33 
            xmax = 45.51 
            text = "For you they call, the swaying mass, their eager faces turning;" 
        intervals [25]:
            xmin = 45.51 
            xmax = 46.2 
            text = "" 
        intervals [26]:
            xmin = 46.2 
            xmax = 48.14 
            text = "Here Captain! dear father!" 
        intervals [27]:
            xmin = 48.14 
            xmax = 48.45 
            text = "" 
        intervals [28]:
            xmin = 48.45 
            xmax = 49.97 
            text = "This arm beneath your head!" 
        intervals [29]:
            xmin = 49.97 
            xmax = 50.52 
            text = "" 
        intervals [30]:
            xmin = 50.52 
            xmax = 52.5 
            text = "It is some dream that on the deck," 
        intervals [31]:
            xmin = 52.5 
            xmax = 52.81 
            text = "" 
        intervals [32]:
            xmin = 52.81 
            xmax = 54.55 
            text = "You’ve fallen cold and dead." 
        intervals [33]:
            xmin = 54.55 
            xmax = 55.82 
            text = "" 
        intervals [34]:
            xmin = 55.82 
            xmax = 59.34 
            text = "My Captain does not answer, his lips are pale and still," 
        intervals [35]:
            xmin = 59.34 
            xmax = 60 
            text = "" 
        intervals [36]:
            xmin = 60 
            xmax = 63.87 
            text = "My father does not feel my arm, he has no pulse nor will," 
        intervals [37]:
            xmin = 63.87 
            xmax = 64.61 
            text = "" 
        intervals [38]:
            xmin = 64.61 
            xmax = 68.56 
            text = "The ship is anchor’d safe and sound, its voyage closed and done," 
        intervals [39]:
            xmin = 68.56 
            xmax = 69.01 
            text = "" 
        intervals [40]:
            xmin = 69.01 
            xmax = 73.06 
            text = "From fearful trip the victor ship comes in with object won;" 
        intervals [41]:
            xmin = 73.06 
            xmax = 73.76 
            text = "" 
        intervals [42]:
            xmin = 73.76 
            xmax = 76.36 
            text = "Exult O shores, and ring O bells!" 
        intervals [43]:
            xmin = 76.36 
            xmax = 76.8 
            text = "" 
        intervals [44]:
            xmin = 76.8 
            xmax = 78.46 
            text = "But I with mournful tread," 
        intervals [45]:
            xmin = 78.46 
            xmax = 78.88 
            text = "" 
        intervals [46]:
            xmin = 78.88 
            xmax = 80.99 
            text = "Walk the deck my Captain lies," 
        intervals [47]:
            xmin = 80.99 
            xmax = 81.23 
            text = "" 
        intervals [48]:
            xmin = 81.23 
            xmax = 83.24 
            text = "Fallen cold and dead." 
        intervals [49]:
            xmin = 83.24 
            xmax = 83.369 
            text = "" 
