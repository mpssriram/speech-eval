    item [2]:
        class = "IntervalTier" 
        name = "sentences" 
        xmin = 0 
        xmax = 84.086 
        intervals: size = 49 
        intervals [1]:
            xmin = 0 
            xmax = 0.14 
            text = "" 
        intervals [2]:
            xmin = 0.14 
            xmax = 4.43 
            text = "O Captain! my Captain! our fearful trip is done," 
        intervals [3]:
            xmin = 4.43 
            xmax = 4.7 
            text = "" 
        intervals [4]:
            xmin = 4.7 
            xmax = 8.6 
            text = "The ship has weather’d every rack, the prize we sought is won," 
        intervals [5]:
            xmin = 8.6 
            xmax = 8.7 
            text = "" 
        intervals [6]:
            xmin = 8.7 
            xmax = 12.6 
            text = "The port is near, the bells I hear, the people all exulting," 
        intervals [7]:
            xmin = 12.6 
            xmax = 13.09 
            text = "" 
        intervals [8]:
            xmin = 13.09 
            xmax = 17.05 
            text = "While follow eyes the steady keel, the vessel grim and daring;" 
        intervals [9]:
            xmin = 17.05 
            xmax = 17.55 
            text = "" 
        intervals [10]:
            xmin = 17.55 
            xmax = 19.57 
            text = "But O heart! heart! heart!" 
        intervals [11]:
            xmin = 19.57 
            xmax = 19.86 
            text = "" 
        intervals [12]:
            xmin = 19.86 
            xmax = 21.62 
            text = "O the bleeding drops of red," 
        intervals [13]:
            xmin = 21.62 
            xmax = 22 
            text = "" 
        intervals [14]:
            xmin = 22 
            xmax = 24.03 
            text = "Where on the deck my Captain lies," 
        intervals [15]:
            xmin = 24.03 
            xmax = 24.29 
            text = "" 
        intervals [16]:
            xmin = 24.29 
            xmax = 25.89 
            text = "Fallen cold and dead." 
        intervals [17]:
            xmin = 25.89 
            xmax = 27.06 
            text = "" 
        intervals [18]:
            xmin = 27.06 
            xmax = 30.34 
            text = "O Captain! my Captain! rise up and hear the bells;" 
        intervals [19]:
            xmin = 30.34 
            xmax = 30.86 
            text = "" 
        intervals [20]:
            xmin = 30.86 
            xmax = 35.24 
            text = "Rise up- for you the flag is flung- for you the bugle trills," 
        intervals [21]:
            xmin = 35.24 
            xmax = 35.54 
            text = "" 
        intervals [22]:
            xmin = 35.54 
            xmax = 39.79 
            text = "For you bouquets and ribbon’d wreaths- for you the shores a-crowding," 
        intervals [23]:
            xmin = 39.79 
            xmax = 40.32 
            text = "" 
        intervals [24]:
            xmin = 40.32 
            xmax = 46.23 
            text = "For you they call, the swaying mass, their eager faces turning;" 
        intervals [25]:
            xmin = 46.23 
            xmax = 46.91 
            text = "" 
        intervals [26]:
            xmin = 46.91 
            xmax = 48.86 
            text = "Here Captain! dear father!" 
        intervals [27]:
            xmin = 48.86 
            xmax = 49.17 
            text = "" 
        intervals [28]:
            xmin = 49.17 
            xmax = 50.71 
            text = "This arm beneath your head!" 
        intervals [29]:
            xmin = 50.71 
            xmax = 51.24 
            text = "" 
        intervals [30]:
            xmin = 51.24 
            xmax = 53.21 
            text = "It is some dream that on the deck," 
        intervals [31]:
            xmin = 53.21 
            xmax = 53.53 
            text = "" 
        intervals [32]:
            xmin = 53.53 
            xmax = 55.25 
            text = "You’ve fallen cold and dead." 
        intervals [33]:
            xmin = 55.25 
            xmax = 56.53 
            text = "" 
        intervals [34]:
            xmin = 56.53 
            xmax = 60.06 
            text = "My Captain does not answer, his lips are pale and still," 
        intervals [35]:
            xmin = 60.06 
            xmax = 60.71 
            text = "" 
        intervals [36]:
            xmin = 60.71 
            xmax = 64.62 
            text = "My father does not feel my arm, he has no pulse nor will," 
        intervals [37]:
            xmin = 64.62 
            xmax = 65.33 
            text = "" 
        intervals [38]:
            xmin = 65.33 
            xmax = 69.27 
            text = "The ship is anchor’d safe and sound, its voyage closed and done," 
        intervals [39]:
            xmin = 69.27 
            xmax = 69.73 
            text = "" 
        intervals [40]:
            xmin = 69.73 
            xmax = 73.76 
            text = "From fearful trip the victor ship comes in with object won;" 
        intervals [41]:
            xmin = 73.76 
            xmax = 74.47 
            text = "" 
        intervals [42]:
            xmin = 74.47 
            xmax = 77.07 
            text = "Exult O shores, and ring O bells!" 
        intervals [43]:
            xmin = 77.07 
            xmax = 77.51 
            text = "" 
        intervals [44]:
            xmin = 77.51 
            xmax = 79.17 
            text = "But I with mournful tread," 
        intervals [45]:
            xmin = 79.17 
            xmax = 79.6 
            text = "" 
        intervals [46]:
            xmin = 79.6 
            xmax = 81.71 
            text = "Walk the deck my Captain lies," 
        intervals [47]:
            xmin = 81.71 
            xmax = 81.95 
            text = "" 
        intervals [48]:
            xmin = 81.95 
            xmax = 83.96 
            text = "Fallen cold and dead." 
        intervals [49]:
            xmin = 83.96 
            xmax = 84.086 
            text = "" 
