    item [2]:
        class = "IntervalTier" 
        name = "sentences" 
        xmin = 0 
        xmax = 111.516 
        intervals: size = 44 
        intervals [1]:
            xmin = 0 
            xmax = 0.25 
            text = "" 
        intervals [2]:
            xmin = 0.25 
            xmax = 6.03 
            text = "O Captain! my Captain! our fearful trip is done," 
        intervals [3]:
            xmin = 6.03 
            xmax = 6.26 
            text = "" 
        intervals [4]:
            xmin = 6.26 
            xmax = 14.9 
            text = "The ship has weather’d every rack, the prize we sought is won," 
        intervals [5]:
            xmin = 14.9 
            xmax = 15.3 
            text = "" 
        intervals [6]:
            xmin = 15.3 
            xmax = 25.45 
            text = "The port is near, the bells I hear, the people all exulting," 
        intervals [7]:
            xmin = 25.45 
            xmax = 25.98 
            text = "" 
        intervals [8]:
            xmin = 25.98 
            xmax = 30.84 
            text = "While follow eyes the steady keel, the vessel grim and daring;" 
        intervals [9]:
            xmin = 30.84 
            xmax = 31.5 
            text = "" 
        intervals [10]:
            xmin = 31.5 
            xmax = 34.6 
            text = "But O heart! heart! heart!" 
        intervals [11]:
            xmin = 34.6 
            xmax = 36.87 
            text = "O the bleeding drops of red," 
        intervals [12]:
            xmin = 36.87 
            xmax = 37.55 
            text = "" 
        intervals [13]:
            xmin = 37.55 
            xmax = 40.2 
            text = "Where on the deck my Captain lies," 
        intervals [14]:
            xmin = 40.2 
            xmax = 41.13 
            text = "" 
        intervals [15]:
            xmin = 41.13 
            xmax = 43.73 
            text = "Fallen cold and dead." 
        intervals [16]:
            xmin = 43.73 
            xmax = 45 
            text = "" 
        intervals [17]:
            xmin = 45 
            xmax = 48.38 
            text = "O Captain! my Captain! rise up and hear the bells;" 
        intervals [18]:
            xmin = 48.38 
            xmax = 48.7 
            text = "" 
        intervals [19]:
            xmin = 48.7 
            xmax = 52.33 
            text = "Rise up- for you the flag is flung- for you the bugle trills," 
        intervals [20]:
            xmin = 52.33 
            xmax = 52.73 
            text = "" 
        intervals [21]:
            xmin = 52.73 
            xmax = 57.19 
            text = "For you bouquets and ribbon’d wreaths- for you the shores a-crowding," 
        intervals [22]:
            xmin = 57.19 
            xmax = 58.02 
            text = "" 
        intervals [23]:
            xmin = 58.02 
            xmax = 63 
            text = "For you they call, the swaying mass, their eager faces turning;" 
        intervals [24]:
            xmin = 63 
            xmax = 63.42 
            text = "" 
        intervals [25]:
            xmin = 63.42 
            xmax = 65.42 
            text = "Here Captain! dear father!" 
        intervals [26]:
            xmin = 65.42 
            xmax = 65.87 
            text = "" 
        intervals [27]:
            xmin = 65.87 
            xmax = 67.66 
            text = "This arm beneath your head!" 
        intervals [28]:
            xmin = 67.66 
            xmax = 69.82 
            text = "It is some dream that on the deck," 
        intervals [29]:
            xmin = 69.82 
            xmax = 69.93 
            text = "" 
        intervals [30]:
            xmin = 69.93 
            xmax = 72.31 
            text = "You’ve fallen cold and dead." 
        intervals [31]:
            xmin = 72.31 
            xmax = 73.99 
            text = "" 
        intervals [32]:
            xmin = 73.99 
            xmax = 79.79 
            text = "My Captain does not answer, his lips are pale and still," 
        intervals [33]:
            xmin = 79.79 
            xmax = 81.34 
            text = "" 
        intervals [34]:
            xmin = 81.34 
            xmax = 87.09 
            text = "My father does not feel my arm, he has no pulse nor will," 
        intervals [35]:
            xmin = 87.09 
            xmax = 87.52 
            text = "" 
        intervals [36]:
            xmin = 87.52 
            xmax = 92.22 
            text = "The ship is anchor’d safe and sound, its voyage closed and done," 
        intervals [37]:
            xmin = 92.22 
            xmax = 97.18 
            text = "From fearful trip the victor ship comes in with object won;" 
        intervals [38]:
            xmin = 97.18 
            xmax = 100.38 
            text = "Exult O shores, and ring O bells!" 
        intervals [39]:
            xmin = 100.38 
            xmax = 101.56 
            text = "" 
        intervals [40]:
            xmin = 101.56 
            xmax = 105 
            text = "But I with mournful tread," 
        intervals [41]:
            xmin = 105 
            xmax = 107.49 
            text = "Walk the deck my Captain lies," 
        intervals [42]:
            xmin = 107.49 
            xmax = 108.56 
            text = "" 
        intervals [43]:
            xmin = 108.56 
            xmax = 111.19 
            text = "Fallen cold and dead." 
        intervals [44]:
            xmin = 111.19 
            xmax = 111.516 
            text = "" 
