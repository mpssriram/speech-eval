    item [2]:
        class = "IntervalTier" 
        name = "sentences" 
        xmin = 0 
        xmax = 96.195 
        intervals: size = 48 
        intervals [1]:
            xmin = 0 
            xmax = 0.13 
            text = "" 
        intervals [2]:
            xmin = 0.13 
            xmax = 3.92 
            text = "O Captain! my Captain! our fearful trip is done," 
        intervals [3]:
            xmin = 3.92 
            xmax = 4.28 
            text = "" 
        intervals [4]:
            xmin = 4.28 
            xmax = 8.18 
            text = "The ship has weather’d every rack, the prize we sought is won," 
        intervals [5]:
            xmin = 8.18 
            xmax = 9.12 
            text = "" 
        intervals [6]:
            xmin = 9.12 
            xmax = 13.23 
            text = "The port is near, the bells I hear, the people all exulting," 
        intervals [7]:
            xmin = 13.23 
            xmax = 13.67 
            text = "" 
        intervals [8]:
            xmin = 13.67 
            xmax = 17.28 
            text = "While follow eyes the steady keel, the vessel grim and daring;" 
        intervals [9]:
            xmin = 17.28 
            xmax = 18.6 
            text = "" 
        intervals [10]:
            xmin = 18.6 
            xmax = 22.08 
            text = "But O heart! heart! heart!" 
        intervals [11]:
            xmin = 22.08 
            xmax = 23.08 
            text = "" 
        intervals [12]:
            xmin = 23.08 
            xmax = 25.47 
            text = "O the bleeding drops of red," 
        intervals [13]:
            xmin = 25.47 
            xmax = 26.32 
            text = "" 
        intervals [14]:
            xmin = 26.32 
            xmax = 28.76 
            text = "Where on the deck my Captain lies," 
        intervals [15]:
            xmin = 28.76 
            xmax = 29.1 
            text = "" 
        intervals [16]:
            xmin = 29.1 
            xmax = 31.01 
            text = "Fallen cold and dead." 
        intervals [17]:
            xmin = 31.01 
            xmax = 32.84 
            text = "" 
        intervals [18]:
            xmin = 32.84 
            xmax = 36.57 
            text = "O Captain! my Captain! rise up and hear the bells;" 
        intervals [19]:
            xmin = 36.57 
            xmax = 36.92 
            text = "" 
        intervals [20]:
            xmin = 36.92 
            xmax = 41.38 
            text = "Rise up- for you the flag is flung- for you the bugle trills," 
        intervals [21]:
            xmin = 41.38 
            xmax = 41.83 
            text = "" 
        intervals [22]:
            xmin = 41.83 
            xmax = 46.36 
            text = "For you bouquets and ribbon’d wreaths- for you the shores a-crowding," 
        intervals [23]:
            xmin = 46.36 
            xmax = 46.72 
            text = "" 
        intervals [24]:
            xmin = 46.72 
            xmax = 51.01 
            text = "For you they call, the swaying mass, their eager faces turning;" 
        intervals [25]:
            xmin = 51.01 
            xmax = 51.84 
            text = "" 
        intervals [26]:
            xmin = 51.84 
            xmax = 53.87 
            text = "Here Captain! dear father!" 
        intervals [27]:
            xmin = 53.87 
            xmax = 55.53 
            text = "This arm beneath your head!" 
        intervals [28]:
            xmin = 55.53 
            xmax = 55.97 
            text = "" 
        intervals [29]:
            xmin = 55.97 
            xmax = 58.22 
            text = "It is some dream that on the deck," 
        intervals [30]:
            xmin = 58.22 
            xmax = 58.52 
            text = "" 
        intervals [31]:
            xmin = 58.52 
            xmax = 60.38 
            text = "You’ve fallen cold and dead." 
        intervals [32]:
            xmin = 60.38 
            xmax = 63.09 
            text = "" 
        intervals [33]:
            xmin = 63.09 
            xmax = 67.72 
            text = "My Captain does not answer, his lips are pale and still," 
        intervals [34]:
            xmin = 67.72 
            xmax = 68.66 
            text = "" 
        intervals [35]:
            xmin = 68.66 
            xmax = 73.79 
            text = "My father does not feel my arm, he has no pulse nor will," 
        intervals [36]:
            xmin = 73.79 
            xmax = 74.81 
            text = "" 
        intervals [37]:
            xmin = 74.81 
            xmax = 78.93 
            text = "The ship is anchor’d safe and sound, its voyage closed and done," 
        intervals [38]:
            xmin = 78.93 
            xmax = 79.28 
            text = "" 
        intervals [39]:
            xmin = 79.28 
            xmax = 83.57 
            text = "From fearful trip the victor ship comes in with object won;" 
        intervals [40]:
            xmin = 83.57 
            xmax = 84.8 
            text = "" 
        intervals [41]:
            xmin = 84.8 
            xmax = 87.6 
            text = "Exult O shores, and ring O bells!" 
        intervals [42]:
            xmin = 87.6 
            xmax = 88.1 
            text = "" 
        intervals [43]:
            xmin = 88.1 
            xmax = 90.15 
            text = "But I with mournful tread," 
        intervals [44]:
            xmin = 90.15 
            xmax = 91.06 
            text = "" 
        intervals [45]:
            xmin = 91.06 
            xmax = 93.44 
            text = "Walk the deck my Captain lies," 
        intervals [46]:
            xmin = 93.44 
            xmax = 93.58 
            text = "" 
        intervals [47]:
            xmin = 93.58 
            xmax = 96.09 
            text = "Fallen cold and dead." 
        intervals [48]:
            xmin = 96.09 
            xmax = 96.195 
            text = "" 
