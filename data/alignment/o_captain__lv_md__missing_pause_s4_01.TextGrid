    item [2]:
        class = "IntervalTier" 
        name = "sentences" 
        xmin = 0 
        xmax = 112.657 
        intervals: size = 48 
        intervals [1]:
            xmin = 0 
            xmax = 0.29 
            text = "" 
        intervals [2]:
            xmin = 0.29 
            xmax = 3.76 
            text = "O Captain! my Captain! our fearful trip is done," 
        intervals [3]:
            xmin = 3.76 
            xmax = 3.83 
            text = "" 
        intervals [4]:
            xmin = 3.83 
            xmax = 7.91 
            text = "The ship has weather’d every rack, the prize we sought is won," 
        intervals [5]:
            xmin = 7.91 
            xmax = 8.46 
            text = "" 
        intervals [6]:
            xmin = 8.46 
            xmax = 12.97 
            text = "The port is near, the bells I hear, the people all exulting," 
        intervals [7]:
            xmin = 12.97 
            xmax = 13.61 
            text = "" 
        intervals [8]:
            xmin = 13.61 
            xmax = 18.69 
            text = "While follow eyes the steady keel, the vessel grim and daring;" 
        intervals [9]:
            xmin = 18.69 
            xmax = 19.5 
            text = "" 
        intervals [10]:
            xmin = 19.5 
            xmax = 22.46 
            text = "But O heart! heart! heart!" 
        intervals [11]:
            xmin = 22.46 
            xmax = 23.15 
            text = "" 
        intervals [12]:
            xmin = 23.15 
            xmax = 25.62 
            text = "O the bleeding drops of red," 
        intervals [13]:
            xmin = 25.62 
            xmax = 26.16 
            text = "" 
        intervals [14]:
            xmin = 26.16 
            xmax = 29.01 
            text = "Where on the deck my Captain lies," 
        intervals [15]:
            xmin = 29.01 
            xmax = 29.38 
            text = "" 
        intervals [16]:
            xmin = 29.38 
            xmax = 31.11 
            text = "Fallen cold and dead." 
        intervals [17]:
            xmin = 31.11 
            xmax = 33.03 
            text = "" 
        intervals [18]:
            xmin = 33.03 
            xmax = 37.31 
            text = "O Captain! my Captain! rise up and hear the bells;" 
        intervals [19]:
            xmin = 37.31 
            xmax = 37.74 
            text = "" 
        intervals [20]:
            xmin = 37.74 
            xmax = 42.54 
            text = "Rise up- for you the flag is flung- for you the bugle trills," 
        intervals [21]:
            xmin = 42.54 
            xmax = 42.97 
            text = "" 
        intervals [22]:
            xmin = 42.97 
            xmax = 47.15 
            text = "For you bouquets and ribbon’d wreaths- for you the shores a-crowding," 
        intervals [23]:
            xmin = 47.15 
            xmax = 47.68 
            text = "" 
        intervals [24]:
            xmin = 47.68 
            xmax = 51.94 
            text = "For you they call, the swaying mass, their eager faces turning;" 
        intervals [25]:
            xmin = 51.94 
            xmax = 52.48 
            text = "" 
        intervals [26]:
            xmin = 52.48 
            xmax = 54.61 
            text = "Here Captain! dear father!" 
        intervals [27]:
            xmin = 54.61 
            xmax = 54.95 
            text = "" 
        intervals [28]:
            xmin = 54.95 
            xmax = 56.77 
            text = "This arm beneath your head!" 
        intervals [29]:
            xmin = 56.77 
            xmax = 57.28 
            text = "" 
        intervals [30]:
            xmin = 57.28 
            xmax = 59.63 
            text = "It is some dream that on the deck," 
        intervals [31]:
            xmin = 59.63 
            xmax = 61.55 
            text = "You’ve fallen cold and dead." 
        intervals [32]:
            xmin = 61.55 
            xmax = 63.21 
            text = "" 
        intervals [33]:
            xmin = 63.21 
            xmax = 67.79 
            text = "My Captain does not answer, his lips are pale and still," 
        intervals [34]:
            xmin = 67.79 
            xmax = 68.43 
            text = "" 
        intervals [35]:
            xmin = 68.43 
            xmax = 72.84 
            text = "My father does not feel my arm, he has no pulse nor will," 
        intervals [36]:
            xmin = 72.84 
            xmax = 73.56 
            text = "" 
        intervals [37]:
            xmin = 73.56 
            xmax = 78.26 
            text = "The ship is anchor’d safe and sound, its voyage closed and done," 
        intervals [38]:
            xmin = 78.26 
            xmax = 78.96 
            text = "" 
        intervals [39]:
            xmin = 78.96 
            xmax = 83.29 
            text = "From fearful trip the victor ship comes in with object won;" 
        intervals [40]:
            xmin = 83.29 
            xmax = 84.22 
            text = "" 
        intervals [41]:
            xmin = 84.22 
            xmax = 87.4 
            text = "Exult O shores, and ring O bells!" 
        intervals [42]:
            xmin = 87.4 
            xmax = 87.72 
            text = "" 
        intervals [43]:
            xmin = 87.72 
            xmax = 89.74 
            text = "But I with mournful tread," 
        intervals [44]:
            xmin = 89.74 
            xmax = 90.71 
            text = "" 
        intervals [45]:
            xmin = 90.71 
            xmax = 93.21 
            text = "Walk the deck my Captain lies," 
        intervals [46]:
            xmin = 93.21 
            xmax = 93.93 
            text = "" 
        intervals [47]:
            xmin = 93.93 
            xmax = 103.61 
            text = "Fallen cold and dead." 
        intervals [48]:
            xmin = 103.61 
            xmax = 112.657 
            text = "" 
