    item [2]:
        class = "IntervalTier" 
        name = "sentences" 
        xmin = 0 
        xmax = 110.816 
        intervals: size = 34 
        intervals [1]:
            xmin = 0 
            xmax = 0.25 
            text = "" 
        intervals [2]:
            xmin = 0.25 
            xmax = 3.32 
            text = "O Captain! my Captain! our fearful trip is done," 
        intervals [3]:
            xmin = 3.32 
            xmax = 3.76 
            text = "" 
        intervals [4]:
            xmin = 3.76 
            xmax = 5.93 
            text = "The ship has weather’d every rack, the prize we sought is won," 
        intervals [5]:
            xmin = 5.93 
            xmax = 12.21 
            text = "The port is near, the bells I hear, the people all exulting," 
        intervals [6]:
            xmin = 12.21 
            xmax = 15.71 
            text = "While follow eyes the steady keel, the vessel grim and daring;" 
        intervals [7]:
            xmin = 15.71 
            xmax = 15.76 
            text = "" 
        intervals [8]:
            xmin = 15.76 
            xmax = 16.33 
            text = "But O heart! heart! heart!" 
        intervals [9]:
            xmin = 16.33 
            xmax = 17.25 
            text = "O the bleeding drops of red," 
        intervals [10]:
            xmin = 17.25 
            xmax = 17.93 
            text = "Where on the deck my Captain lies," 
        intervals [11]:
            xmin = 17.93 
            xmax = 18.82 
            text = "Fallen cold and dead." 
        intervals [12]:
            xmin = 18.82 
            xmax = 21.85 
            text = "O Captain! my Captain! rise up and hear the bells;" 
        intervals [13]:
            xmin = 21.85 
            xmax = 24.67 
            text = "Rise up- for you the flag is flung- for you the bugle trills," 
        intervals [14]:
            xmin = 24.67 
            xmax = 27.73 
            text = "For you bouquets and ribbon’d wreaths- for you the shores a-crowding," 
        intervals [15]:
            xmin = 27.73 
            xmax = 31.37 
            text = "For you they call, the swaying mass, their eager faces turning;" 
        intervals [16]:
            xmin = 31.37 
            xmax = 33.75 
            text = "Here Captain! dear father!" 
        intervals [17]:
            xmin = 33.75 
            xmax = 35.22 
            text = "This arm beneath your head!" 
        intervals [18]:
            xmin = 35.22 
            xmax = 35.27 
            text = "" 
        intervals [19]:
            xmin = 35.27 
            xmax = 37.79 
            text = "It is some dream that on the deck," 
        intervals [20]:
            xmin = 37.79 
            xmax = 38.74 
            text = "" 
        intervals [21]:
            xmin = 38.74 
            xmax = 43.03 
            text = "You’ve fallen cold and dead." 
        intervals [22]:
            xmin = 43.03 
            xmax = 44.29 
            text = "" 
        intervals [23]:
            xmin = 44.29 
            xmax = 47.7 
            text = "My Captain does not answer, his lips are pale and still," 
        intervals [24]:
            xmin = 47.7 
            xmax = 48 
            text = "" 
        intervals [25]:
            xmin = 48 
            xmax = 52.81 
            text = "My father does not feel my arm, he has no pulse nor will," 
        intervals [26]:
            xmin = 52.81 
            xmax = 57.76 
            text = "The ship is anchor’d safe and sound, its voyage closed and done," 
        intervals [27]:
            xmin = 57.76 
            xmax = 65.94 
            text = "From fearful trip the victor ship comes in with object won;" 
        intervals [28]:
            xmin = 65.94 
            xmax = 68.8 
            text = "Exult O shores, and ring O bells!" 
        intervals [29]:
            xmin = 68.8 
            xmax = 71.6 
            text = "But I with mournful tread," 
        intervals [30]:
            xmin = 71.6 
            xmax = 73.29 
            text = "" 
        intervals [31]:
            xmin = 73.29 
            xmax = 86.37 
            text = "Walk the deck my Captain lies," 
        intervals [32]:
            xmin = 86.37 
            xmax = 88.92 
            text = "" 
        intervals [33]:
            xmin = 88.92 
            xmax = 101.85 
            text = "Fallen cold and dead." 
        intervals [34]:
            xmin = 101.85 
            xmax = 110.816 
            text = "" 
