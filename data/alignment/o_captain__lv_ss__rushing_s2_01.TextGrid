    item [2]:
        class = "IntervalTier" 
        name = "sentences" 
        xmin = 0 
        xmax = 86.699 
        intervals: size = 49 
        intervals [1]:
            xmin = 0 
            xmax = 0.13 
            text = "" 
        intervals [2]:
            xmin = 0.13 
            xmax = 3.27 
            text = "O Captain! my Captain! our fearful trip is done," 
        intervals [3]:
            xmin = 3.27 
            xmax = 3.86 
            text = "" 
        intervals [4]:
            xmin = 3.86 
            xmax = 7.35 
            text = "The ship has weather’d every rack, the prize we sought is won," 
        intervals [5]:
            xmin = 7.35 
            xmax = 7.81 
            text = "" 
        intervals [6]:
            xmin = 7.81 
            xmax = 11.34 
            text = "The port is near, the bells I hear, the people all exulting," 
        intervals [7]:
            xmin = 11.34 
            xmax = 11.99 
            text = "" 
        intervals [8]:
            xmin = 11.99 
            xmax = 15.19 
            text = "While follow eyes the steady keel, the vessel grim and daring;" 
        intervals [9]:
            xmin = 15.19 
            xmax = 16.12 
            text = "" 
        intervals [10]:
            xmin = 16.12 
            xmax = 18.13 
            text = "But O heart! heart! heart!" 
        intervals [11]:
            xmin = 18.13 
            xmax = 18.7 
            text = "" 
        intervals [12]:
            xmin = 18.7 
            xmax = 20.41 
            text = "O the bleeding drops of red," 
        intervals [13]:
            xmin = 20.41 
            xmax = 20.66 
            text = "" 
        intervals [14]:
            xmin = 20.66 
            xmax = 22.66 
            text = "Where on the deck my Captain lies," 
        intervals [15]:
            xmin = 22.66 
            xmax = 22.91 
            text = "" 
        intervals [16]:
            xmin = 22.91 
            xmax = 24.37 
            text = "Fallen cold and dead." 
        intervals [17]:
            xmin = 24.37 
            xmax = 25.48 
            text = "" 
        intervals [18]:
            xmin = 25.48 
            xmax = 28.37 
            text = "O Captain! my Captain! rise up and hear the bells;" 
        intervals [19]:
            xmin = 28.37 
            xmax = 28.72 
            text = "" 
        intervals [20]:
            xmin = 28.72 
            xmax = 32.12 
            text = "Rise up- for you the flag is flung- for you the bugle trills," 
        intervals [21]:
            xmin = 32.12 
            xmax = 32.67 
            text = "" 
        intervals [22]:
            xmin = 32.67 
            xmax = 36.73 
            text = "For you bouquets and ribbon’d wreaths- for you the shores a-crowding," 
        intervals [23]:
            xmin = 36.73 
            xmax = 37.29 
            text = "" 
        intervals [24]:
            xmin = 37.29 
            xmax = 40.88 
            text = "For you they call, the swaying mass, their eager faces turning;" 
        intervals [25]:
            xmin = 40.88 
            xmax = 41.52 
            text = "" 
        intervals [26]:
            xmin = 41.52 
            xmax = 43.28 
            text = "Here Captain! dear father!" 
        intervals [27]:
            xmin = 43.28 
            xmax = 43.77 
            text = "" 
        intervals [28]:
            xmin = 43.77 
            xmax = 45.11 
            text = "This arm beneath your head!" 
        intervals [29]:
            xmin = 45.11 
            xmax = 45.71 
            text = "" 
        intervals [30]:
            xmin = 45.71 
            xmax = 47.53 
            text = "It is some dream that on the deck," 
        intervals [31]:
            xmin = 47.53 
            xmax = 47.78 
            text = "" 
        intervals [32]:
            xmin = 47.78 
            xmax = 49.43 
            text = "You’ve fallen cold and dead." 
        intervals [33]:
            xmin = 49.43 
            xmax = 50.29 
            text = "" 
        intervals [34]:
            xmin = 50.29 
            xmax = 53.57 
            text = "My Captain does not answer, his lips are pale and still," 
        intervals [35]:
            xmin = 53.57 
            xmax = 54.07 
            text = "" 
        intervals [36]:
            xmin = 54.07 
            xmax = 57.37 
            text = "My father does not feel my arm, he has no pulse nor will," 
        intervals [37]:
            xmin = 57.37 
            xmax = 57.98 
            text = "" 
        intervals [38]:
            xmin = 57.98 
            xmax = 61.31 
            text = "The ship is anchor’d safe and sound, its voyage closed and done," 
        intervals [39]:
            xmin = 61.31 
            xmax = 61.68 
            text = "" 
        intervals [40]:
            xmin = 61.68 
            xmax = 65.36 
            text = "From fearful trip the victor ship comes in with object won;" 
        intervals [41]:
            xmin = 65.36 
            xmax = 66.05 
            text = "" 
        intervals [42]:
            xmin = 66.05 
            xmax = 68.81 
            text = "Exult O shores, and ring O bells!" 
        intervals [43]:
            xmin = 68.81 
            xmax = 69.49 
            text = "" 
        intervals [44]:
            xmin = 69.49 
            xmax = 71 
            text = "But I with mournful tread," 
        intervals [45]:
            xmin = 71 
            xmax = 71.54 
            text = "" 
        intervals [46]:
            xmin = 71.54 
            xmax = 73.35 
            text = "Walk the deck my Captain lies," 
        intervals [47]:
            xmin = 73.35 
            xmax = 73.63 
            text = "" 
        intervals [48]:
            xmin = 73.63 
            xmax = 83.29 
            text = "Fallen cold and dead." 
        intervals [49]:
            xmin = 83.29 
            xmax = 86.699 
            text = "" 
