    item [2]:
        class = "IntervalTier" 
        name = "sentences" 
        xmin = 0 
        xmax = 108.906 
        intervals: size = 45 
        intervals [1]:
            xmin = 0 
            xmax = 0.25 
            text = "" 
        intervals [2]:
            xmin = 0.25 
            xmax = 6.03 
            text = "O Captain! my Captain! our fearful trip is done," 
        intervals [3]:
            xmin = 6.03 
            xmax = 6.26 
            text = "" 
        intervals [4]:
            xmin = 6.26 
            xmax = 14.9 
            text = "The ship has weather’d every rack, the prize we sought is won," 
        intervals [5]:
            xmin = 14.9 
            xmax = 15.3 
            text = "" 
        intervals [6]:
            xmin = 15.3 
            xmax = 23.25 
            text = "The port is near, the bells I hear, the people all exulting," 
        intervals [7]:
            xmin = 23.25 
            xmax = 23.78 
            text = "" 
        intervals [8]:
            xmin = 23.78 
            xmax = 28.65 
            text = "While follow eyes the steady keel, the vessel grim and daring;" 
        intervals [9]:
            xmin = 28.65 
            xmax = 29.3 
            text = "" 
        intervals [10]:
            xmin = 29.3 
            xmax = 31.99 
            text = "But O heart! heart! heart!" 
        intervals [11]:
            xmin = 31.99 
            xmax = 34.26 
            text = "O the bleeding drops of red," 
        intervals [12]:
            xmin = 34.26 
            xmax = 34.94 
            text = "" 
        intervals [13]:
            xmin = 34.94 
            xmax = 37.56 
            text = "Where on the deck my Captain lies," 
        intervals [14]:
            xmin = 37.56 
            xmax = 38.52 
            text = "" 
        intervals [15]:
            xmin = 38.52 
            xmax = 41.12 
            text = "Fallen cold and dead." 
        intervals [16]:
            xmin = 41.12 
            xmax = 42.39 
            text = "" 
        intervals [17]:
            xmin = 42.39 
            xmax = 45.77 
            text = "O Captain! my Captain! rise up and hear the bells;" 
        intervals [18]:
            xmin = 45.77 
            xmax = 46.09 
            text = "" 
        intervals [19]:
            xmin = 46.09 
            xmax = 49.72 
            text = "Rise up- for you the flag is flung- for you the bugle trills," 
        intervals [20]:
            xmin = 49.72 
            xmax = 50.12 
            text = "" 
        intervals [21]:
            xmin = 50.12 
            xmax = 54.58 
            text = "For you bouquets and ribbon’d wreaths- for you the shores a-crowding," 
        intervals [22]:
            xmin = 54.58 
            xmax = 55.39 
            text = "" 
        intervals [23]:
            xmin = 55.39 
            xmax = 60.39 
            text = "For you they call, the swaying mass, their eager faces turning;" 
        intervals [24]:
            xmin = 60.39 
            xmax = 60.81 
            text = "" 
        intervals [25]:
            xmin = 60.81 
            xmax = 62.81 
            text = "Here Captain! dear father!" 
        intervals [26]:
            xmin = 62.81 
            xmax = 63.26 
            text = "" 
        intervals [27]:
            xmin = 63.26 
            xmax = 65 
            text = "This arm beneath your head!" 
        intervals [28]:
            xmin = 65 
            xmax = 65.03 
            text = "" 
        intervals [29]:
            xmin = 65.03 
            xmax = 67.23 
            text = "It is some dream that on the deck," 
        intervals [30]:
            xmin = 67.23 
            xmax = 67.32 
            text = "" 
        intervals [31]:
            xmin = 67.32 
            xmax = 69.7 
            text = "You’ve fallen cold and dead." 
        intervals [32]:
            xmin = 69.7 
            xmax = 71.38 
            text = "" 
        intervals [33]:
            xmin = 71.38 
            xmax = 77.18 
            text = "My Captain does not answer, his lips are pale and still," 
        intervals [34]:
            xmin = 77.18 
            xmax = 78.72 
            text = "" 
        intervals [35]:
            xmin = 78.72 
            xmax = 84.48 
            text = "My father does not feel my arm, he has no pulse nor will," 
        intervals [36]:
            xmin = 84.48 
            xmax = 84.91 
            text = "" 
        intervals [37]:
            xmin = 84.91 
            xmax = 89.61 
            text = "The ship is anchor’d safe and sound, its voyage closed and done," 
        intervals [38]:
            xmin = 89.61 
            xmax = 94.57 
            text = "From fearful trip the victor ship comes in with object won;" 
        intervals [39]:
            xmin = 94.57 
            xmax = 97.73 
            text = "Exult O shores, and ring O bells!" 
        intervals [40]:
            xmin = 97.73 
            xmax = 98.95 
            text = "" 
        intervals [41]:
            xmin = 98.95 
            xmax = 102.39 
            text = "But I with mournful tread," 
        intervals [42]:
            xmin = 102.39 
            xmax = 104.88 
            text = "Walk the deck my Captain lies," 
        intervals [43]:
            xmin = 104.88 
            xmax = 105.96 
            text = "" 
        intervals [44]:
            xmin = 105.96 
            xmax = 108.58 
            text = "Fallen cold and dead." 
        intervals [45]:
            xmin = 108.58 
            xmax = 108.906 
            text = "" 
