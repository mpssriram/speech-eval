    item [2]:
        class = "IntervalTier" 
        name = "sentences" 
        xmin = 0 
        xmax = 70.595 
        intervals: size = 48 
        intervals [1]:
            xmin = 0 
            xmax = 0.17 
            text = "" 
        intervals [2]:
            xmin = 0.17 
            xmax = 2.84 
            text = "O Captain! my Captain! our fearful trip is done," 
        intervals [3]:
            xmin = 2.84 
            xmax = 3.264 
            text = "" 
        intervals [4]:
            xmin = 3.264 
            xmax = 6.535 
            text = "The ship has weather’d every rack, the prize we sought is won," 
        intervals [5]:
            xmin = 6.535 
            xmax = 6.769 
            text = "" 
        intervals [6]:
            xmin = 6.769 
            xmax = 9.71 
            text = "The port is near, the bells I hear, the people all exulting," 
        intervals [7]:
            xmin = 9.71 
            xmax = 10.275 
            text = "" 
        intervals [8]:
            xmin = 10.275 
            xmax = 13.525 
            text = "While follow eyes the steady keel, the vessel grim and daring;" 
        intervals [9]:
            xmin = 13.525 
            xmax = 14.161 
            text = "" 
        intervals [10]:
            xmin = 14.161 
            xmax = 16.051 
            text = "But O heart! heart! heart!" 
        intervals [11]:
            xmin = 16.051 
            xmax = 16.334 
            text = "" 
        intervals [12]:
            xmin = 16.334 
            xmax = 17.765 
            text = "O the bleeding drops of red," 
        intervals [13]:
            xmin = 17.765 
            xmax = 17.837 
            text = "" 
        intervals [14]:
            xmin = 17.837 
            xmax = 19.507 
            text = "Where on the deck my Captain lies," 
        intervals [15]:
            xmin = 19.507 
            xmax = 19.55 
            text = "" 
        intervals [16]:
            xmin = 19.55 
            xmax = 21.1 
            text = "Fallen cold and dead." 
        intervals [17]:
            xmin = 21.1 
            xmax = 22.84 
            text = "" 
        intervals [18]:
            xmin = 22.84 
            xmax = 25.713 
            text = "O Captain! my Captain! rise up and hear the bells;" 
        intervals [19]:
            xmin = 25.713 
            xmax = 25.743 
            text = "" 
        intervals [20]:
            xmin = 25.743 
            xmax = 29.163 
            text = "Rise up- for you the flag is flung- for you the bugle trills," 
        intervals [21]:
            xmin = 29.163 
            xmax = 29.577 
            text = "" 
        intervals [22]:
            xmin = 29.577 
            xmax = 32.7 
            text = "For you bouquets and ribbon’d wreaths- for you the shores a-crowding," 
        intervals [23]:
            xmin = 32.7 
            xmax = 33.501 
            text = "" 
        intervals [24]:
            xmin = 33.501 
            xmax = 36.705 
            text = "For you they call, the swaying mass, their eager faces turning;" 
        intervals [25]:
            xmin = 36.705 
            xmax = 37.835 
            text = "" 
        intervals [26]:
            xmin = 37.835 
            xmax = 39.318 
            text = "Here Captain! dear father!" 
        intervals [27]:
            xmin = 39.318 
            xmax = 40.698 
            text = "This arm beneath your head!" 
        intervals [28]:
            xmin = 40.698 
            xmax = 40.999 
            text = "" 
        intervals [29]:
            xmin = 40.999 
            xmax = 42.619 
            text = "It is some dream that on the deck," 
        intervals [30]:
            xmin = 42.619 
            xmax = 42.731 
            text = "" 
        intervals [31]:
            xmin = 42.731 
            xmax = 44.381 
            text = "You’ve fallen cold and dead." 
        intervals [32]:
            xmin = 44.381 
            xmax = 45.494 
            text = "" 
        intervals [33]:
            xmin = 45.494 
            xmax = 48.864 
            text = "My Captain does not answer, his lips are pale and still," 
        intervals [34]:
            xmin = 48.864 
            xmax = 49.554 
            text = "" 
        intervals [35]:
            xmin = 49.554 
            xmax = 53.124 
            text = "My father does not feel my arm, he has no pulse nor will," 
        intervals [36]:
            xmin = 53.124 
            xmax = 53.827 
            text = "" 
        intervals [37]:
            xmin = 53.827 
            xmax = 57.327 
            text = "The ship is anchor’d safe and sound, its voyage closed and done," 
        intervals [38]:
            xmin = 57.327 
            xmax = 58.055 
            text = "" 
        intervals [39]:
            xmin = 58.055 
            xmax = 61.455 
            text = "From fearful trip the victor ship comes in with object won;" 
        intervals [40]:
            xmin = 61.455 
            xmax = 61.651 
            text = "" 
        intervals [41]:
            xmin = 61.651 
            xmax = 63.921 
            text = "Exult O shores, and ring O bells!" 
        intervals [42]:
            xmin = 63.921 
            xmax = 64.384 
            text = "" 
        intervals [43]:
            xmin = 64.384 
            xmax = 65.975 
            text = "But I with mournful tread," 
        intervals [44]:
            xmin = 65.975 
            xmax = 66.549 
            text = "" 
        intervals [45]:
            xmin = 66.549 
            xmax = 68.359 
            text = "Walk the deck my Captain lies," 
        intervals [46]:
            xmin = 68.359 
            xmax = 68.532 
            text = "" 
        intervals [47]:
            xmin = 68.532 
            xmax = 70.352 
            text = "Fallen cold and dead." 
        intervals [48]:
            xmin = 70.352 
