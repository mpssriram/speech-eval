    item [2]:
        class = "IntervalTier" 
        name = "sentences" 
        xmin = 0 
        xmax = 112.18 
        intervals: size = 47 
        intervals [1]:
            xmin = 0 
            xmax = 7.46 
            text = "two thousand and six O Captain! my Captain! our fearful trip is done," 
        intervals [2]:
            xmin = 7.46 
            xmax = 8.19 
            text = "" 
        intervals [3]:
            xmin = 8.19 
            xmax = 15.11 
            text = "The ship has weather’d every rack, the prize we sought is won," 
        intervals [4]:
            xmin = 15.11 
            xmax = 15.93 
            text = "" 
        intervals [5]:
            xmin = 15.93 
            xmax = 19.98 
            text = "The port is near, the bells I hear, the people all exulting," 
        intervals [6]:
            xmin = 19.98 
            xmax = 20.67 
            text = "" 
        intervals [7]:
            xmin = 20.67 
            xmax = 25.54 
            text = "While follow eyes the steady keel, the vessel grim and daring;" 
        intervals [8]:
            xmin = 25.54 
            xmax = 26.53 
            text = "" 
        intervals [9]:
            xmin = 26.53 
            xmax = 29.41 
            text = "But O heart! heart! heart!" 
        intervals [10]:
            xmin = 29.41 
            xmax = 30.08 
            text = "" 
        intervals [11]:
            xmin = 30.08 
            xmax = 31.94 
            text = "O the bleeding drops of red," 
        intervals [12]:
            xmin = 31.94 
            xmax = 32.51 
            text = "" 
        intervals [13]:
            xmin = 32.51 
            xmax = 34.61 
            text = "Where on the deck my Captain lies," 
        intervals [14]:
            xmin = 34.61 
            xmax = 36.35 
            text = "Fallen cold and dead." 
        intervals [15]:
            xmin = 36.35 
            xmax = 37.44 
            text = "" 
        intervals [16]:
            xmin = 37.44 
            xmax = 40.6 
            text = "O Captain! my Captain! rise up and hear the bells;" 
        intervals [17]:
            xmin = 40.6 
            xmax = 41.09 
            text = "" 
        intervals [18]:
            xmin = 41.09 
            xmax = 46.3 
            text = "Rise up- for you the flag is flung- for you the bugle trills," 
        intervals [19]:
            xmin = 46.3 
            xmax = 46.73 
            text = "" 
        intervals [20]:
            xmin = 46.73 
            xmax = 51.62 
            text = "For you bouquets and ribbon’d wreaths- for you the shores a-crowding," 
        intervals [21]:
            xmin = 51.62 
            xmax = 52.43 
            text = "" 
        intervals [22]:
            xmin = 52.43 
            xmax = 56.85 
            text = "For you they call, the swaying mass, their eager faces turning;" 
        intervals [23]:
            xmin = 56.85 
            xmax = 57.54 
            text = "" 
        intervals [24]:
            xmin = 57.54 
            xmax = 60.25 
            text = "Here Captain! dear father!" 
        intervals [25]:
            xmin = 60.25 
            xmax = 60.91 
            text = "" 
        intervals [26]:
            xmin = 60.91 
            xmax = 62.81 
            text = "This arm beneath your head!" 
        intervals [27]:
            xmin = 62.81 
            xmax = 63.55 
            text = "" 
        intervals [28]:
            xmin = 63.55 
            xmax = 66.35 
            text = "It is some dream that on the deck," 
        intervals [29]:
            xmin = 66.35 
            xmax = 67.01 
            text = "" 
        intervals [30]:
            xmin = 67.01 
            xmax = 69.56 
            text = "You’ve fallen cold and dead." 
        intervals [31]:
            xmin = 69.56 
            xmax = 71.32 
            text = "" 
        intervals [32]:
            xmin = 71.32 
            xmax = 76.45 
            text = "My Captain does not answer, his lips are pale and still," 
        intervals [33]:
            xmin = 76.45 
            xmax = 77.61 
            text = "" 
        intervals [34]:
            xmin = 77.61 
            xmax = 83.25 
            text = "My father does not feel my arm, he has no pulse nor will," 
        intervals [35]:
            xmin = 83.25 
            xmax = 84.38 
            text = "" 
        intervals [36]:
            xmin = 84.38 
            xmax = 90.12 
            text = "The ship is anchor’d safe and sound, its voyage closed and done," 
        intervals [37]:
            xmin = 90.12 
            xmax = 91.15 
            text = "" 
        intervals [38]:
            xmin = 91.15 
            xmax = 96.93 
            text = "From fearful trip the victor ship comes in with object won;" 
        intervals [39]:
            xmin = 96.93 
            xmax = 98.2 
            text = "" 
        intervals [40]:
            xmin = 98.2 
            xmax = 102.05 
            text = "Exult O shores, and ring O bells!" 
        intervals [41]:
            xmin = 102.05 
            xmax = 102.69 
            text = "" 
        intervals [42]:
            xmin = 102.69 
            xmax = 105.53 
            text = "But I with mournful tread," 
        intervals [43]:
            xmin = 105.53 
            xmax = 106.28 
            text = "" 
        intervals [44]:
            xmin = 106.28 
            xmax = 108.9 
            text = "Walk the deck my Captain lies," 
        intervals [45]:
            xmin = 108.9 
            xmax = 109.62 
            text = "" 
        intervals [46]:
            xmin = 109.62 
            xmax = 111.97 
            text = "Fallen cold and dead." 
        intervals [47]:
            xmin = 111.97 
            xmax = 112.18 
            text = "" 
