    item [2]:
        class = "IntervalTier" 
        name = "sentences" 
        xmin = 0 
        xmax = 112.316 
        intervals: size = 42 
        intervals [1]:
            xmin = 0 
            xmax = 0.25 
            text = "" 
        intervals [2]:
            xmin = 0.25 
            xmax = 3.32 
            text = "O Captain! my Captain! our fearful trip is done," 
        intervals [3]:
            xmin = 3.32 
            xmax = 3.76 
            text = "" 
        intervals [4]:
            xmin = 3.76 
            xmax = 7.44 
            text = "The ship has weather’d every rack, the prize we sought is won," 
        intervals [5]:
            xmin = 7.44 
            xmax = 7.49 
            text = "" 
        intervals [6]:
            xmin = 7.49 
            xmax = 16.67 
            text = "The port is near, the bells I hear, the people all exulting," 
        intervals [7]:
            xmin = 16.67 
            xmax = 26.29 
            text = "While follow eyes the steady keel, the vessel grim and daring;" 
        intervals [8]:
            xmin = 26.29 
            xmax = 26.79 
            text = "" 
        intervals [9]:
            xmin = 26.79 
            xmax = 28.25 
            text = "But O heart! heart! heart!" 
        intervals [10]:
            xmin = 28.25 
            xmax = 30.12 
            text = "O the bleeding drops of red," 
        intervals [11]:
            xmin = 30.12 
            xmax = 33.49 
            text = "Where on the deck my Captain lies," 
        intervals [12]:
            xmin = 33.49 
            xmax = 34.9 
            text = "" 
        intervals [13]:
            xmin = 34.9 
            xmax = 37.67 
            text = "Fallen cold and dead." 
        intervals [14]:
            xmin = 37.67 
            xmax = 38.38 
            text = "" 
        intervals [15]:
            xmin = 38.38 
            xmax = 46.05 
            text = "O Captain! my Captain! rise up and hear the bells;" 
        intervals [16]:
            xmin = 46.05 
            xmax = 46.58 
            text = "" 
        intervals [17]:
            xmin = 46.58 
            xmax = 53.13 
            text = "Rise up- for you the flag is flung- for you the bugle trills," 
        intervals [18]:
            xmin = 53.13 
            xmax = 53.53 
            text = "" 
        intervals [19]:
            xmin = 53.53 
            xmax = 57.99 
            text = "For you bouquets and ribbon’d wreaths- for you the shores a-crowding," 
        intervals [20]:
            xmin = 57.99 
            xmax = 58.8 
            text = "" 
        intervals [21]:
            xmin = 58.8 
            xmax = 63.8 
            text = "For you they call, the swaying mass, their eager faces turning;" 
        intervals [22]:
            xmin = 63.8 
            xmax = 64.22 
            text = "" 
        intervals [23]:
            xmin = 64.22 
            xmax = 66.22 
            text = "Here Captain! dear father!" 
        intervals [24]:
            xmin = 66.22 
            xmax = 66.67 
            text = "" 
        intervals [25]:
            xmin = 66.67 
            xmax = 68.35 
            text = "This arm beneath your head!" 
        intervals [26]:
            xmin = 68.35 
            xmax = 70.64 
            text = "It is some dream that on the deck," 
        intervals [27]:
            xmin = 70.64 
            xmax = 70.73 
            text = "" 
        intervals [28]:
            xmin = 70.73 
            xmax = 73.1 
            text = "You’ve fallen cold and dead." 
        intervals [29]:
            xmin = 73.1 
            xmax = 74.79 
            text = "" 
        intervals [30]:
            xmin = 74.79 
            xmax = 80.59 
            text = "My Captain does not answer, his lips are pale and still," 
        intervals [31]:
            xmin = 80.59 
            xmax = 82.13 
            text = "" 
        intervals [32]:
            xmin = 82.13 
            xmax = 87.89 
            text = "My father does not feel my arm, he has no pulse nor will," 
        intervals [33]:
            xmin = 87.89 
            xmax = 88.31 
            text = "" 
        intervals [34]:
            xmin = 88.31 
            xmax = 93.02 
            text = "The ship is anchor’d safe and sound, its voyage closed and done," 
        intervals [35]:
            xmin = 93.02 
            xmax = 97.98 
            text = "From fearful trip the victor ship comes in with object won;" 
        intervals [36]:
            xmin = 97.98 
            xmax = 101.14 
            text = "Exult O shores, and ring O bells!" 
        intervals [37]:
            xmin = 101.14 
            xmax = 102.36 
            text = "" 
        intervals [38]:
            xmin = 102.36 
            xmax = 105.8 
            text = "But I with mournful tread," 
        intervals [39]:
            xmin = 105.8 
            xmax = 108.29 
            text = "Walk the deck my Captain lies," 
        intervals [40]:
            xmin = 108.29 
            xmax = 109.36 
            text = "" 
        intervals [41]:
            xmin = 109.36 
            xmax = 111.99 
            text = "Fallen cold and dead." 
        intervals [42]:
            xmin = 111.99 
            xmax = 112.316 
            text = "" 
