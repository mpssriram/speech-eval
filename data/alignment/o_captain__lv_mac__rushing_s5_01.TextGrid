            text = "O Captain! my Captain! our fearful trip is done," 
        intervals [3]:
            xmin = 2.84 
            xmax = 3.27 
            text = "" 
        intervals [4]:
            xmin = 3.27 
            xmax = 6.53 
            text = "The ship has weather’d every rack, the prize we sought is won," 
        intervals [5]:
            xmin = 6.53 
            xmax = 6.77 
            text = "" 
        intervals [6]:
            xmin = 6.77 
            xmax = 9.71 
            text = "The port is near, the bells I hear, the people all exulting," 
        intervals [7]:
            xmin = 9.71 
            xmax = 10.28 
            text = "" 
        intervals [8]:
            xmin = 10.28 
            xmax = 13.53 
            text = "While follow eyes the steady keel, the vessel grim and daring;" 
        intervals [9]:
            xmin = 13.53 
            xmax = 14.16 
            text = "" 
        intervals [10]:
            xmin = 14.16 
            xmax = 16.05 
            text = "But O heart! heart! heart!" 
        intervals [11]:
            xmin = 16.05 
            xmax = 16.33 
            text = "" 
        intervals [12]:
            xmin = 16.33 
            xmax = 17.78 
            text = "O the bleeding drops of red," 
        intervals [13]:
            xmin = 17.78 
            xmax = 19.47 
            text = "Where on the deck my Captain lies," 
        intervals [14]:
            xmin = 19.47 
            xmax = 21.1 
            text = "Fallen cold and dead." 
        intervals [15]:
            xmin = 21.1 
            xmax = 22.84 
            text = "" 
        intervals [16]:
            xmin = 22.84 
            xmax = 24.83 
            text = "O Captain! my Captain! rise up and hear the bells;" 
        intervals [17]:
            xmin = 24.83 
            xmax = 24.89 
            text = "" 
        intervals [18]:
            xmin = 24.89 
            xmax = 28.31 
            text = "Rise up- for you the flag is flung- for you the bugle trills," 
        intervals [19]:
            xmin = 28.31 
            xmax = 28.73 
            text = "" 
        intervals [20]:
            xmin = 28.73 
            xmax = 32.14 
            text = "For you bouquets and ribbon’d wreaths- for you the shores a-crowding," 
        intervals [21]:
            xmin = 32.14 
            xmax = 32.65 
            text = "" 
        intervals [22]:
            xmin = 32.65 
            xmax = 36.05 
            text = "For you they call, the swaying mass, their eager faces turning;" 
        intervals [23]:
            xmin = 36.05 
            xmax = 36.98 
            text = "" 
        intervals [24]:
            xmin = 36.98 
            xmax = 38.39 
            text = "Here Captain! dear father!" 
        intervals [25]:
            xmin = 38.39 
            xmax = 39.84 
            text = "This arm beneath your head!" 
        intervals [26]:
            xmin = 39.84 
            xmax = 40.14 
            text = "" 
        intervals [27]:
            xmin = 40.14 
            xmax = 41.86 
            text = "It is some dream that on the deck," 
        intervals [28]:
            xmin = 41.86 
            xmax = 41.89 
            text = "" 
        intervals [29]:
            xmin = 41.89 
            xmax = 43.55 
            text = "You’ve fallen cold and dead." 
        intervals [30]:
            xmin = 43.55 
            xmax = 44.64 
            text = "" 
        intervals [31]:
            xmin = 44.64 
            xmax = 48.01 
            text = "My Captain does not answer, his lips are pale and still," 
        intervals [32]:
            xmin = 48.01 
            xmax = 48.69 
            text = "" 
        intervals [33]:
            xmin = 48.69 
            xmax = 52.27 
            text = "My father does not feel my arm, he has no pulse nor will," 
        intervals [34]:
            xmin = 52.27 
            xmax = 52.97 
            text = "" 
        intervals [35]:
            xmin = 52.97 
            xmax = 56.47 
            text = "The ship is anchor’d safe and sound, its voyage closed and done," 
        intervals [36]:
            xmin = 56.47 
            xmax = 57.2 
            text = "" 
        intervals [37]:
            xmin = 57.2 
            xmax = 60.6 
            text = "From fearful trip the victor ship comes in with object won;" 
        intervals [38]:
            xmin = 60.6 
            xmax = 60.8 
            text = "" 
        intervals [39]:
            xmin = 60.8 
            xmax = 63.06 
            text = "Exult O shores, and ring O bells!" 
        intervals [40]:
            xmin = 63.06 
            xmax = 63.53 
            text = "" 
        intervals [41]:
            xmin = 63.53 
            xmax = 65.14 
            text = "But I with mournful tread," 
        intervals [42]:
            xmin = 65.14 
            xmax = 65.69 
            text = "" 
        intervals [43]:
            xmin = 65.69 
            xmax = 67.5 
            text = "Walk the deck my Captain lies," 
        intervals [44]:
            xmin = 67.5 
            xmax = 67.67 
            text = "" 
        intervals [45]:
            xmin = 67.67 
            xmax = 69.5 
            text = "Fallen cold and dead." 
