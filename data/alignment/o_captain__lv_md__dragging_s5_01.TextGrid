    item [2]:
        class = "IntervalTier" 
        name = "sentences" 
        xmin = 0 
        xmax = 114.928 
        intervals: size = 48 
        intervals [1]:
            xmin = 0 
            xmax = 0.29 
            text = "" 
        intervals [2]:
            xmin = 0.29 
            xmax = 3.77 
            text = "O Captain! my Captain! our fearful trip is done," 
        intervals [3]:
            xmin = 3.77 
            xmax = 4.2 
            text = "" 
        intervals [4]:
            xmin = 4.2 
            xmax = 8.28 
            text = "The ship has weather’d every rack, the prize we sought is won," 
        intervals [5]:
            xmin = 8.28 
            xmax = 8.83 
            text = "" 
        intervals [6]:
            xmin = 8.83 
            xmax = 15.24 
            text = "The port is near, the bells I hear, the people all exulting," 
        intervals [7]:
            xmin = 15.24 
            xmax = 15.87 
            text = "" 
        intervals [8]:
            xmin = 15.87 
            xmax = 20.96 
            text = "While follow eyes the steady keel, the vessel grim and daring;" 
        intervals [9]:
            xmin = 20.96 
            xmax = 21.77 
            text = "" 
        intervals [10]:
            xmin = 21.77 
            xmax = 24.73 
            text = "But O heart! heart! heart!" 
        intervals [11]:
            xmin = 24.73 
            xmax = 25.43 
            text = "" 
        intervals [12]:
            xmin = 25.43 
            xmax = 27.9 
            text = "O the bleeding drops of red," 
        intervals [13]:
            xmin = 27.9 
            xmax = 28.42 
            text = "" 
        intervals [14]:
            xmin = 28.42 
            xmax = 31.28 
            text = "Where on the deck my Captain lies," 
        intervals [15]:
            xmin = 31.28 
            xmax = 31.65 
            text = "" 
        intervals [16]:
            xmin = 31.65 
            xmax = 33.38 
            text = "Fallen cold and dead." 
        intervals [17]:
            xmin = 33.38 
            xmax = 35.3 
            text = "" 
        intervals [18]:
            xmin = 35.3 
            xmax = 39.58 
            text = "O Captain! my Captain! rise up and hear the bells;" 
        intervals [19]:
            xmin = 39.58 
            xmax = 40.01 
            text = "" 
        intervals [20]:
            xmin = 40.01 
            xmax = 44.83 
            text = "Rise up- for you the flag is flung- for you the bugle trills," 
        intervals [21]:
            xmin = 44.83 
            xmax = 45.24 
            text = "" 
        intervals [22]:
            xmin = 45.24 
            xmax = 49.42 
            text = "For you bouquets and ribbon’d wreaths- for you the shores a-crowding," 
        intervals [23]:
            xmin = 49.42 
            xmax = 49.95 
            text = "" 
        intervals [24]:
            xmin = 49.95 
            xmax = 54.21 
            text = "For you they call, the swaying mass, their eager faces turning;" 
        intervals [25]:
            xmin = 54.21 
            xmax = 54.75 
            text = "" 
        intervals [26]:
            xmin = 54.75 
            xmax = 56.88 
            text = "Here Captain! dear father!" 
        intervals [27]:
            xmin = 56.88 
            xmax = 57.22 
            text = "" 
        intervals [28]:
            xmin = 57.22 
            xmax = 59.04 
            text = "This arm beneath your head!" 
        intervals [29]:
            xmin = 59.04 
            xmax = 59.58 
            text = "" 
        intervals [30]:
            xmin = 59.58 
            xmax = 61.9 
            text = "It is some dream that on the deck," 
        intervals [31]:
            xmin = 61.9 
            xmax = 63.82 
            text = "You’ve fallen cold and dead." 
        intervals [32]:
            xmin = 63.82 
            xmax = 65.48 
            text = "" 
        intervals [33]:
            xmin = 65.48 
            xmax = 70.06 
            text = "My Captain does not answer, his lips are pale and still," 
        intervals [34]:
            xmin = 70.06 
            xmax = 70.7 
            text = "" 
        intervals [35]:
            xmin = 70.7 
            xmax = 75.11 
            text = "My father does not feel my arm, he has no pulse nor will," 
        intervals [36]:
            xmin = 75.11 
            xmax = 75.83 
            text = "" 
        intervals [37]:
            xmin = 75.83 
            xmax = 80.53 
            text = "The ship is anchor’d safe and sound, its voyage closed and done," 
        intervals [38]:
            xmin = 80.53 
            xmax = 81.24 
            text = "" 
        intervals [39]:
            xmin = 81.24 
            xmax = 85.56 
            text = "From fearful trip the victor ship comes in with object won;" 
        intervals [40]:
            xmin = 85.56 
            xmax = 86.49 
            text = "" 
        intervals [41]:
            xmin = 86.49 
            xmax = 89.67 
            text = "Exult O shores, and ring O bells!" 
        intervals [42]:
            xmin = 89.67 
            xmax = 89.99 
            text = "" 
        intervals [43]:
            xmin = 89.99 
            xmax = 92.01 
            text = "But I with mournful tread," 
        intervals [44]:
            xmin = 92.01 
            xmax = 92.98 
            text = "" 
        intervals [45]:
            xmin = 92.98 
            xmax = 95.48 
            text = "Walk the deck my Captain lies," 
        intervals [46]:
            xmin = 95.48 
            xmax = 96.2 
            text = "" 
        intervals [47]:
            xmin = 96.2 
            xmax = 105.88 
            text = "Fallen cold and dead." 
        intervals [48]:
            xmin = 105.88 
            xmax = 114.928 
            text = "" 
