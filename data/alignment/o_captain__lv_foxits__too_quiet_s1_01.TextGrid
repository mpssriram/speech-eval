    item [2]:
        class = "IntervalTier" 
        name = "sentences" 
        xmin = 0 
        xmax = 92.244 
        intervals: size = 49 
        intervals [1]:
            xmin = 0 
            xmax = 0.14 
            text = "" 
        intervals [2]:
            xmin = 0.14 
            xmax = 4.19 
            text = "O Captain! my Captain! our fearful trip is done," 
        intervals [3]:
            xmin = 4.19 
            xmax = 4.75 
            text = "" 
        intervals [4]:
            xmin = 4.75 
            xmax = 8.76 
            text = "The ship has weather’d every rack, the prize we sought is won," 
        intervals [5]:
            xmin = 8.76 
            xmax = 9.41 
            text = "" 
        intervals [6]:
            xmin = 9.41 
            xmax = 13.09 
            text = "The port is near, the bells I hear, the people all exulting," 
        intervals [7]:
            xmin = 13.09 
            xmax = 13.71 
            text = "" 
        intervals [8]:
            xmin = 13.71 
            xmax = 18.03 
            text = "While follow eyes the steady keel, the vessel grim and daring;" 
        intervals [9]:
            xmin = 18.03 
            xmax = 18.77 
            text = "" 
        intervals [10]:
            xmin = 18.77 
            xmax = 20.87 
            text = "But O heart! heart! heart!" 
        intervals [11]:
            xmin = 20.87 
            xmax = 21.55 
            text = "" 
        intervals [12]:
            xmin = 21.55 
            xmax = 23.31 
            text = "O the bleeding drops of red," 
        intervals [13]:
            xmin = 23.31 
            xmax = 24 
            text = "" 
        intervals [14]:
            xmin = 24 
            xmax = 26.07 
            text = "Where on the deck my Captain lies," 
        intervals [15]:
            xmin = 26.07 
            xmax = 26.43 
            text = "" 
        intervals [16]:
            xmin = 26.43 
            xmax = 27.99 
            text = "Fallen cold and dead." 
        intervals [17]:
            xmin = 27.99 
            xmax = 28.9 
            text = "" 
        intervals [18]:
            xmin = 28.9 
            xmax = 32.99 
            text = "O Captain! my Captain! rise up and hear the bells;" 
        intervals [19]:
            xmin = 32.99 
            xmax = 33.54 
            text = "" 
        intervals [20]:
            xmin = 33.54 
            xmax = 37.57 
            text = "Rise up- for you the flag is flung- for you the bugle trills," 
        intervals [21]:
            xmin = 37.57 
            xmax = 38.24 
            text = "" 
        intervals [22]:
            xmin = 38.24 
            xmax = 42.32 
            text = "For you bouquets and ribbon’d wreaths- for you the shores a-crowding," 
        intervals [23]:
            xmin = 42.32 
            xmax = 42.86 
            text = "" 
        intervals [24]:
            xmin = 42.86 
            xmax = 46.73 
            text = "For you they call, the swaying mass, their eager faces turning;" 
        intervals [25]:
            xmin = 46.73 
            xmax = 47.3 
            text = "" 
        intervals [26]:
            xmin = 47.3 
            xmax = 49.13 
            text = "Here Captain! dear father!" 
        intervals [27]:
            xmin = 49.13 
            xmax = 49.59 
            text = "" 
        intervals [28]:
            xmin = 49.59 
            xmax = 51.09 
            text = "This arm beneath your head!" 
        intervals [29]:
            xmin = 51.09 
            xmax = 51.67 
            text = "" 
        intervals [30]:
            xmin = 51.67 
            xmax = 53.49 
            text = "It is some dream that on the deck," 
        intervals [31]:
            xmin = 53.49 
            xmax = 53.85 
            text = "" 
        intervals [32]:
            xmin = 53.85 
            xmax = 55.54 
            text = "You’ve fallen cold and dead." 
        intervals [33]:
            xmin = 55.54 
            xmax = 57.24 
            text = "" 
        intervals [34]:
            xmin = 57.24 
            xmax = 61.2 
            text = "My Captain does not answer, his lips are pale and still," 
        intervals [35]:
            xmin = 61.2 
            xmax = 61.94 
            text = "" 
        intervals [36]:
            xmin = 61.94 
            xmax = 66.18 
            text = "My father does not feel my arm, he has no pulse nor will," 
        intervals [37]:
            xmin = 66.18 
            xmax = 66.95 
            text = "" 
        intervals [38]:
            xmin = 66.95 
            xmax = 71.15 
            text = "The ship is anchor’d safe and sound, its voyage closed and done," 
        intervals [39]:
            xmin = 71.15 
            xmax = 71.89 
            text = "" 
        intervals [40]:
            xmin = 71.89 
            xmax = 75.71 
            text = "From fearful trip the victor ship comes in with object won;" 
        intervals [41]:
            xmin = 75.71 
            xmax = 76.42 
            text = "" 
        intervals [42]:
            xmin = 76.42 
            xmax = 79.29 
            text = "Exult O shores, and ring O bells!" 
        intervals [43]:
            xmin = 79.29 
            xmax = 79.88 
            text = "" 
        intervals [44]:
            xmin = 79.88 
            xmax = 81.64 
            text = "But I with mournful tread," 
        intervals [45]:
            xmin = 81.64 
            xmax = 82.35 
            text = "" 
        intervals [46]:
            xmin = 82.35 
            xmax = 84.49 
            text = "Walk the deck my Captain lies," 
        intervals [47]:
            xmin = 84.49 
            xmax = 84.93 
            text = "" 
        intervals [48]:
            xmin = 84.93 
            xmax = 91.8 
            text = "Fallen cold and dead." 
        intervals [49]:
            xmin = 91.8 
            xmax = 92.244 
            text = "" 
