    item [2]:
        class = "IntervalTier" 
        name = "sentences" 
        xmin = 0 
        xmax = 111.073 
        intervals: size = 45 
        intervals [1]:
            xmin = 0 
            xmax = 0.25 
            text = "" 
        intervals [2]:
            xmin = 0.25 
            xmax = 6.03 
            text = "O Captain! my Captain! our fearful trip is done," 
        intervals [3]:
            xmin = 6.03 
            xmax = 6.26 
            text = "" 
        intervals [4]:
            xmin = 6.26 
            xmax = 14.9 
            text = "The ship has weather’d every rack, the prize we sought is won," 
        intervals [5]:
            xmin = 14.9 
            xmax = 15.3 
            text = "" 
        intervals [6]:
            xmin = 15.3 
            xmax = 23.25 
            text = "The port is near, the bells I hear, the people all exulting," 
        intervals [7]:
            xmin = 23.25 
            xmax = 23.78 
            text = "" 
        intervals [8]:
            xmin = 23.78 
            xmax = 28.64 
            text = "While follow eyes the steady keel, the vessel grim and daring;" 
        intervals [9]:
            xmin = 28.64 
            xmax = 29.3 
            text = "" 
        intervals [10]:
            xmin = 29.3 
            xmax = 32.4 
            text = "But O heart! heart! heart!" 
        intervals [11]:
            xmin = 32.4 
            xmax = 34.67 
            text = "O the bleeding drops of red," 
        intervals [12]:
            xmin = 34.67 
            xmax = 35.35 
            text = "" 
        intervals [13]:
            xmin = 35.35 
            xmax = 37.97 
            text = "Where on the deck my Captain lies," 
        intervals [14]:
            xmin = 37.97 
            xmax = 38.93 
            text = "" 
        intervals [15]:
            xmin = 38.93 
            xmax = 41.53 
            text = "Fallen cold and dead." 
        intervals [16]:
            xmin = 41.53 
            xmax = 42.8 
            text = "" 
        intervals [17]:
            xmin = 42.8 
            xmax = 46.18 
            text = "O Captain! my Captain! rise up and hear the bells;" 
        intervals [18]:
            xmin = 46.18 
            xmax = 46.5 
            text = "" 
        intervals [19]:
            xmin = 46.5 
            xmax = 51.89 
            text = "Rise up- for you the flag is flung- for you the bugle trills," 
        intervals [20]:
            xmin = 51.89 
            xmax = 52.29 
            text = "" 
        intervals [21]:
            xmin = 52.29 
            xmax = 56.75 
            text = "For you bouquets and ribbon’d wreaths- for you the shores a-crowding," 
        intervals [22]:
            xmin = 56.75 
            xmax = 57.56 
            text = "" 
        intervals [23]:
            xmin = 57.56 
            xmax = 62.55 
            text = "For you they call, the swaying mass, their eager faces turning;" 
        intervals [24]:
            xmin = 62.55 
            xmax = 62.98 
            text = "" 
        intervals [25]:
            xmin = 62.98 
            xmax = 64.98 
            text = "Here Captain! dear father!" 
        intervals [26]:
            xmin = 64.98 
            xmax = 65.42 
            text = "" 
        intervals [27]:
            xmin = 65.42 
            xmax = 67.16 
            text = "This arm beneath your head!" 
        intervals [28]:
            xmin = 67.16 
            xmax = 67.19 
            text = "" 
        intervals [29]:
            xmin = 67.19 
            xmax = 69.39 
            text = "It is some dream that on the deck," 
        intervals [30]:
            xmin = 69.39 
            xmax = 69.49 
            text = "" 
        intervals [31]:
            xmin = 69.49 
            xmax = 71.86 
            text = "You’ve fallen cold and dead." 
        intervals [32]:
            xmin = 71.86 
            xmax = 73.54 
            text = "" 
        intervals [33]:
            xmin = 73.54 
            xmax = 79.34 
            text = "My Captain does not answer, his lips are pale and still," 
        intervals [34]:
            xmin = 79.34 
            xmax = 80.89 
            text = "" 
        intervals [35]:
            xmin = 80.89 
            xmax = 86.65 
            text = "My father does not feel my arm, he has no pulse nor will," 
        intervals [36]:
            xmin = 86.65 
            xmax = 87.07 
            text = "" 
        intervals [37]:
            xmin = 87.07 
            xmax = 91.78 
            text = "The ship is anchor’d safe and sound, its voyage closed and done," 
        intervals [38]:
            xmin = 91.78 
            xmax = 96.74 
            text = "From fearful trip the victor ship comes in with object won;" 
        intervals [39]:
            xmin = 96.74 
            xmax = 99.9 
            text = "Exult O shores, and ring O bells!" 
        intervals [40]:
            xmin = 99.9 
            xmax = 101.11 
            text = "" 
        intervals [41]:
            xmin = 101.11 
            xmax = 104.56 
            text = "But I with mournful tread," 
        intervals [42]:
            xmin = 104.56 
            xmax = 107.04 
            text = "Walk the deck my Captain lies," 
        intervals [43]:
            xmin = 107.04 
            xmax = 108.12 
            text = "" 
        intervals [44]:
            xmin = 108.12 
            xmax = 110.75 
            text = "Fallen cold and dead." 
        intervals [45]:
            xmin = 110.75 
            xmax = 111.073 
            text = "" 
