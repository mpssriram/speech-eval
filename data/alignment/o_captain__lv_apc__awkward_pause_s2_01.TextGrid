    item [2]:
        class = "IntervalTier" 
        name = "sentences" 
        xmin = 0 
        xmax = 110.304 
        intervals: size = 47 
        intervals [1]:
            xmin = 0 
            xmax = 7.46 
            text = "two thousand and six O Captain! my Captain! our fearful trip is done," 
        intervals [2]:
            xmin = 7.46 
            xmax = 8.19 
            text = "" 
        intervals [3]:
            xmin = 8.19 
            xmax = 12.24 
            text = "The ship has weather’d every rack, the prize we sought is won," 
        intervals [4]:
            xmin = 12.24 
            xmax = 13.05 
            text = "" 
        intervals [5]:
            xmin = 13.05 
            xmax = 17.1 
            text = "The port is near, the bells I hear, the people all exulting," 
        intervals [6]:
            xmin = 17.1 
            xmax = 17.79 
            text = "" 
        intervals [7]:
            xmin = 17.79 
            xmax = 22.66 
            text = "While follow eyes the steady keel, the vessel grim and daring;" 
        intervals [8]:
            xmin = 22.66 
            xmax = 23.65 
            text = "" 
        intervals [9]:
            xmin = 23.65 
            xmax = 26.53 
            text = "But O heart! heart! heart!" 
        intervals [10]:
            xmin = 26.53 
            xmax = 27.2 
            text = "" 
        intervals [11]:
            xmin = 27.2 
            xmax = 30.06 
            text = "O the bleeding drops of red," 
        intervals [12]:
            xmin = 30.06 
            xmax = 30.64 
            text = "" 
        intervals [13]:
            xmin = 30.64 
            xmax = 32.73 
            text = "Where on the deck my Captain lies," 
        intervals [14]:
            xmin = 32.73 
            xmax = 34.48 
            text = "Fallen cold and dead." 
        intervals [15]:
            xmin = 34.48 
            xmax = 35.56 
            text = "" 
        intervals [16]:
            xmin = 35.56 
            xmax = 38.73 
            text = "O Captain! my Captain! rise up and hear the bells;" 
        intervals [17]:
            xmin = 38.73 
            xmax = 39.21 
            text = "" 
        intervals [18]:
            xmin = 39.21 
            xmax = 44.42 
            text = "Rise up- for you the flag is flung- for you the bugle trills," 
        intervals [19]:
            xmin = 44.42 
            xmax = 44.85 
            text = "" 
        intervals [20]:
            xmin = 44.85 
            xmax = 49.75 
            text = "For you bouquets and ribbon’d wreaths- for you the shores a-crowding," 
        intervals [21]:
            xmin = 49.75 
            xmax = 50.55 
            text = "" 
        intervals [22]:
            xmin = 50.55 
            xmax = 54.98 
            text = "For you they call, the swaying mass, their eager faces turning;" 
        intervals [23]:
            xmin = 54.98 
            xmax = 55.66 
            text = "" 
        intervals [24]:
            xmin = 55.66 
            xmax = 58.37 
            text = "Here Captain! dear father!" 
        intervals [25]:
            xmin = 58.37 
            xmax = 59.03 
            text = "" 
        intervals [26]:
            xmin = 59.03 
            xmax = 60.94 
            text = "This arm beneath your head!" 
        intervals [27]:
            xmin = 60.94 
            xmax = 61.67 
            text = "" 
        intervals [28]:
            xmin = 61.67 
            xmax = 64.47 
            text = "It is some dream that on the deck," 
        intervals [29]:
            xmin = 64.47 
            xmax = 65.14 
            text = "" 
        intervals [30]:
            xmin = 65.14 
            xmax = 67.69 
            text = "You’ve fallen cold and dead." 
        intervals [31]:
            xmin = 67.69 
            xmax = 69.45 
            text = "" 
        intervals [32]:
            xmin = 69.45 
            xmax = 74.57 
            text = "My Captain does not answer, his lips are pale and still," 
        intervals [33]:
            xmin = 74.57 
            xmax = 75.73 
            text = "" 
        intervals [34]:
            xmin = 75.73 
            xmax = 81.37 
            text = "My father does not feel my arm, he has no pulse nor will," 
        intervals [35]:
            xmin = 81.37 
            xmax = 82.49 
            text = "" 
        intervals [36]:
            xmin = 82.49 
            xmax = 88.24 
            text = "The ship is anchor’d safe and sound, its voyage closed and done," 
        intervals [37]:
            xmin = 88.24 
            xmax = 89.28 
            text = "" 
        intervals [38]:
            xmin = 89.28 
            xmax = 95.05 
            text = "From fearful trip the victor ship comes in with object won;" 
        intervals [39]:
            xmin = 95.05 
            xmax = 96.32 
            text = "" 
        intervals [40]:
            xmin = 96.32 
            xmax = 100.17 
            text = "Exult O shores, and ring O bells!" 
        intervals [41]:
            xmin = 100.17 
            xmax = 100.81 
            text = "" 
        intervals [42]:
            xmin = 100.81 
            xmax = 103.69 
            text = "But I with mournful tread," 
        intervals [43]:
            xmin = 103.69 
            xmax = 104.4 
            text = "" 
        intervals [44]:
            xmin = 104.4 
            xmax = 107.03 
            text = "Walk the deck my Captain lies," 
        intervals [45]:
            xmin = 107.03 
            xmax = 107.76 
            text = "" 
        intervals [46]:
            xmin = 107.76 
            xmax = 110.09 
            text = "Fallen cold and dead." 
        intervals [47]:
            xmin = 110.09 
            xmax = 110.304 
            text = "" 
