    item [2]:
        class = "IntervalTier" 
        name = "sentences" 
        xmin = 0 
        xmax = 109.509 
        intervals: size = 47 
        intervals [1]:
            xmin = 0 
            xmax = 7.46 
            text = "two thousand and six O Captain! my Captain! our fearful trip is done," 
        intervals [2]:
            xmin = 7.46 
            xmax = 8.19 
            text = "" 
        intervals [3]:
            xmin = 8.19 
            xmax = 12.44 
            text = "The ship has weather’d every rack, the prize we sought is won," 
        intervals [4]:
            xmin = 12.44 
            xmax = 13.26 
            text = "" 
        intervals [5]:
            xmin = 13.26 
            xmax = 17.3 
            text = "The port is near, the bells I hear, the people all exulting," 
        intervals [6]:
            xmin = 17.3 
            xmax = 18 
            text = "" 
        intervals [7]:
            xmin = 18 
            xmax = 22.87 
            text = "While follow eyes the steady keel, the vessel grim and daring;" 
        intervals [8]:
            xmin = 22.87 
            xmax = 23.85 
            text = "" 
        intervals [9]:
            xmin = 23.85 
            xmax = 26.74 
            text = "But O heart! heart! heart!" 
        intervals [10]:
            xmin = 26.74 
            xmax = 27.4 
            text = "" 
        intervals [11]:
            xmin = 27.4 
            xmax = 29.27 
            text = "O the bleeding drops of red," 
        intervals [12]:
            xmin = 29.27 
            xmax = 29.84 
            text = "" 
        intervals [13]:
            xmin = 29.84 
            xmax = 31.94 
            text = "Where on the deck my Captain lies," 
        intervals [14]:
            xmin = 31.94 
            xmax = 33.68 
            text = "Fallen cold and dead." 
        intervals [15]:
            xmin = 33.68 
            xmax = 34.77 
            text = "" 
        intervals [16]:
            xmin = 34.77 
            xmax = 37.93 
            text = "O Captain! my Captain! rise up and hear the bells;" 
        intervals [17]:
            xmin = 37.93 
            xmax = 38.42 
            text = "" 
        intervals [18]:
            xmin = 38.42 
            xmax = 43.63 
            text = "Rise up- for you the flag is flung- for you the bugle trills," 
        intervals [19]:
            xmin = 43.63 
            xmax = 44.06 
            text = "" 
        intervals [20]:
            xmin = 44.06 
            xmax = 48.95 
            text = "For you bouquets and ribbon’d wreaths- for you the shores a-crowding," 
        intervals [21]:
            xmin = 48.95 
            xmax = 49.76 
            text = "" 
        intervals [22]:
            xmin = 49.76 
            xmax = 54.18 
            text = "For you they call, the swaying mass, their eager faces turning;" 
        intervals [23]:
            xmin = 54.18 
            xmax = 54.87 
            text = "" 
        intervals [24]:
            xmin = 54.87 
            xmax = 57.58 
            text = "Here Captain! dear father!" 
        intervals [25]:
            xmin = 57.58 
            xmax = 58.24 
            text = "" 
        intervals [26]:
            xmin = 58.24 
            xmax = 60.15 
            text = "This arm beneath your head!" 
        intervals [27]:
            xmin = 60.15 
            xmax = 60.88 
            text = "" 
        intervals [28]:
            xmin = 60.88 
            xmax = 63.68 
            text = "It is some dream that on the deck," 
        intervals [29]:
            xmin = 63.68 
            xmax = 64.34 
            text = "" 
        intervals [30]:
            xmin = 64.34 
            xmax = 66.89 
            text = "You’ve fallen cold and dead." 
        intervals [31]:
            xmin = 66.89 
            xmax = 68.65 
            text = "" 
        intervals [32]:
            xmin = 68.65 
            xmax = 73.78 
            text = "My Captain does not answer, his lips are pale and still," 
        intervals [33]:
            xmin = 73.78 
            xmax = 74.94 
            text = "" 
        intervals [34]:
            xmin = 74.94 
            xmax = 80.58 
            text = "My father does not feel my arm, he has no pulse nor will," 
        intervals [35]:
            xmin = 80.58 
            xmax = 81.7 
            text = "" 
        intervals [36]:
            xmin = 81.7 
            xmax = 87.45 
            text = "The ship is anchor’d safe and sound, its voyage closed and done," 
        intervals [37]:
            xmin = 87.45 
            xmax = 88.48 
            text = "" 
        intervals [38]:
            xmin = 88.48 
            xmax = 94.25 
            text = "From fearful trip the victor ship comes in with object won;" 
        intervals [39]:
            xmin = 94.25 
            xmax = 95.52 
            text = "" 
        intervals [40]:
            xmin = 95.52 
            xmax = 99.38 
            text = "Exult O shores, and ring O bells!" 
        intervals [41]:
            xmin = 99.38 
            xmax = 100.02 
            text = "" 
        intervals [42]:
            xmin = 100.02 
            xmax = 102.9 
            text = "But I with mournful tread," 
        intervals [43]:
            xmin = 102.9 
            xmax = 103.6 
            text = "" 
        intervals [44]:
            xmin = 103.6 
            xmax = 106.23 
            text = "Walk the deck my Captain lies," 
        intervals [45]:
            xmin = 106.23 
            xmax = 106.95 
            text = "" 
        intervals [46]:
            xmin = 106.95 
            xmax = 109.3 
            text = "Fallen cold and dead." 
        intervals [47]:
            xmin = 109.3 
            xmax = 109.509 
            text = "" 
