    item [2]:
        class = "IntervalTier" 
        name = "sentences" 
        xmin = 0 
        xmax = 91.859 
        intervals: size = 49 
        intervals [1]:
            xmin = 0 
            xmax = 0.14 
            text = "" 
        intervals [2]:
            xmin = 0.14 
            xmax = 3.82 
            text = "O Captain! my Captain! our fearful trip is done," 
        intervals [3]:
            xmin = 3.82 
            xmax = 4.36 
            text = "" 
        intervals [4]:
            xmin = 4.36 
            xmax = 8.38 
            text = "The ship has weather’d every rack, the prize we sought is won," 
        intervals [5]:
            xmin = 8.38 
            xmax = 9.04 
            text = "" 
        intervals [6]:
            xmin = 9.04 
            xmax = 12.71 
            text = "The port is near, the bells I hear, the people all exulting," 
        intervals [7]:
            xmin = 12.71 
            xmax = 13.33 
            text = "" 
        intervals [8]:
            xmin = 13.33 
            xmax = 17.65 
            text = "While follow eyes the steady keel, the vessel grim and daring;" 
        intervals [9]:
            xmin = 17.65 
            xmax = 18.38 
            text = "" 
        intervals [10]:
            xmin = 18.38 
            xmax = 20.49 
            text = "But O heart! heart! heart!" 
        intervals [11]:
            xmin = 20.49 
            xmax = 21.17 
            text = "" 
        intervals [12]:
            xmin = 21.17 
            xmax = 22.93 
            text = "O the bleeding drops of red," 
        intervals [13]:
            xmin = 22.93 
            xmax = 23.61 
            text = "" 
        intervals [14]:
            xmin = 23.61 
            xmax = 25.69 
            text = "Where on the deck my Captain lies," 
        intervals [15]:
            xmin = 25.69 
            xmax = 26.05 
            text = "" 
        intervals [16]:
            xmin = 26.05 
            xmax = 27.63 
            text = "Fallen cold and dead." 
        intervals [17]:
            xmin = 27.63 
            xmax = 28.51 
            text = "" 
        intervals [18]:
            xmin = 28.51 
            xmax = 32.61 
            text = "O Captain! my Captain! rise up and hear the bells;" 
        intervals [19]:
            xmin = 32.61 
            xmax = 33.15 
            text = "" 
        intervals [20]:
            xmin = 33.15 
            xmax = 37.18 
            text = "Rise up- for you the flag is flung- for you the bugle trills," 
        intervals [21]:
            xmin = 37.18 
            xmax = 37.85 
            text = "" 
        intervals [22]:
            xmin = 37.85 
            xmax = 41.97 
            text = "For you bouquets and ribbon’d wreaths- for you the shores a-crowding," 
        intervals [23]:
            xmin = 41.97 
            xmax = 42.47 
            text = "" 
        intervals [24]:
            xmin = 42.47 
            xmax = 46.33 
            text = "For you they call, the swaying mass, their eager faces turning;" 
        intervals [25]:
            xmin = 46.33 
            xmax = 46.91 
            text = "" 
        intervals [26]:
            xmin = 46.91 
            xmax = 48.75 
            text = "Here Captain! dear father!" 
        intervals [27]:
            xmin = 48.75 
            xmax = 49.21 
            text = "" 
        intervals [28]:
            xmin = 49.21 
            xmax = 50.71 
            text = "This arm beneath your head!" 
        intervals [29]:
            xmin = 50.71 
            xmax = 51.28 
            text = "" 
        intervals [30]:
            xmin = 51.28 
            xmax = 53.11 
            text = "It is some dream that on the deck," 
        intervals [31]:
            xmin = 53.11 
            xmax = 53.46 
            text = "" 
        intervals [32]:
            xmin = 53.46 
            xmax = 55.16 
            text = "You’ve fallen cold and dead." 
        intervals [33]:
            xmin = 55.16 
            xmax = 56.85 
            text = "" 
        intervals [34]:
            xmin = 56.85 
            xmax = 60.81 
            text = "My Captain does not answer, his lips are pale and still," 
        intervals [35]:
            xmin = 60.81 
            xmax = 61.55 
            text = "" 
        intervals [36]:
            xmin = 61.55 
            xmax = 65.8 
            text = "My father does not feel my arm, he has no pulse nor will," 
        intervals [37]:
            xmin = 65.8 
            xmax = 66.57 
            text = "" 
        intervals [38]:
            xmin = 66.57 
            xmax = 70.76 
            text = "The ship is anchor’d safe and sound, its voyage closed and done," 
        intervals [39]:
            xmin = 70.76 
            xmax = 71.5 
            text = "" 
        intervals [40]:
            xmin = 71.5 
            xmax = 75.32 
            text = "From fearful trip the victor ship comes in with object won;" 
        intervals [41]:
            xmin = 75.32 
            xmax = 76.03 
            text = "" 
        intervals [42]:
            xmin = 76.03 
            xmax = 78.91 
            text = "Exult O shores, and ring O bells!" 
        intervals [43]:
            xmin = 78.91 
            xmax = 79.5 
            text = "" 
        intervals [44]:
            xmin = 79.5 
            xmax = 81.26 
            text = "But I with mournful tread," 
        intervals [45]:
            xmin = 81.26 
            xmax = 81.96 
            text = "" 
        intervals [46]:
            xmin = 81.96 
            xmax = 84.1 
            text = "Walk the deck my Captain lies," 
        intervals [47]:
            xmin = 84.1 
            xmax = 84.56 
            text = "" 
        intervals [48]:
            xmin = 84.56 
            xmax = 91.42 
            text = "Fallen cold and dead." 
        intervals [49]:
            xmin = 91.42 
            xmax = 91.859 
            text = "" 
