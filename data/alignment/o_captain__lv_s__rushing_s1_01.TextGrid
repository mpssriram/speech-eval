    item [2]:
        class = "IntervalTier" 
        name = "sentences" 
        xmin = 0 
        xmax = 86.538 
        intervals: size = 49 
        intervals [1]:
            xmin = 0 
            xmax = 0.15 
            text = "" 
        intervals [2]:
            xmin = 0.15 
            xmax = 3.33 
            text = "O Captain! my Captain! our fearful trip is done," 
        intervals [3]:
            xmin = 3.33 
            xmax = 3.93 
            text = "" 
        intervals [4]:
            xmin = 3.93 
            xmax = 7.15 
            text = "The ship has weather’d every rack, the prize we sought is won," 
        intervals [5]:
            xmin = 7.15 
            xmax = 7.94 
            text = "" 
        intervals [6]:
            xmin = 7.94 
            xmax = 11.87 
            text = "The port is near, the bells I hear, the people all exulting," 
        intervals [7]:
            xmin = 11.87 
            xmax = 12.49 
            text = "" 
        intervals [8]:
            xmin = 12.49 
            xmax = 16.23 
            text = "While follow eyes the steady keel, the vessel grim and daring;" 
        intervals [9]:
            xmin = 16.23 
            xmax = 17.38 
            text = "" 
        intervals [10]:
            xmin = 17.38 
            xmax = 19.81 
            text = "But O heart! heart! heart!" 
        intervals [11]:
            xmin = 19.81 
            xmax = 20.51 
            text = "" 
        intervals [12]:
            xmin = 20.51 
            xmax = 22.25 
            text = "O the bleeding drops of red," 
        intervals [13]:
            xmin = 22.25 
            xmax = 23 
            text = "" 
        intervals [14]:
            xmin = 23 
            xmax = 25.17 
            text = "Where on the deck my Captain lies," 
        intervals [15]:
            xmin = 25.17 
            xmax = 25.48 
            text = "" 
        intervals [16]:
            xmin = 25.48 
            xmax = 27.58 
            text = "Fallen cold and dead." 
        intervals [17]:
            xmin = 27.58 
            xmax = 29.14 
            text = "" 
        intervals [18]:
            xmin = 29.14 
            xmax = 32.52 
            text = "O Captain! my Captain! rise up and hear the bells;" 
        intervals [19]:
            xmin = 32.52 
            xmax = 33.12 
            text = "" 
        intervals [20]:
            xmin = 33.12 
            xmax = 36.82 
            text = "Rise up- for you the flag is flung- for you the bugle trills," 
        intervals [21]:
            xmin = 36.82 
            xmax = 37.45 
            text = "" 
        intervals [22]:
            xmin = 37.45 
            xmax = 41 
            text = "For you bouquets and ribbon’d wreaths- for you the shores a-crowding," 
        intervals [23]:
            xmin = 41 
            xmax = 41.64 
            text = "" 
        intervals [24]:
            xmin = 41.64 
            xmax = 45.14 
            text = "For you they call, the swaying mass, their eager faces turning;" 
        intervals [25]:
            xmin = 45.14 
            xmax = 46.22 
            text = "" 
        intervals [26]:
            xmin = 46.22 
            xmax = 47.77 
            text = "Here Captain! dear father!" 
        intervals [27]:
            xmin = 47.77 
            xmax = 48.17 
            text = "" 
        intervals [28]:
            xmin = 48.17 
            xmax = 49.66 
            text = "This arm beneath your head!" 
        intervals [29]:
            xmin = 49.66 
            xmax = 50.57 
            text = "" 
        intervals [30]:
            xmin = 50.57 
            xmax = 52.56 
            text = "It is some dream that on the deck," 
        intervals [31]:
            xmin = 52.56 
            xmax = 52.64 
            text = "" 
        intervals [32]:
            xmin = 52.64 
            xmax = 54.89 
            text = "You’ve fallen cold and dead." 
        intervals [33]:
            xmin = 54.89 
            xmax = 56.84 
            text = "" 
        intervals [34]:
            xmin = 56.84 
            xmax = 60.59 
            text = "My Captain does not answer, his lips are pale and still," 
        intervals [35]:
            xmin = 60.59 
            xmax = 61.47 
            text = "" 
        intervals [36]:
            xmin = 61.47 
            xmax = 65.48 
            text = "My father does not feel my arm, he has no pulse nor will," 
        intervals [37]:
            xmin = 65.48 
            xmax = 66.51 
            text = "" 
        intervals [38]:
            xmin = 66.51 
            xmax = 70.11 
            text = "The ship is anchor’d safe and sound, its voyage closed and done," 
        intervals [39]:
            xmin = 70.11 
            xmax = 70.73 
            text = "" 
        intervals [40]:
            xmin = 70.73 
            xmax = 74.07 
            text = "From fearful trip the victor ship comes in with object won;" 
        intervals [41]:
            xmin = 74.07 
            xmax = 74.99 
            text = "" 
        intervals [42]:
            xmin = 74.99 
            xmax = 77.61 
            text = "Exult O shores, and ring O bells!" 
        intervals [43]:
            xmin = 77.61 
            xmax = 78.15 
            text = "" 
        intervals [44]:
            xmin = 78.15 
            xmax = 80.37 
            text = "But I with mournful tread," 
        intervals [45]:
            xmin = 80.37 
            xmax = 81.15 
            text = "" 
        intervals [46]:
            xmin = 81.15 
            xmax = 83.59 
            text = "Walk the deck my Captain lies," 
        intervals [47]:
            xmin = 83.59 
            xmax = 84.26 
            text = "" 
        intervals [48]:
            xmin = 84.26 
            xmax = 86.46 
            text = "Fallen cold and dead." 
        intervals [49]:
            xmin = 86.46 
            xmax = 86.538 
            text = "" 
