        class = "IntervalTier" 
        name = "sentences" 
        xmin = 0 
        xmax = 111.324 
        intervals: size = 47 
        intervals [1]:
            xmin = 0 
            xmax = 0.29 
            text = "" 
        intervals [2]:
            xmin = 0.29 
            xmax = 3.77 
            text = "O Captain! my Captain! our fearful trip is done," 
        intervals [3]:
            xmin = 3.77 
            xmax = 4.2 
            text = "" 
        intervals [4]:
            xmin = 4.2 
            xmax = 8.28 
            text = "The ship has weather’d every rack, the prize we sought is won," 
        intervals [5]:
            xmin = 8.28 
            xmax = 8.83 
            text = "" 
        intervals [6]:
            xmin = 8.83 
            xmax = 13.34 
            text = "The port is near, the bells I hear, the people all exulting," 
        intervals [7]:
            xmin = 13.34 
            xmax = 13.98 
            text = "" 
        intervals [8]:
            xmin = 13.98 
            xmax = 19.06 
            text = "While follow eyes the steady keel, the vessel grim and daring;" 
        intervals [9]:
            xmin = 19.06 
            xmax = 19.87 
            text = "" 
        intervals [10]:
            xmin = 19.87 
            xmax = 22.83 
            text = "But O heart! heart! heart!" 
        intervals [11]:
            xmin = 22.83 
            xmax = 23.53 
            text = "" 
        intervals [12]:
            xmin = 23.53 
            xmax = 26 
            text = "O the bleeding drops of red," 
        intervals [13]:
            xmin = 26 
            xmax = 26.53 
            text = "" 
        intervals [14]:
            xmin = 26.53 
            xmax = 29.27 
            text = "Where on the deck my Captain lies," 
        intervals [15]:
            xmin = 29.27 
            xmax = 31.13 
            text = "Fallen cold and dead." 
        intervals [16]:
            xmin = 31.13 
            xmax = 33.05 
            text = "" 
        intervals [17]:
            xmin = 33.05 
            xmax = 35.96 
            text = "O Captain! my Captain! rise up and hear the bells;" 
        intervals [18]:
            xmin = 35.96 
            xmax = 36.41 
            text = "" 
        intervals [19]:
            xmin = 36.41 
            xmax = 41.22 
            text = "Rise up- for you the flag is flung- for you the bugle trills," 
        intervals [20]:
            xmin = 41.22 
            xmax = 41.6 
            text = "" 
        intervals [21]:
            xmin = 41.6 
            xmax = 45.82 
            text = "For you bouquets and ribbon’d wreaths- for you the shores a-crowding," 
        intervals [22]:
            xmin = 45.82 
            xmax = 46.35 
            text = "" 
        intervals [23]:
            xmin = 46.35 
            xmax = 50.6 
            text = "For you they call, the swaying mass, their eager faces turning;" 
        intervals [24]:
            xmin = 50.6 
            xmax = 51.15 
            text = "" 
        intervals [25]:
            xmin = 51.15 
            xmax = 53.28 
            text = "Here Captain! dear father!" 
        intervals [26]:
            xmin = 53.28 
            xmax = 53.61 
            text = "" 
        intervals [27]:
            xmin = 53.61 
            xmax = 55.43 
            text = "This arm beneath your head!" 
        intervals [28]:
            xmin = 55.43 
            xmax = 55.95 
            text = "" 
        intervals [29]:
            xmin = 55.95 
            xmax = 58.3 
            text = "It is some dream that on the deck," 
        intervals [30]:
            xmin = 58.3 
            xmax = 60.21 
            text = "You’ve fallen cold and dead." 
        intervals [31]:
            xmin = 60.21 
            xmax = 61.88 
            text = "" 
        intervals [32]:
            xmin = 61.88 
            xmax = 66.46 
            text = "My Captain does not answer, his lips are pale and still," 
        intervals [33]:
            xmin = 66.46 
            xmax = 67.09 
            text = "" 
        intervals [34]:
            xmin = 67.09 
            xmax = 71.51 
            text = "My father does not feel my arm, he has no pulse nor will," 
        intervals [35]:
            xmin = 71.51 
            xmax = 72.24 
            text = "" 
        intervals [36]:
            xmin = 72.24 
            xmax = 76.93 
            text = "The ship is anchor’d safe and sound, its voyage closed and done," 
        intervals [37]:
            xmin = 76.93 
            xmax = 77.63 
            text = "" 
        intervals [38]:
            xmin = 77.63 
            xmax = 81.96 
            text = "From fearful trip the victor ship comes in with object won;" 
        intervals [39]:
            xmin = 81.96 
            xmax = 82.86 
            text = "" 
        intervals [40]:
            xmin = 82.86 
            xmax = 86.07 
            text = "Exult O shores, and ring O bells!" 
        intervals [41]:
            xmin = 86.07 
            xmax = 86.39 
            text = "" 
        intervals [42]:
            xmin = 86.39 
            xmax = 88.41 
            text = "But I with mournful tread," 
        intervals [43]:
            xmin = 88.41 
            xmax = 89.37 
            text = "" 
        intervals [44]:
            xmin = 89.37 
            xmax = 91.88 
            text = "Walk the deck my Captain lies," 
        intervals [45]:
            xmin = 91.88 
            xmax = 92.56 
            text = "" 
        intervals [46]:
            xmin = 92.56 
            xmax = 102.28 
            text = "Fallen cold and dead." 
        intervals [47]:
            xmin = 102.28 
            xmax = 111.324 
            text = "" 
