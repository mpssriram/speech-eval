            text = "O Captain! my Captain! our fearful trip is done," 
        intervals [3]:
            xmin = 2.84 
            xmax = 3.27 
            text = "" 
        intervals [4]:
            xmin = 3.27 
            xmax = 6.53 
            text = "The ship has weather’d every rack, the prize we sought is won," 
        intervals [5]:
            xmin = 6.53 
            xmax = 6.77 
            text = "" 
        intervals [6]:
            xmin = 6.77 
            xmax = 11.91 
            text = "The port is near, the bells I hear, the people all exulting," 
        intervals [7]:
            xmin = 11.91 
            xmax = 12.48 
            text = "" 
        intervals [8]:
            xmin = 12.48 
            xmax = 15.73 
            text = "While follow eyes the steady keel, the vessel grim and daring;" 
        intervals [9]:
            xmin = 15.73 
            xmax = 16.36 
            text = "" 
        intervals [10]:
            xmin = 16.36 
            xmax = 18.25 
            text = "But O heart! heart! heart!" 
        intervals [11]:
            xmin = 18.25 
            xmax = 18.53 
            text = "" 
        intervals [12]:
            xmin = 18.53 
            xmax = 19.98 
            text = "O the bleeding drops of red," 
        intervals [13]:
            xmin = 19.98 
            xmax = 21.67 
            text = "Where on the deck my Captain lies," 
        intervals [14]:
            xmin = 21.67 
            xmax = 23.3 
            text = "Fallen cold and dead." 
        intervals [15]:
            xmin = 23.3 
            xmax = 25.04 
            text = "" 
        intervals [16]:
            xmin = 25.04 
            xmax = 27.88 
            text = "O Captain! my Captain! rise up and hear the bells;" 
        intervals [17]:
            xmin = 27.88 
            xmax = 27.95 
            text = "" 
        intervals [18]:
            xmin = 27.95 
            xmax = 31.37 
            text = "Rise up- for you the flag is flung- for you the bugle trills," 
        intervals [19]:
            xmin = 31.37 
            xmax = 31.78 
            text = "" 
        intervals [20]:
            xmin = 31.78 
            xmax = 35.2 
            text = "For you bouquets and ribbon’d wreaths- for you the shores a-crowding," 
        intervals [21]:
            xmin = 35.2 
            xmax = 35.7 
            text = "" 
        intervals [22]:
            xmin = 35.7 
            xmax = 39.11 
            text = "For you they call, the swaying mass, their eager faces turning;" 
        intervals [23]:
            xmin = 39.11 
            xmax = 40.03 
            text = "" 
        intervals [24]:
            xmin = 40.03 
            xmax = 41.44 
            text = "Here Captain! dear father!" 
        intervals [25]:
            xmin = 41.44 
            xmax = 42.9 
            text = "This arm beneath your head!" 
        intervals [26]:
            xmin = 42.9 
            xmax = 43.2 
            text = "" 
        intervals [27]:
            xmin = 43.2 
            xmax = 44.82 
            text = "It is some dream that on the deck," 
        intervals [28]:
            xmin = 44.82 
            xmax = 44.92 
            text = "" 
        intervals [29]:
            xmin = 44.92 
            xmax = 46.6 
            text = "You’ve fallen cold and dead." 
        intervals [30]:
            xmin = 46.6 
            xmax = 47.69 
            text = "" 
        intervals [31]:
            xmin = 47.69 
            xmax = 51.07 
            text = "My Captain does not answer, his lips are pale and still," 
        intervals [32]:
            xmin = 51.07 
            xmax = 51.75 
            text = "" 
        intervals [33]:
            xmin = 51.75 
            xmax = 55.36 
            text = "My father does not feel my arm, he has no pulse nor will," 
        intervals [34]:
            xmin = 55.36 
            xmax = 56.03 
            text = "" 
        intervals [35]:
            xmin = 56.03 
            xmax = 59.53 
            text = "The ship is anchor’d safe and sound, its voyage closed and done," 
        intervals [36]:
            xmin = 59.53 
            xmax = 60.26 
            text = "" 
        intervals [37]:
            xmin = 60.26 
            xmax = 63.66 
            text = "From fearful trip the victor ship comes in with object won;" 
        intervals [38]:
            xmin = 63.66 
            xmax = 63.85 
            text = "" 
        intervals [39]:
            xmin = 63.85 
            xmax = 66.12 
            text = "Exult O shores, and ring O bells!" 
        intervals [40]:
            xmin = 66.12 
            xmax = 66.58 
            text = "" 
        intervals [41]:
            xmin = 66.58 
            xmax = 68.18 
            text = "But I with mournful tread," 
        intervals [42]:
            xmin = 68.18 
            xmax = 68.75 
            text = "" 
        intervals [43]:
            xmin = 68.75 
            xmax = 70.56 
            text = "Walk the deck my Captain lies," 
        intervals [44]:
            xmin = 70.56 
            xmax = 70.73 
            text = "" 
        intervals [45]:
            xmin = 70.73 
            xmax = 72.55 
            text = "Fallen cold and dead." 
        intervals [46]:
            xmin = 72.55 
