    item [2]:
        class = "IntervalTier" 
        name = "sentences" 
        xmin = 0 
        xmax = 98.257 
        intervals: size = 48 
        intervals [1]:
            xmin = 0 
            xmax = 0.13 
            text = "" 
        intervals [2]:
            xmin = 0.13 
            xmax = 3.92 
            text = "O Captain! my Captain! our fearful trip is done," 
        intervals [3]:
            xmin = 3.92 
            xmax = 4.28 
            text = "" 
        intervals [4]:
            xmin = 4.28 
            xmax = 8.18 
            text = "The ship has weather’d every rack, the prize we sought is won," 
        intervals [5]:
            xmin = 8.18 
            xmax = 9.12 
            text = "" 
        intervals [6]:
            xmin = 9.12 
            xmax = 14.25 
            text = "The port is near, the bells I hear, the people all exulting," 
        intervals [7]:
            xmin = 14.25 
            xmax = 14.72 
            text = "" 
        intervals [8]:
            xmin = 14.72 
            xmax = 19.33 
            text = "While follow eyes the steady keel, the vessel grim and daring;" 
        intervals [9]:
            xmin = 19.33 
            xmax = 20.66 
            text = "" 
        intervals [10]:
            xmin = 20.66 
            xmax = 24.13 
            text = "But O heart! heart! heart!" 
        intervals [11]:
            xmin = 24.13 
            xmax = 25.14 
            text = "" 
        intervals [12]:
            xmin = 25.14 
            xmax = 27.53 
            text = "O the bleeding drops of red," 
        intervals [13]:
            xmin = 27.53 
            xmax = 28.39 
            text = "" 
        intervals [14]:
            xmin = 28.39 
            xmax = 30.82 
            text = "Where on the deck my Captain lies," 
        intervals [15]:
            xmin = 30.82 
            xmax = 31.16 
            text = "" 
        intervals [16]:
            xmin = 31.16 
            xmax = 33.07 
            text = "Fallen cold and dead." 
        intervals [17]:
            xmin = 33.07 
            xmax = 34.9 
            text = "" 
        intervals [18]:
            xmin = 34.9 
            xmax = 38.63 
            text = "O Captain! my Captain! rise up and hear the bells;" 
        intervals [19]:
            xmin = 38.63 
            xmax = 38.99 
            text = "" 
        intervals [20]:
            xmin = 38.99 
            xmax = 43.44 
            text = "Rise up- for you the flag is flung- for you the bugle trills," 
        intervals [21]:
            xmin = 43.44 
            xmax = 43.9 
            text = "" 
        intervals [22]:
            xmin = 43.9 
            xmax = 48.42 
            text = "For you bouquets and ribbon’d wreaths- for you the shores a-crowding," 
        intervals [23]:
            xmin = 48.42 
            xmax = 48.79 
            text = "" 
        intervals [24]:
            xmin = 48.79 
            xmax = 53.07 
            text = "For you they call, the swaying mass, their eager faces turning;" 
        intervals [25]:
            xmin = 53.07 
            xmax = 53.91 
            text = "" 
        intervals [26]:
            xmin = 53.91 
            xmax = 55.93 
            text = "Here Captain! dear father!" 
        intervals [27]:
            xmin = 55.93 
            xmax = 57.59 
            text = "This arm beneath your head!" 
        intervals [28]:
            xmin = 57.59 
            xmax = 58.03 
            text = "" 
        intervals [29]:
            xmin = 58.03 
            xmax = 60.28 
            text = "It is some dream that on the deck," 
        intervals [30]:
            xmin = 60.28 
            xmax = 60.58 
            text = "" 
        intervals [31]:
            xmin = 60.58 
            xmax = 62.44 
            text = "You’ve fallen cold and dead." 
        intervals [32]:
            xmin = 62.44 
            xmax = 65.16 
            text = "" 
        intervals [33]:
            xmin = 65.16 
            xmax = 69.78 
            text = "My Captain does not answer, his lips are pale and still," 
        intervals [34]:
            xmin = 69.78 
            xmax = 70.72 
            text = "" 
        intervals [35]:
            xmin = 70.72 
            xmax = 75.85 
            text = "My father does not feel my arm, he has no pulse nor will," 
        intervals [36]:
            xmin = 75.85 
            xmax = 76.88 
            text = "" 
        intervals [37]:
            xmin = 76.88 
            xmax = 80.99 
            text = "The ship is anchor’d safe and sound, its voyage closed and done," 
        intervals [38]:
            xmin = 80.99 
            xmax = 81.34 
            text = "" 
        intervals [39]:
            xmin = 81.34 
            xmax = 85.63 
            text = "From fearful trip the victor ship comes in with object won;" 
        intervals [40]:
            xmin = 85.63 
            xmax = 86.86 
            text = "" 
        intervals [41]:
            xmin = 86.86 
            xmax = 89.66 
            text = "Exult O shores, and ring O bells!" 
        intervals [42]:
            xmin = 89.66 
            xmax = 90.17 
            text = "" 
        intervals [43]:
            xmin = 90.17 
            xmax = 92.21 
            text = "But I with mournful tread," 
        intervals [44]:
            xmin = 92.21 
            xmax = 93.13 
            text = "" 
        intervals [45]:
            xmin = 93.13 
            xmax = 95.5 
            text = "Walk the deck my Captain lies," 
        intervals [46]:
            xmin = 95.5 
            xmax = 95.64 
            text = "" 
        intervals [47]:
            xmin = 95.64 
            xmax = 98.15 
            text = "Fallen cold and dead." 
        intervals [48]:
            xmin = 98.15 
            xmax = 98.257 
            text = "" 
