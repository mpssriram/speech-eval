    item [2]:
        class = "IntervalTier" 
        name = "sentences" 
        xmin = 0 
        xmax = 102.896 
        intervals: size = 44 
        intervals [1]:
            xmin = 0 
            xmax = 0.25 
            text = "" 
        intervals [2]:
            xmin = 0.25 
            xmax = 8.48 
            text = "O Captain! my Captain! our fearful trip is done," 
        intervals [3]:
            xmin = 8.48 
            xmax = 8.88 
            text = "" 
        intervals [4]:
            xmin = 8.88 
            xmax = 12.37 
            text = "The ship has weather’d every rack, the prize we sought is won," 
        intervals [5]:
            xmin = 12.37 
            xmax = 16.83 
            text = "The port is near, the bells I hear, the people all exulting," 
        intervals [6]:
            xmin = 16.83 
            xmax = 17.36 
            text = "" 
        intervals [7]:
            xmin = 17.36 
            xmax = 22.23 
            text = "While follow eyes the steady keel, the vessel grim and daring;" 
        intervals [8]:
            xmin = 22.23 
            xmax = 22.88 
            text = "" 
        intervals [9]:
            xmin = 22.88 
            xmax = 25.98 
            text = "But O heart! heart! heart!" 
        intervals [10]:
            xmin = 25.98 
            xmax = 28.25 
            text = "O the bleeding drops of red," 
        intervals [11]:
            xmin = 28.25 
            xmax = 28.93 
            text = "" 
        intervals [12]:
            xmin = 28.93 
            xmax = 31.54 
            text = "Where on the deck my Captain lies," 
        intervals [13]:
            xmin = 31.54 
            xmax = 32.51 
            text = "" 
        intervals [14]:
            xmin = 32.51 
            xmax = 35.11 
            text = "Fallen cold and dead." 
        intervals [15]:
            xmin = 35.11 
            xmax = 36.38 
            text = "" 
        intervals [16]:
            xmin = 36.38 
            xmax = 39.76 
            text = "O Captain! my Captain! rise up and hear the bells;" 
        intervals [17]:
            xmin = 39.76 
            xmax = 40.08 
            text = "" 
        intervals [18]:
            xmin = 40.08 
            xmax = 43.71 
            text = "Rise up- for you the flag is flung- for you the bugle trills," 
        intervals [19]:
            xmin = 43.71 
            xmax = 44.11 
            text = "" 
        intervals [20]:
            xmin = 44.11 
            xmax = 48.57 
            text = "For you bouquets and ribbon’d wreaths- for you the shores a-crowding," 
        intervals [21]:
            xmin = 48.57 
            xmax = 49.39 
            text = "" 
        intervals [22]:
            xmin = 49.39 
            xmax = 54.37 
            text = "For you they call, the swaying mass, their eager faces turning;" 
        intervals [23]:
            xmin = 54.37 
            xmax = 54.8 
            text = "" 
        intervals [24]:
            xmin = 54.8 
            xmax = 56.8 
            text = "Here Captain! dear father!" 
        intervals [25]:
            xmin = 56.8 
            xmax = 57.25 
            text = "" 
        intervals [26]:
            xmin = 57.25 
            xmax = 58.99 
            text = "This arm beneath your head!" 
        intervals [27]:
            xmin = 58.99 
            xmax = 59.02 
            text = "" 
        intervals [28]:
            xmin = 59.02 
            xmax = 61.2 
            text = "It is some dream that on the deck," 
        intervals [29]:
            xmin = 61.2 
            xmax = 61.31 
            text = "" 
        intervals [30]:
            xmin = 61.31 
            xmax = 63.69 
            text = "You’ve fallen cold and dead." 
        intervals [31]:
            xmin = 63.69 
            xmax = 65.37 
            text = "" 
        intervals [32]:
            xmin = 65.37 
            xmax = 71.17 
            text = "My Captain does not answer, his lips are pale and still," 
        intervals [33]:
            xmin = 71.17 
            xmax = 72.72 
            text = "" 
        intervals [34]:
            xmin = 72.72 
            xmax = 78.47 
            text = "My father does not feel my arm, he has no pulse nor will," 
        intervals [35]:
            xmin = 78.47 
            xmax = 78.9 
            text = "" 
        intervals [36]:
            xmin = 78.9 
            xmax = 83.6 
            text = "The ship is anchor’d safe and sound, its voyage closed and done," 
        intervals [37]:
            xmin = 83.6 
            xmax = 88.56 
            text = "From fearful trip the victor ship comes in with object won;" 
        intervals [38]:
            xmin = 88.56 
            xmax = 91.72 
            text = "Exult O shores, and ring O bells!" 
        intervals [39]:
            xmin = 91.72 
            xmax = 92.94 
            text = "" 
        intervals [40]:
            xmin = 92.94 
            xmax = 96.38 
            text = "But I with mournful tread," 
        intervals [41]:
            xmin = 96.38 
            xmax = 98.87 
            text = "Walk the deck my Captain lies," 
        intervals [42]:
            xmin = 98.87 
            xmax = 99.95 
            text = "" 
        intervals [43]:
            xmin = 99.95 
            xmax = 102.57 
            text = "Fallen cold and dead." 
        intervals [44]:
            xmin = 102.57 
            xmax = 102.896 
            text = "" 
