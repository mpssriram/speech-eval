    item [2]:
        class = "IntervalTier" 
        name = "sentences" 
        xmin = 0 
        xmax = 109.304 
        intervals: size = 48 
        intervals [1]:
            xmin = 0 
            xmax = 0.03 
            text = "" 
        intervals [2]:
            xmin = 0.03 
            xmax = 7.35 
            text = "2006 O Captain! my Captain! our fearful trip is done," 
        intervals [3]:
            xmin = 7.35 
            xmax = 8.19 
            text = "" 
        intervals [4]:
            xmin = 8.19 
            xmax = 12.117 
            text = "The ship has weather’d every rack, the prize we sought is won," 
        intervals [5]:
            xmin = 12.117 
            xmax = 13.057 
            text = "" 
        intervals [6]:
            xmin = 13.057 
            xmax = 17.097 
            text = "The port is near, the bells I hear, the people all exulting," 
        intervals [7]:
            xmin = 17.097 
            xmax = 17.791 
            text = "" 
        intervals [8]:
            xmin = 17.791 
            xmax = 22.661 
            text = "While follow eyes the steady keel, the vessel grim and daring;" 
        intervals [9]:
            xmin = 22.661 
            xmax = 23.653 
            text = "" 
        intervals [10]:
            xmin = 23.653 
            xmax = 26.195 
            text = "But O heart! heart! heart!" 
        intervals [11]:
            xmin = 26.195 
            xmax = 27.205 
            text = "" 
        intervals [12]:
            xmin = 27.205 
            xmax = 29.065 
            text = "O the bleeding drops of red," 
        intervals [13]:
            xmin = 29.065 
            xmax = 29.639 
            text = "" 
        intervals [14]:
            xmin = 29.639 
            xmax = 31.67 
            text = "Where on the deck my Captain lies," 
        intervals [15]:
            xmin = 31.67 
            xmax = 33.252 
            text = "Fallen cold and dead." 
        intervals [16]:
            xmin = 33.252 
            xmax = 34.562 
            text = "" 
        intervals [17]:
            xmin = 34.562 
            xmax = 37.722 
            text = "O Captain! my Captain! rise up and hear the bells;" 
        intervals [18]:
            xmin = 37.722 
            xmax = 38.217 
            text = "" 
        intervals [19]:
            xmin = 38.217 
            xmax = 43.417 
            text = "Rise up- for you the flag is flung- for you the bugle trills," 
        intervals [20]:
            xmin = 43.417 
            xmax = 43.852 
            text = "" 
        intervals [21]:
            xmin = 43.852 
            xmax = 48.341 
            text = "For you bouquets and ribbon’d wreaths- for you the shores a-crowding," 
        intervals [22]:
            xmin = 48.341 
            xmax = 49.552 
            text = "" 
        intervals [23]:
            xmin = 49.552 
            xmax = 53.972 
            text = "For you they call, the swaying mass, their eager faces turning;" 
        intervals [24]:
            xmin = 53.972 
            xmax = 54.662 
            text = "" 
        intervals [25]:
            xmin = 54.662 
            xmax = 57.266 
            text = "Here Captain! dear father!" 
        intervals [26]:
            xmin = 57.266 
            xmax = 58.036 
            text = "" 
        intervals [27]:
            xmin = 58.036 
            xmax = 59.946 
            text = "This arm beneath your head!" 
        intervals [28]:
            xmin = 59.946 
            xmax = 60.672 
            text = "" 
        intervals [29]:
            xmin = 60.672 
            xmax = 63.472 
            text = "It is some dream that on the deck," 
        intervals [30]:
            xmin = 63.472 
            xmax = 64.137 
            text = "" 
        intervals [31]:
            xmin = 64.137 
            xmax = 66.687 
            text = "You’ve fallen cold and dead." 
        intervals [32]:
            xmin = 66.687 
            xmax = 68.445 
            text = "" 
        intervals [33]:
            xmin = 68.445 
            xmax = 73.575 
            text = "My Captain does not answer, his lips are pale and still," 
        intervals [34]:
            xmin = 73.575 
            xmax = 74.735 
            text = "" 
        intervals [35]:
            xmin = 74.735 
            xmax = 80.375 
            text = "My father does not feel my arm, he has no pulse nor will," 
        intervals [36]:
            xmin = 80.375 
            xmax = 81.502 
            text = "" 
        intervals [37]:
            xmin = 81.502 
            xmax = 87.242 
            text = "The ship is anchor’d safe and sound, its voyage closed and done," 
        intervals [38]:
            xmin = 87.242 
            xmax = 88.279 
            text = "" 
        intervals [39]:
            xmin = 88.279 
            xmax = 94.049 
            text = "From fearful trip the victor ship comes in with object won;" 
        intervals [40]:
            xmin = 94.049 
            xmax = 95.316 
            text = "" 
        intervals [41]:
            xmin = 95.316 
            xmax = 99.219 
            text = "Exult O shores, and ring O bells!" 
        intervals [42]:
            xmin = 99.219 
            xmax = 99.81 
            text = "" 
        intervals [43]:
            xmin = 99.81 
            xmax = 102.69 
            text = "But I with mournful tread," 
        intervals [44]:
            xmin = 102.69 
            xmax = 103.397 
            text = "" 
        intervals [45]:
            xmin = 103.397 
            xmax = 105.728 
            text = "Walk the deck my Captain lies," 
        intervals [46]:
            xmin = 105.728 
            xmax = 106.758 
            text = "" 
        intervals [47]:
            xmin = 106.758 
            xmax = 109.088 
            text = "Fallen cold and dead." 
        intervals [48]:
            xmin = 109.088 
            xmax = 109.304 
            text = "" 
