    item [2]:
        class = "IntervalTier" 
        name = "sentences" 
        xmin = 0 
        xmax = 87.288 
        intervals: size = 49 
        intervals [1]:
            xmin = 0 
            xmax = 0.13 
            text = "" 
        intervals [2]:
            xmin = 0.13 
            xmax = 3.27 
            text = "O Captain! my Captain! our fearful trip is done," 
        intervals [3]:
            xmin = 3.27 
            xmax = 3.854 
            text = "" 
        intervals [4]:
            xmin = 3.854 
            xmax = 7.344 
            text = "The ship has weather’d every rack, the prize we sought is won," 
        intervals [5]:
            xmin = 7.344 
            xmax = 7.818 
            text = "" 
        intervals [6]:
            xmin = 7.818 
            xmax = 11.338 
            text = "The port is near, the bells I hear, the people all exulting," 
        intervals [7]:
            xmin = 11.338 
            xmax = 11.992 
            text = "" 
        intervals [8]:
            xmin = 11.992 
            xmax = 15.192 
            text = "While follow eyes the steady keel, the vessel grim and daring;" 
        intervals [9]:
            xmin = 15.192 
            xmax = 16.116 
            text = "" 
        intervals [10]:
            xmin = 16.116 
            xmax = 18.146 
            text = "But O heart! heart! heart!" 
        intervals [11]:
            xmin = 18.146 
            xmax = 18.819 
            text = "" 
        intervals [12]:
            xmin = 18.819 
            xmax = 20.409 
            text = "O the bleeding drops of red," 
        intervals [13]:
            xmin = 20.409 
            xmax = 20.66 
            text = "" 
        intervals [14]:
            xmin = 20.66 
            xmax = 22.66 
            text = "Where on the deck my Captain lies," 
        intervals [15]:
            xmin = 22.66 
            xmax = 22.913 
            text = "" 
        intervals [16]:
            xmin = 22.913 
            xmax = 24.372 
            text = "Fallen cold and dead." 
        intervals [17]:
            xmin = 24.372 
            xmax = 25.475 
            text = "" 
        intervals [18]:
            xmin = 25.475 
            xmax = 28.365 
            text = "O Captain! my Captain! rise up and hear the bells;" 
        intervals [19]:
            xmin = 28.365 
            xmax = 28.718 
            text = "" 
        intervals [20]:
            xmin = 28.718 
            xmax = 32.118 
            text = "Rise up- for you the flag is flung- for you the bugle trills," 
        intervals [21]:
            xmin = 32.118 
            xmax = 32.672 
            text = "" 
        intervals [22]:
            xmin = 32.672 
            xmax = 36.702 
            text = "For you bouquets and ribbon’d wreaths- for you the shores a-crowding," 
        intervals [23]:
            xmin = 36.702 
            xmax = 37.287 
            text = "" 
        intervals [24]:
            xmin = 37.287 
            xmax = 40.887 
            text = "For you they call, the swaying mass, their eager faces turning;" 
        intervals [25]:
            xmin = 40.887 
            xmax = 41.514 
            text = "" 
        intervals [26]:
            xmin = 41.514 
            xmax = 43.274 
            text = "Here Captain! dear father!" 
        intervals [27]:
            xmin = 43.274 
            xmax = 43.771 
            text = "" 
        intervals [28]:
            xmin = 43.771 
            xmax = 45.111 
            text = "This arm beneath your head!" 
        intervals [29]:
            xmin = 45.111 
            xmax = 45.713 
            text = "" 
        intervals [30]:
            xmin = 45.713 
            xmax = 47.533 
            text = "It is some dream that on the deck," 
        intervals [31]:
            xmin = 47.533 
            xmax = 47.775 
            text = "" 
        intervals [32]:
            xmin = 47.775 
            xmax = 49.375 
            text = "You’ve fallen cold and dead." 
        intervals [33]:
            xmin = 49.375 
            xmax = 50.298 
            text = "" 
        intervals [34]:
            xmin = 50.298 
            xmax = 53.568 
            text = "My Captain does not answer, his lips are pale and still," 
        intervals [35]:
            xmin = 53.568 
            xmax = 54.082 
            text = "" 
        intervals [36]:
            xmin = 54.082 
            xmax = 57.952 
            text = "My father does not feel my arm, he has no pulse nor will," 
        intervals [37]:
            xmin = 57.952 
            xmax = 58.568 
            text = "" 
        intervals [38]:
            xmin = 58.568 
            xmax = 61.898 
            text = "The ship is anchor’d safe and sound, its voyage closed and done," 
        intervals [39]:
            xmin = 61.898 
            xmax = 62.262 
            text = "" 
        intervals [40]:
            xmin = 62.262 
            xmax = 65.785 
            text = "From fearful trip the victor ship comes in with object won;" 
        intervals [41]:
            xmin = 65.785 
            xmax = 67.168 
            text = "" 
        intervals [42]:
            xmin = 67.168 
            xmax = 69.398 
            text = "Exult O shores, and ring O bells!" 
        intervals [43]:
            xmin = 69.398 
            xmax = 70.074 
            text = "" 
        intervals [44]:
            xmin = 70.074 
            xmax = 71.437 
            text = "But I with mournful tread," 
        intervals [45]:
            xmin = 71.437 
            xmax = 72.129 
            text = "" 
        intervals [46]:
            xmin = 72.129 
            xmax = 73.939 
            text = "Walk the deck my Captain lies," 
        intervals [47]:
            xmin = 73.939 
            xmax = 74.225 
            text = "" 
        intervals [48]:
            xmin = 74.225 
            xmax = 83.884 
            text = "Fallen cold and dead." 
        intervals [49]:
            xmin = 83.884 
            xmax = 87.288 
            text = "" 
