    item [2]:
        class = "IntervalTier" 
        name = "sentences" 
        xmin = 0 
        xmax = 109.316 
        intervals: size = 48 
        intervals [1]:
            xmin = 0 
            xmax = 0.25 
            text = "" 
        intervals [2]:
            xmin = 0.25 
            xmax = 14.836 
            text = "O Captain! my Captain! our fearful trip is done," 
        intervals [3]:
            xmin = 14.836 
            xmax = 15.296 
            text = "" 
        intervals [4]:
            xmin = 15.296 
            xmax = 18.776 
            text = "The ship has weather’d every rack, the prize we sought is won," 
        intervals [5]:
            xmin = 18.776 
            xmax = 18.811 
            text = "" 
        intervals [6]:
            xmin = 18.811 
            xmax = 23.251 
            text = "The port is near, the bells I hear, the people all exulting," 
        intervals [7]:
            xmin = 23.251 
            xmax = 23.776 
            text = "" 
        intervals [8]:
            xmin = 23.776 
            xmax = 28.636 
            text = "While follow eyes the steady keel, the vessel grim and daring;" 
        intervals [9]:
            xmin = 28.636 
            xmax = 29.304 
            text = "" 
        intervals [10]:
            xmin = 29.304 
            xmax = 32.19 
            text = "But O heart! heart! heart!" 
        intervals [11]:
            xmin = 32.19 
            xmax = 32.39 
            text = "" 
        intervals [12]:
            xmin = 32.39 
            xmax = 34.67 
            text = "O the bleeding drops of red," 
        intervals [13]:
            xmin = 34.67 
            xmax = 35.344 
            text = "" 
        intervals [14]:
            xmin = 35.344 
            xmax = 38.008 
            text = "Where on the deck my Captain lies," 
        intervals [15]:
            xmin = 38.008 
            xmax = 38.928 
            text = "" 
        intervals [16]:
            xmin = 38.928 
            xmax = 41.412 
            text = "Fallen cold and dead." 
        intervals [17]:
            xmin = 41.412 
            xmax = 42.803 
            text = "" 
        intervals [18]:
            xmin = 42.803 
            xmax = 46.173 
            text = "O Captain! my Captain! rise up and hear the bells;" 
        intervals [19]:
            xmin = 46.173 
            xmax = 46.499 
            text = "" 
        intervals [20]:
            xmin = 46.499 
            xmax = 50.13 
            text = "Rise up- for you the flag is flung- for you the bugle trills," 
        intervals [21]:
            xmin = 50.13 
            xmax = 50.535 
            text = "" 
        intervals [22]:
            xmin = 50.535 
            xmax = 54.54 
            text = "For you bouquets and ribbon’d wreaths- for you the shores a-crowding," 
        intervals [23]:
            xmin = 54.54 
            xmax = 55.802 
            text = "" 
        intervals [24]:
            xmin = 55.802 
            xmax = 60.792 
            text = "For you they call, the swaying mass, their eager faces turning;" 
        intervals [25]:
            xmin = 60.792 
            xmax = 61.224 
            text = "" 
        intervals [26]:
            xmin = 61.224 
            xmax = 63.224 
            text = "Here Captain! dear father!" 
        intervals [27]:
            xmin = 63.224 
            xmax = 63.668 
            text = "" 
        intervals [28]:
            xmin = 63.668 
            xmax = 65.213 
            text = "This arm beneath your head!" 
        intervals [29]:
            xmin = 65.213 
            xmax = 67.633 
            text = "It is some dream that on the deck," 
        intervals [30]:
            xmin = 67.633 
            xmax = 67.759 
            text = "" 
        intervals [31]:
            xmin = 67.759 
            xmax = 70.099 
            text = "You’ve fallen cold and dead." 
        intervals [32]:
            xmin = 70.099 
            xmax = 71.788 
            text = "" 
        intervals [33]:
            xmin = 71.788 
            xmax = 77.588 
            text = "My Captain does not answer, his lips are pale and still," 
        intervals [34]:
            xmin = 77.588 
            xmax = 79.14 
            text = "" 
        intervals [35]:
            xmin = 79.14 
            xmax = 84.89 
            text = "My father does not feel my arm, he has no pulse nor will," 
        intervals [36]:
            xmin = 84.89 
            xmax = 85.317 
            text = "" 
        intervals [37]:
            xmin = 85.317 
            xmax = 89.907 
            text = "The ship is anchor’d safe and sound, its voyage closed and done," 
        intervals [38]:
            xmin = 89.907 
            xmax = 90.073 
            text = "" 
        intervals [39]:
            xmin = 90.073 
            xmax = 94.889 
            text = "From fearful trip the victor ship comes in with object won;" 
        intervals [40]:
            xmin = 94.889 
            xmax = 95.009 
            text = "" 
        intervals [41]:
            xmin = 95.009 
            xmax = 98.139 
            text = "Exult O shores, and ring O bells!" 
        intervals [42]:
            xmin = 98.139 
            xmax = 99.354 
            text = "" 
        intervals [43]:
            xmin = 99.354 
            xmax = 102.614 
            text = "But I with mournful tread," 
        intervals [44]:
            xmin = 102.614 
            xmax = 102.779 
            text = "" 
        intervals [45]:
            xmin = 102.779 
            xmax = 105.682 
            text = "Walk the deck my Captain lies," 
        intervals [46]:
            xmin = 105.682 
            xmax = 106.363 
            text = "" 
        intervals [47]:
            xmin = 106.363 
            xmax = 108.993 
            text = "Fallen cold and dead." 
        intervals [48]:
            xmin = 108.993 
            xmax = 109.316 
            text = "" 
