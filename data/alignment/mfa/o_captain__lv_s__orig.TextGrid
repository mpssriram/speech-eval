    item [2]:
        class = "IntervalTier" 
        name = "sentences" 
        xmin = 0 
        xmax = 86.761 
        intervals: size = 49 
        intervals [1]:
            xmin = 0 
            xmax = 0.15 
            text = "" 
        intervals [2]:
            xmin = 0.15 
            xmax = 3.33 
            text = "O Captain! my Captain! our fearful trip is done," 
        intervals [3]:
            xmin = 3.33 
            xmax = 3.925 
            text = "" 
        intervals [4]:
            xmin = 3.925 
            xmax = 7.145 
            text = "The ship has weather’d every rack, the prize we sought is won," 
        intervals [5]:
            xmin = 7.145 
            xmax = 7.94 
            text = "" 
        intervals [6]:
            xmin = 7.94 
            xmax = 11.86 
            text = "The port is near, the bells I hear, the people all exulting," 
        intervals [7]:
            xmin = 11.86 
            xmax = 12.506 
            text = "" 
        intervals [8]:
            xmin = 12.506 
            xmax = 16.466 
            text = "While follow eyes the steady keel, the vessel grim and daring;" 
        intervals [9]:
            xmin = 16.466 
            xmax = 17.602 
            text = "" 
        intervals [10]:
            xmin = 17.602 
            xmax = 19.862 
            text = "But O heart! heart! heart!" 
        intervals [11]:
            xmin = 19.862 
            xmax = 20.735 
            text = "" 
        intervals [12]:
            xmin = 20.735 
            xmax = 22.475 
            text = "O the bleeding drops of red," 
        intervals [13]:
            xmin = 22.475 
            xmax = 23.22 
            text = "" 
        intervals [14]:
            xmin = 23.22 
            xmax = 25.242 
            text = "Where on the deck my Captain lies," 
        intervals [15]:
            xmin = 25.242 
            xmax = 25.702 
            text = "" 
        intervals [16]:
            xmin = 25.702 
            xmax = 27.485 
            text = "Fallen cold and dead." 
        intervals [17]:
            xmin = 27.485 
            xmax = 29.364 
            text = "" 
        intervals [18]:
            xmin = 29.364 
            xmax = 32.744 
            text = "O Captain! my Captain! rise up and hear the bells;" 
        intervals [19]:
            xmin = 32.744 
            xmax = 33.341 
            text = "" 
        intervals [20]:
            xmin = 33.341 
            xmax = 37.031 
            text = "Rise up- for you the flag is flung- for you the bugle trills," 
        intervals [21]:
            xmin = 37.031 
            xmax = 37.666 
            text = "" 
        intervals [22]:
            xmin = 37.666 
            xmax = 40.989 
            text = "For you bouquets and ribbon’d wreaths- for you the shores a-crowding," 
        intervals [23]:
            xmin = 40.989 
            xmax = 41.9 
            text = "" 
        intervals [24]:
            xmin = 41.9 
            xmax = 45.33 
            text = "For you they call, the swaying mass, their eager faces turning;" 
        intervals [25]:
            xmin = 45.33 
            xmax = 46.445 
            text = "" 
        intervals [26]:
            xmin = 46.445 
            xmax = 47.927 
            text = "Here Captain! dear father!" 
        intervals [27]:
            xmin = 47.927 
            xmax = 48.397 
            text = "" 
        intervals [28]:
            xmin = 48.397 
            xmax = 49.877 
            text = "This arm beneath your head!" 
        intervals [29]:
            xmin = 49.877 
            xmax = 50.797 
            text = "" 
        intervals [30]:
            xmin = 50.797 
            xmax = 52.747 
            text = "It is some dream that on the deck," 
        intervals [31]:
            xmin = 52.747 
            xmax = 52.859 
            text = "" 
        intervals [32]:
            xmin = 52.859 
            xmax = 55.109 
            text = "You’ve fallen cold and dead." 
        intervals [33]:
            xmin = 55.109 
            xmax = 57.054 
            text = "" 
        intervals [34]:
            xmin = 57.054 
            xmax = 60.794 
            text = "My Captain does not answer, his lips are pale and still," 
        intervals [35]:
            xmin = 60.794 
            xmax = 61.689 
            text = "" 
        intervals [36]:
            xmin = 61.689 
            xmax = 65.583 
            text = "My father does not feel my arm, he has no pulse nor will," 
        intervals [37]:
            xmin = 65.583 
            xmax = 66.733 
            text = "" 
        intervals [38]:
            xmin = 66.733 
            xmax = 70.333 
            text = "The ship is anchor’d safe and sound, its voyage closed and done," 
        intervals [39]:
            xmin = 70.333 
            xmax = 70.959 
            text = "" 
        intervals [40]:
            xmin = 70.959 
            xmax = 74.289 
            text = "From fearful trip the victor ship comes in with object won;" 
        intervals [41]:
            xmin = 74.289 
            xmax = 75.213 
            text = "" 
        intervals [42]:
            xmin = 75.213 
            xmax = 77.833 
            text = "Exult O shores, and ring O bells!" 
        intervals [43]:
            xmin = 77.833 
            xmax = 78.377 
            text = "" 
        intervals [44]:
            xmin = 78.377 
            xmax = 80.597 
            text = "But I with mournful tread," 
        intervals [45]:
            xmin = 80.597 
            xmax = 81.379 
            text = "" 
        intervals [46]:
            xmin = 81.379 
            xmax = 83.634 
            text = "Walk the deck my Captain lies," 
        intervals [47]:
            xmin = 83.634 
            xmax = 84.494 
            text = "" 
        intervals [48]:
            xmin = 84.494 
            xmax = 86.684 
            text = "Fallen cold and dead." 
        intervals [49]:
            xmin = 86.684 
            xmax = 86.761 
            text = "" 
