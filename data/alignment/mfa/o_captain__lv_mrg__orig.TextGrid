    item [2]:
        class = "IntervalTier" 
        name = "sentences" 
        xmin = 0 
        xmax = 86.412 
        intervals: size = 48 
        intervals [1]:
            xmin = 0 
            xmax = 0.14 
            text = "" 
        intervals [2]:
            xmin = 0.14 
            xmax = 2.843 
            text = "O Captain! my Captain! our fearful trip is done," 
        intervals [3]:
            xmin = 2.843 
            xmax = 3.553 
            text = "" 
        intervals [4]:
            xmin = 3.553 
            xmax = 7.543 
            text = "The ship has weather’d every rack, the prize we sought is won," 
        intervals [5]:
            xmin = 7.543 
            xmax = 8.16 
            text = "" 
        intervals [6]:
            xmin = 8.16 
            xmax = 12.01 
            text = "The port is near, the bells I hear, the people are exulting," 
        intervals [7]:
            xmin = 12.01 
            xmax = 12.837 
            text = "" 
        intervals [8]:
            xmin = 12.837 
            xmax = 17.007 
            text = "While follow eyes the steady keel, the vessel grim and daring;" 
        intervals [9]:
            xmin = 17.007 
            xmax = 17.383 
            text = "" 
        intervals [10]:
            xmin = 17.383 
            xmax = 19.872 
            text = "But O heart! heart! heart!" 
        intervals [11]:
            xmin = 19.872 
            xmax = 20.417 
            text = "" 
        intervals [12]:
            xmin = 20.417 
            xmax = 22.377 
            text = "O the bleeding drops of red," 
        intervals [13]:
            xmin = 22.377 
            xmax = 22.876 
            text = "" 
        intervals [14]:
            xmin = 22.876 
            xmax = 24.956 
            text = "Where on the deck my Captain lies," 
        intervals [15]:
            xmin = 24.956 
            xmax = 25.025 
            text = "" 
        intervals [16]:
            xmin = 25.025 
            xmax = 26.805 
            text = "Fallen cold and dead." 
        intervals [17]:
            xmin = 26.805 
            xmax = 27.779 
            text = "" 
        intervals [18]:
            xmin = 27.779 
            xmax = 30.959 
            text = "O Captain! my Captain! rise up and hear the bells;" 
        intervals [19]:
            xmin = 30.959 
            xmax = 31.323 
            text = "" 
        intervals [20]:
            xmin = 31.323 
            xmax = 35.983 
            text = "Rise up- for you the flag is flung- for you the bugle trills," 
        intervals [21]:
            xmin = 35.983 
            xmax = 36.3 
            text = "" 
        intervals [22]:
            xmin = 36.3 
            xmax = 40.856 
            text = "For you bouquets and ribbon’d wreaths- for you the shores a-crowding," 
        intervals [23]:
            xmin = 40.856 
            xmax = 41.777 
            text = "" 
        intervals [24]:
            xmin = 41.777 
            xmax = 45.612 
            text = "For you they call, the swaying mass, their eager faces turning;" 
        intervals [25]:
            xmin = 45.612 
            xmax = 46.532 
            text = "" 
        intervals [26]:
            xmin = 46.532 
            xmax = 48.022 
            text = "Here Captain! dear father!" 
        intervals [27]:
            xmin = 48.022 
            xmax = 48.056 
            text = "" 
        intervals [28]:
            xmin = 48.056 
            xmax = 49.526 
            text = "This arm beneath your head!" 
        intervals [29]:
            xmin = 49.526 
            xmax = 50.08 
            text = "" 
        intervals [30]:
            xmin = 50.08 
            xmax = 52.54 
            text = "It is some dream that on the deck," 
        intervals [31]:
            xmin = 52.54 
            xmax = 52.615 
            text = "" 
        intervals [32]:
            xmin = 52.615 
            xmax = 53.915 
            text = "You’ve fallen cold and dead." 
        intervals [33]:
            xmin = 53.915 
            xmax = 54.899 
            text = "" 
        intervals [34]:
            xmin = 54.899 
            xmax = 59.274 
            text = "My Captain does not answer, his lips are pale and still," 
        intervals [35]:
            xmin = 59.274 
            xmax = 63.69 
            text = "My father does not feel my arm, he has no pulse nor will," 
        intervals [36]:
            xmin = 63.69 
            xmax = 64.29 
            text = "" 
        intervals [37]:
            xmin = 64.29 
            xmax = 68.44 
            text = "The ship is anchor’d safe and sound, its voyage closed and done," 
        intervals [38]:
            xmin = 68.44 
            xmax = 68.926 
            text = "" 
        intervals [39]:
            xmin = 68.926 
            xmax = 72.807 
            text = "From fearful trip the victor ship comes in with object won;" 
        intervals [40]:
            xmin = 72.807 
            xmax = 73.652 
            text = "" 
        intervals [41]:
            xmin = 73.652 
            xmax = 76.582 
            text = "Exult O shores, and ring O bells!" 
        intervals [42]:
            xmin = 76.582 
            xmax = 76.978 
            text = "" 
        intervals [43]:
            xmin = 76.978 
            xmax = 79.887 
            text = "But I with mournful tread," 
        intervals [44]:
            xmin = 79.887 
            xmax = 80.688 
            text = "" 
        intervals [45]:
            xmin = 80.688 
            xmax = 82.801 
            text = "Walk the deck my Captain lies," 
        intervals [46]:
            xmin = 82.801 
            xmax = 83.521 
            text = "" 
        intervals [47]:
            xmin = 83.521 
            xmax = 86.151 
            text = "Fallen cold and dead. End" 
        intervals [48]:
            xmin = 86.151 
            xmax = 86.412 
            text = "" 
