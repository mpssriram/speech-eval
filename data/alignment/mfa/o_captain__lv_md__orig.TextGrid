    item [2]:
        class = "IntervalTier" 
        name = "sentences" 
        xmin = 0 
        xmax = 113.028 
        intervals: size = 49 
        intervals [1]:
            xmin = 0 
            xmax = 0.29 
            text = "" 
        intervals [2]:
            xmin = 0.29 
            xmax = 3.77 
            text = "O Captain! my Captain! our fearful trip is done," 
        intervals [3]:
            xmin = 3.77 
            xmax = 4.206 
            text = "" 
        intervals [4]:
            xmin = 4.206 
            xmax = 8.286 
            text = "The ship has weather’d every rack, the prize we sought is won," 
        intervals [5]:
            xmin = 8.286 
            xmax = 8.823 
            text = "" 
        intervals [6]:
            xmin = 8.823 
            xmax = 12.979 
            text = "The port is near, the bells I hear, the people all exulting," 
        intervals [7]:
            xmin = 12.979 
            xmax = 13.97 
            text = "" 
        intervals [8]:
            xmin = 13.97 
            xmax = 19.059 
            text = "While follow eyes the steady keel, the vessel grim and daring;" 
        intervals [9]:
            xmin = 19.059 
            xmax = 19.89 
            text = "" 
        intervals [10]:
            xmin = 19.89 
            xmax = 22.83 
            text = "But O heart! heart! heart!" 
        intervals [11]:
            xmin = 22.83 
            xmax = 23.535 
            text = "" 
        intervals [12]:
            xmin = 23.535 
            xmax = 25.828 
            text = "O the bleeding drops of red," 
        intervals [13]:
            xmin = 25.828 
            xmax = 26.538 
            text = "" 
        intervals [14]:
            xmin = 26.538 
            xmax = 29.378 
            text = "Where on the deck my Captain lies," 
        intervals [15]:
            xmin = 29.378 
            xmax = 29.758 
            text = "" 
        intervals [16]:
            xmin = 29.758 
            xmax = 31.478 
            text = "Fallen cold and dead." 
        intervals [17]:
            xmin = 31.478 
            xmax = 33.407 
            text = "" 
        intervals [18]:
            xmin = 33.407 
            xmax = 37.667 
            text = "O Captain! my Captain! rise up and hear the bells;" 
        intervals [19]:
            xmin = 37.667 
            xmax = 38.113 
            text = "" 
        intervals [20]:
            xmin = 38.113 
            xmax = 42.933 
            text = "Rise up- for you the flag is flung- for you the bugle trills," 
        intervals [21]:
            xmin = 42.933 
            xmax = 43.34 
            text = "" 
        intervals [22]:
            xmin = 43.34 
            xmax = 47.084 
            text = "For you bouquets and ribbon’d wreaths- for you the shores a-crowding," 
        intervals [23]:
            xmin = 47.084 
            xmax = 48.046 
            text = "" 
        intervals [24]:
            xmin = 48.046 
            xmax = 52.306 
            text = "For you they call, the swaying mass, their eager faces turning;" 
        intervals [25]:
            xmin = 52.306 
            xmax = 52.852 
            text = "" 
        intervals [26]:
            xmin = 52.852 
            xmax = 54.982 
            text = "Here Captain! dear father!" 
        intervals [27]:
            xmin = 54.982 
            xmax = 55.315 
            text = "" 
        intervals [28]:
            xmin = 55.315 
            xmax = 57.136 
            text = "This arm beneath your head!" 
        intervals [29]:
            xmin = 57.136 
            xmax = 57.678 
            text = "" 
        intervals [30]:
            xmin = 57.678 
            xmax = 59.931 
            text = "It is some dream that on the deck," 
        intervals [31]:
            xmin = 59.931 
            xmax = 59.981 
            text = "" 
        intervals [32]:
            xmin = 59.981 
            xmax = 61.921 
            text = "You’ve fallen cold and dead." 
        intervals [33]:
            xmin = 61.921 
            xmax = 63.576 
            text = "" 
        intervals [34]:
            xmin = 63.576 
            xmax = 68.166 
            text = "My Captain does not answer, his lips are pale and still," 
        intervals [35]:
            xmin = 68.166 
            xmax = 68.793 
            text = "" 
        intervals [36]:
            xmin = 68.793 
            xmax = 73.199 
            text = "My father does not feel my arm, he has no pulse nor will," 
        intervals [37]:
            xmin = 73.199 
            xmax = 73.939 
            text = "" 
        intervals [38]:
            xmin = 73.939 
            xmax = 78.639 
            text = "The ship is anchor’d safe and sound, its voyage closed and done," 
        intervals [39]:
            xmin = 78.639 
            xmax = 79.338 
            text = "" 
        intervals [40]:
            xmin = 79.338 
            xmax = 83.504 
            text = "From fearful trip the victor ship comes in with object won;" 
        intervals [41]:
            xmin = 83.504 
            xmax = 84.593 
            text = "" 
        intervals [42]:
            xmin = 84.593 
            xmax = 87.773 
            text = "Exult O shores, and ring O bells!" 
        intervals [43]:
            xmin = 87.773 
            xmax = 88.114 
            text = "" 
        intervals [44]:
            xmin = 88.114 
            xmax = 90.114 
            text = "But I with mournful tread," 
        intervals [45]:
            xmin = 90.114 
            xmax = 91.077 
            text = "" 
        intervals [46]:
            xmin = 91.077 
            xmax = 93.587 
            text = "Walk the deck my Captain lies," 
        intervals [47]:
            xmin = 93.587 
            xmax = 94.3 
            text = "" 
        intervals [48]:
            xmin = 94.3 
            xmax = 103.98 
            text = "Fallen cold and dead." 
        intervals [49]:
            xmin = 103.98 
            xmax = 113.028 
            text = "" 
