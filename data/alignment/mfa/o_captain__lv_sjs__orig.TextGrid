    item [2]:
        class = "IntervalTier" 
        name = "sentences" 
        xmin = 0 
        xmax = 97.983 
        intervals: size = 48 
        intervals [1]:
            xmin = 0 
            xmax = 0.05 
            text = "" 
        intervals [2]:
            xmin = 0.05 
            xmax = 3.9 
            text = "O Captain! my Captain! our fearful trip is done," 
        intervals [3]:
            xmin = 3.9 
            xmax = 4.536 
            text = "" 
        intervals [4]:
            xmin = 4.536 
            xmax = 7.646 
            text = "The ship has weather’d every rack, the prize we sought is won," 
        intervals [5]:
            xmin = 7.646 
            xmax = 8.563 
            text = "" 
        intervals [6]:
            xmin = 8.563 
            xmax = 12.613 
            text = "The port is near, the bells I hear, the people all exulting," 
        intervals [7]:
            xmin = 12.613 
            xmax = 13.069 
            text = "" 
        intervals [8]:
            xmin = 13.069 
            xmax = 16.799 
            text = "While follow eyes the steady keel, the vessel grim and daring;" 
        intervals [9]:
            xmin = 16.799 
            xmax = 18.557 
            text = "" 
        intervals [10]:
            xmin = 18.557 
            xmax = 20.967 
            text = "But O heart! heart! heart!" 
        intervals [11]:
            xmin = 20.967 
            xmax = 23.722 
            text = "" 
        intervals [12]:
            xmin = 23.722 
            xmax = 25.402 
            text = "O the bleeding drops of red," 
        intervals [13]:
            xmin = 25.402 
            xmax = 26.455 
            text = "" 
        intervals [14]:
            xmin = 26.455 
            xmax = 28.497 
            text = "Where on the deck my Captain lies," 
        intervals [15]:
            xmin = 28.497 
            xmax = 29.659 
            text = "Fallen cold and dead." 
        intervals [16]:
            xmin = 29.659 
            xmax = 31.789 
            text = "" 
        intervals [17]:
            xmin = 31.789 
            xmax = 35.359 
            text = "O Captain! my Captain! rise up and hear the bells;" 
        intervals [18]:
            xmin = 35.359 
            xmax = 35.626 
            text = "" 
        intervals [19]:
            xmin = 35.626 
            xmax = 39.146 
            text = "Rise up- for you the flag is flung- for you the bugle trills," 
        intervals [20]:
            xmin = 39.146 
            xmax = 39.781 
            text = "" 
        intervals [21]:
            xmin = 39.781 
            xmax = 43.255 
            text = "For you bouquets and ribbon’d wreaths- for you the shores a-crowding," 
        intervals [22]:
            xmin = 43.255 
            xmax = 44.437 
            text = "" 
        intervals [23]:
            xmin = 44.437 
            xmax = 48.141 
            text = "For you they call, the swaying mass, their eager faces turning;" 
        intervals [24]:
            xmin = 48.141 
            xmax = 50.262 
            text = "" 
        intervals [25]:
            xmin = 50.262 
            xmax = 51.858 
            text = "Here Captain! dear father!" 
        intervals [26]:
            xmin = 51.858 
            xmax = 52.338 
            text = "" 
        intervals [27]:
            xmin = 52.338 
            xmax = 53.57 
            text = "This arm beneath your head!" 
        intervals [28]:
            xmin = 53.57 
            xmax = 54.43 
            text = "" 
        intervals [29]:
            xmin = 54.43 
            xmax = 56.2 
            text = "It is some dream that on the deck," 
        intervals [30]:
            xmin = 56.2 
            xmax = 56.352 
            text = "" 
        intervals [31]:
            xmin = 56.352 
            xmax = 57.622 
            text = "You’ve fallen cold and dead." 
        intervals [32]:
            xmin = 57.622 
            xmax = 60.217 
            text = "" 
        intervals [33]:
            xmin = 60.217 
            xmax = 64.417 
            text = "My Captain does not answer, his lips are pale and still," 
        intervals [34]:
            xmin = 64.417 
            xmax = 65.543 
            text = "" 
        intervals [35]:
            xmin = 65.543 
            xmax = 70.238 
            text = "My father does not feel my arm, he has no pulse nor will," 
        intervals [36]:
            xmin = 70.238 
            xmax = 72.058 
            text = "" 
        intervals [37]:
            xmin = 72.058 
            xmax = 76.278 
            text = "The ship is anchor’d safe and sound, its voyage closed and done," 
        intervals [38]:
            xmin = 76.278 
            xmax = 76.954 
            text = "" 
        intervals [39]:
            xmin = 76.954 
            xmax = 80.739 
            text = "From fearful trip the victor ship comes in with object won;" 
        intervals [40]:
            xmin = 80.739 
            xmax = 81.929 
            text = "" 
        intervals [41]:
            xmin = 81.929 
            xmax = 84.149 
            text = "Exult O shores, and ring O bells!" 
        intervals [42]:
            xmin = 84.149 
            xmax = 84.987 
            text = "" 
        intervals [43]:
            xmin = 84.987 
            xmax = 86.817 
            text = "But I with mournful tread," 
        intervals [44]:
            xmin = 86.817 
            xmax = 87.873 
            text = "" 
        intervals [45]:
            xmin = 87.873 
            xmax = 89.753 
            text = "Walk the deck my Captain lies," 
        intervals [46]:
            xmin = 89.753 
            xmax = 90.619 
            text = "" 
        intervals [47]:
            xmin = 90.619 
            xmax = 97.399 
            text = "Fallen cold and dead." 
        intervals [48]:
            xmin = 97.399 
            xmax = 97.983 
            text = "" 
