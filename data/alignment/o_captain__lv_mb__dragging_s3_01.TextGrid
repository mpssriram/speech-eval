    item [2]:
        class = "IntervalTier" 
        name = "sentences" 
        xmin = 0 
        xmax = 82.433 
        intervals: size = 49 
        intervals [1]:
            xmin = 0 
            xmax = 0.14 
            text = "" 
        intervals [2]:
            xmin = 0.14 
            xmax = 3.43 
            text = "O Captain! my Captain! our fearful trip is done," 
        intervals [3]:
            xmin = 3.43 
            xmax = 3.7 
            text = "" 
        intervals [4]:
            xmin = 3.7 
            xmax = 8.15 
            text = "The ship has weather’d every rack, the prize we sought is won," 
        intervals [5]:
            xmin = 8.15 
            xmax = 8.77 
            text = "" 
        intervals [6]:
            xmin = 8.77 
            xmax = 12.67 
            text = "The port is near, the bells I hear, the people all exulting," 
        intervals [7]:
            xmin = 12.67 
            xmax = 13.16 
            text = "" 
        intervals [8]:
            xmin = 13.16 
            xmax = 17.12 
            text = "While follow eyes the steady keel, the vessel grim and daring;" 
        intervals [9]:
            xmin = 17.12 
            xmax = 17.62 
            text = "" 
        intervals [10]:
            xmin = 17.62 
            xmax = 19.64 
            text = "But O heart! heart! heart!" 
        intervals [11]:
            xmin = 19.64 
            xmax = 19.93 
            text = "" 
        intervals [12]:
            xmin = 19.93 
            xmax = 21.69 
            text = "O the bleeding drops of red," 
        intervals [13]:
            xmin = 21.69 
            xmax = 22.07 
            text = "" 
        intervals [14]:
            xmin = 22.07 
            xmax = 24.1 
            text = "Where on the deck my Captain lies," 
        intervals [15]:
            xmin = 24.1 
            xmax = 24.36 
            text = "" 
        intervals [16]:
            xmin = 24.36 
            xmax = 25.96 
            text = "Fallen cold and dead." 
        intervals [17]:
            xmin = 25.96 
            xmax = 27.13 
            text = "" 
        intervals [18]:
            xmin = 27.13 
            xmax = 30.41 
            text = "O Captain! my Captain! rise up and hear the bells;" 
        intervals [19]:
            xmin = 30.41 
            xmax = 30.94 
            text = "" 
        intervals [20]:
            xmin = 30.94 
            xmax = 35.31 
            text = "Rise up- for you the flag is flung- for you the bugle trills," 
        intervals [21]:
            xmin = 35.31 
            xmax = 35.61 
            text = "" 
        intervals [22]:
            xmin = 35.61 
            xmax = 39.86 
            text = "For you bouquets and ribbon’d wreaths- for you the shores a-crowding," 
        intervals [23]:
            xmin = 39.86 
            xmax = 40.39 
            text = "" 
        intervals [24]:
            xmin = 40.39 
            xmax = 44.57 
            text = "For you they call, the swaying mass, their eager faces turning;" 
        intervals [25]:
            xmin = 44.57 
            xmax = 45.26 
            text = "" 
        intervals [26]:
            xmin = 45.26 
            xmax = 47.21 
            text = "Here Captain! dear father!" 
        intervals [27]:
            xmin = 47.21 
            xmax = 47.52 
            text = "" 
        intervals [28]:
            xmin = 47.52 
            xmax = 49.06 
            text = "This arm beneath your head!" 
        intervals [29]:
            xmin = 49.06 
            xmax = 49.59 
            text = "" 
        intervals [30]:
            xmin = 49.59 
            xmax = 51.57 
            text = "It is some dream that on the deck," 
        intervals [31]:
            xmin = 51.57 
            xmax = 51.88 
            text = "" 
        intervals [32]:
            xmin = 51.88 
            xmax = 53.64 
            text = "You’ve fallen cold and dead." 
        intervals [33]:
            xmin = 53.64 
            xmax = 54.88 
            text = "" 
        intervals [34]:
            xmin = 54.88 
            xmax = 58.4 
            text = "My Captain does not answer, his lips are pale and still," 
        intervals [35]:
            xmin = 58.4 
            xmax = 59.06 
            text = "" 
        intervals [36]:
            xmin = 59.06 
            xmax = 62.97 
            text = "My father does not feel my arm, he has no pulse nor will," 
        intervals [37]:
            xmin = 62.97 
            xmax = 63.68 
            text = "" 
        intervals [38]:
            xmin = 63.68 
            xmax = 67.62 
            text = "The ship is anchor’d safe and sound, its voyage closed and done," 
        intervals [39]:
            xmin = 67.62 
            xmax = 68.08 
            text = "" 
        intervals [40]:
            xmin = 68.08 
            xmax = 72.11 
            text = "From fearful trip the victor ship comes in with object won;" 
        intervals [41]:
            xmin = 72.11 
            xmax = 72.82 
            text = "" 
        intervals [42]:
            xmin = 72.82 
            xmax = 75.42 
            text = "Exult O shores, and ring O bells!" 
        intervals [43]:
            xmin = 75.42 
            xmax = 75.86 
            text = "" 
        intervals [44]:
            xmin = 75.86 
            xmax = 77.52 
            text = "But I with mournful tread," 
        intervals [45]:
            xmin = 77.52 
            xmax = 77.95 
            text = "" 
        intervals [46]:
            xmin = 77.95 
            xmax = 80.05 
            text = "Walk the deck my Captain lies," 
        intervals [47]:
            xmin = 80.05 
            xmax = 80.29 
            text = "" 
        intervals [48]:
            xmin = 80.29 
            xmax = 82.22 
            text = "Fallen cold and dead." 
        intervals [49]:
            xmin = 82.22 
            xmax = 82.433 
            text = "" 
