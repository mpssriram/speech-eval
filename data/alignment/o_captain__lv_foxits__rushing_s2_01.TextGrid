    item [2]:
        class = "IntervalTier" 
        name = "sentences" 
        xmin = 0 
        xmax = 91.822 
        intervals: size = 49 
        intervals [1]:
            xmin = 0 
            xmax = 0.14 
            text = "" 
        intervals [2]:
            xmin = 0.14 
            xmax = 4.19 
            text = "O Captain! my Captain! our fearful trip is done," 
        intervals [3]:
            xmin = 4.19 
            xmax = 4.75 
            text = "" 
        intervals [4]:
            xmin = 4.75 
            xmax = 8.76 
            text = "The ship has weather’d every rack, the prize we sought is won," 
        intervals [5]:
            xmin = 8.76 
            xmax = 9.41 
            text = "" 
        intervals [6]:
            xmin = 9.41 
            xmax = 12.67 
            text = "The port is near, the bells I hear, the people all exulting," 
        intervals [7]:
            xmin = 12.67 
            xmax = 13.29 
            text = "" 
        intervals [8]:
            xmin = 13.29 
            xmax = 17.61 
            text = "While follow eyes the steady keel, the vessel grim and daring;" 
        intervals [9]:
            xmin = 17.61 
            xmax = 18.35 
            text = "" 
        intervals [10]:
            xmin = 18.35 
            xmax = 20.45 
            text = "But O heart! heart! heart!" 
        intervals [11]:
            xmin = 20.45 
            xmax = 21.13 
            text = "" 
        intervals [12]:
            xmin = 21.13 
            xmax = 22.89 
            text = "O the bleeding drops of red," 
        intervals [13]:
            xmin = 22.89 
            xmax = 23.58 
            text = "" 
        intervals [14]:
            xmin = 23.58 
            xmax = 25.65 
            text = "Where on the deck my Captain lies," 
        intervals [15]:
            xmin = 25.65 
            xmax = 26.01 
            text = "" 
        intervals [16]:
            xmin = 26.01 
            xmax = 27.57 
            text = "Fallen cold and dead." 
        intervals [17]:
            xmin = 27.57 
            xmax = 28.47 
            text = "" 
        intervals [18]:
            xmin = 28.47 
            xmax = 32.57 
            text = "O Captain! my Captain! rise up and hear the bells;" 
        intervals [19]:
            xmin = 32.57 
            xmax = 33.11 
            text = "" 
        intervals [20]:
            xmin = 33.11 
            xmax = 37.15 
            text = "Rise up- for you the flag is flung- for you the bugle trills," 
        intervals [21]:
            xmin = 37.15 
            xmax = 37.82 
            text = "" 
        intervals [22]:
            xmin = 37.82 
            xmax = 41.91 
            text = "For you bouquets and ribbon’d wreaths- for you the shores a-crowding," 
        intervals [23]:
            xmin = 41.91 
            xmax = 42.44 
            text = "" 
        intervals [24]:
            xmin = 42.44 
            xmax = 46.29 
            text = "For you they call, the swaying mass, their eager faces turning;" 
        intervals [25]:
            xmin = 46.29 
            xmax = 46.88 
            text = "" 
        intervals [26]:
            xmin = 46.88 
            xmax = 48.71 
            text = "Here Captain! dear father!" 
        intervals [27]:
            xmin = 48.71 
            xmax = 49.17 
            text = "" 
        intervals [28]:
            xmin = 49.17 
            xmax = 50.65 
            text = "This arm beneath your head!" 
        intervals [29]:
            xmin = 50.65 
            xmax = 51.25 
            text = "" 
        intervals [30]:
            xmin = 51.25 
            xmax = 53.07 
            text = "It is some dream that on the deck," 
        intervals [31]:
            xmin = 53.07 
            xmax = 53.43 
            text = "" 
        intervals [32]:
            xmin = 53.43 
            xmax = 55.12 
            text = "You’ve fallen cold and dead." 
        intervals [33]:
            xmin = 55.12 
            xmax = 56.82 
            text = "" 
        intervals [34]:
            xmin = 56.82 
            xmax = 60.78 
            text = "My Captain does not answer, his lips are pale and still," 
        intervals [35]:
            xmin = 60.78 
            xmax = 61.52 
            text = "" 
        intervals [36]:
            xmin = 61.52 
            xmax = 65.76 
            text = "My father does not feel my arm, he has no pulse nor will," 
        intervals [37]:
            xmin = 65.76 
            xmax = 66.53 
            text = "" 
        intervals [38]:
            xmin = 66.53 
            xmax = 70.73 
            text = "The ship is anchor’d safe and sound, its voyage closed and done," 
        intervals [39]:
            xmin = 70.73 
            xmax = 71.47 
            text = "" 
        intervals [40]:
            xmin = 71.47 
            xmax = 75.29 
            text = "From fearful trip the victor ship comes in with object won;" 
        intervals [41]:
            xmin = 75.29 
            xmax = 75.99 
            text = "" 
        intervals [42]:
            xmin = 75.99 
            xmax = 78.87 
            text = "Exult O shores, and ring O bells!" 
        intervals [43]:
            xmin = 78.87 
            xmax = 79.46 
            text = "" 
        intervals [44]:
            xmin = 79.46 
            xmax = 81.22 
            text = "But I with mournful tread," 
        intervals [45]:
            xmin = 81.22 
            xmax = 81.93 
            text = "" 
        intervals [46]:
            xmin = 81.93 
            xmax = 84.07 
            text = "Walk the deck my Captain lies," 
        intervals [47]:
            xmin = 84.07 
            xmax = 84.51 
            text = "" 
        intervals [48]:
            xmin = 84.51 
            xmax = 91.37 
            text = "Fallen cold and dead." 
        intervals [49]:
            xmin = 91.37 
            xmax = 91.822 
            text = "" 
