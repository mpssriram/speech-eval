    item [2]:
        class = "IntervalTier" 
        name = "sentences" 
        xmin = 0 
        xmax = 87.761 
        intervals: size = 49 
        intervals [1]:
            xmin = 0 
            xmax = 0.15 
            text = "" 
        intervals [2]:
            xmin = 0.15 
            xmax = 3.33 
            text = "O Captain! my Captain! our fearful trip is done," 
        intervals [3]:
            xmin = 3.33 
            xmax = 3.93 
            text = "" 
        intervals [4]:
            xmin = 3.93 
            xmax = 7.15 
            text = "The ship has weather’d every rack, the prize we sought is won," 
        intervals [5]:
            xmin = 7.15 
            xmax = 7.94 
            text = "" 
        intervals [6]:
            xmin = 7.94 
            xmax = 11.87 
            text = "The port is near, the bells I hear, the people all exulting," 
        intervals [7]:
            xmin = 11.87 
            xmax = 12.49 
            text = "" 
        intervals [8]:
            xmin = 12.49 
            xmax = 16.45 
            text = "While follow eyes the steady keel, the vessel grim and daring;" 
        intervals [9]:
            xmin = 16.45 
            xmax = 17.6 
            text = "" 
        intervals [10]:
            xmin = 17.6 
            xmax = 20.06 
            text = "But O heart! heart! heart!" 
        intervals [11]:
            xmin = 20.06 
            xmax = 20.73 
            text = "" 
        intervals [12]:
            xmin = 20.73 
            xmax = 22.51 
            text = "O the bleeding drops of red," 
        intervals [13]:
            xmin = 22.51 
            xmax = 23.22 
            text = "" 
        intervals [14]:
            xmin = 23.22 
            xmax = 25.4 
            text = "Where on the deck my Captain lies," 
        intervals [15]:
            xmin = 25.4 
            xmax = 25.7 
            text = "" 
        intervals [16]:
            xmin = 25.7 
            xmax = 27.8 
            text = "Fallen cold and dead." 
        intervals [17]:
            xmin = 27.8 
            xmax = 29.36 
            text = "" 
        intervals [18]:
            xmin = 29.36 
            xmax = 32.74 
            text = "O Captain! my Captain! rise up and hear the bells;" 
        intervals [19]:
            xmin = 32.74 
            xmax = 33.34 
            text = "" 
        intervals [20]:
            xmin = 33.34 
            xmax = 37.05 
            text = "Rise up- for you the flag is flung- for you the bugle trills," 
        intervals [21]:
            xmin = 37.05 
            xmax = 37.67 
            text = "" 
        intervals [22]:
            xmin = 37.67 
            xmax = 41.22 
            text = "For you bouquets and ribbon’d wreaths- for you the shores a-crowding," 
        intervals [23]:
            xmin = 41.22 
            xmax = 41.86 
            text = "" 
        intervals [24]:
            xmin = 41.86 
            xmax = 45.33 
            text = "For you they call, the swaying mass, their eager faces turning;" 
        intervals [25]:
            xmin = 45.33 
            xmax = 46.44 
            text = "" 
        intervals [26]:
            xmin = 46.44 
            xmax = 48 
            text = "Here Captain! dear father!" 
        intervals [27]:
            xmin = 48 
            xmax = 48.4 
            text = "" 
        intervals [28]:
            xmin = 48.4 
            xmax = 49.88 
            text = "This arm beneath your head!" 
        intervals [29]:
            xmin = 49.88 
            xmax = 50.79 
            text = "" 
        intervals [30]:
            xmin = 50.79 
            xmax = 52.78 
            text = "It is some dream that on the deck," 
        intervals [31]:
            xmin = 52.78 
            xmax = 52.86 
            text = "" 
        intervals [32]:
            xmin = 52.86 
            xmax = 55.11 
            text = "You’ve fallen cold and dead." 
        intervals [33]:
            xmin = 55.11 
            xmax = 57.06 
            text = "" 
        intervals [34]:
            xmin = 57.06 
            xmax = 60.81 
            text = "My Captain does not answer, his lips are pale and still," 
        intervals [35]:
            xmin = 60.81 
            xmax = 61.69 
            text = "" 
        intervals [36]:
            xmin = 61.69 
            xmax = 66.63 
            text = "My father does not feel my arm, he has no pulse nor will," 
        intervals [37]:
            xmin = 66.63 
            xmax = 67.72 
            text = "" 
        intervals [38]:
            xmin = 67.72 
            xmax = 71.33 
            text = "The ship is anchor’d safe and sound, its voyage closed and done," 
        intervals [39]:
            xmin = 71.33 
            xmax = 71.95 
            text = "" 
        intervals [40]:
            xmin = 71.95 
            xmax = 75.29 
            text = "From fearful trip the victor ship comes in with object won;" 
        intervals [41]:
            xmin = 75.29 
            xmax = 76.21 
            text = "" 
        intervals [42]:
            xmin = 76.21 
            xmax = 78.83 
            text = "Exult O shores, and ring O bells!" 
        intervals [43]:
            xmin = 78.83 
            xmax = 79.37 
            text = "" 
        intervals [44]:
            xmin = 79.37 
            xmax = 81.59 
            text = "But I with mournful tread," 
        intervals [45]:
            xmin = 81.59 
            xmax = 82.38 
            text = "" 
        intervals [46]:
            xmin = 82.38 
            xmax = 84.82 
            text = "Walk the deck my Captain lies," 
        intervals [47]:
            xmin = 84.82 
            xmax = 85.49 
            text = "" 
        intervals [48]:
            xmin = 85.49 
            xmax = 87.73 
            text = "Fallen cold and dead." 
        intervals [49]:
            xmin = 87.73 
            xmax = 87.761 
            text = "" 
