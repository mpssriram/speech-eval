    item [2]:
        class = "IntervalTier" 
        name = "sentences" 
        xmin = 0 
        xmax = 86.199 
        intervals: size = 48 
        intervals [1]:
            xmin = 0 
            xmax = 0.14 
            text = "" 
        intervals [2]:
            xmin = 0.14 
            xmax = 2.91 
            text = "O Captain! my Captain! our fearful trip is done," 
        intervals [3]:
            xmin = 2.91 
            xmax = 3.34 
            text = "" 
        intervals [4]:
            xmin = 3.34 
            xmax = 7.42 
            text = "The ship has weather’d every rack, the prize we sought is won," 
        intervals [5]:
            xmin = 7.42 
            xmax = 7.95 
            text = "" 
        intervals [6]:
            xmin = 7.95 
            xmax = 11.79 
            text = "The port is near, the bells I hear, the people are exulting," 
        intervals [7]:
            xmin = 11.79 
            xmax = 12.62 
            text = "" 
        intervals [8]:
            xmin = 12.62 
            xmax = 16.79 
            text = "While follow eyes the steady keel, the vessel grim and daring;" 
        intervals [9]:
            xmin = 16.79 
            xmax = 17.17 
            text = "" 
        intervals [10]:
            xmin = 17.17 
            xmax = 19.69 
            text = "But O heart! heart! heart!" 
        intervals [11]:
            xmin = 19.69 
            xmax = 20.2 
            text = "" 
        intervals [12]:
            xmin = 20.2 
            xmax = 22.19 
            text = "O the bleeding drops of red," 
        intervals [13]:
            xmin = 22.19 
            xmax = 22.66 
            text = "" 
        intervals [14]:
            xmin = 22.66 
            xmax = 24.78 
            text = "Where on the deck my Captain lies," 
        intervals [15]:
            xmin = 24.78 
            xmax = 24.82 
            text = "" 
        intervals [16]:
            xmin = 24.82 
            xmax = 26.59 
            text = "Fallen cold and dead." 
        intervals [17]:
            xmin = 26.59 
            xmax = 27.57 
            text = "" 
        intervals [18]:
            xmin = 27.57 
            xmax = 30.74 
            text = "O Captain! my Captain! rise up and hear the bells;" 
        intervals [19]:
            xmin = 30.74 
            xmax = 31.11 
            text = "" 
        intervals [20]:
            xmin = 31.11 
            xmax = 35.84 
            text = "Rise up- for you the flag is flung- for you the bugle trills," 
        intervals [21]:
            xmin = 35.84 
            xmax = 36.09 
            text = "" 
        intervals [22]:
            xmin = 36.09 
            xmax = 41.08 
            text = "For you bouquets and ribbon’d wreaths- for you the shores a-crowding," 
        intervals [23]:
            xmin = 41.08 
            xmax = 41.57 
            text = "" 
        intervals [24]:
            xmin = 41.57 
            xmax = 45.47 
            text = "For you they call, the swaying mass, their eager faces turning;" 
        intervals [25]:
            xmin = 45.47 
            xmax = 46.29 
            text = "" 
        intervals [26]:
            xmin = 46.29 
            xmax = 47.8 
            text = "Here Captain! dear father!" 
        intervals [27]:
            xmin = 47.8 
            xmax = 47.85 
            text = "" 
        intervals [28]:
            xmin = 47.85 
            xmax = 49.32 
            text = "This arm beneath your head!" 
        intervals [29]:
            xmin = 49.32 
            xmax = 49.85 
            text = "" 
        intervals [30]:
            xmin = 49.85 
            xmax = 52.33 
            text = "It is some dream that on the deck," 
        intervals [31]:
            xmin = 52.33 
            xmax = 52.36 
            text = "" 
        intervals [32]:
            xmin = 52.36 
            xmax = 53.71 
            text = "You’ve fallen cold and dead." 
        intervals [33]:
            xmin = 53.71 
            xmax = 54.69 
            text = "" 
        intervals [34]:
            xmin = 54.69 
            xmax = 59.03 
            text = "My Captain does not answer, his lips are pale and still," 
        intervals [35]:
            xmin = 59.03 
            xmax = 63.56 
            text = "My father does not feel my arm, he has no pulse nor will," 
        intervals [36]:
            xmin = 63.56 
            xmax = 64.08 
            text = "" 
        intervals [37]:
            xmin = 64.08 
            xmax = 68.23 
            text = "The ship is anchor’d safe and sound, its voyage closed and done," 
        intervals [38]:
            xmin = 68.23 
            xmax = 68.71 
            text = "" 
        intervals [39]:
            xmin = 68.71 
            xmax = 72.68 
            text = "From fearful trip the victor ship comes in with object won;" 
        intervals [40]:
            xmin = 72.68 
            xmax = 73.44 
            text = "" 
        intervals [41]:
            xmin = 73.44 
            xmax = 76.37 
            text = "Exult O shores, and ring O bells!" 
        intervals [42]:
            xmin = 76.37 
            xmax = 76.76 
            text = "" 
        intervals [43]:
            xmin = 76.76 
            xmax = 79.67 
            text = "But I with mournful tread," 
        intervals [44]:
            xmin = 79.67 
            xmax = 80.47 
            text = "" 
        intervals [45]:
            xmin = 80.47 
            xmax = 82.64 
            text = "Walk the deck my Captain lies," 
        intervals [46]:
            xmin = 82.64 
            xmax = 83.31 
            text = "" 
        intervals [47]:
            xmin = 83.31 
            xmax = 85.94 
            text = "Fallen cold and dead. End" 
        intervals [48]:
            xmin = 85.94 
            xmax = 86.199 
            text = "" 
