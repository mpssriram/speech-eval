    item [2]:
        class = "IntervalTier" 
        name = "sentences" 
        xmin = 0 
        xmax = 92.089 
        intervals: size = 49 
        intervals [1]:
            xmin = 0 
            xmax = 0.25 
            text = "" 
        intervals [2]:
            xmin = 0.25 
            xmax = 4.164 
            text = "O Captain! my Captain! our fearful trip is done," 
        intervals [3]:
            xmin = 4.164 
            xmax = 5.024 
            text = "" 
        intervals [4]:
            xmin = 5.024 
            xmax = 8.844 
            text = "The ship has weather’d every rack, the prize we sought is won," 
        intervals [5]:
            xmin = 8.844 
            xmax = 9.809 
            text = "" 
        intervals [6]:
            xmin = 9.809 
            xmax = 13.869 
            text = "The port is near, the bells I hear, the people all exulting," 
        intervals [7]:
            xmin = 13.869 
            xmax = 14.754 
            text = "" 
        intervals [8]:
            xmin = 14.754 
            xmax = 18.904 
            text = "While follow eyes the steady keel, the vessel grim and daring;" 
        intervals [9]:
            xmin = 18.904 
            xmax = 19.929 
            text = "" 
        intervals [10]:
            xmin = 19.929 
            xmax = 22.211 
            text = "But O heart! heart! heart!" 
        intervals [11]:
            xmin = 22.211 
            xmax = 23.15 
            text = "" 
        intervals [12]:
            xmin = 23.15 
            xmax = 24.941 
            text = "O the bleeding drops of red," 
        intervals [13]:
            xmin = 24.941 
            xmax = 25.694 
            text = "" 
        intervals [14]:
            xmin = 25.694 
            xmax = 27.666 
            text = "Where on the deck my Captain lies," 
        intervals [15]:
            xmin = 27.666 
            xmax = 28.316 
            text = "" 
        intervals [16]:
            xmin = 28.316 
            xmax = 29.916 
            text = "Fallen cold and dead." 
        intervals [17]:
            xmin = 29.916 
            xmax = 31.856 
            text = "" 
        intervals [18]:
            xmin = 31.856 
            xmax = 35.556 
            text = "O Captain! my Captain! rise up and hear the bells;" 
        intervals [19]:
            xmin = 35.556 
            xmax = 36.223 
            text = "" 
        intervals [20]:
            xmin = 36.223 
            xmax = 40.683 
            text = "Rise up- for you the flag is flung- for you the bugle trills," 
        intervals [21]:
            xmin = 40.683 
            xmax = 41.131 
            text = "" 
        intervals [22]:
            xmin = 41.131 
            xmax = 45.771 
            text = "For you bouquets and ribbon’d wreaths- for you the shores a-crowding," 
        intervals [23]:
            xmin = 45.771 
            xmax = 46.439 
            text = "" 
        intervals [24]:
            xmin = 46.439 
            xmax = 50.429 
            text = "For you they call, the swaying mass, their eager faces turning;" 
        intervals [25]:
            xmin = 50.429 
            xmax = 51.577 
            text = "" 
        intervals [26]:
            xmin = 51.577 
            xmax = 53.36 
            text = "Here Captain! dear father!" 
        intervals [27]:
            xmin = 53.36 
            xmax = 53.74 
            text = "" 
        intervals [28]:
            xmin = 53.74 
            xmax = 55.12 
            text = "This arm beneath your head!" 
        intervals [29]:
            xmin = 55.12 
            xmax = 55.803 
            text = "" 
        intervals [30]:
            xmin = 55.803 
            xmax = 57.733 
            text = "It is some dream that on the deck," 
        intervals [31]:
            xmin = 57.733 
            xmax = 58.087 
            text = "" 
        intervals [32]:
            xmin = 58.087 
            xmax = 59.737 
            text = "You’ve fallen cold and dead." 
        intervals [33]:
            xmin = 59.737 
            xmax = 61.062 
            text = "" 
        intervals [34]:
            xmin = 61.062 
            xmax = 65.342 
            text = "My Captain does not answer, his lips are pale and still," 
        intervals [35]:
            xmin = 65.342 
            xmax = 66.217 
            text = "" 
        intervals [36]:
            xmin = 66.217 
            xmax = 70.317 
            text = "My father does not feel my arm, he has no pulse nor will," 
        intervals [37]:
            xmin = 70.317 
            xmax = 71.722 
            text = "" 
        intervals [38]:
            xmin = 71.722 
            xmax = 75.786 
            text = "The ship is anchor’d safe and sound, its voyage closed and done," 
        intervals [39]:
            xmin = 75.786 
            xmax = 76.806 
            text = "" 
        intervals [40]:
            xmin = 76.806 
            xmax = 80.771 
            text = "From fearful trip the victor ship comes in with object won;" 
        intervals [41]:
            xmin = 80.771 
            xmax = 82.011 
            text = "" 
        intervals [42]:
            xmin = 82.011 
            xmax = 84.601 
            text = "Exult O shores, and ring O bells!" 
        intervals [43]:
            xmin = 84.601 
            xmax = 85.005 
            text = "" 
        intervals [44]:
            xmin = 85.005 
            xmax = 86.765 
            text = "But I with mournful tread," 
        intervals [45]:
            xmin = 86.765 
            xmax = 87.498 
            text = "" 
        intervals [46]:
            xmin = 87.498 
            xmax = 89.688 
            text = "Walk the deck my Captain lies," 
        intervals [47]:
            xmin = 89.688 
            xmax = 90.19 
            text = "" 
        intervals [48]:
            xmin = 90.19 
            xmax = 91.89 
            text = "Fallen cold and dead." 
        intervals [49]:
            xmin = 91.89 
            xmax = 92.089 
            text = "" 
